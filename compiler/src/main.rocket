import std.collections
import std.binary
import std.crypto
import std.file
import std.path
import std.process
import std.string
import std.target

struct Diagnostic:
    code: String
    line: Int
    column: Int
    message: String

struct Token:
    kind: Int
    text: String
    line: Int
    column: Int

struct LexResult:
    tokens: Array[Token]
    diagnostics: Array[Diagnostic]

struct AstExpr:
    kind: Int
    text: String
    children: Array[AstExpr]
    line: Int
    column: Int

struct AstMatchCase:
    variant: String
    wildcard: Bool
    bindings: Array[String]
    body: Array[AstStatement]
    line: Int
    column: Int

struct AstStatement:
    kind: Int
    name: String
    type_name: String
    mutable_binding: Bool
    expressions: Array[AstExpr]
    body: Array[AstStatement]
    else_body: Array[AstStatement]
    cases: Array[AstMatchCase]
    line: Int
    column: Int

struct AstParameter:
    name: String
    type_name: String
    line: Int
    column: Int

struct AstTraitConstraint:
    type_parameter: String
    trait_name: String
    line: Int
    column: Int

struct AstFunction:
    name: String
    public_declaration: Bool
    type_parameters: Array[String]
    parameters: Array[AstParameter]
    result_type: String
    body: Array[AstStatement]
    method_owner: String
    method_trait: String
    associated_constant: Bool
    native_import: Bool
    native_export: Bool
    native_constant: Bool
    native_name: String
    constraints: Array[AstTraitConstraint]
    line: Int
    column: Int
    asynchronous: Bool

struct AstTypeField:
    name: String
    type_name: String
    line: Int
    column: Int

struct AstStructDecl:
    name: String
    public_declaration: Bool
    type_parameters: Array[String]
    fields: Array[AstTypeField]
    representation: Int
    callback_parameters: Array[AstParameter]
    callback_result: String
    native_name: String
    line: Int
    column: Int

struct AstEnumVariant:
    name: String
    payload_types: Array[String]
    line: Int
    column: Int

struct AstEnumDecl:
    name: String
    public_declaration: Bool
    type_parameters: Array[String]
    variants: Array[AstEnumVariant]
    line: Int
    column: Int

struct AstTraitMethod:
    name: String
    parameters: Array[AstParameter]
    result_type: String
    line: Int
    column: Int

struct AstTraitDecl:
    name: String
    public_declaration: Bool
    methods: Array[AstTraitMethod]
    line: Int
    column: Int

struct AstImport:
    name: String
    line: Int
    column: Int

struct AstModule:
    imports: Array[AstImport]
    structs: Array[AstStructDecl]
    enums: Array[AstEnumDecl]
    traits: Array[AstTraitDecl]
    functions: Array[AstFunction]

struct ParserState:
    tokens: Array[Token]
    index: Int
    diagnostics: Array[Diagnostic]

struct TokenResult:
    token: Token
    state: ParserState

struct MatchResult:
    matched: Bool
    state: ParserState

struct TypeNameResult:
    name: String
    state: ParserState

struct StringsResult:
    values: Array[String]
    state: ParserState

struct ExprResult:
    expression: AstExpr
    state: ParserState

struct ExpressionsResult:
    expressions: Array[AstExpr]
    state: ParserState

struct StatementResult:
    statement: AstStatement
    state: ParserState

struct StatementsResult:
    statements: Array[AstStatement]
    state: ParserState

struct MatchCasesResult:
    cases: Array[AstMatchCase]
    state: ParserState

struct FunctionResult:
    function: AstFunction
    state: ParserState

struct FunctionsResult:
    functions: Array[AstFunction]
    state: ParserState

struct StructResult:
    declaration: AstStructDecl
    state: ParserState

struct EnumResult:
    declaration: AstEnumDecl
    state: ParserState

struct TraitResult:
    declaration: AstTraitDecl
    state: ParserState

struct ParseResult:
    module: AstModule
    diagnostics: Array[Diagnostic]

struct ProgramLoadState:
    module: AstModule
    diagnostics: Array[Diagnostic]
    loaded_paths: Array[String]
    active_paths: Array[String]
    source_bytes: Int

struct HirSymbol:
    id: Int
    kind: Int
    name: String
    type_name: String
    mutable_binding: Bool
    parameter_types: Array[String]
    intrinsic: Int
    native_import: Bool
    native_export: Bool
    native_name: String
    asynchronous: Bool

struct HirExpr:
    kind: Int
    text: String
    type_name: String
    children: Array[HirExpr]
    symbol: Int
    field: Int
    line: Int
    column: Int

struct HirMatchCase:
    tag: Int
    bindings: Array[Int]
    body: Array[HirStatement]
    line: Int
    column: Int

struct HirStatement:
    kind: Int
    symbol: Int
    extra_symbol: Int
    expressions: Array[HirExpr]
    body: Array[HirStatement]
    else_body: Array[HirStatement]
    cases: Array[HirMatchCase]
    line: Int
    column: Int

struct HirFunction:
    symbol: Int
    parameters: Array[Int]
    result_type: String
    body: Array[HirStatement]
    asynchronous: Bool

struct HirModule:
    symbols: Array[HirSymbol]
    structs: Array[AstStructDecl]
    enums: Array[AstEnumDecl]
    functions: Array[HirFunction]
    library: Bool

struct ScopeBinding:
    name: String
    symbol: Int
    depth: Int

struct LambdaCapture:
    name: String
    symbol: Int

struct Substitutions:
    names: Array[String]
    values: Array[String]

struct PendingSpecialization:
    function_index: Int
    symbol: Int
    substitutions: Substitutions

struct Specialization:
    key: String
    symbol: Int

struct LowerState:
    module: AstModule
    symbols: Array[HirSymbol]
    functions: Array[HirFunction]
    bindings: Array[ScopeBinding]
    depth: Int
    return_type: String
    loop_depth: Int
    unsafe_depth: Int
    substitutions: Substitutions
    pending: Array[PendingSpecialization]
    specializations: Array[Specialization]
    diagnostics: Array[Diagnostic]
    current_async: Bool
    moved_symbols: Array[Int]
    borrowing_unique: Bool
    move_analysis_enabled: Bool

struct SymbolResult:
    symbol: Int
    state: LowerState

struct HirExprResult:
    expression: HirExpr
    state: LowerState

struct HirStatementResult:
    statement: HirStatement
    state: LowerState

struct HirStatementsResult:
    statements: Array[HirStatement]
    state: LowerState

struct HirFunctionResult:
    function: HirFunction
    state: LowerState

struct HirResult:
    module: HirModule
    diagnostics: Array[Diagnostic]

struct MirLocal:
    id: Int
    type_name: String
    parameter: Bool

struct MirOperand:
    local: Int
    constant: String
    type_name: String
    is_constant: Bool

struct MirInstruction:
    kind: Int
    destination: Int
    operands: Array[MirOperand]
    symbol: Int
    field: Int
    text: String
    type_name: String

struct MirTerminator:
    kind: Int
    target: Int
    then_target: Int
    else_target: Int
    condition: MirOperand
    returned: MirOperand
    has_returned: Bool

struct MirBlock:
    id: Int
    instructions: Array[MirInstruction]
    terminator: MirTerminator

struct MirFunction:
    symbol: Int
    parameters: Array[Int]
    locals: Array[MirLocal]
    blocks: Array[MirBlock]
    result_type: String
    asynchronous: Bool

struct MirModule:
    symbols: Array[HirSymbol]
    structs: Array[AstStructDecl]
    functions: Array[MirFunction]
    library: Bool

struct MirSymbolLocal:
    symbol: Int
    local: Int

struct MirState:
    module: HirModule
    locals: Array[MirLocal]
    symbol_locals: Array[MirSymbolLocal]
    blocks: Array[MirBlock]
    current_block: Int
    current_instructions: Array[MirInstruction]
    terminated: Bool
    next_block: Int
    break_targets: Array[Int]
    continue_targets: Array[Int]
    diagnostics: Array[Diagnostic]

struct MirOperandResult:
    operand: MirOperand
    state: MirState

struct MirStateResult:
    state: MirState

struct MirBlockResult:
    block: Int
    state: MirState

struct MirFunctionBuildResult:
    function: MirFunction
    diagnostics: Array[Diagnostic]

struct MirResult:
    module: MirModule
    diagnostics: Array[Diagnostic]

struct LlvmValue:
    name: String
    type_name: String

struct StandardSignature:
    found: Bool
    type_parameters: Array[String]
    parameter_types: Array[String]
    result_type: String
    intrinsic: Int

struct EnumConstructor:
    found: Bool
    declaration: Int
    variant: Int

struct PackageInfo:
    valid: Bool
    root: String
    entry: String
    test_directory: String
    name: String
    output_kind: Int
    output_name: String
    native_libraries: Array[String]
    native_library_search: Array[String]
    native_headers: Array[String]
    target_alias: String
    target_triple: String
    target_source_root: String
    error: String

struct TargetInfo:
    valid: Bool
    alias: String
    triple: String
    os: String
    architecture: String
    environment: String
    pointer_width: Int
    endianness: String
    features: Array[String]
    error_code: String
    error: String

struct TargetCommandOptions:
    valid: Bool
    input: String
    selected_target: TargetInfo
    target_sdk: String
    filter: String
    error_code: String
    error: String

struct DependencyImportPath:
    matched: Bool
    valid: Bool
    path: String

struct ToolchainInfo:
    valid: Bool
    clang: String
    runtime: String
    librarian: String
    library_directories: Array[String]
    sysroot: String
    error_code: String
    error: String

struct NativeBuildResult:
    status: Int
    executable: String

struct BuildHashResult:
    valid: Bool
    entries: Array[String]
    error: String

struct BindingParameterResult:
    valid: Bool
    type_name: String
    name: String

struct BindingGenerationResult:
    valid: Bool
    output: String
    error: String

