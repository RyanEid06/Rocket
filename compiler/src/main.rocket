fn append[T](values: Array[T], value: T) -> Array[T]:
    return collections.append(values, value)

fn prefix[T](values: Array[T], count: Int) -> Array[T]:
    var result: Array[T] = []
    for index in 0..count:
        result = append(result, values[index])
    return result

fn make_token(kind: Int, text: String, line: Int, column: Int) -> Token:
    return Token(kind, text, line, column)

fn make_diagnostic(code: String, line: Int, column: Int, message: String) -> Diagnostic:
    return Diagnostic(code, line, column, message)

fn keyword_kind(word: String) -> Int:
    if word == "fn":
        return kind_fn()
    if word == "let":
        return kind_let()
    if word == "var":
        return kind_var()
    if word == "if":
        return kind_if()
    if word == "else":
        return kind_else()
    if word == "while":
        return kind_while()
    if word == "for":
        return kind_for()
    if word == "in":
        return kind_in()
    if word == "break":
        return kind_break()
    if word == "continue":
        return kind_continue()
    if word == "return":
        return kind_return()
    if word == "true":
        return kind_true()
    if word == "false":
        return kind_false()
    if word == "and":
        return kind_and()
    if word == "or":
        return kind_or()
    if word == "not":
        return kind_not()
    if word == "struct":
        return kind_struct()
    if word == "enum":
        return kind_enum()
    if word == "trait":
        return kind_trait()
    if word == "impl":
        return kind_impl()
    if word == "where":
        return kind_where()
    if word == "const":
        return kind_const()
    if word == "match":
        return kind_match()
    if word == "case":
        return kind_case()
    if word == "pub":
        return kind_pub()
    if word == "import":
        return kind_import()
    return kind_identifier()

fn is_identifier_start(text: String, index: Int) -> Bool:
    let character = string.slice(text, index, index + 1)
    return string.contains("abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ_", character)

fn is_digit(text: String, index: Int) -> Bool:
    let character = string.slice(text, index, index + 1)
    return string.contains("0123456789", character)

fn is_identifier_continue(text: String, index: Int) -> Bool:
    return is_identifier_start(text, index) or is_digit(text, index)

fn escaped_character(raw: String) -> String:
    if raw == "\\n":
        return "\n"
    if raw == "\\r":
        return "\r"
    if raw == "\\t":
        return "\t"
    if raw == "\\'":
        return "'"
    if raw == "\\\\":
        return "\\"
    return ""

fn scan_line(line_text: String, line_number: Int, start: Int, input_tokens: Array[Token], input_diagnostics: Array[Diagnostic]) -> LexResult:
    var tokens = input_tokens
    var diagnostics = input_diagnostics
    var index = start
    let length = string.byte_length(line_text)
    while index < length:
        let character = string.byte_at(line_text, index)
        if character == ' ' or character == '\r':
            index = index + 1
            continue
        if character == '#':
            return LexResult(tokens, diagnostics)
        if character == '\t':
            diagnostics = append(diagnostics, make_diagnostic("R1002", line_number, index + 1, "tabs are not allowed; use spaces"))
            index = index + 1
            continue
        if is_identifier_start(line_text, index):
            let begin = index
            index = index + 1
            while index < length and is_identifier_continue(line_text, index):
                index = index + 1
            let word = string.slice(line_text, begin, index)
            tokens = append(tokens, make_token(keyword_kind(word), word, line_number, begin + 1))
            continue
        if is_digit(line_text, index):
            let begin = index
            index = index + 1
            while index < length and is_digit(line_text, index):
                index = index + 1
            var token_kind = kind_integer()
            if index + 1 < length and string.byte_at(line_text, index) == '.' and string.byte_at(line_text, index + 1) != '.' and is_digit(line_text, index + 1):
                token_kind = kind_float()
                index = index + 1
                while index < length and is_digit(line_text, index):
                    index = index + 1
            tokens = append(tokens, make_token(token_kind, string.slice(line_text, begin, index), line_number, begin + 1))
            continue
        if character == '\'':
            let begin = index
            index = index + 1
            let content_begin = index
            var escaped = false
            var closed = false
            while index < length:
                let current = string.byte_at(line_text, index)
                if not escaped and current == '\'':
                    closed = true
                    break
                if not escaped and current == '\\':
                    escaped = true
                else:
                    escaped = false
                index = index + 1
            var value = ""
            if closed:
                let raw = string.slice(line_text, content_begin, index)
                if string.byte_length(raw) == 1:
                    value = raw
                else:
                    value = escaped_character(raw)
                index = index + 1
            if not closed or string.byte_length(value) != 1:
                diagnostics = append(diagnostics, make_diagnostic("R1001", line_number, begin + 1, "character literals must contain exactly one byte"))
            tokens = append(tokens, make_token(kind_character(), value, line_number, begin + 1))
            continue
        if character == '"':
            let begin = index
            index = index + 1
            var segment_begin = index
            var value = ""
            var closed = false
            while index < length:
                let current = string.byte_at(line_text, index)
                if current == '"':
                    value = string.concat(value, string.slice(line_text, segment_begin, index))
                    index = index + 1
                    closed = true
                    break
                if current == '\\' and index + 1 < length:
                    value = string.concat(value, string.slice(line_text, segment_begin, index))
                    let escaped = string.byte_at(line_text, index + 1)
                    if escaped == 'n':
                        value = string.concat(value, "\n")
                    else:
                        if escaped == 'r':
                            value = string.concat(value, "\r")
                        else:
                            if escaped == 't':
                                value = string.concat(value, "\t")
                            else:
                                if escaped == '"':
                                    value = string.concat(value, "\"")
                                else:
                                    if escaped == '\\':
                                        value = string.concat(value, "\\")
                                    else:
                                        diagnostics = append(diagnostics, make_diagnostic("R1001", line_number, index + 2, "unknown string escape"))
                                        value = string.concat(value, string.slice(line_text, index + 1, index + 2))
                    index = index + 2
                    segment_begin = index
                    continue
                index = index + 1
            if not closed:
                diagnostics = append(diagnostics, make_diagnostic("R1001", line_number, begin + 1, "unterminated string literal"))
            tokens = append(tokens, make_token(kind_string(), value, line_number, begin + 1))
            continue
        let column = index + 1
        if character == '(':
            tokens = append(tokens, make_token(kind_lparen(), "(", line_number, column))
            index = index + 1
            continue
        if character == ')':
            tokens = append(tokens, make_token(kind_rparen(), ")", line_number, column))
            index = index + 1
            continue
        if character == '[':
            tokens = append(tokens, make_token(kind_lbracket(), "[", line_number, column))
            index = index + 1
            continue
        if character == ']':
            tokens = append(tokens, make_token(kind_rbracket(), "]", line_number, column))
            index = index + 1
            continue
        if character == ':':
            tokens = append(tokens, make_token(kind_colon(), ":", line_number, column))
            index = index + 1
            continue
        if character == ',':
            tokens = append(tokens, make_token(kind_comma(), ",", line_number, column))
            index = index + 1
            continue
        if character == '+':
            tokens = append(tokens, make_token(kind_plus(), "+", line_number, column))
            index = index + 1
            continue
        if character == '*':
            tokens = append(tokens, make_token(kind_star(), "*", line_number, column))
            index = index + 1
            continue
        if character == '/':
            tokens = append(tokens, make_token(kind_slash(), "/", line_number, column))
            index = index + 1
            continue
        if character == '?':
            tokens = append(tokens, make_token(kind_question(), "?", line_number, column))
            index = index + 1
            continue
        if character == '.':
            if index + 1 < length and string.byte_at(line_text, index + 1) == '.':
                tokens = append(tokens, make_token(kind_dotdot(), "..", line_number, column))
                index = index + 2
            else:
                tokens = append(tokens, make_token(kind_dot(), ".", line_number, column))
                index = index + 1
            continue
        if character == '-':
            if index + 1 < length and string.byte_at(line_text, index + 1) == '>':
                tokens = append(tokens, make_token(kind_arrow(), "->", line_number, column))
                index = index + 2
            else:
                tokens = append(tokens, make_token(kind_minus(), "-", line_number, column))
                index = index + 1
            continue
        if character == '=':
            if index + 1 < length and string.byte_at(line_text, index + 1) == '=':
                tokens = append(tokens, make_token(kind_equal_equal(), "==", line_number, column))
                index = index + 2
            else:
                if index + 1 < length and string.byte_at(line_text, index + 1) == '>':
                    tokens = append(tokens, make_token(kind_fat_arrow(), "=>", line_number, column))
                    index = index + 2
                else:
                    tokens = append(tokens, make_token(kind_equal(), "=", line_number, column))
                    index = index + 1
            continue
        if character == '<':
            if index + 1 < length and string.byte_at(line_text, index + 1) == '=':
                tokens = append(tokens, make_token(kind_less_equal(), "<=", line_number, column))
                index = index + 2
            else:
                tokens = append(tokens, make_token(kind_less(), "<", line_number, column))
                index = index + 1
            continue
        if character == '>':
            if index + 1 < length and string.byte_at(line_text, index + 1) == '=':
                tokens = append(tokens, make_token(kind_greater_equal(), ">=", line_number, column))
                index = index + 2
            else:
                tokens = append(tokens, make_token(kind_greater(), ">", line_number, column))
                index = index + 1
            continue
        if character == '!':
            if index + 1 < length and string.byte_at(line_text, index + 1) == '=':
                tokens = append(tokens, make_token(kind_bang_equal(), "!=", line_number, column))
                index = index + 2
            else:
                diagnostics = append(diagnostics, make_diagnostic("R1001", line_number, column, "expected '=' after '!'"))
                index = index + 1
            continue
        diagnostics = append(diagnostics, make_diagnostic("R1001", line_number, column, "unexpected source byte"))
        index = index + 1
    return LexResult(tokens, diagnostics)

fn lex_source(source: String) -> LexResult:
    let lines = string.split(source, "\n")
    var tokens: Array[Token] = []
    var pending_tokens: Array[Token] = []
    var diagnostics: Array[Diagnostic] = []
    var indents = [0]
    var line_number = 1
    for line_index in 0..collections.length(lines):
        var line_text = lines[line_index]
        let original_length = string.byte_length(line_text)
        if original_length > 0 and string.byte_at(line_text, original_length - 1) == '\r':
            line_text = string.slice(line_text, 0, original_length - 1)
        let length = string.byte_length(line_text)
        var first = 0
        while first < length and string.byte_at(line_text, first) == ' ':
            first = first + 1
        if first < length and string.byte_at(line_text, first) == '\t':
            diagnostics = append(diagnostics, make_diagnostic("R1002", line_number, first + 1, "tabs are not allowed for indentation"))
            while first < length and string.byte_at(line_text, first) == '\t':
                first = first + 1
        let blank = first >= length or string.byte_at(line_text, first) == '#'
        if not blank:
            if first / 4 * 4 != first:
                diagnostics = append(diagnostics, make_diagnostic("R1002", line_number, 1, "indentation must use multiples of four spaces"))
            let current_indent = indents[collections.length(indents) - 1]
            if first > current_indent:
                indents = append(indents, first)
                pending_tokens = append(pending_tokens, make_token(kind_indent(), "", line_number, 1))
            else:
                while first < indents[collections.length(indents) - 1]:
                    indents = prefix(indents, collections.length(indents) - 1)
                    pending_tokens = append(pending_tokens, make_token(kind_dedent(), "", line_number, 1))
                if first != indents[collections.length(indents) - 1]:
                    diagnostics = append(diagnostics, make_diagnostic("R1002", line_number, 1, "indentation does not match an outer block"))
            let scanned = scan_line(line_text, line_number, first, pending_tokens, diagnostics)
            pending_tokens = append(scanned.tokens, make_token(kind_newline(), "", line_number, length + 1))
            diagnostics = scanned.diagnostics
            if line_index > 0 and line_index / 64 * 64 == line_index:
                tokens = collections.concat(tokens, pending_tokens)
                pending_tokens = []
        line_number = line_number + 1
    tokens = collections.concat(tokens, pending_tokens)
    while collections.length(indents) > 1:
        indents = prefix(indents, collections.length(indents) - 1)
        tokens = append(tokens, make_token(kind_dedent(), "", line_number, 1))
    tokens = append(tokens, make_token(kind_end(), "", line_number, 1))
    return LexResult(tokens, diagnostics)

fn make_expression(kind: Int, text: String, children: Array[AstExpr], token: Token) -> AstExpr:
    return AstExpr(kind, text, children, token.line, token.column)

fn make_statement(kind: Int, name: String, type_name: String, mutable_binding: Bool, expressions: Array[AstExpr], body: Array[AstStatement], else_body: Array[AstStatement], cases: Array[AstMatchCase], token: Token) -> AstStatement:
    return AstStatement(kind, name, type_name, mutable_binding, expressions, body, else_body, cases, token.line, token.column)

fn current_token(state: ParserState) -> Token:
    return state.tokens[state.index]

fn at_token(state: ParserState, kind: Int) -> Bool:
    return current_token(state).kind == kind

fn advance_parser(state: ParserState) -> ParserState:
    if state.index + 1 < collections.length(state.tokens):
        return ParserState(state.tokens, state.index + 1, state.diagnostics)
    return state

fn token_name(kind: Int) -> String:
    if kind == kind_end():
        return "end of file"
    if kind == kind_newline():
        return "newline"
    if kind == kind_indent():
        return "indent"
    if kind == kind_dedent():
        return "dedent"
    if kind == kind_identifier():
        return "identifier"
    if kind == kind_integer():
        return "integer"
    if kind == kind_float():
        return "float"
    if kind == kind_character():
        return "character"
    if kind == kind_string():
        return "string"
    return "token"

fn parser_error(state: ParserState, token: Token, message: String) -> ParserState:
    let diagnostic = make_diagnostic("R2001", token.line, token.column, message)
    return ParserState(state.tokens, state.index, append(state.diagnostics, diagnostic))

fn match_token(state: ParserState, kind: Int) -> MatchResult:
    if at_token(state, kind):
        return MatchResult(true, advance_parser(state))
    return MatchResult(false, state)

fn consume_token(state: ParserState, kind: Int, message: String) -> TokenResult:
    let token = current_token(state)
    if token.kind == kind:
        return TokenResult(token, advance_parser(state))
    let detail = string.concat(message, string.concat("; found ", token_name(token.kind)))
    var next = parser_error(state, token, detail)
    if token.kind != kind_end():
        next = advance_parser(next)
    return TokenResult(token, next)

fn skip_newlines(state: ParserState) -> ParserState:
    var next = state
    while at_token(next, kind_newline()):
        next = advance_parser(next)
    return next

fn parse_type_name(state: ParserState) -> TypeNameResult:
    let outer = consume_token(state, kind_identifier(), "expected type")
    var next = outer.state
    var name = outer.token.text
    var dotted = match_token(next, kind_dot())
    next = dotted.state
    while dotted.matched:
        let member = consume_token(next, kind_identifier(), "expected type name after '.'")
        name = string.concat(name, string.concat(".", member.token.text))
        next = member.state
        dotted = match_token(next, kind_dot())
        next = dotted.state
    let bracket = match_token(next, kind_lbracket())
    next = bracket.state
    if not bracket.matched:
        return TypeNameResult(name, next)
    name = string.concat(name, "[")
    var first = true
    while true:
        let argument = parse_type_name(next)
        next = argument.state
        if not first:
            name = string.concat(name, ", ")
        name = string.concat(name, argument.name)
        first = false
        let comma = match_token(next, kind_comma())
        next = comma.state
        if not comma.matched:
            break
    let close = consume_token(next, kind_rbracket(), "expected ']' after type arguments")
    return TypeNameResult(string.concat(name, "]"), close.state)

fn parse_type_parameters(state: ParserState) -> StringsResult:
    let bracket = match_token(state, kind_lbracket())
    var next = bracket.state
    var parameters: Array[String] = []
    if not bracket.matched:
        return StringsResult(parameters, next)
    while true:
        let parameter = consume_token(next, kind_identifier(), "expected type parameter")
        parameters = append(parameters, parameter.token.text)
        next = parameter.state
        let comma = match_token(next, kind_comma())
        next = comma.state
        if not comma.matched:
            break
    let close = consume_token(next, kind_rbracket(), "expected ']' after type parameters")
    return StringsResult(parameters, close.state)

fn parse_primary(state: ParserState) -> ExprResult:
    let token = current_token(state)
    if token.kind == kind_fn():
        let open = consume_token(advance_parser(state), kind_lparen(), "expected '(' after 'fn' in lambda")
        var next = open.state
        var parameter_nodes: Array[AstExpr] = []
        if not at_token(next, kind_rparen()):
            while true:
                let parameter = consume_token(next, kind_identifier(), "expected lambda parameter name")
                let colon = consume_token(parameter.state, kind_colon(), "expected ':' after lambda parameter name")
                let parameter_type = parse_type_name(colon.state)
                let type_node = make_expression(expr_name(), parameter_type.name, [], parameter.token)
                parameter_nodes = append(parameter_nodes, make_expression(expr_name(), parameter.token.text, [type_node], parameter.token))
                next = parameter_type.state
                let comma = match_token(next, kind_comma())
                next = comma.state
                if not comma.matched:
                    break
        let close = consume_token(next, kind_rparen(), "expected ')' after lambda parameters")
        let arrow = consume_token(close.state, kind_arrow(), "expected '->' and lambda result type")
        let result_type = parse_type_name(arrow.state)
        let body_arrow = consume_token(result_type.state, kind_fat_arrow(), "expected '=>' before lambda expression")
        let body = parse_expression(body_arrow.state)
        return ExprResult(make_expression(expr_lambda(), result_type.name, collections.concat(parameter_nodes, [body.expression]), token), body.state)
    if token.kind == kind_lbracket():
        var next = advance_parser(state)
        var elements: Array[AstExpr] = []
        if not at_token(next, kind_rbracket()):
            while true:
                let element = parse_expression(next)
                elements = append(elements, element.expression)
                next = element.state
                let comma = match_token(next, kind_comma())
                next = comma.state
                if not comma.matched:
                    break
        let close = consume_token(next, kind_rbracket(), "expected ']' after Array literal")
        return ExprResult(make_expression(expr_array(), "", elements, token), close.state)
    if token.kind == kind_integer():
        return ExprResult(make_expression(expr_integer(), token.text, [], token), advance_parser(state))
    if token.kind == kind_float():
        return ExprResult(make_expression(expr_float(), token.text, [], token), advance_parser(state))
    if token.kind == kind_character():
        return ExprResult(make_expression(expr_character(), token.text, [], token), advance_parser(state))
    if token.kind == kind_string():
        return ExprResult(make_expression(expr_string(), token.text, [], token), advance_parser(state))
    if token.kind == kind_true() or token.kind == kind_false():
        return ExprResult(make_expression(expr_bool(), token.text, [], token), advance_parser(state))
    if token.kind == kind_identifier():
        return ExprResult(make_expression(expr_name(), token.text, [], token), advance_parser(state))
    if token.kind == kind_lparen():
        let inner = parse_expression(advance_parser(state))
        let close = consume_token(inner.state, kind_rparen(), "expected ')' after expression")
        return ExprResult(inner.expression, close.state)
    var next = parser_error(state, token, string.concat("expected expression; found ", token_name(token.kind)))
    if token.kind != kind_end():
        next = advance_parser(next)
    return ExprResult(make_expression(expr_integer(), "0", [], token), next)

fn parse_call(state: ParserState) -> ExprResult:
    let primary = parse_primary(state)
    var expression = primary.expression
    var next = primary.state
    while true:
        let token = current_token(next)
        if token.kind == kind_lparen():
            next = advance_parser(next)
            var arguments: Array[AstExpr] = []
            if not at_token(next, kind_rparen()):
                while true:
                    let argument = parse_expression(next)
                    arguments = append(arguments, argument.expression)
                    next = argument.state
                    let comma = match_token(next, kind_comma())
                    next = comma.state
                    if not comma.matched:
                        break
            let close = consume_token(next, kind_rparen(), "expected ')' after arguments")
            next = close.state
            expression = make_expression(expr_call(), "", collections.concat([expression], arguments), token)
            continue
        if token.kind == kind_lbracket():
            next = advance_parser(next)
            let first = parse_expression(next)
            next = first.state
            let range = match_token(next, kind_dotdot())
            next = range.state
            if range.matched:
                let end = parse_expression(next)
                let close = consume_token(end.state, kind_rbracket(), "expected ']' after slice bounds")
                expression = make_expression(expr_slice(), "", [expression, first.expression, end.expression], token)
                next = close.state
            else:
                let close = consume_token(next, kind_rbracket(), "expected ']' after index")
                expression = make_expression(expr_index(), "", [expression, first.expression], token)
                next = close.state
            continue
        if token.kind == kind_dot():
            let field = consume_token(advance_parser(next), kind_identifier(), "expected field name after '.'")
            expression = make_expression(expr_field(), field.token.text, [expression], field.token)
            next = field.state
            continue
        if token.kind == kind_question():
            expression = make_expression(expr_propagate(), "", [expression], token)
            next = advance_parser(next)
            continue
        break
    return ExprResult(expression, next)

fn parse_unary(state: ParserState) -> ExprResult:
    let token = current_token(state)
    if token.kind == kind_identifier() and token.text == "await":
        let operand = parse_unary(advance_parser(state))
        return ExprResult(make_expression(expr_await(), "", [operand.expression], token), operand.state)
    if token.kind == kind_minus() or token.kind == kind_not():
        let operand = parse_unary(advance_parser(state))
        return ExprResult(make_expression(expr_unary(), token.text, [operand.expression], token), operand.state)
    return parse_call(state)

fn parse_factor(state: ParserState) -> ExprResult:
    let first = parse_unary(state)
    var expression = first.expression
    var next = first.state
    while at_token(next, kind_star()) or at_token(next, kind_slash()):
        let op = current_token(next)
        let right = parse_unary(advance_parser(next))
        expression = make_expression(expr_binary(), op.text, [expression, right.expression], op)
        next = right.state
    return ExprResult(expression, next)

fn parse_term(state: ParserState) -> ExprResult:
    let first = parse_factor(state)
    var expression = first.expression
    var next = first.state
    while at_token(next, kind_plus()) or at_token(next, kind_minus()):
        let op = current_token(next)
        let right = parse_factor(advance_parser(next))
        expression = make_expression(expr_binary(), op.text, [expression, right.expression], op)
        next = right.state
    return ExprResult(expression, next)

fn parse_comparison(state: ParserState) -> ExprResult:
    let first = parse_term(state)
    var expression = first.expression
    var next = first.state
    while at_token(next, kind_less()) or at_token(next, kind_less_equal()) or at_token(next, kind_greater()) or at_token(next, kind_greater_equal()):
        let op = current_token(next)
        let right = parse_term(advance_parser(next))
        expression = make_expression(expr_binary(), op.text, [expression, right.expression], op)
        next = right.state
    return ExprResult(expression, next)

fn parse_equality(state: ParserState) -> ExprResult:
    let first = parse_comparison(state)
    var expression = first.expression
    var next = first.state
    while at_token(next, kind_equal_equal()) or at_token(next, kind_bang_equal()):
        let op = current_token(next)
        let right = parse_comparison(advance_parser(next))
        expression = make_expression(expr_binary(), op.text, [expression, right.expression], op)
        next = right.state
    return ExprResult(expression, next)

fn parse_and(state: ParserState) -> ExprResult:
    let first = parse_equality(state)
    var expression = first.expression
    var next = first.state
    while at_token(next, kind_and()):
        let op = current_token(next)
        let right = parse_equality(advance_parser(next))
        expression = make_expression(expr_binary(), op.text, [expression, right.expression], op)
        next = right.state
    return ExprResult(expression, next)

fn parse_or(state: ParserState) -> ExprResult:
    let first = parse_and(state)
    var expression = first.expression
    var next = first.state
    while at_token(next, kind_or()):
        let op = current_token(next)
        let right = parse_and(advance_parser(next))
        expression = make_expression(expr_binary(), op.text, [expression, right.expression], op)
        next = right.state
    return ExprResult(expression, next)

fn parse_expression(state: ParserState) -> ExprResult:
    return parse_or(state)

fn parse_block(state: ParserState) -> StatementsResult:
    let opening = consume_token(state, kind_indent(), "expected an indented block")
    var next = opening.state
    var statements: Array[AstStatement] = []
    while not at_token(next, kind_dedent()) and not at_token(next, kind_end()):
        if at_token(next, kind_newline()):
            next = advance_parser(next)
            continue
        let parsed = parse_statement(next)
        statements = append(statements, parsed.statement)
        next = parsed.state
    let closing = consume_token(next, kind_dedent(), "expected end of indented block")
    return StatementsResult(statements, closing.state)

fn parse_if_statement(state: ParserState) -> StatementResult:
    let keyword = consume_token(state, kind_if(), "expected 'if'")
    let condition = parse_expression(keyword.state)
    let colon = consume_token(condition.state, kind_colon(), "expected ':' after condition")
    let newline = consume_token(colon.state, kind_newline(), "expected newline after condition")
    let then_block = parse_block(newline.state)
    var next = then_block.state
    var else_body: Array[AstStatement] = []
    let otherwise = match_token(next, kind_else())
    next = otherwise.state
    if otherwise.matched:
        let else_colon = consume_token(next, kind_colon(), "expected ':' after 'else'")
        let else_newline = consume_token(else_colon.state, kind_newline(), "expected newline after 'else'")
        let else_block = parse_block(else_newline.state)
        else_body = else_block.statements
        next = else_block.state
    let statement = make_statement(statement_if(), "", "", false, [condition.expression], then_block.statements, else_body, [], keyword.token)
    return StatementResult(statement, next)

fn parse_while_statement(state: ParserState) -> StatementResult:
    let keyword = consume_token(state, kind_while(), "expected 'while'")
    let condition = parse_expression(keyword.state)
    let colon = consume_token(condition.state, kind_colon(), "expected ':' after condition")
    let newline = consume_token(colon.state, kind_newline(), "expected newline after condition")
    let body = parse_block(newline.state)
    return StatementResult(make_statement(statement_while(), "", "", false, [condition.expression], body.statements, [], [], keyword.token), body.state)

fn parse_for_statement(state: ParserState) -> StatementResult:
    let keyword = consume_token(state, kind_for(), "expected 'for'")
    let name = consume_token(keyword.state, kind_identifier(), "expected loop variable name")
    let inside = consume_token(name.state, kind_in(), "expected 'in' after loop variable")
    let start = parse_expression(inside.state)
    let range = match_token(start.state, kind_dotdot())
    var next = range.state
    var expressions: Array[AstExpr] = [start.expression]
    if range.matched:
        let end = parse_expression(next)
        expressions = append(expressions, end.expression)
        next = end.state
    let colon = consume_token(next, kind_colon(), "expected ':' after for source")
    let newline = consume_token(colon.state, kind_newline(), "expected newline after range")
    let body = parse_block(newline.state)
    return StatementResult(make_statement(statement_for(), name.token.text, "", false, expressions, body.statements, [], [], keyword.token), body.state)

fn parse_match_statement(state: ParserState) -> StatementResult:
    let keyword = consume_token(state, kind_match(), "expected 'match'")
    let value = parse_expression(keyword.state)
    let colon = consume_token(value.state, kind_colon(), "expected ':' after match value")
    let newline = consume_token(colon.state, kind_newline(), "expected newline after match value")
    let opening = consume_token(newline.state, kind_indent(), "expected an indented match body")
    var next = opening.state
    var cases: Array[AstMatchCase] = []
    while not at_token(next, kind_dedent()) and not at_token(next, kind_end()):
        if at_token(next, kind_newline()):
            next = advance_parser(next)
            continue
        let case_keyword = consume_token(next, kind_case(), "expected 'case' in match body")
        let variant = consume_token(case_keyword.state, kind_identifier(), "expected variant name or '_'")
        next = variant.state
        var variant_name = variant.token.text
        var dot = match_token(next, kind_dot())
        next = dot.state
        while dot.matched:
            let member = consume_token(next, kind_identifier(), "expected variant name after '.'")
            variant_name = string.concat(variant_name, string.concat(".", member.token.text))
            next = member.state
            dot = match_token(next, kind_dot())
            next = dot.state
        var bindings: Array[String] = []
        let parenthesis = match_token(next, kind_lparen())
        next = parenthesis.state
        if parenthesis.matched:
            if not at_token(next, kind_rparen()):
                while true:
                    let binding = consume_token(next, kind_identifier(), "expected pattern binding")
                    bindings = append(bindings, binding.token.text)
                    next = binding.state
                    let comma = match_token(next, kind_comma())
                    next = comma.state
                    if not comma.matched:
                        break
            let close = consume_token(next, kind_rparen(), "expected ')' after pattern bindings")
            next = close.state
        let case_colon = consume_token(next, kind_colon(), "expected ':' after pattern")
        let case_newline = consume_token(case_colon.state, kind_newline(), "expected newline after pattern")
        let body = parse_block(case_newline.state)
        cases = append(cases, AstMatchCase(variant_name, variant_name == "_", bindings, body.statements, variant.token.line, variant.token.column))
        next = body.state
    let closing = consume_token(next, kind_dedent(), "expected end of match body")
    return StatementResult(make_statement(statement_match(), "", "", false, [value.expression], [], [], cases, keyword.token), closing.state)

fn parse_statement(state: ParserState) -> StatementResult:
    let token = current_token(state)
    if token.kind == kind_identifier() and token.text == "unsafe" and current_token(advance_parser(state)).kind == kind_colon():
        let colon = consume_token(advance_parser(state), kind_colon(), "expected ':' after 'unsafe'")
        let newline = consume_token(colon.state, kind_newline(), "expected newline after 'unsafe:'")
        let body = parse_block(newline.state)
        return StatementResult(make_statement(statement_unsafe(), "", "", false, [], body.statements, [], [], token), body.state)
    if token.kind == kind_let() or token.kind == kind_var():
        var next = advance_parser(state)
        let name = consume_token(next, kind_identifier(), "expected binding name")
        next = name.state
        var declared_type = ""
        let type_colon = match_token(next, kind_colon())
        next = type_colon.state
        if type_colon.matched:
            let parsed_type = parse_type_name(next)
            declared_type = parsed_type.name
            next = parsed_type.state
        let equal = consume_token(next, kind_equal(), "expected '=' after binding name")
        let value = parse_expression(equal.state)
        let newline = consume_token(value.state, kind_newline(), "expected newline after binding")
        return StatementResult(make_statement(statement_binding(), name.token.text, declared_type, token.kind == kind_var(), [value.expression], [], [], [], token), newline.state)
    if token.kind == kind_return():
        var next = advance_parser(state)
        var expressions: Array[AstExpr] = []
        if not at_token(next, kind_newline()):
            let value = parse_expression(next)
            expressions = append(expressions, value.expression)
            next = value.state
        let newline = consume_token(next, kind_newline(), "expected newline after return")
        return StatementResult(make_statement(statement_return(), "", "", false, expressions, [], [], [], token), newline.state)
    if token.kind == kind_if():
        return parse_if_statement(state)
    if token.kind == kind_while():
        return parse_while_statement(state)
    if token.kind == kind_for():
        return parse_for_statement(state)
    if token.kind == kind_match():
        return parse_match_statement(state)
    if token.kind == kind_break():
        let newline = consume_token(advance_parser(state), kind_newline(), "expected newline after 'break'")
        return StatementResult(make_statement(statement_break(), "", "", false, [], [], [], [], token), newline.state)
    if token.kind == kind_continue():
        let newline = consume_token(advance_parser(state), kind_newline(), "expected newline after 'continue'")
        return StatementResult(make_statement(statement_continue(), "", "", false, [], [], [], [], token), newline.state)
    let parsed_target = parse_expression(state)
    let equal = match_token(parsed_target.state, kind_equal())
    if equal.matched:
        let value = parse_expression(equal.state)
        let newline = consume_token(value.state, kind_newline(), "expected newline after assignment")
        if parsed_target.expression.kind == expr_name():
            return StatementResult(make_statement(statement_assignment(), parsed_target.expression.text, "", false, [value.expression], [], [], [], token), newline.state)
        if parsed_target.expression.kind == expr_index() and parsed_target.expression.children[0].kind == expr_name():
            return StatementResult(make_statement(statement_index_assignment(), parsed_target.expression.children[0].text, "", false, [parsed_target.expression.children[1], value.expression], [], [], [], token), newline.state)
        let invalid = parser_error(newline.state, token, "assignment target must be a binding or Array element")
        return StatementResult(make_statement(statement_expression(), "", "", false, [value.expression], [], [], [], token), invalid)
    let newline = consume_token(parsed_target.state, kind_newline(), "expected newline after expression")
    return StatementResult(make_statement(statement_expression(), "", "", false, [parsed_target.expression], [], [], [], token), newline.state)

fn parse_function(state: ParserState, public_declaration: Bool, asynchronous: Bool) -> FunctionResult:
    let keyword = consume_token(state, kind_fn(), "expected 'fn'")
    let name = consume_token(keyword.state, kind_identifier(), "expected function name")
    let type_parameters = parse_type_parameters(name.state)
    let open = consume_token(type_parameters.state, kind_lparen(), "expected '(' after function name")
    var next = open.state
    var parameters: Array[AstParameter] = []
    if not at_token(next, kind_rparen()):
        while true:
            let parameter = consume_token(next, kind_identifier(), "expected parameter name")
            let colon = consume_token(parameter.state, kind_colon(), "expected ':' after parameter name")
            let parameter_type = parse_type_name(colon.state)
            parameters = append(parameters, AstParameter(parameter.token.text, parameter_type.name, parameter.token.line, parameter.token.column))
            next = parameter_type.state
            let comma = match_token(next, kind_comma())
            next = comma.state
            if not comma.matched:
                break
    let close = consume_token(next, kind_rparen(), "expected ')' after parameters")
    let arrow = consume_token(close.state, kind_arrow(), "expected '->' and an explicit return type")
    let result_type = parse_type_name(arrow.state)
    var next_after_type = result_type.state
    var constraints: Array[AstTraitConstraint] = []
    let where_clause = match_token(next_after_type, kind_where())
    next_after_type = where_clause.state
    if where_clause.matched:
        while true:
            let constrained = consume_token(next_after_type, kind_identifier(), "expected constrained type parameter")
            let constraint_colon = consume_token(constrained.state, kind_colon(), "expected ':' in trait constraint")
            let trait_name = parse_type_name(constraint_colon.state)
            constraints = append(constraints, AstTraitConstraint(constrained.token.text, trait_name.name, constrained.token.line, constrained.token.column))
            next_after_type = trait_name.state
            let constraint_comma = match_token(next_after_type, kind_comma())
            next_after_type = constraint_comma.state
            if not constraint_comma.matched:
                break
    let colon = consume_token(next_after_type, kind_colon(), "expected ':' before function body")
    let newline = consume_token(colon.state, kind_newline(), "expected newline after function signature")
    let body = parse_block(newline.state)
    return FunctionResult(AstFunction(name.token.text, public_declaration, type_parameters.values, parameters, result_type.name, body.statements, "", "", false, false, false, false, name.token.text, constraints, keyword.token.line, keyword.token.column, asynchronous), body.state)

fn parse_extern_function(state: ParserState, public_declaration: Bool) -> FunctionResult:
    let keyword = consume_token(state, kind_fn(), "expected 'fn'")
    let name = consume_token(keyword.state, kind_identifier(), "expected native function name")
    let open = consume_token(name.state, kind_lparen(), "expected '(' after native function name")
    var next = open.state
    var parameters: Array[AstParameter] = []
    if not at_token(next, kind_rparen()):
        while true:
            let parameter = consume_token(next, kind_identifier(), "expected parameter name")
            let colon = consume_token(parameter.state, kind_colon(), "expected ':' after parameter name")
            let parameter_type = parse_type_name(colon.state)
            parameters = append(parameters, AstParameter(parameter.token.text, parameter_type.name, parameter.token.line, parameter.token.column))
            next = parameter_type.state
            let comma = match_token(next, kind_comma())
            next = comma.state
            if not comma.matched:
                break
    let close = consume_token(next, kind_rparen(), "expected ')' after native parameters")
    let arrow = consume_token(close.state, kind_arrow(), "expected '->' and native result type")
    let result_type = parse_type_name(arrow.state)
    let newline = consume_token(result_type.state, kind_newline(), "expected newline after native function declaration")
    let function = AstFunction(name.token.text, public_declaration, [], parameters, result_type.name, [], "", "", false, true, false, false, name.token.text, [], keyword.token.line, keyword.token.column, false)
    return FunctionResult(function, newline.state)

fn parse_extern_constant(state: ParserState, public_declaration: Bool) -> FunctionResult:
    let keyword = consume_token(state, kind_const(), "expected 'const'")
    let name = consume_token(keyword.state, kind_identifier(), "expected native constant name")
    let colon = consume_token(name.state, kind_colon(), "expected ':' after native constant name")
    let type_name = parse_type_name(colon.state)
    let equal = consume_token(type_name.state, kind_equal(), "expected '=' after native constant type")
    let value = parse_expression(equal.state)
    let newline = consume_token(value.state, kind_newline(), "expected newline after native constant")
    let returned = make_statement(statement_return(), "", "", false, [value.expression], [], [], [], keyword.token)
    let constant = AstFunction(name.token.text, public_declaration, [], [], type_name.name, [returned], "", "", false, false, false, true, name.token.text, [], keyword.token.line, keyword.token.column, false)
    return FunctionResult(constant, newline.state)

fn parse_extern_type(state: ParserState, public_declaration: Bool) -> StructResult:
    let token = current_token(state)
    if token.kind == kind_identifier() and token.text == "opaque":
        let name = consume_token(advance_parser(state), kind_identifier(), "expected opaque type name")
        let newline = consume_token(name.state, kind_newline(), "expected newline after opaque declaration")
        return StructResult(AstStructDecl(name.token.text, public_declaration, [], [], representation_opaque(), [], "", name.token.text, token.line, token.column), newline.state)
    if token.kind == kind_identifier() and token.text == "callback":
        let name = consume_token(advance_parser(state), kind_identifier(), "expected callback type name")
        let open = consume_token(name.state, kind_lparen(), "expected '(' after callback type name")
        var next = open.state
        var parameters: Array[AstParameter] = []
        if not at_token(next, kind_rparen()):
            while true:
                let parameter = consume_token(next, kind_identifier(), "expected callback parameter name")
                let colon = consume_token(parameter.state, kind_colon(), "expected ':' after callback parameter name")
                let parameter_type = parse_type_name(colon.state)
                parameters = append(parameters, AstParameter(parameter.token.text, parameter_type.name, parameter.token.line, parameter.token.column))
                next = parameter_type.state
                let comma = match_token(next, kind_comma())
                next = comma.state
                if not comma.matched:
                    break
        let close = consume_token(next, kind_rparen(), "expected ')' after callback parameters")
        let arrow = consume_token(close.state, kind_arrow(), "expected '->' and callback result type")
        let result = parse_type_name(arrow.state)
        let newline = consume_token(result.state, kind_newline(), "expected newline after callback declaration")
        return StructResult(AstStructDecl(name.token.text, public_declaration, [], [], representation_callback(), parameters, result.name, name.token.text, token.line, token.column), newline.state)
    let keyword = consume_token(state, kind_struct(), "expected 'struct'")
    let name = consume_token(keyword.state, kind_identifier(), "expected native struct name")
    let colon = consume_token(name.state, kind_colon(), "expected ':' after native struct name")
    let newline = consume_token(colon.state, kind_newline(), "expected newline after native struct declaration")
    let opening = consume_token(newline.state, kind_indent(), "expected an indented native struct body")
    var next = opening.state
    var fields: Array[AstTypeField] = []
    while not at_token(next, kind_dedent()) and not at_token(next, kind_end()):
        if at_token(next, kind_newline()):
            next = advance_parser(next)
            continue
        let field = consume_token(next, kind_identifier(), "expected native struct field name")
        let field_colon = consume_token(field.state, kind_colon(), "expected ':' after native struct field name")
        let field_type = parse_type_name(field_colon.state)
        let field_newline = consume_token(field_type.state, kind_newline(), "expected newline after native struct field")
        fields = append(fields, AstTypeField(field.token.text, field_type.name, field.token.line, field.token.column))
        next = field_newline.state
    let closing = consume_token(next, kind_dedent(), "expected end of native struct body")
    return StructResult(AstStructDecl(name.token.text, public_declaration, [], fields, representation_native(), [], "", name.token.text, keyword.token.line, keyword.token.column), closing.state)

fn parse_impl(state: ParserState) -> FunctionsResult:
    let keyword = consume_token(state, kind_impl(), "expected 'impl'")
    let impl_parameters = parse_type_parameters(keyword.state)
    let first_type = parse_type_name(impl_parameters.state)
    var owner_name = first_type.name
    var trait_name = ""
    var after_owner = first_type.state
    let trait_for = match_token(after_owner, kind_for())
    after_owner = trait_for.state
    if trait_for.matched:
        trait_name = first_type.name
        let parsed_owner = parse_type_name(after_owner)
        owner_name = parsed_owner.name
        after_owner = parsed_owner.state
    let colon = consume_token(after_owner, kind_colon(), "expected ':' after impl type")
    let newline = consume_token(colon.state, kind_newline(), "expected newline after impl declaration")
    let opening = consume_token(newline.state, kind_indent(), "expected an indented impl body")
    var next = opening.state
    var methods: Array[AstFunction] = []
    while not at_token(next, kind_dedent()) and not at_token(next, kind_end()):
        if at_token(next, kind_newline()):
            next = advance_parser(next)
            continue
        var public_declaration = false
        let published = match_token(next, kind_pub())
        next = published.state
        if published.matched:
            public_declaration = true
        if at_token(next, kind_const()):
            let constant_keyword = consume_token(next, kind_const(), "expected 'const'")
            let constant_name = consume_token(constant_keyword.state, kind_identifier(), "expected associated constant name")
            let constant_colon = consume_token(constant_name.state, kind_colon(), "expected ':' after associated constant name")
            let constant_type = parse_type_name(constant_colon.state)
            let constant_equal = consume_token(constant_type.state, kind_equal(), "expected '=' in associated constant declaration")
            let constant_value = parse_expression(constant_equal.state)
            let constant_newline = consume_token(constant_value.state, kind_newline(), "expected newline after associated constant")
            var constant_state = constant_newline.state
            if collections.length(impl_parameters.values) > 0:
                constant_state = parser_error(constant_state, constant_name.token, "associated constants in generic impl blocks are not supported")
            if trait_name != "":
                constant_state = parser_error(constant_state, constant_name.token, "trait impl blocks cannot declare associated constants")
            let constant_full_name = string.concat(type_base(owner_name), string.concat(".", constant_name.token.text))
            let returned = make_statement(statement_return(), "", "", false, [constant_value.expression], [], [], [], constant_name.token)
            methods = append(methods, AstFunction(constant_full_name, public_declaration, impl_parameters.values, [], constant_type.name, [returned], owner_name, trait_name, true, false, false, false, constant_full_name, [], constant_name.token.line, constant_name.token.column, false))
            next = constant_state
            continue
        var asynchronous = false
        if at_token(next, kind_identifier()) and current_token(next).text == "async":
            asynchronous = true
            next = advance_parser(next)
        if not at_token(next, kind_fn()):
            next = parser_error(next, current_token(next), "expected a method or associated constant in impl body")
            next = synchronize_top_level(next)
            continue
        let parsed = parse_function(next, public_declaration, asynchronous)
        let method = parsed.function
        var name = string.concat(type_base(owner_name), string.concat(".", method.name))
        if trait_name != "":
            name = string.concat(type_base(owner_name), string.concat(".", string.concat(trait_name, string.concat(".", method.name))))
        let parameters = collections.concat(impl_parameters.values, method.type_parameters)
        methods = append(methods, AstFunction(name, method.public_declaration, parameters, method.parameters, method.result_type, method.body, owner_name, trait_name, false, false, false, false, name, method.constraints, method.line, method.column, method.asynchronous))
        next = parsed.state
    let closing = consume_token(next, kind_dedent(), "expected end of impl body")
    return FunctionsResult(methods, closing.state)

fn parse_trait(state: ParserState, public_declaration: Bool) -> TraitResult:
    let keyword = consume_token(state, kind_trait(), "expected 'trait'")
    let name = consume_token(keyword.state, kind_identifier(), "expected trait name")
    let colon = consume_token(name.state, kind_colon(), "expected ':' after trait name")
    let newline = consume_token(colon.state, kind_newline(), "expected newline after trait declaration")
    let opening = consume_token(newline.state, kind_indent(), "expected an indented trait body")
    var next = opening.state
    var methods: Array[AstTraitMethod] = []
    while not at_token(next, kind_dedent()) and not at_token(next, kind_end()):
        if at_token(next, kind_newline()):
            next = advance_parser(next)
            continue
        let method_keyword = consume_token(next, kind_fn(), "expected a method signature in trait body")
        let method_name = consume_token(method_keyword.state, kind_identifier(), "expected trait method name")
        let open = consume_token(method_name.state, kind_lparen(), "expected '(' after trait method name")
        next = open.state
        var parameters: Array[AstParameter] = []
        if not at_token(next, kind_rparen()):
            while true:
                let parameter = consume_token(next, kind_identifier(), "expected parameter name")
                let parameter_colon = consume_token(parameter.state, kind_colon(), "expected ':' after parameter name")
                let parameter_type = parse_type_name(parameter_colon.state)
                parameters = append(parameters, AstParameter(parameter.token.text, parameter_type.name, parameter.token.line, parameter.token.column))
                next = parameter_type.state
                let comma = match_token(next, kind_comma())
                next = comma.state
                if not comma.matched:
                    break
        let close = consume_token(next, kind_rparen(), "expected ')' after trait method parameters")
        let arrow = consume_token(close.state, kind_arrow(), "expected '->' after trait method parameters")
        let result = parse_type_name(arrow.state)
        let method_newline = consume_token(result.state, kind_newline(), "expected newline after trait method signature")
        methods = append(methods, AstTraitMethod(method_name.token.text, parameters, result.name, method_keyword.token.line, method_keyword.token.column))
        next = method_newline.state
    let closing = consume_token(next, kind_dedent(), "expected end of trait body")
    return TraitResult(AstTraitDecl(name.token.text, public_declaration, methods, keyword.token.line, keyword.token.column), closing.state)

fn parse_struct(state: ParserState, public_declaration: Bool) -> StructResult:
    let keyword = consume_token(state, kind_struct(), "expected 'struct'")
    let name = consume_token(keyword.state, kind_identifier(), "expected struct name")
    let type_parameters = parse_type_parameters(name.state)
    let colon = consume_token(type_parameters.state, kind_colon(), "expected ':' after struct name")
    let newline = consume_token(colon.state, kind_newline(), "expected newline after struct declaration")
    let opening = consume_token(newline.state, kind_indent(), "expected an indented struct body")
    var next = opening.state
    var fields: Array[AstTypeField] = []
    while not at_token(next, kind_dedent()) and not at_token(next, kind_end()):
        if at_token(next, kind_newline()):
            next = advance_parser(next)
            continue
        let field = consume_token(next, kind_identifier(), "expected field name")
        let field_colon = consume_token(field.state, kind_colon(), "expected ':' after field name")
        let field_type = parse_type_name(field_colon.state)
        let field_newline = consume_token(field_type.state, kind_newline(), "expected newline after field")
        fields = append(fields, AstTypeField(field.token.text, field_type.name, field.token.line, field.token.column))
        next = field_newline.state
    let closing = consume_token(next, kind_dedent(), "expected end of struct body")
    return StructResult(AstStructDecl(name.token.text, public_declaration, type_parameters.values, fields, representation_rocket(), [], "", name.token.text, keyword.token.line, keyword.token.column), closing.state)

fn parse_enum(state: ParserState, public_declaration: Bool) -> EnumResult:
    let keyword = consume_token(state, kind_enum(), "expected 'enum'")
    let name = consume_token(keyword.state, kind_identifier(), "expected enum name")
    let type_parameters = parse_type_parameters(name.state)
    let colon = consume_token(type_parameters.state, kind_colon(), "expected ':' after enum name")
    let newline = consume_token(colon.state, kind_newline(), "expected newline after enum declaration")
    let opening = consume_token(newline.state, kind_indent(), "expected an indented enum body")
    var next = opening.state
    var variants: Array[AstEnumVariant] = []
    while not at_token(next, kind_dedent()) and not at_token(next, kind_end()):
        if at_token(next, kind_newline()):
            next = advance_parser(next)
            continue
        let variant = consume_token(next, kind_identifier(), "expected variant name")
        next = variant.state
        var payload_types: Array[String] = []
        let parenthesis = match_token(next, kind_lparen())
        next = parenthesis.state
        if parenthesis.matched:
            if not at_token(next, kind_rparen()):
                while true:
                    let payload = parse_type_name(next)
                    payload_types = append(payload_types, payload.name)
                    next = payload.state
                    let comma = match_token(next, kind_comma())
                    next = comma.state
                    if not comma.matched:
                        break
            let close = consume_token(next, kind_rparen(), "expected ')' after variant payload types")
            next = close.state
        let variant_newline = consume_token(next, kind_newline(), "expected newline after enum variant")
        variants = append(variants, AstEnumVariant(variant.token.text, payload_types, variant.token.line, variant.token.column))
        next = variant_newline.state
    let closing = consume_token(next, kind_dedent(), "expected end of enum body")
    return EnumResult(AstEnumDecl(name.token.text, public_declaration, type_parameters.values, variants, keyword.token.line, keyword.token.column), closing.state)

fn synchronize_top_level(state: ParserState) -> ParserState:
    var next = state
    while not at_token(next, kind_end()) and not at_token(next, kind_newline()):
        next = advance_parser(next)
    return skip_newlines(next)

fn parse_tokens(tokens: Array[Token], lexer_diagnostics: Array[Diagnostic]) -> ParseResult:
    var state = ParserState(tokens, 0, lexer_diagnostics)
    state = skip_newlines(state)
    var imports: Array[AstImport] = []
    var structs: Array[AstStructDecl] = []
    var enums: Array[AstEnumDecl] = []
    var traits: Array[AstTraitDecl] = []
    var functions: Array[AstFunction] = []
    while not at_token(state, kind_end()):
        if at_token(state, kind_import()):
            let keyword = current_token(state)
            let first = consume_token(advance_parser(state), kind_identifier(), "expected module name after 'import'")
            var next = first.state
            var name = first.token.text
            var dot = match_token(next, kind_dot())
            next = dot.state
            while dot.matched:
                let member = consume_token(next, kind_identifier(), "expected module name after '.'")
                name = string.concat(name, string.concat(".", member.token.text))
                next = member.state
                dot = match_token(next, kind_dot())
                next = dot.state
            let newline = consume_token(next, kind_newline(), "expected newline after import")
            imports = append(imports, AstImport(name, keyword.line, keyword.column))
            state = skip_newlines(newline.state)
            continue
        var public_declaration = false
        let published = match_token(state, kind_pub())
        state = published.state
        if published.matched:
            public_declaration = true
        var external = false
        if at_token(state, kind_identifier()) and current_token(state).text == "extern":
            external = true
            state = advance_parser(state)
        if external:
            if at_token(state, kind_fn()):
                let function = parse_extern_function(state, public_declaration)
                functions = append(functions, function.function)
                state = skip_newlines(function.state)
                continue
            if at_token(state, kind_const()):
                let constant = parse_extern_constant(state, public_declaration)
                functions = append(functions, constant.function)
                state = skip_newlines(constant.state)
                continue
            if at_token(state, kind_struct()) or(at_token(state, kind_identifier()) and(current_token(state).text == "opaque" or current_token(state).text == "callback")):
                let declaration = parse_extern_type(state, public_declaration)
                structs = append(structs, declaration.declaration)
                state = skip_newlines(declaration.state)
                continue
            state = parser_error(state, current_token(state), "expected 'fn', 'const', 'struct', 'opaque', or 'callback' after 'extern'")
            state = synchronize_top_level(state)
            continue
        var exported = false
        if at_token(state, kind_identifier()) and current_token(state).text == "export":
            exported = true
            state = advance_parser(state)
        if exported:
            if not at_token(state, kind_fn()):
                state = parser_error(state, current_token(state), "expected 'fn' after 'export'")
                state = synchronize_top_level(state)
                continue
            let parsed = parse_function(state, true, false)
            let function = parsed.function
            functions = append(functions, AstFunction(function.name, true, function.type_parameters, function.parameters, function.result_type, function.body, function.method_owner, function.method_trait, function.associated_constant, false, true, false, function.name, function.constraints, function.line, function.column, false))
            state = skip_newlines(parsed.state)
            continue
        var asynchronous = false
        if at_token(state, kind_identifier()) and current_token(state).text == "async":
            asynchronous = true
            state = advance_parser(state)
        if at_token(state, kind_fn()):
            let function = parse_function(state, public_declaration, asynchronous)
            functions = append(functions, function.function)
            state = skip_newlines(function.state)
            continue
        if at_token(state, kind_struct()):
            let structure = parse_struct(state, public_declaration)
            structs = append(structs, structure.declaration)
            state = skip_newlines(structure.state)
            continue
        if at_token(state, kind_enum()):
            let enumeration = parse_enum(state, public_declaration)
            enums = append(enums, enumeration.declaration)
            state = skip_newlines(enumeration.state)
            continue
        if at_token(state, kind_trait()):
            let parsed_trait = parse_trait(state, public_declaration)
            traits = append(traits, parsed_trait.declaration)
            state = skip_newlines(parsed_trait.state)
            continue
        if at_token(state, kind_impl()):
            if public_declaration:
                state = parser_error(state, current_token(state), "an impl block is not public; mark individual methods 'pub'")
            let implementation = parse_impl(state)
            functions = collections.concat(functions, implementation.functions)
            state = skip_newlines(implementation.state)
            continue
        let unexpected = current_token(state)
        state = parser_error(state, unexpected, "expected a declaration or import at top level")
        state = synchronize_top_level(state)
    return ParseResult(AstModule(imports, structs, enums, traits, functions), state.diagnostics)

fn parse_source(source: String) -> ParseResult:
    let lexed = lex_source(source)
    return parse_tokens(lexed.tokens, lexed.diagnostics)

fn state_symbols(state: LowerState, symbols: Array[HirSymbol]) -> LowerState:
    return LowerState(state.module, symbols, state.functions, state.bindings, state.depth, state.return_type, state.loop_depth, state.unsafe_depth, state.substitutions, state.pending, state.specializations, state.diagnostics, state.current_async, state.moved_symbols, state.borrowing_unique, state.move_analysis_enabled)

fn state_module(state: LowerState, module: AstModule) -> LowerState:
    return LowerState(module, state.symbols, state.functions, state.bindings, state.depth, state.return_type, state.loop_depth, state.unsafe_depth, state.substitutions, state.pending, state.specializations, state.diagnostics, state.current_async, state.moved_symbols, state.borrowing_unique, state.move_analysis_enabled)

fn state_functions(state: LowerState, functions: Array[HirFunction]) -> LowerState:
    return LowerState(state.module, state.symbols, functions, state.bindings, state.depth, state.return_type, state.loop_depth, state.unsafe_depth, state.substitutions, state.pending, state.specializations, state.diagnostics, state.current_async, state.moved_symbols, state.borrowing_unique, state.move_analysis_enabled)

fn state_bindings(state: LowerState, bindings: Array[ScopeBinding]) -> LowerState:
    return LowerState(state.module, state.symbols, state.functions, bindings, state.depth, state.return_type, state.loop_depth, state.unsafe_depth, state.substitutions, state.pending, state.specializations, state.diagnostics, state.current_async, state.moved_symbols, state.borrowing_unique, state.move_analysis_enabled)

fn state_depth(state: LowerState, depth: Int) -> LowerState:
    return LowerState(state.module, state.symbols, state.functions, state.bindings, depth, state.return_type, state.loop_depth, state.unsafe_depth, state.substitutions, state.pending, state.specializations, state.diagnostics, state.current_async, state.moved_symbols, state.borrowing_unique, state.move_analysis_enabled)

fn state_function_context(state: LowerState, return_type: String, loop_depth: Int, substitutions: Substitutions, current_async: Bool) -> LowerState:
    return LowerState(state.module, state.symbols, state.functions, state.bindings, state.depth, return_type, loop_depth, state.unsafe_depth, substitutions, state.pending, state.specializations, state.diagnostics, current_async, state.moved_symbols, state.borrowing_unique, state.move_analysis_enabled)

fn state_loop_depth(state: LowerState, loop_depth: Int) -> LowerState:
    return LowerState(state.module, state.symbols, state.functions, state.bindings, state.depth, state.return_type, loop_depth, state.unsafe_depth, state.substitutions, state.pending, state.specializations, state.diagnostics, state.current_async, state.moved_symbols, state.borrowing_unique, state.move_analysis_enabled)

fn state_unsafe_depth(state: LowerState, unsafe_depth: Int) -> LowerState:
    return LowerState(state.module, state.symbols, state.functions, state.bindings, state.depth, state.return_type, state.loop_depth, unsafe_depth, state.substitutions, state.pending, state.specializations, state.diagnostics, state.current_async, state.moved_symbols, state.borrowing_unique, state.move_analysis_enabled)

fn state_pending(state: LowerState, pending: Array[PendingSpecialization]) -> LowerState:
    return LowerState(state.module, state.symbols, state.functions, state.bindings, state.depth, state.return_type, state.loop_depth, state.unsafe_depth, state.substitutions, pending, state.specializations, state.diagnostics, state.current_async, state.moved_symbols, state.borrowing_unique, state.move_analysis_enabled)

fn state_specializations(state: LowerState, specializations: Array[Specialization]) -> LowerState:
    return LowerState(state.module, state.symbols, state.functions, state.bindings, state.depth, state.return_type, state.loop_depth, state.unsafe_depth, state.substitutions, state.pending, specializations, state.diagnostics, state.current_async, state.moved_symbols, state.borrowing_unique, state.move_analysis_enabled)

fn state_moved_symbols(state: LowerState, moved_symbols: Array[Int]) -> LowerState:
    return LowerState(state.module, state.symbols, state.functions, state.bindings, state.depth, state.return_type, state.loop_depth, state.unsafe_depth, state.substitutions, state.pending, state.specializations, state.diagnostics, state.current_async, moved_symbols, state.borrowing_unique, state.move_analysis_enabled)

fn state_borrowing_unique(state: LowerState, borrowing_unique: Bool) -> LowerState:
    return LowerState(state.module, state.symbols, state.functions, state.bindings, state.depth, state.return_type, state.loop_depth, state.unsafe_depth, state.substitutions, state.pending, state.specializations, state.diagnostics, state.current_async, state.moved_symbols, borrowing_unique, state.move_analysis_enabled)

fn contains_symbol(symbols: Array[Int], symbol: Int) -> Bool:
    for index in 0..collections.length(symbols):
        if symbols[index] == symbol:
            return true
    return false

fn lower_error(state: LowerState, line: Int, column: Int, message: String) -> LowerState:
    let diagnostic = make_diagnostic("R4001", line, column, message)
    return LowerState(state.module, state.symbols, state.functions, state.bindings, state.depth, state.return_type, state.loop_depth, state.unsafe_depth, state.substitutions, state.pending, state.specializations, append(state.diagnostics, diagnostic), state.current_async, state.moved_symbols, state.borrowing_unique, state.move_analysis_enabled)

fn lower_issue(state: LowerState, code: String, line: Int, column: Int, message: String) -> LowerState:
    let diagnostic = make_diagnostic(code, line, column, message)
    return LowerState(state.module, state.symbols, state.functions, state.bindings, state.depth, state.return_type, state.loop_depth, state.unsafe_depth, state.substitutions, state.pending, state.specializations, append(state.diagnostics, diagnostic), state.current_async, state.moved_symbols, state.borrowing_unique, state.move_analysis_enabled)

fn add_hir_symbol(state: LowerState, kind: Int, name: String, type_name: String, mutable_binding: Bool, parameter_types: Array[String], intrinsic: Int) -> SymbolResult:
    let id = collections.length(state.symbols)
    let symbol = HirSymbol(id, kind, name, type_name, mutable_binding, parameter_types, intrinsic, false, false, name, false)
    return SymbolResult(id, state_symbols(state, append(state.symbols, symbol)))

fn set_hir_native_symbol(state: LowerState, symbol: Int, native_import: Bool, native_export: Bool, native_name: String) -> LowerState:
    var symbols = state.symbols
    let value = symbols[symbol]
    symbols[symbol] = HirSymbol(value.id, value.kind, value.name, value.type_name, value.mutable_binding, value.parameter_types, value.intrinsic, native_import, native_export, native_name, value.asynchronous)
    return state_symbols(state, symbols)

fn set_hir_async_symbol(state: LowerState, symbol: Int, asynchronous: Bool) -> LowerState:
    var symbols = state.symbols
    let value = symbols[symbol]
    symbols[symbol] = HirSymbol(value.id, value.kind, value.name, value.type_name, value.mutable_binding, value.parameter_types, value.intrinsic, value.native_import, value.native_export, value.native_name, asynchronous)
    return state_symbols(state, symbols)

fn add_scope_binding(state: LowerState, name: String, symbol: Int) -> LowerState:
    return state_bindings(state, append(state.bindings, ScopeBinding(name, symbol, state.depth)))

fn find_scope_symbol(state: LowerState, name: String) -> Int:
    let length = collections.length(state.bindings)
    for offset in 0..length:
        let binding = state.bindings[length - offset - 1]
        if binding.depth <= state.depth and binding.name == name:
            return binding.symbol
    return -1

fn find_symbol_by_name(state: LowerState, name: String, kind: Int) -> Int:
    for index in 0..collections.length(state.symbols):
        let symbol = state.symbols[index]
        if symbol.kind == kind and symbol.name == name:
            return symbol.id
    return -1

fn substitution_value(substitutions: Substitutions, name: String) -> String:
    for index in 0..collections.length(substitutions.names):
        if substitutions.names[index] == name:
            return substitutions.values[index]
    return ""

fn type_base(type_name: String) -> String:
    let length = string.byte_length(type_name)
    var index = 0
    while index < length:
        if string.byte_at(type_name, index) == '[':
            return string.slice(type_name, 0, index)
        index = index + 1
    return type_name

fn type_arguments(type_name: String) -> Array[String]:
    let length = string.byte_length(type_name)
    var opening = -1
    var index = 0
    while index < length:
        if string.byte_at(type_name, index) == '[':
            opening = index
            break
        index = index + 1
    var arguments: Array[String] = []
    if opening < 0 or length < opening + 2:
        return arguments
    var depth = 1
    var start = opening + 1
    index = start
    while index < length:
        let character = string.byte_at(type_name, index)
        if character == '[':
            depth = depth + 1
        if character == ']':
            depth = depth - 1
            if depth == 0:
                arguments = append(arguments, string.trim(string.slice(type_name, start, index)))
                return arguments
        if character == ',' and depth == 1:
            arguments = append(arguments, string.trim(string.slice(type_name, start, index)))
            start = index + 1
        index = index + 1
    return arguments

fn make_type(base: String, arguments: Array[String]) -> String:
    if collections.length(arguments) == 0:
        return base
    return string.concat(base, string.concat("[", string.concat(collections.join(arguments, ", "), "]")))

fn substitute_type(type_name: String, substitutions: Substitutions) -> String:
    let replacement = substitution_value(substitutions, type_name)
    if replacement != "":
        return replacement
    let arguments = type_arguments(type_name)
    if collections.length(arguments) == 0:
        return type_name
    var replaced: Array[String] = []
    for index in 0..collections.length(arguments):
        replaced = append(replaced, substitute_type(arguments[index], substitutions))
    return make_type(type_base(type_name), replaced)

fn bind_substitution(substitutions: Substitutions, name: String, value: String) -> Substitutions:
    let existing = substitution_value(substitutions, name)
    if existing != "":
        return substitutions
    return Substitutions(append(substitutions.names, name), append(substitutions.values, value))

fn infer_type(pattern: String, actual: String, type_parameters: Array[String], substitutions: Substitutions) -> Substitutions:
    for index in 0..collections.length(type_parameters):
        if pattern == type_parameters[index]:
            return bind_substitution(substitutions, pattern, actual)
    let pattern_arguments = type_arguments(pattern)
    let actual_arguments = type_arguments(actual)
    var inferred = substitutions
    if type_base(pattern) != type_base(actual) or collections.length(pattern_arguments) != collections.length(actual_arguments):
        return inferred
    for index in 0..collections.length(pattern_arguments):
        inferred = infer_type(pattern_arguments[index], actual_arguments[index], type_parameters, inferred)
    return inferred

fn contains_type_parameter(type_name: String, type_parameters: Array[String]) -> Bool:
    for index in 0..collections.length(type_parameters):
        if type_name == type_parameters[index]:
            return true
    let arguments = type_arguments(type_name)
    for index in 0..collections.length(arguments):
        if contains_type_parameter(arguments[index], type_parameters):
            return true
    return false

fn contains_string(values: Array[String], value: String) -> Bool:
    for index in 0..collections.length(values):
        if values[index] == value:
            return true
    return false

fn contains_int(values: Array[Int], value: Int) -> Bool:
    for index in 0..collections.length(values):
        if values[index] == value:
            return true
    return false

fn source_parent(path_value: String) -> String:
    var separator = -1
    for index in 0..string.byte_length(path_value):
        let value = string.byte_at(path_value, index)
        if value == '/' or value == '\\':
            separator = index
    if separator < 0:
        return "."
    if separator == 0:
        return string.slice(path_value, 0, 1)
    return string.slice(path_value, 0, separator)

fn standard_module_path(name: String) -> String:
    if name != "std.testing":
        return ""
    let relative = "stdlib/std/testing.rocket"
    let working = process.working_directory()
    match working:
        case Ok(directory):
            let candidate = std.path.normalize(std.path.join(directory, relative))
            if file.exists(candidate):
                return candidate
        case Err(error):
            let ignored = error
    let executable = process.executable_path()
    match executable:
        case Ok(path_value):
            let directory = source_parent(path_value)
            let adjacent = std.path.normalize(std.path.join(directory, "../stdlib/std/testing.rocket"))
            if file.exists(adjacent):
                return adjacent
            let repository = std.path.normalize(std.path.join(directory, "../../stdlib/std/testing.rocket"))
            if file.exists(repository):
                return repository
            let stage0_repository = std.path.normalize(std.path.join(directory, "../../../stdlib/std/testing.rocket"))
            if file.exists(stage0_repository):
                return stage0_repository
        case Err(error):
            let ignored = error
    return ""

fn module_root_for_source(path_value: String) -> String:
    let normalized = std.path.normalize(path_value)
    let fallback = source_parent(normalized)
    var current = fallback
    while true:
        if file.exists(std.path.join(current, "rocket.toml")):
            return current
        let parent = source_parent(current)
        if parent == current or current == ".":
            return fallback
        current = parent
    return fallback

fn import_alias(name: String) -> String:
    let pieces = string.split(name, ".")
    if collections.length(pieces) == 0:
        return name
    return pieces[collections.length(pieces) - 1]

fn lock_line_value(line_value: String, key: String) -> String:
    let line = string.trim(line_value)
    if not string.starts_with(line, string.concat(key, " ")):
        return ""
    var equals = -1
    for index in 0..string.byte_length(line):
        if string.byte_at(line, index) == '=':
            equals = index
    if equals < 0:
        return ""
    let raw = string.trim(string.slice(line, equals + 1, string.byte_length(line)))
    if string.byte_length(raw) < 2 or string.byte_at(raw, 0) != '"' or string.byte_at(raw, string.byte_length(raw) - 1) != '"':
        return ""
    return string.slice(raw, 1, string.byte_length(raw) - 1)

fn lock_package_field(source: String, selector_key: String, selector_value: String, target_key: String) -> String:
    let lines = string.split(source, "\n")
    var in_package = false
    var selected = false
    for index in 0..collections.length(lines):
        let line = string.trim(lines[index])
        if line == "[[package]]":
            in_package = true
            selected = false
            continue
        if not in_package:
            continue
        let selector = lock_line_value(line, selector_key)
        if selector != "":
            selected = selector == selector_value
        if selected:
            let selected_value = lock_line_value(line, target_key)
            if selected_value != "":
                return selected_value
    return ""

fn lock_owner_dependencies(source: String, cache_root: String, source_path: String) -> String:
    let lines = string.split(source, "\n")
    var checksum = ""
    for index in 0..collections.length(lines):
        let line = string.trim(lines[index])
        if line == "[[package]]":
            checksum = ""
            continue
        let raw_checksum = lock_line_value(line, "checksum")
        if raw_checksum != "":
            if string.starts_with(raw_checksum, "sha256:"):
                checksum = string.slice(raw_checksum, 7, string.byte_length(raw_checksum))
            else:
                checksum = raw_checksum
        let dependencies = lock_line_value(line, "dependencies")
        if dependencies != "" and checksum != "":
            let owner_root = std.path.normalize(std.path.join(cache_root, checksum))
            if string.starts_with(std.path.normalize(source_path), owner_root):
                return dependencies
    return manifest_value(source, "", "root-dependencies")

fn locked_dependency_import(module_root: String, source_path: String, name: String) -> DependencyImportPath:
    let lock_path = std.path.join(module_root, "rocket.lock")
    if not file.exists(lock_path):
        return DependencyImportPath(false, false, "")
    let loaded = file.read_text(lock_path)
    match loaded:
        case Err(error):
            return DependencyImportPath(false, false, "")
        case Ok(source):
            let pieces = string.split(name, ".")
            if collections.length(pieces) == 0:
                return DependencyImportPath(false, false, "")
            let dependency_name = pieces[0]
            let version = lock_package_field(source, "name", dependency_name, "version")
            if version == "":
                return DependencyImportPath(false, false, "")
            let identity = string.concat(dependency_name, string.concat("@", version))
            let cache_root = std.path.normalize(std.path.join(module_root, ".rocketc/cache/sha256"))
            let allowed = string.split(lock_owner_dependencies(source, cache_root, source_path), ";")
            if not contains_string(allowed, identity):
                return DependencyImportPath(true, false, "")
            let raw_checksum = lock_package_field(source, "name", dependency_name, "checksum")
            if not string.starts_with(raw_checksum, "sha256:"):
                return DependencyImportPath(true, false, "")
            let checksum = string.slice(raw_checksum, 7, string.byte_length(raw_checksum))
            let dependency_root = std.path.normalize(std.path.join(cache_root, checksum))
            var resolved = dependency_root
            if collections.length(pieces) == 1:
                let manifest = file.read_text(std.path.join(dependency_root, "rocket.toml"))
                match manifest:
                    case Err(error):
                        return DependencyImportPath(true, false, "")
                    case Ok(manifest_source):
                        let entry = manifest_value(manifest_source, "package", "entry")
                        if entry == "":
                            return DependencyImportPath(true, false, "")
                        resolved = std.path.normalize(std.path.join(dependency_root, entry))
            else:
                for index in 1..collections.length(pieces):
                    var piece = pieces[index]
                    if index + 1 == collections.length(pieces):
                        piece = string.concat(piece, ".rocket")
                    resolved = std.path.join(resolved, piece)
                resolved = std.path.normalize(resolved)
            return DependencyImportPath(true, file.exists(resolved), resolved)

fn resolve_import_path(module_root: String, target_root: String, source_path: String, name: String) -> DependencyImportPath:
    let dependency = locked_dependency_import(module_root, source_path, name)
    if dependency.matched:
        return dependency
    let pieces = string.split(name, ".")
    var relative = ""
    for index in 0..collections.length(pieces):
        var piece = pieces[index]
        if index + 1 == collections.length(pieces):
            piece = string.concat(piece, ".rocket")
        if relative == "":
            relative = piece
        else:
            relative = std.path.join(relative, piece)
    if target_root != "":
        let target_result = std.path.normalize(std.path.join(target_root, relative))
        if file.exists(target_result):
            return DependencyImportPath(false, true, target_result)
    let result = std.path.join(module_root, relative)
    return DependencyImportPath(false, file.exists(std.path.normalize(result)), std.path.normalize(result))

fn mapped_declaration_name(prefix_name: String, name: String, public_declaration: Bool) -> String:
    if prefix_name == "":
        return name
    if public_declaration:
        return string.concat(prefix_name, string.concat(".", name))
    return string.concat("$", string.concat(prefix_name, string.concat(".", name)))

fn mapped_local_type_base(module: AstModule, prefix_name: String, base: String) -> String:
    for index in 0..collections.length(module.structs):
        if module.structs[index].name == base:
            return mapped_declaration_name(prefix_name, base, module.structs[index].public_declaration)
    for index in 0..collections.length(module.enums):
        if module.enums[index].name == base:
            return mapped_declaration_name(prefix_name, base, module.enums[index].public_declaration)
    return base

fn mapped_local_type(module: AstModule, prefix_name: String, type_name: String) -> String:
    if type_name == "":
        return ""
    let arguments = type_arguments(type_name)
    let base = mapped_local_type_base(module, prefix_name, type_base(type_name))
    if collections.length(arguments) == 0:
        return base
    var mapped_arguments: Array[String] = []
    for index in 0..collections.length(arguments):
        mapped_arguments = append(mapped_arguments, mapped_local_type(module, prefix_name, arguments[index]))
    return make_type(base, mapped_arguments)

fn mapped_local_trait(module: AstModule, prefix_name: String, trait_name: String) -> String:
    if trait_name == "":
        return ""
    for index in 0..collections.length(module.traits):
        if module.traits[index].name == trait_name:
            return mapped_declaration_name(prefix_name, trait_name, module.traits[index].public_declaration)
    return trait_name

fn mapped_local_callable(module: AstModule, prefix_name: String, name: String) -> String:
    for index in 0..collections.length(module.functions):
        if module.functions[index].name == name:
            return mapped_declaration_name(prefix_name, name, module.functions[index].public_declaration)
    if string.contains(name, "."):
        return name
    for index in 0..collections.length(module.structs):
        if module.structs[index].name == name:
            return mapped_declaration_name(prefix_name, name, module.structs[index].public_declaration)
    for declaration_index in 0..collections.length(module.enums):
        let declaration = module.enums[declaration_index]
        for variant_index in 0..collections.length(declaration.variants):
            if declaration.variants[variant_index].name == name:
                return mapped_declaration_name(prefix_name, name, declaration.public_declaration)
    return name

fn module_qualified_callable(module: AstModule, name: String) -> Bool:
    if string.starts_with(name, "std.") or find_function_index(module, name) >= 0:
        return true
    let pieces = string.split(name, ".")
    if collections.length(pieces) < 2:
        return false
    for index in 0..collections.length(module.imports):
        let imported = module.imports[index].name
        let imported_pieces = string.split(imported, ".")
        if collections.length(imported_pieces) > 0 and imported_pieces[collections.length(imported_pieces) - 1] == pieces[0]:
            return true
    return false

fn map_module_expression(module: AstModule, prefix_name: String, expression: AstExpr) -> AstExpr:
    if expression.kind == expr_field():
        let raw_constant = callable_name(expression)
        let constant_index = find_function_index(module, raw_constant)
        if constant_index >= 0 and module.functions[constant_index].associated_constant:
            let mapped_constant = mapped_local_callable(module, prefix_name, raw_constant)
            let callee = AstExpr(expr_name(), mapped_constant, [], expression.line, expression.column)
            return AstExpr(expr_call(), "", [callee], expression.line, expression.column)
        if module_qualified_callable(module, raw_constant):
            return AstExpr(expr_name(), raw_constant, [], expression.line, expression.column)
    if expression.kind == expr_call() and collections.length(expression.children) > 0:
        let raw_name = callable_name(expression.children[0])
        let mapped_name = mapped_local_callable(module, prefix_name, raw_name)
        if expression.children[0].kind == expr_field() and not module_qualified_callable(module, raw_name):
            var method_children: Array[AstExpr] = [map_module_expression(module, prefix_name, expression.children[0])]
            for method_index in 1..collections.length(expression.children):
                method_children = append(method_children, map_module_expression(module, prefix_name, expression.children[method_index]))
            return AstExpr(expression.kind, expression.text, method_children, expression.line, expression.column)
        var children: Array[AstExpr] = [AstExpr(expr_name(), mapped_name, [], expression.children[0].line, expression.children[0].column)]
        for index in 1..collections.length(expression.children):
            children = append(children, map_module_expression(module, prefix_name, expression.children[index]))
        return AstExpr(expression.kind, expression.text, children, expression.line, expression.column)
    var children: Array[AstExpr] = []
    for index in 0..collections.length(expression.children):
        children = append(children, map_module_expression(module, prefix_name, expression.children[index]))
    return AstExpr(expression.kind, expression.text, children, expression.line, expression.column)

fn map_module_statements(module: AstModule, prefix_name: String, statements: Array[AstStatement]) -> Array[AstStatement]:
    var result: Array[AstStatement] = []
    for statement_index in 0..collections.length(statements):
        let statement = statements[statement_index]
        var expressions: Array[AstExpr] = []
        for index in 0..collections.length(statement.expressions):
            expressions = append(expressions, map_module_expression(module, prefix_name, statement.expressions[index]))
        var cases: Array[AstMatchCase] = []
        for case_index in 0..collections.length(statement.cases):
            let source_case = statement.cases[case_index]
            let mapped_variant = mapped_local_callable(module, prefix_name, source_case.variant)
            cases = append(cases, AstMatchCase(mapped_variant, source_case.wildcard, source_case.bindings, map_module_statements(module, prefix_name, source_case.body), source_case.line, source_case.column))
        result = append(result, AstStatement(statement.kind, statement.name, mapped_local_type(module, prefix_name, statement.type_name), statement.mutable_binding, expressions, map_module_statements(module, prefix_name, statement.body), map_module_statements(module, prefix_name, statement.else_body), cases, statement.line, statement.column))
    return result

fn map_imported_module(module: AstModule, prefix_name: String) -> AstModule:
    if prefix_name == "":
        return module
    var structs: Array[AstStructDecl] = []
    for declaration_index in 0..collections.length(module.structs):
        let declaration = module.structs[declaration_index]
        var fields: Array[AstTypeField] = []
        for field_index in 0..collections.length(declaration.fields):
            let field = declaration.fields[field_index]
            fields = append(fields, AstTypeField(field.name, mapped_local_type(module, prefix_name, field.type_name), field.line, field.column))
        var callback_parameters: Array[AstParameter] = []
        for callback_index in 0..collections.length(declaration.callback_parameters):
            let parameter = declaration.callback_parameters[callback_index]
            callback_parameters = append(callback_parameters, AstParameter(parameter.name, mapped_local_type(module, prefix_name, parameter.type_name), parameter.line, parameter.column))
        structs = append(structs, AstStructDecl(mapped_declaration_name(prefix_name, declaration.name, declaration.public_declaration), declaration.public_declaration, declaration.type_parameters, fields, declaration.representation, callback_parameters, mapped_local_type(module, prefix_name, declaration.callback_result), declaration.native_name, declaration.line, declaration.column))
    var enums: Array[AstEnumDecl] = []
    for declaration_index in 0..collections.length(module.enums):
        let declaration = module.enums[declaration_index]
        var variants: Array[AstEnumVariant] = []
        for variant_index in 0..collections.length(declaration.variants):
            let variant = declaration.variants[variant_index]
            var payload_types: Array[String] = []
            for payload_index in 0..collections.length(variant.payload_types):
                payload_types = append(payload_types, mapped_local_type(module, prefix_name, variant.payload_types[payload_index]))
            variants = append(variants, AstEnumVariant(mapped_declaration_name(prefix_name, variant.name, declaration.public_declaration), payload_types, variant.line, variant.column))
        enums = append(enums, AstEnumDecl(mapped_declaration_name(prefix_name, declaration.name, declaration.public_declaration), declaration.public_declaration, declaration.type_parameters, variants, declaration.line, declaration.column))
    var traits: Array[AstTraitDecl] = []
    for trait_index in 0..collections.length(module.traits):
        let declaration = module.traits[trait_index]
        var methods: Array[AstTraitMethod] = []
        for method_index in 0..collections.length(declaration.methods):
            let method = declaration.methods[method_index]
            var method_parameters: Array[AstParameter] = []
            for parameter_index in 0..collections.length(method.parameters):
                let parameter = method.parameters[parameter_index]
                method_parameters = append(method_parameters, AstParameter(parameter.name, mapped_local_type(module, prefix_name, parameter.type_name), parameter.line, parameter.column))
            methods = append(methods, AstTraitMethod(method.name, method_parameters, mapped_local_type(module, prefix_name, method.result_type), method.line, method.column))
        traits = append(traits, AstTraitDecl(mapped_declaration_name(prefix_name, declaration.name, declaration.public_declaration), declaration.public_declaration, methods, declaration.line, declaration.column))
    var functions: Array[AstFunction] = []
    for function_index in 0..collections.length(module.functions):
        let function = module.functions[function_index]
        var parameters: Array[AstParameter] = []
        for parameter_index in 0..collections.length(function.parameters):
            let parameter = function.parameters[parameter_index]
            parameters = append(parameters, AstParameter(parameter.name, mapped_local_type(module, prefix_name, parameter.type_name), parameter.line, parameter.column))
        var constraints: Array[AstTraitConstraint] = []
        for constraint_index in 0..collections.length(function.constraints):
            let constraint = function.constraints[constraint_index]
            constraints = append(constraints, AstTraitConstraint(constraint.type_parameter, mapped_local_trait(module, prefix_name, constraint.trait_name), constraint.line, constraint.column))
        functions = append(functions, AstFunction(mapped_declaration_name(prefix_name, function.name, function.public_declaration), function.public_declaration, function.type_parameters, parameters, mapped_local_type(module, prefix_name, function.result_type), map_module_statements(module, prefix_name, function.body), mapped_local_type(module, prefix_name, function.method_owner), mapped_local_trait(module, prefix_name, function.method_trait), function.associated_constant, function.native_import, function.native_export, function.native_constant, function.native_name, constraints, function.line, function.column, function.asynchronous))
    return AstModule(module.imports, structs, enums, traits, functions)

fn merge_ast_modules(left: AstModule, right: AstModule) -> AstModule:
    return AstModule(collections.concat(left.imports, right.imports), collections.concat(left.structs, right.structs), collections.concat(left.enums, right.enums), collections.concat(left.traits, right.traits), collections.concat(left.functions, right.functions))

fn load_state_module(state: ProgramLoadState, module: AstModule) -> ProgramLoadState:
    return ProgramLoadState(module, state.diagnostics, state.loaded_paths, state.active_paths, state.source_bytes)

fn load_state_diagnostics(state: ProgramLoadState, diagnostics: Array[Diagnostic]) -> ProgramLoadState:
    return ProgramLoadState(state.module, diagnostics, state.loaded_paths, state.active_paths, state.source_bytes)

fn load_state_paths(state: ProgramLoadState, loaded_paths: Array[String], active_paths: Array[String]) -> ProgramLoadState:
    return ProgramLoadState(state.module, state.diagnostics, loaded_paths, active_paths, state.source_bytes)

fn load_state_source_bytes(state: ProgramLoadState, source_bytes: Int) -> ProgramLoadState:
    return ProgramLoadState(state.module, state.diagnostics, state.loaded_paths, state.active_paths, source_bytes)

fn diagnose_import_aliases(state: ProgramLoadState, imports: Array[AstImport]) -> ProgramLoadState:
    var next = state
    for left in 0..collections.length(imports):
        if string.starts_with(imports[left].name, "std."):
            continue
        for right in left + 1..collections.length(imports):
            if import_alias(imports[left].name) == import_alias(imports[right].name):
                next = load_state_diagnostics(next, append(next.diagnostics, make_diagnostic("R3004", imports[right].line, imports[right].column, string.concat("duplicate import alias '", string.concat(import_alias(imports[right].name), "'")))))
    return next

fn load_program_module(state: ProgramLoadState, source_path: String, prefix_name: String, module_root: String, target_root: String) -> ProgramLoadState:
    let normalized = std.path.normalize(source_path)
    if contains_string(state.active_paths, normalized):
        return load_state_diagnostics(state, append(state.diagnostics, make_diagnostic("R3002", 1, 1, string.concat("import cycle detected at '", string.concat(normalized, "'")))))
    if contains_string(state.loaded_paths, normalized):
        return state
    if collections.length(state.active_paths) >= 64:
        return load_state_diagnostics(state, append(state.diagnostics, make_diagnostic("R1003", 1, 1, "import nesting exceeds the 64-level limit")))
    if collections.length(state.loaded_paths) + collections.length(state.active_paths) >= 4096:
        return load_state_diagnostics(state, append(state.diagnostics, make_diagnostic("R1003", 1, 1, "module graph exceeds the 4096-file limit")))
    var next = load_state_paths(state, state.loaded_paths, append(state.active_paths, normalized))
    let loaded = file.read_text(normalized)
    match loaded:
        case Err(error):
            next = load_state_diagnostics(next, append(next.diagnostics, make_diagnostic("R3001", 1, 1, string.concat("cannot read module '", string.concat(normalized, string.concat("': ", error))))))
        case Ok(source):
            let bytes = string.byte_length(source)
            if bytes > 4194304:
                next = load_state_diagnostics(next, append(next.diagnostics, make_diagnostic("R1003", 1, 1, "source file exceeds the 4 MiB limit")))
            else:
                if next.source_bytes > 67108864 - bytes:
                    next = load_state_diagnostics(next, append(next.diagnostics, make_diagnostic("R1003", 1, 1, "module graph exceeds the 64 MiB source limit")))
                else:
                    next = load_state_source_bytes(next, next.source_bytes + bytes)
                    let parsed = parse_source(source)
                    next = load_state_diagnostics(next, collections.concat(next.diagnostics, parsed.diagnostics))
                    next = diagnose_import_aliases(next, parsed.module.imports)
                    for index in 0..collections.length(parsed.module.imports):
                        let imported = parsed.module.imports[index]
                        if imported.name == "std.testing":
                            let standard_path = standard_module_path(imported.name)
                            if standard_path == "":
                                next = load_state_diagnostics(next, append(next.diagnostics, make_diagnostic("R3001", imported.line, imported.column, "cannot locate bundled standard module 'std.testing'")))
                            else:
                                next = load_program_module(next, standard_path, imported.name, module_root, target_root)
                        else:
                            if not string.starts_with(imported.name, "std."):
                                let imported_path = resolve_import_path(module_root, target_root, normalized, imported.name)
                                if not imported_path.valid:
                                    var code = "R3001"
                                    if imported_path.matched:
                                        code = "R3005"
                                    next = load_state_diagnostics(next, append(next.diagnostics, make_diagnostic(code, imported.line, imported.column, string.concat("dependency import is absent from the exact locked graph or cache: '", string.concat(imported.name, "'")))))
                                else:
                                    next = load_program_module(next, imported_path.path, import_alias(imported.name), module_root, target_root)
                    next = load_state_module(next, merge_ast_modules(next.module, map_imported_module(parsed.module, prefix_name)))
    return load_state_paths(next, append(next.loaded_paths, normalized), prefix(next.active_paths, collections.length(next.active_paths) - 1))

fn parse_program(source_path: String) -> ParseResult:
    return parse_program_target(source_path, "")

fn parse_program_target(source_path: String, target_root: String) -> ParseResult:
    let empty = AstModule([], [], [], [], [])
    let normalized = std.path.normalize(source_path)
    let loaded = load_program_module(ProgramLoadState(empty, [], [], [], 0), normalized, "", module_root_for_source(normalized), target_root)
    return ParseResult(loaded.module, loaded.diagnostics)

fn is_array_type(type_name: String) -> Bool:
    return type_base(type_name) == "Array"

fn is_slice_type(type_name: String) -> Bool:
    return type_base(type_name) == "Slice"

fn is_hashable_key(type_name: String) -> Bool:
    return type_name == "Int" or type_name == "Bool" or type_name == "Char" or type_name == "String"

fn is_collection_comparable(type_name: String) -> Bool:
    return is_hashable_key(type_name) or type_name == "Float"

fn collection_element_type(type_name: String) -> String:
    let arguments = type_arguments(type_name)
    if collections.length(arguments) == 1:
        return arguments[0]
    return "<invalid>"

fn is_native_primitive(type_name: String) -> Bool:
    return type_name == "Int" or type_name == "Float" or type_name == "Bool" or type_name == "Char" or type_name == "Unit"

fn foreign_type_index(module: AstModule, type_name: String) -> Int:
    let base = type_base(type_name)
    for index in 0..collections.length(module.structs):
        if module.structs[index].name == base and module.structs[index].representation != representation_rocket():
            return index
    return -1

fn is_native_type(module: AstModule, type_name: String) -> Bool:
    return type_base(type_name) == "Pointer" or foreign_type_index(module, type_name) >= 0

fn is_native_abi_value(module: AstModule, type_name: String) -> Bool:
    if is_native_primitive(type_name):
        return true
    if type_base(type_name) == "Pointer":
        return collections.length(type_arguments(type_name)) == 1
    let index = foreign_type_index(module, type_name)
    if index < 0:
        return false
    return module.structs[index].representation == representation_opaque() or module.structs[index].representation == representation_callback()

fn collection_contains_native(module: AstModule, type_name: String) -> Bool:
    if not is_array_type(type_name) and not is_slice_type(type_name):
        return false
    let element = collection_element_type(type_name)
    return is_native_type(module, element) or collection_contains_native(module, element)

fn callback_matches(module: AstModule, callback_index: Int, function_index: Int) -> Bool:
    let signature = module.structs[callback_index]
    let function = module.functions[function_index]
    if function.native_import or function.native_constant or collections.length(function.type_parameters) != 0:
        return false
    if signature.callback_result != function.result_type or collections.length(signature.callback_parameters) != collections.length(function.parameters):
        return false
    for index in 0..collections.length(function.parameters):
        if signature.callback_parameters[index].type_name != function.parameters[index].type_name:
            return false
    return true

fn native_constant_literal(expression: AstExpr) -> Bool:
    if expression.kind == expr_integer() or expression.kind == expr_float() or expression.kind == expr_character() or expression.kind == expr_bool():
        return true
    return expression.kind == expr_unary() and expression.text == "-" and collections.length(expression.children) == 1 and(expression.children[0].kind == expr_integer() or expression.children[0].kind == expr_float())

fn callable_name(expression: AstExpr) -> String:
    if expression.kind == expr_name():
        return expression.text
    if expression.kind == expr_field() and collections.length(expression.children) == 1:
        let base = callable_name(expression.children[0])
        if base != "":
            return string.concat(base, string.concat(".", expression.text))
    return ""

fn standard_callable(module: AstModule, name: String) -> String:
    let pieces = string.split(name, ".")
    if collections.length(pieces) < 2:
        return name
    let alias = pieces[0]
    for index in 0..collections.length(module.imports):
        let imported = module.imports[index].name
        let imported_pieces = string.split(imported, ".")
        if collections.length(imported_pieces) > 0 and imported_pieces[collections.length(imported_pieces) - 1] == alias and string.starts_with(imported, "std."):
            var suffix: Array[String] = []
            for piece_index in 1..collections.length(pieces):
                suffix = append(suffix, pieces[piece_index])
            return string.concat(imported, string.concat(".", collections.join(suffix, ".")))
    return name

fn associated_standard_callable(name: String) -> String:
    if name == "String.from_int":
        return "std.string.from_int"
    if name == "String.builder":
        return "std.string.builder"
    if name == "std.collections.Map.from_arrays":
        return "std.collections.map_from_arrays"
    if name == "std.collections.Set.from_array":
        return "std.collections.set_from_array"
    return name

fn standard_method_callable(type_name: String, method: String) -> String:
    if type_name == "String":
        if method == "byte_length" or method == "concat" or method == "contains" or method == "starts_with" or method == "ends_with" or method == "trim" or method == "split" or method == "byte_at" or method == "byte_value_at" or method == "slice" or method == "parse_int":
            return string.concat("std.string.", method)
    let base = type_base(type_name)
    if base == "Slice" and method == "length":
        return "std.collections.slice_length"
    if base == "Array":
        if method == "length" or method == "capacity" or method == "reserve" or method == "append" or method == "pop" or method == "insert" or method == "remove" or method == "clear" or method == "contains" or method == "find" or method == "filter_equal" or method == "reverse" or method == "join":
            return string.concat("std.collections.", method)
        if method == "sort":
            let element = collection_element_type(type_name)
            if element == "Int":
                return "std.collections.sort_int"
            if element == "Float":
                return "std.collections.sort_float"
            if element == "Char":
                return "std.collections.sort_char"
            if element == "String":
                return "std.collections.sort_string"
    if base == "std.collections.Map":
        if method == "length" or method == "find" or method == "get" or method == "keys" or method == "values":
            return string.concat("std.collections.map_", method)
    if base == "std.collections.Set":
        if method == "contains" or method == "values":
            return string.concat("std.collections.set_", method)
    return ""

