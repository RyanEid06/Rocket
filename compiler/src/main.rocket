fn print_runtime_name(type_name: String) -> String:
    if type_name == "Int":
        return "@rocket_rt_print_int"
    if type_name == "Float":
        return "@rocket_rt_print_float"
    if type_name == "Bool":
        return "@rocket_rt_print_bool"
    if type_name == "Char":
        return "@rocket_rt_print_char"
    if type_name == "String":
        return "@rocket_rt_print_string"
    return "@rocket_rt_print_unit"

fn emit_runtime_guard_llvm(builder: std.string.Builder, condition: String, panic: String, name: String) -> Unit:
    let failure = string.concat(name, "_failure")
    let success = string.concat(name, "_success")
    emit_llvm_line(builder, string.concat("  br i1 ", string.concat(condition, string.concat(", label %", string.concat(failure, string.concat(", label %", success))))))
    emit_llvm_line(builder, string.concat(failure, ":"))
    emit_llvm_line(builder, string.concat("  call void ", string.concat(panic, "()")))
    emit_llvm_line(builder, "  unreachable")
    emit_llvm_line(builder, string.concat(success, ":"))

fn emit_checked_int_binary_llvm(builder: std.string.Builder, left: LlvmValue, right: LlvmValue, op: String, name: String) -> LlvmValue:
    let result = string.concat("%", string.concat(name, "_result"))
    if op == "/":
        let zero = string.concat("%", string.concat(name, "_zero"))
        emit_llvm_line(builder, string.concat("  ", string.concat(zero, string.concat(" = icmp eq i64 ", string.concat(right.name, ", 0")))))
        emit_runtime_guard_llvm(builder, zero, "@rocket_rt_panic_division_by_zero", string.concat(name, "_division_zero"))
        let minimum = string.concat("%", string.concat(name, "_minimum"))
        let negative_one = string.concat("%", string.concat(name, "_negative_one"))
        let overflow = string.concat("%", string.concat(name, "_overflow"))
        emit_llvm_line(builder, string.concat("  ", string.concat(minimum, string.concat(" = icmp eq i64 ", string.concat(left.name, ", -9223372036854775808")))))
        emit_llvm_line(builder, string.concat("  ", string.concat(negative_one, string.concat(" = icmp eq i64 ", string.concat(right.name, ", -1")))))
        emit_llvm_line(builder, string.concat("  ", string.concat(overflow, string.concat(" = and i1 ", string.concat(minimum, string.concat(", ", negative_one))))))
        emit_runtime_guard_llvm(builder, overflow, "@rocket_rt_panic_integer_overflow", string.concat(name, "_division_overflow"))
        emit_llvm_line(builder, string.concat("  ", string.concat(result, string.concat(" = sdiv i64 ", string.concat(left.name, string.concat(", ", right.name))))))
        return LlvmValue(result, "Int")
    var intrinsic = "@llvm.sadd.with.overflow.i64"
    if op == "-":
        intrinsic = "@llvm.ssub.with.overflow.i64"
    if op == "*":
        intrinsic = "@llvm.smul.with.overflow.i64"
    let pair = string.concat("%", string.concat(name, "_checked"))
    let overflow = string.concat("%", string.concat(name, "_overflow"))
    emit_llvm_line(builder, string.concat("  ", string.concat(pair, string.concat(" = call { i64, i1 } ", string.concat(intrinsic, string.concat("(i64 ", string.concat(left.name, string.concat(", i64 ", string.concat(right.name, ")")))))))))
    emit_llvm_line(builder, string.concat("  ", string.concat(result, string.concat(" = extractvalue { i64, i1 } ", string.concat(pair, ", 0")))))
    emit_llvm_line(builder, string.concat("  ", string.concat(overflow, string.concat(" = extractvalue { i64, i1 } ", string.concat(pair, ", 1")))))
    emit_runtime_guard_llvm(builder, overflow, "@rocket_rt_panic_integer_overflow", string.concat(name, "_arithmetic"))
    return LlvmValue(result, "Int")

fn emit_binary_llvm(builder: std.string.Builder, left: LlvmValue, right: LlvmValue, op: String, result_type: String, name: String) -> LlvmValue:
    let result = string.concat("%", string.concat(name, "_result"))
    if left.type_name == "String" and(op == "==" or op == "!="):
        let equal = string.concat("%", string.concat(name, "_equal"))
        emit_llvm_line(builder, string.concat("  ", string.concat(equal, string.concat(" = call i8 @rocket_rt_string_equal(ptr ", string.concat(left.name, string.concat(", ptr ", string.concat(right.name, ")")))))))
        let compared = string.concat("%", string.concat(name, "_bool"))
        emit_llvm_line(builder, string.concat("  ", string.concat(compared, string.concat(" = trunc i8 ", string.concat(equal, " to i1")))))
        if op == "!=":
            emit_llvm_line(builder, string.concat("  ", string.concat(result, string.concat(" = xor i1 ", string.concat(compared, ", true")))))
            return LlvmValue(result, "Bool")
        return LlvmValue(compared, "Bool")
    if left.type_name == "Int" and(op == "+" or op == "-" or op == "*" or op == "/"):
        return emit_checked_int_binary_llvm(builder, left, right, op, name)
    var instruction = ""
    if left.type_name == "Float":
        if op == "+":
            instruction = "fadd"
        if op == "-":
            instruction = "fsub"
        if op == "*":
            instruction = "fmul"
        if op == "/":
            instruction = "fdiv"
        if op == "==":
            instruction = "fcmp oeq"
        if op == "!=":
            instruction = "fcmp one"
        if op == "<":
            instruction = "fcmp olt"
        if op == "<=":
            instruction = "fcmp ole"
        if op == ">":
            instruction = "fcmp ogt"
        if op == ">=":
            instruction = "fcmp oge"
    else:
        if op == "+":
            instruction = "add"
        if op == "-":
            instruction = "sub"
        if op == "*":
            instruction = "mul"
        if op == "/":
            instruction = "sdiv"
        if op == "==":
            instruction = "icmp eq"
        if op == "!=":
            instruction = "icmp ne"
        if op == "<":
            instruction = "icmp slt"
        if op == "<=":
            instruction = "icmp sle"
        if op == ">":
            instruction = "icmp sgt"
        if op == ">=":
            instruction = "icmp sge"
    emit_llvm_line(builder, string.concat("  ", string.concat(result, string.concat(" = ", string.concat(instruction, string.concat(" ", string.concat(llvm_type(left.type_name), string.concat(" ", string.concat(left.name, string.concat(", ", right.name))))))))))
    return LlvmValue(result, result_type)

fn emit_call_llvm(builder: std.string.Builder, module: MirModule, instruction: MirInstruction, values: Array[LlvmValue], name: String) -> LlvmValue:
    let symbol = module.symbols[instruction.symbol]
    if symbol.intrinsic == intrinsic_print():
        let value = values[0]
        var argument = value.name
        var argument_type = llvm_type(value.type_name)
        if value.type_name == "Bool":
            let extended = string.concat("%", string.concat(name, "_print_bool"))
            emit_llvm_line(builder, string.concat("  ", string.concat(extended, string.concat(" = zext i1 ", string.concat(value.name, " to i8")))))
            argument = extended
            argument_type = "i8"
        emit_llvm_line(builder, string.concat("  call void ", string.concat(print_runtime_name(value.type_name), string.concat("(", string.concat(argument_type, string.concat(" ", string.concat(argument, ")")))))))
        return LlvmValue("0", "Unit")
    if symbol.intrinsic != intrinsic_none():
        var arguments: Array[String] = []
        for index in 0..collections.length(values):
            var argument_name = values[index].name
            var argument_type = llvm_type(values[index].type_name)
            if values[index].type_name == "Bool":
                let extended = string.concat("%", string.concat(name, string.concat("_arg_bool_", string.from_int(index))))
                emit_llvm_line(builder, string.concat("  ", string.concat(extended, string.concat(" = zext i1 ", string.concat(argument_name, " to i8")))))
                argument_name = extended
                argument_type = "i8"
            arguments = append(arguments, string.concat(argument_type, string.concat(" ", argument_name)))
        var runtime_name = intrinsic_runtime_name(symbol.intrinsic)
        if symbol.intrinsic == intrinsic_collections_append():
            runtime_name = llvm_array_append_name(collection_element_type(values[0].type_name))
        if symbol.intrinsic == intrinsic_collections_insert():
            runtime_name = llvm_array_insert_name(collection_element_type(values[0].type_name))
        if symbol.intrinsic == intrinsic_collections_map_find() or symbol.intrinsic == intrinsic_collections_map_get() or symbol.intrinsic == intrinsic_collections_set_contains() or symbol.intrinsic == intrinsic_collections_contains() or symbol.intrinsic == intrinsic_collections_find() or symbol.intrinsic == intrinsic_collections_filter_equal():
            runtime_name = string.concat(runtime_name, llvm_key_suffix(values[1].type_name))
        if symbol.intrinsic == intrinsic_collections_hash():
            runtime_name = string.concat(runtime_name, llvm_key_suffix(values[0].type_name))
        if symbol.intrinsic == intrinsic_collections_map_hash():
            runtime_name = string.concat(runtime_name, llvm_key_suffix(collection_element_type(values[0].type_name)))
        if symbol.intrinsic == intrinsic_buffer_get() or symbol.intrinsic == intrinsic_buffer_set() or symbol.intrinsic == intrinsic_buffer_append():
            runtime_name = string.concat(runtime_name, llvm_value_suffix(collection_element_type(values[0].type_name)))
        if symbol.intrinsic == intrinsic_task_group():
            runtime_name = string.concat(runtime_name, llvm_value_suffix(collection_element_type(instruction.type_name)))
        if symbol.intrinsic == intrinsic_sync_mutex() or symbol.intrinsic == intrinsic_sync_once() or symbol.intrinsic == intrinsic_sync_once_empty():
            runtime_name = string.concat(runtime_name, llvm_value_suffix(values[0].type_name))
        if symbol.intrinsic == intrinsic_sync_guard_get():
            runtime_name = string.concat(runtime_name, llvm_value_suffix(instruction.type_name))
        if symbol.intrinsic == intrinsic_sync_guard_set() or symbol.intrinsic == intrinsic_sync_once_set() or symbol.intrinsic == intrinsic_channel_send():
            runtime_name = string.concat(runtime_name, llvm_value_suffix(values[1].type_name))
        if symbol.intrinsic == intrinsic_sync_once_get():
            runtime_name = string.concat(runtime_name, llvm_value_suffix(type_arguments(instruction.type_name)[0]))
        if instruction.type_name == "Unit":
            emit_llvm_line(builder, string.concat("  call void ", string.concat(runtime_name, string.concat("(", string.concat(collections.join(arguments, ", "), ")")))))
            return LlvmValue("0", "Unit")
        var result_type = llvm_type(instruction.type_name)
        if instruction.type_name == "Bool":
            result_type = "i8"
        let call_result = string.concat("%", string.concat(name, "_call"))
        emit_llvm_line(builder, string.concat("  ", string.concat(call_result, string.concat(" = call ", string.concat(result_type, string.concat(" ", string.concat(runtime_name, string.concat("(", string.concat(collections.join(arguments, ", "), ")")))))))))
        if instruction.type_name == "Bool":
            let truncated = string.concat("%", string.concat(name, "_call_bool"))
            emit_llvm_line(builder, string.concat("  ", string.concat(truncated, string.concat(" = trunc i8 ", string.concat(call_result, " to i1")))))
            return LlvmValue(truncated, "Bool")
        return LlvmValue(call_result, instruction.type_name)
    if symbol.native_import:
        var arguments: Array[String] = []
        for index in 0..collections.length(values):
            var argument_name = values[index].name
            let argument_type = native_llvm_type(values[index].type_name)
            if values[index].type_name == "Bool":
                let extended = string.concat("%", string.concat(name, string.concat("_native_bool_", string.from_int(index))))
                emit_llvm_line(builder, string.concat("  ", string.concat(extended, string.concat(" = zext i1 ", string.concat(argument_name, " to i8")))))
                argument_name = extended
            arguments = append(arguments, string.concat(argument_type, string.concat(" ", argument_name)))
        if instruction.type_name == "Unit":
            emit_llvm_line(builder, string.concat("  call void ", string.concat(native_symbol_name(symbol), string.concat("(", string.concat(collections.join(arguments, ", "), ")")))))
            return LlvmValue("0", "Unit")
        let raw = string.concat("%", string.concat(name, "_native_call"))
        emit_llvm_line(builder, string.concat("  ", string.concat(raw, string.concat(" = call ", string.concat(native_llvm_type(instruction.type_name), string.concat(" ", string.concat(native_symbol_name(symbol), string.concat("(", string.concat(collections.join(arguments, ", "), ")")))))))))
        if instruction.type_name == "Bool":
            let converted = string.concat("%", string.concat(name, "_native_bool_result"))
            emit_llvm_line(builder, string.concat("  ", string.concat(converted, string.concat(" = trunc i8 ", string.concat(raw, " to i1")))))
            return LlvmValue(converted, "Bool")
        return LlvmValue(raw, instruction.type_name)
    var arguments: Array[String] = []
    for index in 0..collections.length(values):
        arguments = append(arguments, string.concat(llvm_type(values[index].type_name), string.concat(" ", values[index].name)))
    if instruction.type_name == "Unit":
        emit_llvm_line(builder, string.concat("  call void ", string.concat(llvm_function_name(instruction.symbol), string.concat("(", string.concat(collections.join(arguments, ", "), ")")))))
        return LlvmValue("0", "Unit")
    let result = string.concat("%", string.concat(name, "_call"))
    emit_llvm_line(builder, string.concat("  ", string.concat(result, string.concat(" = call ", string.concat(llvm_type(instruction.type_name), string.concat(" ", string.concat(llvm_function_name(instruction.symbol), string.concat("(", string.concat(collections.join(arguments, ", "), ")")))))))))
    return LlvmValue(result, instruction.type_name)

fn emit_mir_instruction_llvm(builder: std.string.Builder, globals: std.string.Builder, module: MirModule, function: MirFunction, block: Int, instruction_index: Int, instruction: MirInstruction) -> Unit:
    let name = string.concat("f", string.concat(string.from_int(function.symbol), string.concat("_b", string.concat(string.from_int(block), string.concat("_i", string.from_int(instruction_index))))))
    var values: Array[LlvmValue] = []
    for index in 0..collections.length(instruction.operands):
        values = append(values, load_llvm_operand(builder, instruction.operands[index], string.concat(name, string.concat("_o", string.from_int(index)))))
    if instruction.kind == mir_retain():
        emit_llvm_line(builder, string.concat("  call void @rocket_rt_retain(ptr ", string.concat(values[0].name, ")")))
        return
    if instruction.kind == mir_release():
        emit_llvm_line(builder, string.concat("  call void @rocket_rt_release(ptr ", string.concat(values[0].name, ")")))
        return
    if instruction.kind == mir_copy():
        store_copied_llvm(builder, instruction.destination, values[0], name)
        return
    if instruction.kind == mir_constant():
        if callback_declaration_for_type(module, instruction.type_name) >= 0:
            store_owned_llvm(builder, instruction.destination, LlvmValue(callback_wrapper_name(instruction.symbol), instruction.type_name), name)
        else:
            if instruction.type_name == "String":
                let global_name = string.concat("@rocket_string_", name)
                let length = string.byte_length(instruction.text)
                emit_llvm_line(globals, string.concat(global_name, string.concat(" = private unnamed_addr constant [", string.concat(string.from_int(length), string.concat(" x i8] c\"", string.concat(llvm_escape_bytes(instruction.text), "\""))))))
                let result = string.concat("%", string.concat(name, "_string"))
                emit_llvm_line(builder, string.concat("  ", string.concat(result, string.concat(" = call ptr @rocket_rt_string_new(ptr ", string.concat(global_name, string.concat(", i64 ", string.concat(string.from_int(length), ")")))))))
                store_owned_llvm(builder, instruction.destination, LlvmValue(result, "String"), name)
            else:
                store_owned_llvm(builder, instruction.destination, LlvmValue(llvm_constant_value(MirOperand(-1, instruction.text, instruction.type_name, true)), instruction.type_name), name)
        return
    if instruction.kind == mir_unary():
        let result = string.concat("%", string.concat(name, "_unary"))
        if instruction.text == "not":
            emit_llvm_line(builder, string.concat("  ", string.concat(result, string.concat(" = xor i1 ", string.concat(values[0].name, ", true")))))
        else:
            if instruction.type_name == "Float":
                emit_llvm_line(builder, string.concat("  ", string.concat(result, string.concat(" = fneg double ", values[0].name))))
            else:
                let checked = string.concat("%", string.concat(name, "_unary_checked"))
                let overflow = string.concat("%", string.concat(name, "_unary_overflow"))
                emit_llvm_line(builder, string.concat("  ", string.concat(checked, string.concat(" = call { i64, i1 } @llvm.ssub.with.overflow.i64(i64 0, i64 ", string.concat(values[0].name, ")")))))
                emit_llvm_line(builder, string.concat("  ", string.concat(result, string.concat(" = extractvalue { i64, i1 } ", string.concat(checked, ", 0")))))
                emit_llvm_line(builder, string.concat("  ", string.concat(overflow, string.concat(" = extractvalue { i64, i1 } ", string.concat(checked, ", 1")))))
                emit_runtime_guard_llvm(builder, overflow, "@rocket_rt_panic_integer_overflow", string.concat(name, "_negation"))
        store_owned_llvm(builder, instruction.destination, LlvmValue(result, instruction.type_name), name)
        return
    if instruction.kind == mir_binary():
        let value = emit_binary_llvm(builder, values[0], values[1], instruction.text, instruction.type_name, name)
        store_owned_llvm(builder, instruction.destination, value, name)
        return
    if instruction.kind == mir_call():
        let value = emit_call_llvm(builder, module, instruction, values, name)
        store_owned_llvm(builder, instruction.destination, value, name)
        return
    if instruction.kind == mir_async_call():
        var mask = 0
        for index in 0..collections.length(values):
            if managed_type(values[index].type_name):
                mask = mask + power_of_two(index)
        let context = string.concat("%", string.concat(name, "_async_context"))
        emit_llvm_line(builder, string.concat("  ", string.concat(context, string.concat(" = call ptr @rocket_rt_aggregate_new(i32 0, i32 ", string.concat(string.from_int(collections.length(values)), string.concat(", i64 ", string.concat(string.from_int(mask), ")")))))))
        for index in 0..collections.length(values):
            var argument_name = values[index].name
            var argument_type = llvm_type(values[index].type_name)
            if values[index].type_name == "Bool":
                let extended = string.concat("%", string.concat(name, string.concat("_async_bool_", string.from_int(index))))
                emit_llvm_line(builder, string.concat("  ", string.concat(extended, string.concat(" = zext i1 ", string.concat(argument_name, " to i8")))))
                argument_name = extended
                argument_type = "i8"
            emit_llvm_line(builder, string.concat("  call void ", string.concat(llvm_aggregate_set_name(values[index].type_name), string.concat("(ptr ", string.concat(context, string.concat(", i32 ", string.concat(string.from_int(index), string.concat(", ", string.concat(argument_type, string.concat(" ", string.concat(argument_name, ")")))))))))))
        let task = string.concat("%", string.concat(name, "_task"))
        emit_llvm_line(builder, string.concat("  ", string.concat(task, string.concat(" = call ptr @rocket_rt_task_spawn(ptr ", string.concat(llvm_async_entry_name(instruction.symbol), string.concat(", ptr ", string.concat(context, ")")))))))
        store_owned_llvm(builder, instruction.destination, LlvmValue(task, instruction.type_name), name)
        return
    if instruction.kind == mir_await():
        let result = string.concat("%", string.concat(name, "_await"))
        emit_llvm_line(builder, string.concat("  ", string.concat(result, string.concat(" = call ptr @rocket_rt_task_await(ptr ", string.concat(values[0].name, ")")))))
        store_owned_llvm(builder, instruction.destination, LlvmValue(result, instruction.type_name), name)
        return
    if instruction.kind == mir_array():
        let element_type = collection_element_type(instruction.type_name)
        let result = string.concat("%", string.concat(name, "_array"))
        emit_llvm_line(builder, string.concat("  ", string.concat(result, string.concat(" = call ptr @rocket_rt_array_new(i32 ", string.concat(string.from_int(llvm_element_kind(element_type)), string.concat(", i64 ", string.concat(string.from_int(collections.length(values)), ")")))))))
        for index in 0..collections.length(values):
            var argument_name = values[index].name
            var argument_type = llvm_type(element_type)
            if element_type == "Bool":
                let extended = string.concat("%", string.concat(name, string.concat("_array_bool_", string.from_int(index))))
                emit_llvm_line(builder, string.concat("  ", string.concat(extended, string.concat(" = zext i1 ", string.concat(argument_name, " to i8")))))
                argument_name = extended
                argument_type = "i8"
            emit_llvm_line(builder, string.concat("  call void ", string.concat(llvm_array_set_name(element_type), string.concat("(ptr ", string.concat(result, string.concat(", i64 ", string.concat(string.from_int(index), string.concat(", ", string.concat(argument_type, string.concat(" ", string.concat(argument_name, ")")))))))))))
        store_owned_llvm(builder, instruction.destination, LlvmValue(result, instruction.type_name), name)
        return
    if instruction.kind == mir_array_update():
        let element_type = collection_element_type(instruction.type_name)
        var argument_name = values[2].name
        var argument_type = llvm_type(element_type)
        if element_type == "Bool":
            let extended = string.concat("%", string.concat(name, "_array_update_bool"))
            emit_llvm_line(builder, string.concat("  ", string.concat(extended, string.concat(" = zext i1 ", string.concat(argument_name, " to i8")))))
            argument_name = extended
            argument_type = "i8"
        let result = string.concat("%", string.concat(name, "_array_update"))
        let arguments = string.concat("(ptr ", string.concat(values[0].name, string.concat(", i64 ", string.concat(values[1].name, string.concat(", ", string.concat(argument_type, string.concat(" ", string.concat(argument_name, ")"))))))))
        let call = string.concat("  ", string.concat(result, string.concat(" = call ptr ", string.concat(llvm_array_update_name(element_type), arguments))))
        emit_llvm_line(builder, call)
        store_owned_llvm(builder, instruction.destination, LlvmValue(result, instruction.type_name), name)
        return
    if instruction.kind == mir_aggregate():
        var mask = 0
        for index in 0..collections.length(values):
            if managed_type(values[index].type_name):
                mask = mask + power_of_two(index)
        let result = string.concat("%", string.concat(name, "_aggregate"))
        var tag = 0
        if instruction.text == "$enum":
            tag = instruction.field
        emit_llvm_line(builder, string.concat("  ", string.concat(result, string.concat(" = call ptr @rocket_rt_aggregate_new(i32 ", string.concat(string.from_int(tag), string.concat(", i32 ", string.concat(string.from_int(collections.length(values)), string.concat(", i64 ", string.concat(string.from_int(mask), ")")))))))))
        for index in 0..collections.length(values):
            var argument_name = values[index].name
            var argument_type = llvm_type(values[index].type_name)
            if values[index].type_name == "Bool":
                let extended = string.concat("%", string.concat(name, string.concat("_field_bool_", string.from_int(index))))
                emit_llvm_line(builder, string.concat("  ", string.concat(extended, string.concat(" = zext i1 ", string.concat(argument_name, " to i8")))))
                argument_name = extended
                argument_type = "i8"
            emit_llvm_line(builder, string.concat("  call void ", string.concat(llvm_aggregate_set_name(values[index].type_name), string.concat("(ptr ", string.concat(result, string.concat(", i32 ", string.concat(string.from_int(index), string.concat(", ", string.concat(argument_type, string.concat(" ", string.concat(argument_name, ")")))))))))))
        store_owned_llvm(builder, instruction.destination, LlvmValue(result, instruction.type_name), name)
        return
    if instruction.kind == mir_index():
        let raw = string.concat("%", string.concat(name, "_index"))
        var raw_type = llvm_type(instruction.type_name)
        if instruction.type_name == "Bool":
            raw_type = "i8"
        emit_llvm_line(builder, string.concat("  ", string.concat(raw, string.concat(" = call ", string.concat(raw_type, string.concat(" ", string.concat(llvm_index_name(instruction.type_name), string.concat("(ptr ", string.concat(values[0].name, string.concat(", i64 ", string.concat(values[1].name, ")")))))))))))
        var result = raw
        if instruction.type_name == "Bool":
            result = string.concat("%", string.concat(name, "_index_bool"))
            emit_llvm_line(builder, string.concat("  ", string.concat(result, string.concat(" = trunc i8 ", string.concat(raw, " to i1")))))
        store_owned_llvm(builder, instruction.destination, LlvmValue(result, instruction.type_name), name)
        return
    if instruction.kind == mir_slice():
        let result = string.concat("%", string.concat(name, "_slice"))
        emit_llvm_line(builder, string.concat("  ", string.concat(result, string.concat(" = call ptr @rocket_rt_slice_new(ptr ", string.concat(values[0].name, string.concat(", i64 ", string.concat(values[1].name, string.concat(", i64 ", string.concat(values[2].name, ")")))))))))
        store_owned_llvm(builder, instruction.destination, LlvmValue(result, instruction.type_name), name)
        return
    if instruction.kind == mir_field():
        let raw = string.concat("%", string.concat(name, "_field"))
        var raw_type = llvm_type(instruction.type_name)
        if instruction.type_name == "Bool":
            raw_type = "i8"
        emit_llvm_line(builder, string.concat("  ", string.concat(raw, string.concat(" = call ", string.concat(raw_type, string.concat(" ", string.concat(llvm_aggregate_get_name(instruction.type_name), string.concat("(ptr ", string.concat(values[0].name, string.concat(", i32 ", string.concat(string.from_int(instruction.field), ")")))))))))))
        var result = raw
        if instruction.type_name == "Bool":
            result = string.concat("%", string.concat(name, "_field_bool"))
            emit_llvm_line(builder, string.concat("  ", string.concat(result, string.concat(" = trunc i8 ", string.concat(raw, " to i1")))))
        store_owned_llvm(builder, instruction.destination, LlvmValue(result, instruction.type_name), name)
        return
    if instruction.kind == mir_tag():
        let raw = string.concat("%", string.concat(name, "_tag32"))
        let result = string.concat("%", string.concat(name, "_tag"))
        emit_llvm_line(builder, string.concat("  ", string.concat(raw, string.concat(" = call i32 @rocket_rt_aggregate_tag(ptr ", string.concat(values[0].name, ")")))))
        emit_llvm_line(builder, string.concat("  ", string.concat(result, string.concat(" = zext i32 ", string.concat(raw, " to i64")))))
        store_owned_llvm(builder, instruction.destination, LlvmValue(result, "Int"), name)

fn emit_mir_terminator_llvm(builder: std.string.Builder, function: MirFunction, block: MirBlock) -> Unit:
    let terminator = block.terminator
    let name = string.concat("f", string.concat(string.from_int(function.symbol), string.concat("_b", string.concat(string.from_int(block.id), "_term"))))
    if terminator.kind == terminator_goto():
        emit_llvm_line(builder, string.concat("  br label %bb", string.from_int(terminator.target)))
        return
    if terminator.kind == terminator_branch():
        let condition = load_llvm_operand(builder, terminator.condition, string.concat(name, "_condition"))
        emit_llvm_line(builder, string.concat("  br i1 ", string.concat(condition.name, string.concat(", label %bb", string.concat(string.from_int(terminator.then_target), string.concat(", label %bb", string.from_int(terminator.else_target)))))))
        return
    if function.result_type == "Unit":
        emit_llvm_line(builder, "  ret void")
        return
    let returned = load_llvm_operand(builder, terminator.returned, string.concat(name, "_returned"))
    emit_llvm_line(builder, string.concat("  ret ", string.concat(llvm_type(function.result_type), string.concat(" ", returned.name))))

fn emit_mir_function_llvm(builder: std.string.Builder, globals: std.string.Builder, module: MirModule, function: MirFunction) -> Unit:
    var parameters: Array[String] = []
    for index in 0..collections.length(function.parameters):
        let local = function.locals[function.parameters[index]]
        parameters = append(parameters, string.concat(llvm_type(local.type_name), string.concat(" %arg", string.from_int(index))))
    emit_llvm_line(builder, string.concat("define ", string.concat(llvm_result_type(function.result_type), string.concat(" ", string.concat(llvm_function_name(function.symbol), string.concat("(", string.concat(collections.join(parameters, ", "), ") {")))))))
    emit_llvm_line(builder, "entry:")
    for index in 0..collections.length(function.locals):
        let local = function.locals[index]
        emit_llvm_line(builder, string.concat("  ", string.concat(llvm_local_name(local.id), string.concat(" = alloca ", llvm_type(local.type_name)))))
        if not local.parameter:
            emit_llvm_line(builder, string.concat("  store ", string.concat(llvm_type(local.type_name), string.concat(" ", string.concat(llvm_zero(local.type_name), string.concat(", ptr ", llvm_local_name(local.id)))))))
    for index in 0..collections.length(function.parameters):
        let local = function.locals[function.parameters[index]]
        emit_llvm_line(builder, string.concat("  store ", string.concat(llvm_type(local.type_name), string.concat(" %arg", string.concat(string.from_int(index), string.concat(", ptr ", llvm_local_name(local.id)))))))
    emit_llvm_line(builder, "  br label %bb0")
    for block_index in 0..collections.length(function.blocks):
        let block = function.blocks[block_index]
        emit_llvm_line(builder, string.concat("bb", string.concat(string.from_int(block.id), ":")))
        for instruction_index in 0..collections.length(block.instructions):
            emit_mir_instruction_llvm(builder, globals, module, function, block.id, instruction_index, block.instructions[instruction_index])
        emit_mir_terminator_llvm(builder, function, block)
    emit_llvm_line(builder, "}")
    emit_llvm_line(builder, "")

fn emit_async_entry_llvm(builder: std.string.Builder, module: MirModule, function: MirFunction) -> Unit:
    let symbol = module.symbols[function.symbol]
    emit_llvm_line(builder, string.concat("define internal ptr ", string.concat(llvm_async_entry_name(function.symbol), "(ptr %context) {")))
    emit_llvm_line(builder, "entry:")
    var arguments: Array[String] = []
    for index in 0..collections.length(symbol.parameter_types):
        let type_name = symbol.parameter_types[index]
        var raw_type = llvm_type(type_name)
        if type_name == "Bool":
            raw_type = "i8"
        let raw = string.concat("%rocket_async_arg_", string.from_int(index))
        emit_llvm_line(builder, string.concat("  ", string.concat(raw, string.concat(" = call ", string.concat(raw_type, string.concat(" ", string.concat(llvm_aggregate_get_name(type_name), string.concat("(ptr %context, i32 ", string.concat(string.from_int(index), ")")))))))))
        var argument = raw
        if type_name == "Bool":
            argument = string.concat("%rocket_async_bool_", string.from_int(index))
            emit_llvm_line(builder, string.concat("  ", string.concat(argument, string.concat(" = trunc i8 ", string.concat(raw, " to i1")))))
        arguments = append(arguments, string.concat(llvm_type(type_name), string.concat(" ", argument)))
    emit_llvm_line(builder, string.concat("  %rocket_async_result = call ptr ", string.concat(llvm_function_name(function.symbol), string.concat("(", string.concat(collections.join(arguments, ", "), ")")))))
    emit_llvm_line(builder, "  ret ptr %rocket_async_result")
    emit_llvm_line(builder, "}")
    emit_llvm_line(builder, "")

fn emit_async_entries_llvm(builder: std.string.Builder, module: MirModule) -> Unit:
    for index in 0..collections.length(module.functions):
        if module.functions[index].asynchronous:
            emit_async_entry_llvm(builder, module, module.functions[index])

fn emit_native_declarations(builder: std.string.Builder, module: MirModule) -> Unit:
    for symbol_index in 0..collections.length(module.symbols):
        let symbol = module.symbols[symbol_index]
        if symbol.kind == symbol_function() and symbol.native_import:
            var parameters: Array[String] = []
            for parameter_index in 0..collections.length(symbol.parameter_types):
                parameters = append(parameters, native_llvm_type(symbol.parameter_types[parameter_index]))
            emit_llvm_line(builder, string.concat("declare ", string.concat(native_llvm_type(symbol.type_name), string.concat(" ", string.concat(native_symbol_name(symbol), string.concat("(", string.concat(collections.join(parameters, ", "), ")")))))))
    emit_llvm_line(builder, "")

fn emit_callback_wrapper(builder: std.string.Builder, module: MirModule, symbol: HirSymbol, callback_declaration: AstStructDecl) -> Unit:
    var parameters: Array[String] = []
    for index in 0..collections.length(callback_declaration.callback_parameters):
        parameters = append(parameters, string.concat(native_llvm_type(callback_declaration.callback_parameters[index].type_name), string.concat(" %arg", string.from_int(index))))
    emit_llvm_line(builder, string.concat("define ", string.concat(native_llvm_type(callback_declaration.callback_result), string.concat(" ", string.concat(callback_wrapper_name(symbol.id), string.concat("(", string.concat(collections.join(parameters, ", "), ") {")))))))
    emit_llvm_line(builder, "entry:")
    var arguments: Array[String] = []
    for index in 0..collections.length(callback_declaration.callback_parameters):
        let type_name = callback_declaration.callback_parameters[index].type_name
        var value = string.concat("%arg", string.from_int(index))
        if type_name == "Bool":
            let converted = string.concat("%rocket_callback_bool_", string.from_int(index))
            emit_llvm_line(builder, string.concat("  ", string.concat(converted, string.concat(" = trunc i8 ", string.concat(value, " to i1")))))
            value = converted
        arguments = append(arguments, string.concat(llvm_type(type_name), string.concat(" ", value)))
    if callback_declaration.callback_result == "Unit":
        emit_llvm_line(builder, string.concat("  call void ", string.concat(llvm_function_name(symbol.id), string.concat("(", string.concat(collections.join(arguments, ", "), ")")))))
        emit_llvm_line(builder, "  ret void")
    else:
        let called = "%rocket_callback_result"
        emit_llvm_line(builder, string.concat("  ", string.concat(called, string.concat(" = call ", string.concat(llvm_type(callback_declaration.callback_result), string.concat(" ", string.concat(llvm_function_name(symbol.id), string.concat("(", string.concat(collections.join(arguments, ", "), ")")))))))))
        if callback_declaration.callback_result == "Bool":
            emit_llvm_line(builder, string.concat("  %rocket_callback_native_bool = zext i1 ", string.concat(called, " to i8")))
            emit_llvm_line(builder, "  ret i8 %rocket_callback_native_bool")
        else:
            emit_llvm_line(builder, string.concat("  ret ", string.concat(native_llvm_type(callback_declaration.callback_result), string.concat(" ", called))))
    emit_llvm_line(builder, "}")
    emit_llvm_line(builder, "")

fn emit_callback_wrappers(builder: std.string.Builder, module: MirModule) -> Unit:
    for symbol_index in 0..collections.length(module.symbols):
        let symbol = module.symbols[symbol_index]
        if symbol.kind != symbol_function() or symbol.native_import:
            continue
        for declaration_index in 0..collections.length(module.structs):
            let declaration = module.structs[declaration_index]
            if declaration.representation == representation_callback() and symbol_matches_callback(module, symbol, declaration):
                emit_callback_wrapper(builder, module, symbol, declaration)
                break

fn emit_export_wrapper(builder: std.string.Builder, symbol: HirSymbol, selected: TargetInfo) -> Unit:
    var parameters: Array[String] = []
    for index in 0..collections.length(symbol.parameter_types):
        parameters = append(parameters, string.concat(native_llvm_type(symbol.parameter_types[index]), string.concat(" %arg", string.from_int(index))))
    var storage = ""
    if selected.os == "windows":
        storage = "dllexport "
    emit_llvm_line(builder, string.concat("define ", string.concat(storage, string.concat(native_llvm_type(symbol.type_name), string.concat(" ", string.concat(native_symbol_name(symbol), string.concat("(", string.concat(collections.join(parameters, ", "), ") {"))))))))
    emit_llvm_line(builder, "entry:")
    var arguments: Array[String] = []
    for index in 0..collections.length(symbol.parameter_types):
        let type_name = symbol.parameter_types[index]
        var value = string.concat("%arg", string.from_int(index))
        if type_name == "Bool":
            let converted = string.concat("%rocket_export_bool_", string.from_int(index))
            emit_llvm_line(builder, string.concat("  ", string.concat(converted, string.concat(" = trunc i8 ", string.concat(value, " to i1")))))
            value = converted
        arguments = append(arguments, string.concat(llvm_type(type_name), string.concat(" ", value)))
    if symbol.type_name == "Unit":
        emit_llvm_line(builder, string.concat("  call void ", string.concat(llvm_function_name(symbol.id), string.concat("(", string.concat(collections.join(arguments, ", "), ")")))))
        emit_llvm_line(builder, "  ret void")
    else:
        let called = "%rocket_export_result"
        emit_llvm_line(builder, string.concat("  ", string.concat(called, string.concat(" = call ", string.concat(llvm_type(symbol.type_name), string.concat(" ", string.concat(llvm_function_name(symbol.id), string.concat("(", string.concat(collections.join(arguments, ", "), ")")))))))))
        if symbol.type_name == "Bool":
            emit_llvm_line(builder, string.concat("  %rocket_export_native_bool = zext i1 ", string.concat(called, " to i8")))
            emit_llvm_line(builder, "  ret i8 %rocket_export_native_bool")
        else:
            emit_llvm_line(builder, string.concat("  ret ", string.concat(native_llvm_type(symbol.type_name), string.concat(" ", called))))
    emit_llvm_line(builder, "}")
    emit_llvm_line(builder, "")

fn emit_export_wrappers(builder: std.string.Builder, module: MirModule, selected: TargetInfo) -> Unit:
    for index in 0..collections.length(module.symbols):
        if module.symbols[index].native_export:
            emit_export_wrapper(builder, module.symbols[index], selected)

fn emit_native_entrypoint(builder: std.string.Builder, module: MirModule) -> Unit:
    if module.library:
        return
    var main_symbol = -1
    for index in 0..collections.length(module.functions):
        let symbol = module.functions[index].symbol
        if module.symbols[symbol].name == "main":
            main_symbol = symbol
    if main_symbol < 0:
        return
    emit_llvm_line(builder, "define i32 @main(i32 %argc, ptr %argv) {")
    emit_llvm_line(builder, "entry:")
    emit_llvm_line(builder, "  call void @rocket_std_process_set_arguments(i32 %argc, ptr %argv)")
    emit_llvm_line(builder, string.concat("  %rocket_main = call i64 ", string.concat(llvm_function_name(main_symbol), "()")))
    emit_llvm_line(builder, "  %rocket_exit = trunc i64 %rocket_main to i32")
    emit_llvm_line(builder, "  ret i32 %rocket_exit")
    emit_llvm_line(builder, "}")
    emit_llvm_line(builder, "")

fn append_llvm_chunk(path: String, chunk: String) -> Bool:
    let appended = file.append_text(path, chunk)
    match appended:
        case Ok(value):
            return true
        case Err(error):
            print(string.concat("rocketc: error[R5002]: ", error))
            return false

fn write_llvm_function(path: String, module: MirModule, function: MirFunction) -> Bool:
    let function_output = string.builder()
    let function_globals = string.builder()
    emit_mir_function_llvm(function_output, function_globals, module, function)
    if not append_llvm_chunk(path, string.builder_finish(function_globals)):
        return false
    if not append_llvm_chunk(path, string.builder_finish(function_output)):
        return false
    return true

fn write_llvm_ir(module: MirModule, selected: TargetInfo, path: String) -> Bool:
    let initialized = file.write_text(path, "")
    match initialized:
        case Err(error):
            print(string.concat("rocketc: error[R5002]: ", error))
            return false
        case Ok(value):
            let ignored = value
    let prefix = string.builder()
    emit_llvm_line(prefix, "; Generated by the Rocket self-hosted compiler")
    emit_llvm_line(prefix, "; The selected pinned Clang driver supplies the concrete target triple")
    emit_llvm_line(prefix, "")
    emit_runtime_declarations(prefix)
    emit_native_declarations(prefix, module)
    if not append_llvm_chunk(path, string.builder_finish(prefix)):
        return false
    for index in 0..collections.length(module.functions):
        if not write_llvm_function(path, module, module.functions[index]):
            return false
    let suffix = string.builder()
    emit_async_entries_llvm(suffix, module)
    emit_callback_wrappers(suffix, module)
    emit_export_wrappers(suffix, module, selected)
    emit_native_entrypoint(suffix, module)
    if not append_llvm_chunk(path, string.builder_finish(suffix)):
        return false
    return true

fn parser_self_test() -> Int:
    let source = "import std.string\n\nstruct Pair[T]:\n    first: T\n    second: T\n\nenum Choice:\n    Yes(Int)\n    No\n\nfn main() -> Int:\n    var total = 0\n    var values = [1, 2]\n    values[0] = 3\n    for index in 0..3:\n        if index == 2:\n            total = total + index\n    return total\n"
    let result = parse_source(source)
    if collections.length(result.diagnostics) != 0:
        return 11
    if collections.length(result.module.imports) != 1 or result.module.imports[0].name != "std.string":
        return 12
    if collections.length(result.module.structs) != 1 or result.module.structs[0].name != "Pair":
        return 13
    if collections.length(result.module.enums) != 1 or collections.length(result.module.enums[0].variants) != 2:
        return 14
    if collections.length(result.module.functions) != 1 or collections.length(result.module.functions[0].body) != 5:
        return 15
    if result.module.functions[0].body[2].kind != statement_index_assignment() or result.module.functions[0].body[3].kind != statement_for():
        return 16
    return 0

fn diagnostic_text(path: String, diagnostic: Diagnostic) -> String:
    let line = string.from_int(diagnostic.line)
    let column = string.from_int(diagnostic.column)
    let location = string.concat(path, string.concat(":", string.concat(line, string.concat(":", column))))
    return string.concat(location, string.concat(": error[", string.concat(diagnostic.code, string.concat("]: ", diagnostic.message))))

fn syntax_check(path: String) -> Int:
    let result = parse_program(path)
    if collections.length(result.diagnostics) != 0:
        for index in 0..collections.length(result.diagnostics):
            print(diagnostic_text(path, result.diagnostics[index]))
        return 1
    print(string.concat(path, ": syntax check succeeded"))
    return 0

fn hir_check(path: String) -> Int:
    let result = analyze_program(path)
    if collections.length(result.diagnostics) != 0:
        for index in 0..collections.length(result.diagnostics):
            print(diagnostic_text(path, result.diagnostics[index]))
        return 1
    print(string.concat(path, ": HIR check succeeded"))
    return 0

fn mir_check(path: String) -> Int:
    let result = compile_program_to_mir(path)
    if collections.length(result.diagnostics) != 0:
        for index in 0..collections.length(result.diagnostics):
            print(diagnostic_text(path, result.diagnostics[index]))
        return 1
    print(string.concat(path, ": MIR check succeeded"))
    return 0

fn emit_ir_file(input: String, output: String) -> Int:
    let result = compile_program_to_mir(input)
    if collections.length(result.diagnostics) != 0:
        for index in 0..collections.length(result.diagnostics):
            print(diagnostic_text(input, result.diagnostics[index]))
        return 1
    if not write_llvm_ir(result.module, native_target(), output):
        return 1
    print(string.concat("emitted self-hosted LLVM IR to ", output))
    return 0

fn manifest_value(source: String, section: String, key: String) -> String:
    let lines = string.split(source, "\n")
    var current_section = ""
    for index in 0..collections.length(lines):
        let line = string.trim(lines[index])
        if string.starts_with(line, "[") and string.ends_with(line, "]"):
            current_section = string.slice(line, 1, string.byte_length(line) - 1)
            continue
        if current_section == section and string.starts_with(line, string.concat(key, " ")):
            var equals = -1
            for byte_index in 0..string.byte_length(line):
                if string.byte_at(line, byte_index) == '=':
                    equals = byte_index
            if equals >= 0:
                let raw = string.trim(string.slice(line, equals + 1, string.byte_length(line)))
                if string.byte_length(raw) >= 2 and string.byte_at(raw, 0) == '"' and string.byte_at(raw, string.byte_length(raw) - 1) == '"':
                    return string.slice(raw, 1, string.byte_length(raw) - 1)
    return ""

fn manifest_resource_error(source: String) -> String:
    if string.byte_length(source) > 1048576:
        return "rocket.toml exceeds the 1 MiB limit"
    let lines = string.split(source, "\n")
    for index in 0..collections.length(lines):
        if string.byte_length(lines[index]) > 65536:
            return "rocket.toml contains a line above the 64 KiB limit"
    return ""

fn manifest_list(source: String, section: String, key: String) -> Array[String]:
    let raw = manifest_value(source, section, key)
    var values: Array[String] = []
    if raw == "":
        return values
    let pieces = string.split(raw, ";")
    for index in 0..collections.length(pieces):
        let value = string.trim(pieces[index])
        if value != "":
            values = append(values, value)
    return values

fn safe_manifest_relative_path(value: String) -> Bool:
    if value == "" or string.contains(value, "..") or string.contains(value, ":"):
        return false
    let first = string.byte_at(value, 0)
    return first != '/' and first != '\\'

fn normalize_target(value: String) -> TargetInfo:
    if value == "windows-x64" or value == "x86_64-pc-windows-msvc":
        return TargetInfo(true, "windows-x64", "x86_64-pc-windows-msvc", "windows", "x64", "msvc", 64, "little", ["threads", "dynamic-libraries", "codeview", "sse2"], "", "")
    if value == "linux-x64" or value == "x86_64-unknown-linux-gnu":
        return TargetInfo(true, "linux-x64", "x86_64-unknown-linux-gnu", "linux", "x64", "gnu", 64, "little", ["threads", "dynamic-libraries", "dwarf", "sse2"], "", "")
    if value == "linux-arm64" or value == "aarch64-unknown-linux-gnu":
        return TargetInfo(true, "linux-arm64", "aarch64-unknown-linux-gnu", "linux", "arm64", "gnu", 64, "little", ["threads", "dynamic-libraries", "dwarf", "neon"], "", "")
    if value == "macos-arm64" or value == "arm64-apple-macosx":
        return TargetInfo(true, "macos-arm64", "arm64-apple-macosx", "macos", "arm64", "apple", 64, "little", ["threads", "dynamic-libraries", "dwarf", "neon"], "", "")
    if value == "windows-arm64" or value == "aarch64-pc-windows-msvc":
        return TargetInfo(false, "windows-arm64", "aarch64-pc-windows-msvc", "windows", "arm64", "msvc", 64, "little", [], "R6002", "target 'windows-arm64' is recognized but is not production-supported")
    return TargetInfo(false, "", "", "", "", "", 0, "", [], "R6001", string.concat("unknown target '", string.concat(value, "'")))

fn native_target() -> TargetInfo:
    return normalize_target(target.alias())

fn target_cross_supported(host: TargetInfo, selected: TargetInfo) -> Bool:
    if host.alias == selected.alias:
        return true
    if host.alias == "windows-x64":
        return selected.alias == "linux-x64" or selected.alias == "linux-arm64"
    if host.alias == "linux-x64":
        return selected.alias == "linux-arm64" or selected.alias == "windows-x64"
    return false

fn target_sdk_environment_variable(selected: TargetInfo) -> String:
    if selected.alias == "windows-x64":
        return "ROCKET_TARGET_SDK_WINDOWS_X64"
    if selected.alias == "linux-x64":
        return "ROCKET_TARGET_SDK_LINUX_X64"
    if selected.alias == "linux-arm64":
        return "ROCKET_TARGET_SDK_LINUX_ARM64"
    if selected.alias == "macos-arm64":
        return "ROCKET_TARGET_SDK_MACOS_ARM64"
    return "ROCKET_TARGET_SDK_WINDOWS_ARM64"

fn parse_target_command_options(arguments: Array[String], allow_filter: Bool) -> TargetCommandOptions:
    var input = "."
    var input_set = false
    var requested = target.alias()
    var target_sdk = ""
    var filter = ""
    var forwarding = false
    var index = 1
    while index < collections.length(arguments):
        let argument = arguments[index]
        if forwarding:
            index = index + 1
        else:
            if argument == "--":
                forwarding = true
                index = index + 1
            else:
                if argument == "--target":
                    if index + 1 >= collections.length(arguments):
                        return TargetCommandOptions(false, input, normalize_target(requested), target_sdk, filter, "R5002", "--target requires an alias or triple")
                    requested = arguments[index + 1]
                    index = index + 2
                else:
                    if argument == "--target-sdk":
                        if index + 1 >= collections.length(arguments):
                            return TargetCommandOptions(false, input, normalize_target(requested), target_sdk, filter, "R5002", "--target-sdk requires a directory")
                        target_sdk = arguments[index + 1]
                        index = index + 2
                    else:
                        if argument == "--filter":
                            if not allow_filter or index + 1 >= collections.length(arguments):
                                return TargetCommandOptions(false, input, normalize_target(requested), target_sdk, filter, "R5002", "--filter is only valid for test and requires text")
                            filter = arguments[index + 1]
                            index = index + 2
                        else:
                            if string.starts_with(argument, "--"):
                                return TargetCommandOptions(false, input, normalize_target(requested), target_sdk, filter, "R5002", string.concat("unexpected argument '", string.concat(argument, "'")))
                            if input_set:
                                return TargetCommandOptions(false, input, normalize_target(requested), target_sdk, filter, "R5002", string.concat("unexpected argument '", string.concat(argument, "'")))
                            input = argument
                            input_set = true
                            index = index + 1
    let selected = normalize_target(requested)
    if not selected.valid:
        return TargetCommandOptions(false, input, selected, target_sdk, filter, selected.error_code, selected.error)
    return TargetCommandOptions(true, input, selected, target_sdk, filter, "", "")

fn ensure_target_build_available(selected: TargetInfo, target_sdk: String) -> Int:
    let host = native_target()
    if host.alias == selected.alias:
        return 0
    if target_cross_supported(host, selected):
        var configured = target_sdk
        if configured == "":
            configured = environment_or_empty(target_sdk_environment_variable(selected))
        if configured == "":
            print(string.concat("rocketc: error[R6003]: target SDK for '", string.concat(selected.alias, string.concat("' is not configured; use --target-sdk or ", target_sdk_environment_variable(selected)))))
            return 2
        return 0
    print(string.concat("rocketc: error[R6004]: host '", string.concat(host.alias, string.concat("' cannot produce target '", string.concat(selected.alias, "'")))))
    return 2

fn ensure_target_execution_available(selected: TargetInfo, tests: Bool) -> Int:
    let host = native_target()
    if host.alias == selected.alias:
        return 0
    if tests:
        print(string.concat("rocketc: error[R6004]: cannot execute target '", string.concat(selected.alias, string.concat("' tests on host '", string.concat(host.alias, "'")))))
    else:
        print(string.concat("rocketc: error[R6004]: cannot execute target '", string.concat(selected.alias, string.concat("' on host '", string.concat(host.alias, "'")))))
    return 2

fn target_command(arguments: Array[String]) -> Int:
    var requested = target.alias()
    var verbose = false
    var index = 1
    while index < collections.length(arguments):
        if arguments[index] == "--verbose":
            verbose = true
            index = index + 1
        else:
            if arguments[index] == "--target" and index + 1 < collections.length(arguments):
                requested = arguments[index + 1]
                index = index + 2
            else:
                print(string.concat("rocketc: error[R5002]: unexpected target argument '", string.concat(arguments[index], "'")))
                return 2
    let selected = normalize_target(requested)
    if not selected.valid:
        print(string.concat("rocketc: error[", string.concat(selected.error_code, string.concat("]: ", selected.error))))
        return 2
    if not verbose:
        print(selected.alias)
        return 0
    let host = native_target()
    if not host.valid:
        print(string.concat("rocketc: error[", string.concat(host.error_code, string.concat("]: ", host.error))))
        return 2
    print(string.concat("host: ", host.alias))
    print(string.concat("target: ", selected.alias))
    print(string.concat("triple: ", selected.triple))
    print(string.concat("os: ", selected.os))
    print(string.concat("architecture: ", selected.architecture))
    print(string.concat("environment: ", selected.environment))
    print(string.concat("pointer-width: ", string.from_int(selected.pointer_width)))
    print(string.concat("endianness: ", selected.endianness))
    print(string.concat("features: ", collections.join(selected.features, ",")))
    if host.alias == selected.alias:
        print("native: true")
    else:
        print("native: false")
    if target_cross_supported(host, selected):
        print("cross-supported: true")
    else:
        print("cross-supported: false")
    return 0

fn resolve_package_target(input: String, selected_target: TargetInfo) -> PackageInfo:
    let normalized = std.path.normalize(input)
    if std.path.extension(normalized) == ".rocket":
        let filename = std.path.basename(normalized)
        let name = string.slice(filename, 0, string.byte_length(filename) - 7)
        return PackageInfo(true, source_parent(normalized), normalized, std.path.join(source_parent(normalized), "tests"), name, output_executable(), name, [], [], [], selected_target.alias, selected_target.triple, "", "")
    let manifest_path = std.path.join(normalized, "rocket.toml")
    let loaded = file.read_text(manifest_path)
    match loaded:
        case Err(error):
            return PackageInfo(false, normalized, "", "", "", output_executable(), "", [], [], [], selected_target.alias, selected_target.triple, "", string.concat("cannot read rocket.toml: ", error))
        case Ok(source):
            let resource_error = manifest_resource_error(source)
            if resource_error != "":
                return PackageInfo(false, normalized, "", "", "", output_executable(), "", [], [], [], selected_target.alias, selected_target.triple, "", resource_error)
            let package_name = manifest_value(source, "package", "name")
            let version = manifest_value(source, "package", "version")
            let entry_relative = manifest_value(source, "package", "entry")
            var tests_relative = manifest_value(source, "test", "directory")
            if tests_relative == "":
                tests_relative = "tests"
            var output_kind = output_executable()
            let kind = manifest_value(source, "build", "kind")
            if kind == "static-library":
                output_kind = output_static_library()
            else:
                if kind == "dynamic-library":
                    output_kind = output_dynamic_library()
                else:
                    if kind != "" and kind != "executable":
                        return PackageInfo(false, normalized, "", "", package_name, output_executable(), "", [], [], [], selected_target.alias, selected_target.triple, "", "build.kind must be executable, static-library, or dynamic-library")
            var output_name = manifest_value(source, "build", "name")
            if output_name == "":
                if output_kind == output_executable():
                    output_name = "main"
                else:
                    output_name = package_name
            let native_section = string.concat("native.", selected_target.alias)
            let native_libraries = manifest_list(source, native_section, "libraries")
            let native_search_relative = manifest_list(source, native_section, "library-search")
            let native_headers_relative = manifest_list(source, native_section, "headers")
            var native_search: Array[String] = []
            var native_headers: Array[String] = []
            for index in 0..collections.length(native_libraries):
                if string.starts_with(native_libraries[index], "framework:"):
                    let framework = string.slice(native_libraries[index], 10, string.byte_length(native_libraries[index]))
                    if selected_target.os != "macos" or not safe_framework_name(framework):
                        return PackageInfo(false, normalized, "", "", package_name, output_kind, output_name, [], [], [], selected_target.alias, selected_target.triple, "", string.concat("invalid target-native framework input '", string.concat(native_libraries[index], "'")))
            for index in 0..collections.length(native_search_relative):
                if not safe_manifest_relative_path(native_search_relative[index]):
                    return PackageInfo(false, normalized, "", "", package_name, output_kind, output_name, [], [], [], selected_target.alias, selected_target.triple, "", "native library search paths must remain inside the package")
                native_search = append(native_search, std.path.normalize(std.path.join(normalized, native_search_relative[index])))
            let configured_native_root = environment_or_empty("ROCKET_NATIVE_LIBRARY_ROOT")
            if configured_native_root != "" and file.exists(configured_native_root):
                native_search = append(native_search, std.path.normalize(configured_native_root))
            for index in 0..collections.length(native_headers_relative):
                if not safe_manifest_relative_path(native_headers_relative[index]):
                    return PackageInfo(false, normalized, "", "", package_name, output_kind, output_name, [], [], [], selected_target.alias, selected_target.triple, "", "native headers must remain inside the package")
                let header = std.path.normalize(std.path.join(normalized, native_headers_relative[index]))
                if not file.exists(header):
                    return PackageInfo(false, normalized, "", "", package_name, output_kind, output_name, [], [], [], selected_target.alias, selected_target.triple, "", string.concat("native header does not exist: ", header))
                native_headers = append(native_headers, header)
            if package_name == "" or version == "" or not safe_manifest_relative_path(entry_relative) or not safe_manifest_relative_path(tests_relative):
                return PackageInfo(false, normalized, "", "", package_name, output_kind, output_name, native_libraries, native_search, native_headers, selected_target.alias, selected_target.triple, "", "invalid package name, version, entry, or test directory")
            let target_section = string.concat("target.", selected_target.alias)
            let source_root_relative = manifest_value(source, target_section, "source-root")
            let target_entry_relative = manifest_value(source, target_section, "entry")
            let target_tests_relative = manifest_value(source, target_section, "test-directory")
            var target_source_root = ""
            if source_root_relative != "":
                if not safe_manifest_relative_path(source_root_relative):
                    return PackageInfo(false, normalized, "", "", package_name, output_kind, output_name, native_libraries, native_search, native_headers, selected_target.alias, selected_target.triple, "", "target manifest source-root must stay inside the package")
                target_source_root = std.path.normalize(std.path.join(normalized, source_root_relative))
                if not file.exists(target_source_root):
                    return PackageInfo(false, normalized, "", "", package_name, output_kind, output_name, native_libraries, native_search, native_headers, selected_target.alias, selected_target.triple, "", "selected target source-root does not exist inside the package")
            var entry = std.path.normalize(std.path.join(normalized, entry_relative))
            var tests = std.path.normalize(std.path.join(normalized, tests_relative))
            var selected_base = normalized
            if target_source_root != "":
                selected_base = target_source_root
                let overlaid_entry = std.path.normalize(std.path.join(selected_base, entry_relative))
                if file.exists(overlaid_entry):
                    entry = overlaid_entry
                let overlaid_tests = std.path.normalize(std.path.join(selected_base, tests_relative))
                if file.exists(overlaid_tests):
                    tests = overlaid_tests
            if target_entry_relative != "":
                if not safe_manifest_relative_path(target_entry_relative):
                    return PackageInfo(false, normalized, "", "", package_name, output_kind, output_name, native_libraries, native_search, native_headers, selected_target.alias, selected_target.triple, target_source_root, "target manifest entry must stay inside the package")
                entry = std.path.normalize(std.path.join(selected_base, target_entry_relative))
            if target_tests_relative != "":
                if not safe_manifest_relative_path(target_tests_relative):
                    return PackageInfo(false, normalized, "", "", package_name, output_kind, output_name, native_libraries, native_search, native_headers, selected_target.alias, selected_target.triple, target_source_root, "target manifest test-directory must stay inside the package")
                tests = std.path.normalize(std.path.join(selected_base, target_tests_relative))
            if not file.exists(entry):
                return PackageInfo(false, normalized, entry, "", package_name, output_kind, output_name, native_libraries, native_search, native_headers, selected_target.alias, selected_target.triple, target_source_root, string.concat("package entry does not exist: ", entry))
            return PackageInfo(true, normalized, entry, tests, package_name, output_kind, output_name, native_libraries, native_search, native_headers, selected_target.alias, selected_target.triple, target_source_root, "")

fn resolve_package(input: String) -> PackageInfo:
    return resolve_package_target(input, native_target())

fn environment_or_empty(name: String) -> String:
    let result = process.environment(name)
    match result:
        case Some(value):
            return value
        case None:
            return ""

fn first_existing(paths: Array[String]) -> String:
    for index in 0..collections.length(paths):
        if file.exists(paths[index]):
            return paths[index]
    return ""

fn executable_directory() -> String:
    let resolved = process.executable_path()
    match resolved:
        case Ok(path_value):
            return source_parent(std.path.normalize(path_value))
        case Err(error):
            return "."

fn existing_directories(paths: Array[String]) -> Array[String]:
    var result: Array[String] = []
    for index in 0..collections.length(paths):
        if file.exists(paths[index]):
            result = append(result, std.path.normalize(paths[index]))
    return result

fn host_tool_suffix() -> String:
    if native_target().os == "windows":
        return ".exe"
    return ""

fn target_executable_suffix(selected: TargetInfo) -> String:
    if selected.os == "windows":
        return ".exe"
    return ""

fn target_object_suffix(selected: TargetInfo) -> String:
    if selected.os == "windows":
        return ".obj"
    return ".o"

fn target_static_library_suffix(selected: TargetInfo) -> String:
    if selected.os == "windows":
        return ".lib"
    return ".a"

fn target_dynamic_library_suffix(selected: TargetInfo) -> String:
    if selected.os == "windows":
        return ".dll"
    if selected.os == "macos":
        return ".dylib"
    return ".so"

fn target_metadata_matches(root: String, selected: TargetInfo) -> Bool:
    let loaded = file.read_text(std.path.join(root, "share/rocket/target.txt"))
    match loaded:
        case Err(error):
            return false
        case Ok(source):
            let lines = string.split(source, "\n")
            if collections.length(lines) < 3:
                return false
            if string.trim(lines[0]) != "rocket-target-sdk-1":
                return false
            if string.trim(lines[1]) != string.concat("alias=", selected.alias):
                return false
            if string.trim(lines[2]) != string.concat("triple=", selected.triple):
                return false
            for index in 3..collections.length(lines):
                if string.trim(lines[index]) != "":
                    return false
            return true

fn installed_target_toolchain(root: String, selected: TargetInfo, require_metadata: Bool) -> ToolchainInfo:
    let normalized = std.path.normalize(root)
    if not file.exists(normalized) or(require_metadata and not target_metadata_matches(normalized, selected)):
        return ToolchainInfo(false, "", "", "", [], "", "R6003", string.concat("configured target SDK for '", string.concat(selected.alias, "' is incomplete or has mismatched target metadata")))
    let suffix = host_tool_suffix()
    let clang_path = std.path.join(normalized, string.concat("bin/clang", suffix))
    var librarian_name = "bin/llvm-ar"
    if selected.os == "windows":
        librarian_name = "bin/llvm-lib"
    let librarian = std.path.join(normalized, string.concat(librarian_name, suffix))
    let runtime_path = std.path.join(normalized, string.concat("lib/rocket_runtime", target_static_library_suffix(selected)))
    var library_directories: Array[String] = []
    if selected.os == "windows":
        library_directories = existing_directories([std.path.join(normalized, "lib/msvc"), std.path.join(normalized, "lib/ucrt"), std.path.join(normalized, "lib/um")])
    else:
        library_directories = existing_directories([std.path.join(normalized, "lib")])
    var sysroot = ""
    let possible_sysroot = std.path.join(normalized, "sysroot")
    if file.exists(possible_sysroot):
        sysroot = possible_sysroot
    let host = native_target()
    let cross = host.alias != selected.alias
    var complete = file.exists(clang_path) and file.exists(librarian) and file.exists(runtime_path)
    if cross and selected.os == "linux" and sysroot == "":
        complete = false
    if cross and selected.os == "windows" and collections.length(library_directories) != 3:
        complete = false
    if not complete:
        return ToolchainInfo(false, clang_path, runtime_path, librarian, library_directories, sysroot, "R6003", string.concat("configured target SDK for '", string.concat(selected.alias, "' is incomplete or has mismatched target metadata")))
    return ToolchainInfo(true, clang_path, runtime_path, librarian, library_directories, sysroot, "", "")

fn apply_native_macos_sysroot(toolchain: ToolchainInfo, selected: TargetInfo) -> ToolchainInfo:
    let host = native_target()
    if not toolchain.valid or host.alias != selected.alias or selected.os != "macos" or toolchain.sysroot != "":
        return toolchain
    let configured = environment_or_empty("ROCKET_MACOS_SDK_ROOT")
    if configured == "":
        return ToolchainInfo(false, toolchain.clang, toolchain.runtime, toolchain.librarian, toolchain.library_directories, "", "R6003", "native macOS SDK root is not configured; set ROCKET_MACOS_SDK_ROOT")
    let sysroot = std.path.normalize(configured)
    if not file.exists(sysroot):
        return ToolchainInfo(false, toolchain.clang, toolchain.runtime, toolchain.librarian, toolchain.library_directories, "", "R6003", string.concat("native macOS SDK root does not exist: '", string.concat(sysroot, "'")))
    return ToolchainInfo(true, toolchain.clang, toolchain.runtime, toolchain.librarian, toolchain.library_directories, sysroot, "", "")

fn locate_toolchain_target(selected: TargetInfo, target_sdk: String) -> ToolchainInfo:
    let host = native_target()
    if host.alias != selected.alias and not target_cross_supported(host, selected):
        return ToolchainInfo(false, "", "", "", [], "", "R6004", string.concat("host '", string.concat(host.alias, string.concat("' cannot produce target '", string.concat(selected.alias, "'")))))
    var configured = target_sdk
    if configured == "":
        configured = environment_or_empty(target_sdk_environment_variable(selected))
    if configured != "":
        return apply_native_macos_sysroot(installed_target_toolchain(configured, selected, true), selected)
    if host.alias != selected.alias:
        return ToolchainInfo(false, "", "", "", [], "", "R6003", string.concat("target SDK for '", string.concat(selected.alias, string.concat("' is not configured; use --target-sdk or ", target_sdk_environment_variable(selected)))))
    let compiler_directory = executable_directory()
    var install_root = compiler_directory
    if std.path.basename(compiler_directory) == "bin":
        install_root = source_parent(compiler_directory)
    let installed = installed_target_toolchain(install_root, selected, false)
    if installed.valid:
        return apply_native_macos_sysroot(installed, selected)
    var development_root = ""
    if std.path.basename(compiler_directory) == ".rocketc":
        development_root = source_parent(source_parent(compiler_directory))
    let targets_directory = source_parent(compiler_directory)
    let cache_directory = source_parent(targets_directory)
    if std.path.basename(targets_directory) == "targets" and std.path.basename(cache_directory) == ".rocketc":
        development_root = source_parent(source_parent(cache_directory))
    let suffix = host_tool_suffix()
    var clang_path = environment_or_empty("ROCKET_CLANG")
    var runtime_path = environment_or_empty("ROCKET_RUNTIME")
    if clang_path == "":
        clang_path = first_existing([std.path.join(compiler_directory, string.concat("clang", suffix)), std.path.join(install_root, string.concat("bin/clang", suffix)), std.path.join(development_root, string.concat("dependencies/installed/llvm-22.1.6/bin/clang", suffix)), string.concat("bin/clang", suffix), string.concat("dependencies/installed/llvm-22.1.6/bin/clang", suffix)])
    if runtime_path == "":
        let runtime_name = string.concat("rocket_runtime", target_static_library_suffix(selected))
        runtime_path = first_existing([std.path.join(install_root, string.concat("lib/", runtime_name)), std.path.join(compiler_directory, runtime_name), std.path.join(development_root, std.path.join(string.concat("out/build/", string.concat(selected.alias, "-debug")), runtime_name)), std.path.join(development_root, std.path.join(string.concat("out/build/", string.concat(selected.alias, "-release")), runtime_name)), std.path.join("lib", runtime_name)])
    var librarian = environment_or_empty("ROCKET_LIBRARIAN")
    if librarian == "" and clang_path != "":
        var librarian_name = "llvm-ar"
        if selected.os == "windows":
            librarian_name = "llvm-lib"
        librarian = std.path.join(source_parent(std.path.normalize(clang_path)), string.concat(librarian_name, suffix))
    let library_directories = existing_directories([std.path.join(install_root, "lib/msvc"), std.path.join(install_root, "lib/ucrt"), std.path.join(install_root, "lib/um")])
    if clang_path == "" or runtime_path == "" or librarian == "" or not file.exists(librarian):
        return ToolchainInfo(false, clang_path, runtime_path, librarian, library_directories, "", "R6003", string.concat("native toolchain for '", string.concat(selected.alias, "' is incomplete; install the Rocket SDK or configure its compiler, librarian, and runtime")))
    return apply_native_macos_sysroot(ToolchainInfo(true, std.path.normalize(clang_path), std.path.normalize(runtime_path), std.path.normalize(librarian), library_directories, "", "", ""), selected)

fn locate_toolchain() -> ToolchainInfo:
    return locate_toolchain_target(native_target(), "")

fn ensure_directory(directory: String) -> Int:
    let created = file.create_directory(directory)
    match created:
        case Ok(value):
            return 0
        case Err(error):
            print(string.concat("rocketc: error[R5002]: ", error))
            return 1

fn native_declaration_name(module: AstModule, type_name: String) -> String:
    let base = type_base(type_name)
    for index in 0..collections.length(module.structs):
        if module.structs[index].name == base and module.structs[index].representation != representation_rocket():
            return module.structs[index].native_name
    return base

fn native_c_type(module: AstModule, type_name: String) -> String:
    if type_name == "Int":
        return "int64_t"
    if type_name == "Float":
        return "double"
    if type_name == "Bool":
        return "rocket_bool"
    if type_name == "Char":
        return "uint8_t"
    if type_name == "Unit":
        return "void"
    if type_base(type_name) == "Pointer":
        let arguments = type_arguments(type_name)
        if collections.length(arguments) == 0 or arguments[0] == "Unit":
            return "void*"
        return string.concat(native_c_type(module, arguments[0]), "*")
    let index = foreign_type_index(module, type_name)
    if index >= 0 and module.structs[index].representation == representation_opaque():
        return string.concat(module.structs[index].native_name, "*")
    return native_declaration_name(module, type_name)

fn uppercase_guard(value: String) -> String:
    let lower = "abcdefghijklmnopqrstuvwxyz"
    let upper = "ABCDEFGHIJKLMNOPQRSTUVWXYZ"
    let builder = string.builder()
    for index in 0..string.byte_length(value):
        let character = string.slice(value, index, index + 1)
        var written = false
        for letter in 0..string.byte_length(lower):
            if character == string.slice(lower, letter, letter + 1):
                string.builder_append(builder, string.slice(upper, letter, letter + 1))
                written = true
        if not written:
            if string.contains("ABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789_", character):
                string.builder_append(builder, character)
            else:
                string.builder_append(builder, "_")
    return string.builder_finish(builder)

fn generate_native_header(module: AstModule, package_name: String) -> String:
    let guard = string.concat("ROCKET_", string.concat(uppercase_guard(package_name), "_H"))
    let output = string.builder()
    string.builder_append(output, string.concat("#ifndef ", string.concat(guard, string.concat("\n#define ", string.concat(guard, "\n\n")))))
    string.builder_append(output, "#include <stdint.h>\n\ntypedef uint8_t rocket_bool;\n#ifndef ROCKET_API\n#define ROCKET_API\n#endif\n\n#ifdef __cplusplus\nextern \"C\" {\n#endif\n\n")
    var wrote_type = false
    for index in 0..collections.length(module.structs):
        let declaration = module.structs[index]
        if declaration.representation == representation_opaque():
            string.builder_append(output, string.concat("typedef struct ", string.concat(declaration.native_name, string.concat(" ", string.concat(declaration.native_name, ";\n")))))
            wrote_type = true
        if declaration.representation == representation_native():
            string.builder_append(output, string.concat("typedef struct ", string.concat(declaration.native_name, " { ")))
            for field_index in 0..collections.length(declaration.fields):
                let field = declaration.fields[field_index]
                string.builder_append(output, string.concat(native_c_type(module, field.type_name), string.concat(" ", string.concat(field.name, "; "))))
            string.builder_append(output, string.concat("} ", string.concat(declaration.native_name, ";\n")))
            wrote_type = true
        if declaration.representation == representation_callback():
            string.builder_append(output, string.concat("typedef ", string.concat(native_c_type(module, declaration.callback_result), string.concat(" (*", string.concat(declaration.native_name, ")(")))))
            if collections.length(declaration.callback_parameters) == 0:
                string.builder_append(output, "void")
            for parameter_index in 0..collections.length(declaration.callback_parameters):
                if parameter_index > 0:
                    string.builder_append(output, ", ")
                let parameter = declaration.callback_parameters[parameter_index]
                string.builder_append(output, string.concat(native_c_type(module, parameter.type_name), string.concat(" ", parameter.name)))
            string.builder_append(output, ");\n")
            wrote_type = true
    if wrote_type:
        string.builder_append(output, "\n")
    for index in 0..collections.length(module.functions):
        let function = module.functions[index]
        if function.native_export:
            string.builder_append(output, string.concat("ROCKET_API ", string.concat(native_c_type(module, function.result_type), string.concat(" ", string.concat(function.native_name, "(")))))
            if collections.length(function.parameters) == 0:
                string.builder_append(output, "void")
            for parameter_index in 0..collections.length(function.parameters):
                if parameter_index > 0:
                    string.builder_append(output, ", ")
                let parameter = function.parameters[parameter_index]
                string.builder_append(output, string.concat(native_c_type(module, parameter.type_name), string.concat(" ", parameter.name)))
            string.builder_append(output, ");\n")
    string.builder_append(output, "\n#ifdef __cplusplus\n}\n#endif\n\n#endif\n")
    return string.builder_finish(output)

fn emit_header_command(input: String, output_path: String) -> Int:
    let package = resolve_package(input)
    if not package.valid:
        print(string.concat("rocketc: error[R5001]: ", package.error))
        return 1
    let parsed = parse_program(package.entry)
    let checked = lower_to_hir(parsed.module, parsed.diagnostics, true)
    if collections.length(checked.diagnostics) != 0:
        for index in 0..collections.length(checked.diagnostics):
            print(diagnostic_text(package.entry, checked.diagnostics[index]))
        return 1
    let header = generate_native_header(parsed.module, package.name)
    if output_path == "":
        print(header)
        return 0
    let written = file.write_text(output_path, header)
    match written:
        case Ok(value):
            return 0
        case Err(error):
            print(string.concat("rocketc: error[R5002]: ", error))
            return 1

fn substring_index(value: String, pattern: String) -> Int:
    if string.byte_length(pattern) == 0:
        return 0
    if string.byte_length(pattern) > string.byte_length(value):
        return -1
    for index in 0..string.byte_length(value) - string.byte_length(pattern) + 1:
        if string.slice(value, index, index + string.byte_length(pattern)) == pattern:
            return index
    return -1

fn last_space_index(value: String) -> Int:
    var result = -1
    for index in 0..string.byte_length(value):
        let character = string.byte_at(value, index)
        if character == ' ' or character == '\t':
            result = index
    return result

fn parse_binding_parameter(value: String) -> BindingParameterResult:
    let clean = string.trim(value)
    let space = last_space_index(clean)
    if space < 0:
        return BindingParameterResult(false, "", "")
    var type_name = string.trim(string.slice(clean, 0, space))
    var name = string.trim(string.slice(clean, space + 1, string.byte_length(clean)))
    while string.starts_with(name, "*"):
        type_name = string.concat(type_name, "*")
        name = string.slice(name, 1, string.byte_length(name))
    return BindingParameterResult(type_name != "" and name != "", type_name, name)

fn binding_c_type(type_name: String, opaque_types: Array[String], structures: Array[String], callbacks: Array[String]) -> String:
    var value = string.trim(type_name)
    if string.starts_with(value, "const "):
        value = string.trim(string.slice(value, 6, string.byte_length(value)))
    while string.contains(value, "  "):
        let pieces = string.split(value, "  ")
        value = collections.join(pieces, " ")
    if value == "int64_t":
        return "Int"
    if value == "double":
        return "Float"
    if value == "rocket_bool":
        return "Bool"
    if value == "uint8_t":
        return "Char"
    if value == "void":
        return "Unit"
    if value == "void*":
        return "Pointer[Unit]"
    if string.ends_with(value, "*"):
        let base = string.trim(string.slice(value, 0, string.byte_length(value) - 1))
        if contains_string(opaque_types, base):
            return base
        if contains_string(structures, base):
            return string.concat("Pointer[", string.concat(base, "]"))
        let inner = binding_c_type(base, opaque_types, structures, callbacks)
        if inner == "":
            return ""
        return string.concat("Pointer[", string.concat(inner, "]"))
    if contains_string(opaque_types, value) or contains_string(structures, value) or contains_string(callbacks, value):
        return value
    return ""

fn integer_define_value(value: String) -> Bool:
    if value == "":
        return false
    var start = 0
    if string.starts_with(value, "-"):
        if string.byte_length(value) == 1:
            return false
        start = 1
    for index in start..string.byte_length(value):
        if not string.contains("0123456789", string.slice(value, index, index + 1)):
            return false
    return true

fn binding_type_sets(lines: Array[String], set_kind: Int) -> Array[String]:
    var result: Array[String] = []
    for index in 0..collections.length(lines):
        let current = string.trim(lines[index])
        if string.starts_with(current, "typedef struct "):
            let open = substring_index(current, " { ")
            if open >= 0:
                if set_kind == representation_native():
                    result = append(result, string.slice(current, 15, open))
            else:
                let pieces = string.split(current, " ")
                if collections.length(pieces) == 4:
                    let final = pieces[3]
                    if string.ends_with(final, ";") and pieces[2] == string.slice(final, 0, string.byte_length(final) - 1) and set_kind == representation_opaque():
                        result = append(result, pieces[2])
        if string.starts_with(current, "typedef ") and string.contains(current, " (*") and string.contains(current, ")("):
            let marker = substring_index(current, " (*")
            let close = substring_index(current, ")(")
            if marker >= 0 and close > marker and set_kind == representation_callback():
                result = append(result, string.slice(current, marker + 3, close))
    return result

fn generate_rocket_bindings(header: String) -> BindingGenerationResult:
    let lines = string.split(header, "\n")
    let opaque_types = binding_type_sets(lines, representation_opaque())
    let structures = binding_type_sets(lines, representation_native())
    let callbacks = binding_type_sets(lines, representation_callback())
    let output = string.builder()
    string.builder_append(output, "# Generated deterministically by rocketc bind.\n")
    for index in 0..collections.length(lines):
        let current = string.trim(lines[index])
        if string.starts_with(current, "#define "):
            let pieces = string.split(current, " ")
            if collections.length(pieces) == 3 and integer_define_value(pieces[2]):
                string.builder_append(output, string.concat("pub extern const ", string.concat(pieces[1], string.concat(": Int = ", string.concat(pieces[2], "\n")))))
            continue
        if current == "" or string.starts_with(current, "#") or current == "extern \"C\" {" or current == "}" or current == "typedef uint8_t rocket_bool;":
            continue
        if string.starts_with(current, "typedef struct "):
            let open = substring_index(current, " { ")
            if open < 0:
                let pieces = string.split(current, " ")
                if collections.length(pieces) == 4 and contains_string(opaque_types, pieces[2]):
                    string.builder_append(output, string.concat("pub extern opaque ", string.concat(pieces[2], "\n")))
                continue
            let close = substring_index(current, " } ")
            if close < 0:
                return BindingGenerationResult(false, "", string.concat("unsupported native struct declaration '", string.concat(current, "'")))
            let name = string.slice(current, 15, open)
            string.builder_append(output, string.concat("pub extern struct ", string.concat(name, ":\n")))
            let fields = string.split(string.slice(current, open + 3, close), ";")
            for field_index in 0..collections.length(fields):
                if string.trim(fields[field_index]) != "":
                    let parameter = parse_binding_parameter(fields[field_index])
                    if not parameter.valid:
                        return BindingGenerationResult(false, "", string.concat("unsupported native struct field '", string.concat(fields[field_index], "'")))
                    let mapped = binding_c_type(parameter.type_name, opaque_types, structures, callbacks)
                    if mapped == "":
                        return BindingGenerationResult(false, "", string.concat("unsupported C binding type '", string.concat(parameter.type_name, "'")))
                    string.builder_append(output, string.concat("    ", string.concat(parameter.name, string.concat(": ", string.concat(mapped, "\n")))))
            continue
        if string.starts_with(current, "typedef ") and string.contains(current, " (*") and string.contains(current, ")("):
            let marker = substring_index(current, " (*")
            let close = substring_index(current, ")(")
            let end = substring_index(current, ");")
            let result_type = binding_c_type(string.slice(current, 8, marker), opaque_types, structures, callbacks)
            if result_type == "" or end < close:
                return BindingGenerationResult(false, "", string.concat("unsupported callback declaration '", string.concat(current, "'")))
            let name = string.slice(current, marker + 3, close)
            let parameters = string.split(string.slice(current, close + 2, end), ",")
            string.builder_append(output, string.concat("pub extern callback ", string.concat(name, "(")))
            if not(collections.length(parameters) == 1 and string.trim(parameters[0]) == "void"):
                for parameter_index in 0..collections.length(parameters):
                    let parameter = parse_binding_parameter(parameters[parameter_index])
                    if not parameter.valid:
                        return BindingGenerationResult(false, "", string.concat("unsupported callback parameter '", string.concat(parameters[parameter_index], "'")))
                    let mapped = binding_c_type(parameter.type_name, opaque_types, structures, callbacks)
                    if mapped == "":
                        return BindingGenerationResult(false, "", string.concat("unsupported C binding type '", string.concat(parameter.type_name, "'")))
                    if parameter_index > 0:
                        string.builder_append(output, ", ")
                    string.builder_append(output, string.concat(parameter.name, string.concat(": ", mapped)))
            string.builder_append(output, string.concat(") -> ", string.concat(result_type, "\n")))
            continue
        if string.starts_with(current, "ROCKET_API ") or string.ends_with(current, ");") and not string.starts_with(current, "typedef "):
            let open = substring_index(current, "(")
            let close = substring_index(current, ");")
            if open < 0 or close < open:
                return BindingGenerationResult(false, "", string.concat("unsupported C function declaration '", string.concat(current, "'")))
            var signature_start = 0
            if string.starts_with(current, "ROCKET_API "):
                signature_start = 11
            let signature = string.slice(current, signature_start, open)
            let separator = last_space_index(signature)
            if separator < 0:
                return BindingGenerationResult(false, "", string.concat("unsupported C function declaration '", string.concat(current, "'")))
            let result_type = binding_c_type(string.slice(signature, 0, separator), opaque_types, structures, callbacks)
            let name = string.slice(signature, separator + 1, string.byte_length(signature))
            if result_type == "":
                return BindingGenerationResult(false, "", string.concat("unsupported C binding type in '", string.concat(current, "'")))
            let parameters = string.split(string.slice(current, open + 1, close), ",")
            string.builder_append(output, string.concat("pub extern fn ", string.concat(name, "(")))
            if not(collections.length(parameters) == 1 and string.trim(parameters[0]) == "void"):
                for parameter_index in 0..collections.length(parameters):
                    let parameter = parse_binding_parameter(parameters[parameter_index])
                    if not parameter.valid:
                        return BindingGenerationResult(false, "", string.concat("unsupported C function parameter '", string.concat(parameters[parameter_index], "'")))
                    let mapped = binding_c_type(parameter.type_name, opaque_types, structures, callbacks)
                    if mapped == "":
                        return BindingGenerationResult(false, "", string.concat("unsupported C binding type '", string.concat(parameter.type_name, "'")))
                    if parameter_index > 0:
                        string.builder_append(output, ", ")
                    string.builder_append(output, string.concat(parameter.name, string.concat(": ", mapped)))
            string.builder_append(output, string.concat(") -> ", string.concat(result_type, "\n")))
    return BindingGenerationResult(true, string.builder_finish(output), "")

fn bind_command(header_path: String, output_path: String) -> Int:
    let loaded = file.read_text(header_path)
    match loaded:
        case Err(error):
            print(string.concat("rocketc: error[R5002]: ", error))
            return 1
        case Ok(header):
            let generated = generate_rocket_bindings(header)
            if not generated.valid:
                print(string.concat("rocketc: error[R5002]: ", generated.error))
                return 1
            if output_path == "":
                print(generated.output)
                return 0
            let written = file.write_text(output_path, generated.output)
            match written:
                case Ok(value):
                    return 0
                case Err(error):
                    print(string.concat("rocketc: error[R5002]: ", error))
                    return 1

fn write_generated_ir_kind(input: String, output: String, library: Bool) -> Int:
    return write_generated_ir_kind_target(input, "", output, library, native_target())

fn write_generated_ir_kind_target(input: String, target_root: String, output: String, library: Bool, selected: TargetInfo) -> Int:
    let result = compile_program_to_mir_kind_target(input, target_root, library)
    if collections.length(result.diagnostics) != 0:
        for index in 0..collections.length(result.diagnostics):
            print(diagnostic_text(input, result.diagnostics[index]))
        return 1
    if write_llvm_ir(result.module, selected, output):
        return 0
    return 1

fn write_generated_ir(input: String, output: String) -> Int:
    return write_generated_ir_kind(input, output, false)

fn direct_process(program: String, arguments: Array[String]) -> Int:
    let result = process.run(program, arguments)
    match result:
        case Ok(status):
            return status
        case Err(error):
            print(string.concat("rocketc: error[R5002]: ", error))
            return 1

fn report_external_command_failure(stage: String, program: String, arguments: Array[String], status: Int) -> Unit:
    print(string.concat("rocketc: external ", string.concat(stage, string.concat(" command failed with status ", string.from_int(status)))))
    print(string.concat("  program: ", program))
    for index in 0..collections.length(arguments):
        print(string.concat("  argument: ", arguments[index]))

fn ignored_build_entry(name: String) -> Bool:
    return name == ".git" or name == ".rocketc" or name == "out" or name == "build" or name == "dependencies" or name == "node_modules"

fn collect_build_hashes(root: String, relative: String) -> BuildHashResult:
    var current = root
    if relative != "":
        current = std.path.join(root, relative)
    let listed = file.list(current)
    match listed:
        case Ok(names):
            var entries: Array[String] = []
            for index in 0..collections.length(names):
                let name = names[index]
                if relative == "" and ignored_build_entry(name):
                    continue
                var child = name
                if relative != "":
                    child = std.path.join(relative, name)
                let nested = collect_build_hashes(root, child)
                if not nested.valid:
                    return nested
                entries = collections.concat(entries, nested.entries)
            return BuildHashResult(true, entries, "")
        case Err(list_error):
            let loaded = file.read_binary(current)
            match loaded:
                case Err(read_error):
                    return BuildHashResult(false, [], string.concat(list_error, string.concat(": ", read_error)))
                case Ok(bytes):
                    let hashed = crypto.sha256(bytes)
                    match hashed:
                        case Err(hash_error):
                            return BuildHashResult(false, [], hash_error)
                        case Ok(digest):
                            return BuildHashResult(true, [string.concat(relative, string.concat("=", digest))], "")

fn hash_build_text(value: String) -> String:
    let hashed = crypto.sha256(binary.from_string(value))
    match hashed:
        case Ok(digest):
            return digest
        case Err(error):
            return ""

fn hash_build_file(path_value: String) -> String:
    let loaded = file.read_binary(path_value)
    match loaded:
        case Err(error):
            return ""
        case Ok(bytes):
            let hashed = crypto.sha256(bytes)
            match hashed:
                case Ok(digest):
                    return digest
                case Err(error):
                    return ""

fn output_extension(output_kind: Int, selected: TargetInfo) -> String:
    if output_kind == output_static_library():
        return target_static_library_suffix(selected)
    if output_kind == output_dynamic_library():
        return target_dynamic_library_suffix(selected)
    return target_executable_suffix(selected)

fn safe_artifact_identity(value: String) -> String:
    let builder = string.builder()
    for index in 0..string.byte_length(value):
        let byte = string.byte_value_at(value, index)
        if(byte >= 65 and byte <= 90) or(byte >= 97 and byte <= 122) or(byte >= 48 and byte <= 57) or byte == 95 or byte == 45:
            string.builder_append(builder, string.slice(value, index, index + 1))
        else:
            string.builder_append(builder, "_")
    let result = string.builder_finish(builder)
    if result == "":
        return "anonymous"
    return result

fn package_artifact_directory(package: PackageInfo) -> String:
    var root = package.root
    let configured = environment_or_empty("ROCKET_ARTIFACT_ROOT")
    if configured != "":
        root = std.path.join(std.path.normalize(configured), safe_artifact_identity(package.name))
    return std.path.join(std.path.join(std.path.join(root, ".rocketc"), "targets"), package.target_alias)

fn package_artifact_path(package: PackageInfo) -> String:
    return std.path.join(package_artifact_directory(package), string.concat(package.output_name, output_extension(package.output_kind, normalize_target(package.target_alias))))

fn package_cache_marker(package: PackageInfo) -> String:
    return std.path.join(package_artifact_directory(package), string.concat(package.output_name, ".rocket-build-cache-1"))

fn build_cache_key(package: PackageInfo, target_sdk: String) -> String:
    if not file.exists(std.path.join(package.root, "rocket.toml")):
        return ""
    let sources = collect_build_hashes(package.root, "")
    if not sources.valid:
        return ""
    let source_digest = hash_build_text(collections.join(sources.entries, "\n"))
    if source_digest == "":
        return ""
    let executable = process.executable_path()
    var compiler_digest = ""
    match executable:
        case Ok(path_value):
            compiler_digest = hash_build_file(path_value)
        case Err(error):
            return ""
    let toolchain = locate_toolchain_target(normalize_target(package.target_alias), target_sdk)
    if not toolchain.valid:
        return ""
    let runtime_digest = hash_build_file(toolchain.runtime)
    if compiler_digest == "" or runtime_digest == "":
        return ""
    let material = string.builder()
    string.builder_append(material, "rocket-build-cache-1\n")
    string.builder_append(material, "compiler-version=2.1.0\n")
    string.builder_append(material, string.concat("compiler-sha256=", string.concat(compiler_digest, "\n")))
    string.builder_append(material, string.concat("source-sha256=", string.concat(source_digest, "\n")))
    string.builder_append(material, string.concat("target=", string.concat(package.target_alias, "\n")))
    string.builder_append(material, string.concat("triple=", string.concat(package.target_triple, "\n")))
    string.builder_append(material, "optimized=true\n")
    string.builder_append(material, string.concat("output-kind=", string.concat(string.from_int(package.output_kind), "\n")))
    string.builder_append(material, string.concat("output-name=", string.concat(package.output_name, "\n")))
    string.builder_append(material, string.concat("runtime-sha256=", string.concat(runtime_digest, "\n")))
    for index in 0..collections.length(package.native_library_search):
        string.builder_append(material, string.concat("native-search=", string.concat(package.native_library_search[index], "\n")))
    for index in 0..collections.length(package.native_libraries):
        string.builder_append(material, string.concat("native-library=", string.concat(package.native_libraries[index], "\n")))
    return hash_build_text(string.builder_finish(material))

fn package_build_cache_hit(package: PackageInfo, key: String) -> Bool:
    if key == "" or not file.exists(package_artifact_path(package)):
        return false
    if package.output_kind != output_executable() and not file.exists(std.path.join(package_artifact_directory(package), string.concat(package.output_name, ".h"))):
        return false
    let loaded = file.read_text(package_cache_marker(package))
    match loaded:
        case Ok(value):
            return string.trim(value) == key
        case Err(error):
            return false

fn safe_framework_name(value: String) -> Bool:
    if value == "":
        return false
    for index in 0..string.byte_length(value):
        let byte = string.byte_value_at(value, index)
        if not((byte >= 65 and byte <= 90) or(byte >= 97 and byte <= 122) or(byte >= 48 and byte <= 57) or byte == 95):
            return false
    return true

fn native_library_arguments(package: PackageInfo) -> Array[String]:
    var result: Array[String] = []
    for index in 0..collections.length(package.native_libraries):
        let library = package.native_libraries[index]
        if package.target_alias == "macos-arm64" and string.starts_with(library, "framework:"):
            let framework = string.slice(library, 10, string.byte_length(library))
            if safe_framework_name(framework):
                result = append(result, "-framework")
                result = append(result, framework)
            else:
                result = append(result, library)
            continue
        var resolved = ""
        if string.contains(library, "/") or string.contains(library, "\\"):
            if safe_manifest_relative_path(library):
                let candidate = std.path.normalize(std.path.join(package.root, library))
                if file.exists(candidate):
                    resolved = candidate
        else:
            for search_index in 0..collections.length(package.native_library_search):
                let candidate = std.path.join(package.native_library_search[search_index], library)
                if resolved == "" and file.exists(candidate):
                    resolved = std.path.normalize(candidate)
            if resolved == "":
                let candidate = std.path.join(package.root, library)
                if file.exists(candidate):
                    resolved = std.path.normalize(candidate)
        if resolved == "":
            let extension = std.path.extension(library)
            if extension == ".lib":
                result = append(result, string.concat("-l", string.slice(library, 0, string.byte_length(library) - 4)))
            else:
                if extension == ".a" and string.starts_with(library, "lib"):
                    result = append(result, string.concat("-l", string.slice(library, 3, string.byte_length(library) - 2)))
                else:
                    if extension == ".so" and string.starts_with(library, "lib"):
                        result = append(result, string.concat("-l", string.slice(library, 3, string.byte_length(library) - 3)))
                    else:
                        if extension == ".dylib" and string.starts_with(library, "lib"):
                            result = append(result, string.concat("-l", string.slice(library, 3, string.byte_length(library) - 6)))
                        else:
                            if extension == "":
                                result = append(result, string.concat("-l", library))
                            else:
                                result = append(result, library)
        else:
            result = append(result, resolved)
    return result

fn build_native_source_with_package(package: PackageInfo, source: String, artifact_directory: String, artifact_name: String, output_kind: Int, target_sdk: String) -> NativeBuildResult:
    if ensure_directory(artifact_directory) != 0:
        return NativeBuildResult(1, "")
    let selected = normalize_target(package.target_alias)
    let toolchain = locate_toolchain_target(selected, target_sdk)
    if not toolchain.valid:
        print(string.concat("rocketc: error[", string.concat(toolchain.error_code, string.concat("]: ", toolchain.error))))
        return NativeBuildResult(2, "")
    let ir = std.path.join(artifact_directory, string.concat(artifact_name, ".ll"))
    let object = std.path.join(artifact_directory, string.concat(artifact_name, target_object_suffix(selected)))
    let artifact = std.path.join(artifact_directory, string.concat(artifact_name, output_extension(output_kind, selected)))
    if write_generated_ir_kind_target(source, package.target_source_root, ir, output_kind != output_executable(), selected) != 0:
        return NativeBuildResult(1, artifact)
    var compile_arguments: Array[String] = ["-c", "-O2", "-Wno-override-module", string.concat("--target=", selected.triple)]
    if toolchain.sysroot != "":
        compile_arguments = append(compile_arguments, string.concat("--sysroot=", toolchain.sysroot))
    compile_arguments = append(compile_arguments, ir)
    compile_arguments = append(compile_arguments, "-o")
    compile_arguments = append(compile_arguments, object)
    let compile_status = direct_process(toolchain.clang, compile_arguments)
    if compile_status != 0:
        report_external_command_failure("compile", toolchain.clang, compile_arguments, compile_status)
        return NativeBuildResult(1, artifact)
    if output_kind == output_static_library():
        var librarian_arguments: Array[String] = ["rcsD", artifact, object]
        if selected.os == "windows":
            librarian_arguments = ["/nologo", string.concat("/OUT:", artifact), object]
        let librarian_status = direct_process(toolchain.librarian, librarian_arguments)
        if librarian_status != 0:
            report_external_command_failure("archive", toolchain.librarian, librarian_arguments, librarian_status)
            return NativeBuildResult(1, artifact)
        return NativeBuildResult(0, artifact)
    var link_arguments: Array[String] = [object, toolchain.runtime, string.concat("--target=", selected.triple), "-fuse-ld=lld"]
    if output_kind == output_dynamic_library():
        link_arguments = ["-shared", object, toolchain.runtime, string.concat("--target=", selected.triple), "-fuse-ld=lld"]
    if toolchain.sysroot != "":
        link_arguments = append(link_arguments, string.concat("--sysroot=", toolchain.sysroot))
    if selected.os == "windows":
        link_arguments = append(link_arguments, "-Wl,/Brepro")
        link_arguments = append(link_arguments, "-Wl,/DEBUG:FULL")
        link_arguments = append(link_arguments, string.concat("-Wl,/PDB:", std.path.join(artifact_directory, string.concat(artifact_name, ".pdb"))))
    else:
        if selected.os == "linux":
            link_arguments = append(link_arguments, "-Wl,--build-id=sha1")
        else:
            link_arguments = append(link_arguments, "-Wl,-no_uuid")
    for index in 0..collections.length(toolchain.library_directories):
        link_arguments = append(link_arguments, "-L")
        link_arguments = append(link_arguments, toolchain.library_directories[index])
        if native_target().alias == selected.alias and selected.os != "windows":
            link_arguments = append(link_arguments, string.concat("-Wl,-rpath,", toolchain.library_directories[index]))
    for index in 0..collections.length(package.native_library_search):
        link_arguments = append(link_arguments, "-L")
        link_arguments = append(link_arguments, package.native_library_search[index])
    link_arguments = collections.concat(link_arguments, native_library_arguments(package))
    if selected.os == "linux":
        link_arguments = collections.concat(link_arguments, ["-lcurl", "-lcrypto", "-licuuc", "-licudata", "-lpthread", "-ldl", "-lstdc++", "-lm"])
    if selected.os == "macos":
        link_arguments = collections.concat(link_arguments, ["-lcurl", "-lcrypto", "-licuuc", "-licudata", "-lpthread", "-lc++", "-lm", "-framework", "Security", "-framework", "CoreFoundation"])
    link_arguments = append(link_arguments, "-o")
    link_arguments = append(link_arguments, artifact)
    let link_status = direct_process(toolchain.clang, link_arguments)
    if link_status != 0:
        report_external_command_failure("link", toolchain.clang, link_arguments, link_status)
        return NativeBuildResult(1, artifact)
    return NativeBuildResult(0, artifact)

fn build_native_source(source: String, artifact_directory: String, artifact_name: String) -> NativeBuildResult:
    let root = source_parent(std.path.normalize(source))
    let host = native_target()
    let package = PackageInfo(true, root, source, std.path.join(root, "tests"), artifact_name, output_executable(), artifact_name, [], [], [], host.alias, host.triple, "", "")
    return build_native_source_with_package(package, source, artifact_directory, artifact_name, output_executable(), "")

fn check_command(input: String) -> Int:
    return check_command_target(input, native_target())

fn check_command_target(input: String, selected_target: TargetInfo) -> Int:
    let package = resolve_package_target(input, selected_target)
    if not package.valid:
        print(string.concat("rocketc: error[R5001]: ", package.error))
        return 1
    let result = analyze_program_kind_target(package.entry, package.target_source_root, package.output_kind != output_executable())
    if collections.length(result.diagnostics) != 0:
        for index in 0..collections.length(result.diagnostics):
            print(diagnostic_text(package.entry, result.diagnostics[index]))
        return 1
    print(string.concat(package.entry, ": check succeeded"))
    return 0

fn build_command(input: String) -> NativeBuildResult:
    return build_command_target(input, native_target(), "")

fn build_command_target(input: String, selected_target: TargetInfo, target_sdk: String) -> NativeBuildResult:
    let package = resolve_package_target(input, selected_target)
    if not package.valid:
        print(string.concat("rocketc: error[R5001]: ", package.error))
        return NativeBuildResult(1, "")
    let cache_key = build_cache_key(package, target_sdk)
    if package_build_cache_hit(package, cache_key):
        let artifact = package_artifact_path(package)
        print(string.concat("built ", string.concat(artifact, " (cache hit)")))
        return NativeBuildResult(0, artifact)
    let result = build_native_source_with_package(package, package.entry, package_artifact_directory(package), package.output_name, package.output_kind, target_sdk)
    if result.status == 0:
        if package.output_kind != output_executable():
            let header = std.path.join(package_artifact_directory(package), string.concat(package.output_name, ".h"))
            if emit_header_command(input, header) != 0:
                return NativeBuildResult(1, result.executable)
        if cache_key != "":
            let cached = file.write_text(package_cache_marker(package), string.concat(cache_key, "\n"))
            match cached:
                case Ok(success):
                    let ignored = success
                case Err(error):
                    let ignored = error
        print(string.concat("built ", result.executable))
    return result

fn run_command(arguments: Array[String]) -> Int:
    if collections.length(arguments) < 2:
        print("rocketc: error[R5002]: run expects a source file or package")
        return 1
    return run_command_target(arguments, arguments[1], native_target(), "")

fn run_command_target(arguments: Array[String], input: String, selected_target: TargetInfo, target_sdk: String) -> Int:
    let package = resolve_package_target(input, selected_target)
    if not package.valid:
        print(string.concat("rocketc: error[R5001]: ", package.error))
        return 1
    if package.output_kind != output_executable():
        print("rocketc: error[R5002]: run requires an executable package")
        return 1
    let built = build_command_target(input, selected_target, target_sdk)
    if built.status != 0:
        return built.status
    var program_arguments: Array[String] = []
    var after_separator = false
    for index in 2..collections.length(arguments):
        if arguments[index] == "--" and not after_separator:
            after_separator = true
        else:
            if after_separator:
                program_arguments = append(program_arguments, arguments[index])
    return direct_process(built.executable, program_arguments)

fn right_trim_line(value: String) -> String:
    var end = string.byte_length(value)
    while end > 0:
        let last = string.byte_at(value, end - 1)
        if last == ' ' or last == '\t' or last == '\r':
            end = end - 1
        else:
            break
    return string.slice(value, 0, end)

fn formatter_word(kind: Int) -> Bool:
    return kind == kind_identifier() or kind == kind_integer() or kind == kind_float() or kind == kind_character() or kind == kind_string() or kind == kind_impl() or kind == kind_trait() or kind == kind_where() or kind == kind_const() or(kind >= kind_fn() and kind <= kind_import()) or(kind >= kind_unsafe() and kind <= kind_callback())

fn formatter_binary(kind: Int) -> Bool:
    return kind == kind_plus() or kind == kind_minus() or kind == kind_star() or kind == kind_slash() or kind == kind_equal() or kind == kind_equal_equal() or kind == kind_bang_equal() or kind == kind_less() or kind == kind_less_equal() or kind == kind_greater() or kind == kind_greater_equal() or kind == kind_arrow() or kind == kind_fat_arrow() or kind == kind_and() or kind == kind_or()

fn formatter_prefix_context(kind: Int) -> Bool:
    return kind == kind_lparen() or kind == kind_lbracket() or kind == kind_comma() or kind == kind_equal() or kind == kind_colon() or kind == kind_return() or kind == kind_in() or formatter_binary(kind)

fn formatter_unary_minus(tokens: Array[Token], index: Int) -> Bool:
    if tokens[index].kind != kind_minus():
        return false
    return index == 0 or formatter_prefix_context(tokens[index - 1].kind)

fn formatter_needs_space(tokens: Array[Token], index: Int) -> Bool:
    if index == 0:
        return false
    let current = tokens[index].kind
    let previous = tokens[index - 1].kind
    if current == kind_rparen() or current == kind_rbracket() or current == kind_comma() or current == kind_colon() or current == kind_dot() or current == kind_dotdot() or current == kind_question():
        return false
    if previous == kind_lparen() or previous == kind_lbracket() or previous == kind_dot() or previous == kind_dotdot():
        return false
    if current == kind_identifier() and previous == kind_rbracket() and collections.length(tokens) > 0 and tokens[0].kind == kind_impl():
        return true
    if current == kind_lparen():
        return false
    if current == kind_lbracket() and(formatter_word(previous) or previous == kind_rparen() or previous == kind_rbracket() or previous == kind_question()):
        return false
    if previous == kind_comma() or previous == kind_colon():
        return true
    if formatter_unary_minus(tokens, index):
        return true
    if formatter_unary_minus(tokens, index - 1):
        return false
    if formatter_binary(current) or formatter_binary(previous):
        return true
    if current == kind_not() or previous == kind_not():
        return true
    return formatter_word(previous) and formatter_word(current)

fn formatter_escape(value: String, quote: Char) -> String:
    let builder = string.builder()
    string.builder_append(builder, string.slice("\"'", 0, 1))
    if quote == '\'':
        let initial = string.builder()
        string.builder_append(initial, "'")
        for index in 0..string.byte_length(value):
            let character = string.byte_at(value, index)
            if character == '\\':
                string.builder_append(initial, "\\\\")
            else:
                if character == '\'':
                    string.builder_append(initial, "\\'")
                else:
                    if character == '\n':
                        string.builder_append(initial, "\\n")
                    else:
                        if character == '\r':
                            string.builder_append(initial, "\\r")
                        else:
                            if character == '\t':
                                string.builder_append(initial, "\\t")
                            else:
                                string.builder_append(initial, string.slice(value, index, index + 1))
        string.builder_append(initial, "'")
        return string.builder_finish(initial)
    for index in 0..string.byte_length(value):
        let character = string.byte_at(value, index)
        if character == '\\':
            string.builder_append(builder, "\\\\")
        else:
            if character == '"':
                string.builder_append(builder, "\\\"")
            else:
                if character == '\n':
                    string.builder_append(builder, "\\n")
                else:
                    if character == '\r':
                        string.builder_append(builder, "\\r")
                    else:
                        if character == '\t':
                            string.builder_append(builder, "\\t")
                        else:
                            string.builder_append(builder, string.slice(value, index, index + 1))
    string.builder_append(builder, "\"")
    return string.builder_finish(builder)

fn formatter_spelling(token: Token) -> String:
    if token.kind == kind_string():
        return formatter_escape(token.text, '"')
    if token.kind == kind_character():
        return formatter_escape(token.text, '\'')
    return token.text

fn formatter_comment_offset(line: String) -> Int:
    var in_string = false
    var in_character = false
    var escaped = false
    for index in 0..string.byte_length(line):
        let value = string.byte_at(line, index)
        if escaped:
            escaped = false
        else:
            if(in_string or in_character) and value == '\\':
                escaped = true
            else:
                if not in_character and value == '"':
                    in_string = not in_string
                else:
                    if not in_string and value == '\'':
                        in_character = not in_character
                    else:
                        if not in_string and not in_character and value == '#':
                            return index
    return -1

fn formatter_spaces(count: Int) -> String:
    let builder = string.builder()
    for index in 0..count:
        string.builder_append(builder, " ")
    return string.builder_finish(builder)

fn formatter_line_tokens(tokens: Array[Token], line: Int) -> Array[Token]:
    var result: Array[Token] = []
    for index in 0..collections.length(tokens):
        let token = tokens[index]
        if token.line == line and token.kind != kind_indent() and token.kind != kind_dedent() and token.kind != kind_newline() and token.kind != kind_end():
            result = append(result, token)
    return result

fn canonical_format(source: String, tokens: Array[Token]) -> String:
    var lines = string.split(source, "\n")
    if collections.length(lines) > 0 and lines[collections.length(lines) - 1] == "":
        lines = prefix(lines, collections.length(lines) - 1)
    let output = string.builder()
    for line_index in 0..collections.length(lines):
        let original = right_trim_line(lines[line_index])
        var leading = 0
        while leading < string.byte_length(original) and string.byte_at(original, leading) == ' ':
            leading = leading + 1
        let comment = formatter_comment_offset(original)
        let line_tokens = formatter_line_tokens(tokens, line_index + 1)
        if collections.length(line_tokens) > 0:
            string.builder_append(output, formatter_spaces(leading / 4 * 4))
            for token_index in 0..collections.length(line_tokens):
                if formatter_needs_space(line_tokens, token_index):
                    string.builder_append(output, " ")
                string.builder_append(output, formatter_spelling(line_tokens[token_index]))
            if comment >= 0:
                string.builder_append(output, "  ")
                string.builder_append(output, right_trim_line(string.slice(original, comment, string.byte_length(original))))
        else:
            if comment >= 0:
                string.builder_append(output, formatter_spaces(leading / 4 * 4))
                string.builder_append(output, right_trim_line(string.slice(original, comment, string.byte_length(original))))
        string.builder_append(output, "\n")
    if collections.length(lines) == 0:
        string.builder_append(output, "\n")
    return string.builder_finish(output)

fn format_file(source_path: String, check_only: Bool) -> Int:
    let loaded = file.read_text(source_path)
    match loaded:
        case Err(error):
            print(string.concat("rocketc: error[R5002]: ", error))
            return 1
        case Ok(source):
            let lexed = lex_source(source)
            if collections.length(lexed.diagnostics) != 0:
                for index in 0..collections.length(lexed.diagnostics):
                    print(diagnostic_text(source_path, lexed.diagnostics[index]))
                return 1
            let formatted = canonical_format(source, lexed.tokens)
            if check_only:
                if formatted != source:
                    print(string.concat(source_path, ": formatting differs"))
                    return 1
                return 0
            let written = file.write_text(source_path, formatted)
            match written:
                case Ok(value):
                    return 0
                case Err(error):
                    print(string.concat("rocketc: error[R5002]: ", error))
                    return 1

fn format_command(input: String, check_only: Bool) -> Int:
    let package = resolve_package(input)
    if not package.valid:
        print(string.concat("rocketc: error[R5001]: ", package.error))
        return 1
    var failures = format_file(package.entry, check_only)
    if file.exists(package.test_directory):
        let listed = file.list(package.test_directory)
        match listed:
            case Ok(entries):
                for index in 0..collections.length(entries):
                    if std.path.extension(entries[index]) == ".rocket":
                        failures = failures + format_file(std.path.join(package.test_directory, entries[index]), check_only)
            case Err(error):
                print(string.concat("rocketc: error[R5002]: ", error))
                failures = failures + 1
    if failures == 0:
        if check_only:
            print("format check succeeded")
        else:
            print("format succeeded")
        return 0
    return 1

fn test_command(input: String, filter: String) -> Int:
    return test_command_target(input, filter, native_target(), "")

fn test_command_target(input: String, filter: String, selected_target: TargetInfo, target_sdk: String) -> Int:
    let package = resolve_package_target(input, selected_target)
    if not package.valid:
        print(string.concat("rocketc: error[R5001]: ", package.error))
        return 1
    if not file.exists(package.test_directory):
        print("rocketc: error[R5002]: package test directory does not exist")
        return 1
    let listed = file.list(package.test_directory)
    match listed:
        case Err(error):
            print(string.concat("rocketc: error[R5002]: ", error))
            return 1
        case Ok(entries):
            var passed = 0
            var failed = 0
            var expected_failures = 0
            var selected = 0
            let artifact_directory = std.path.join(package_artifact_directory(package), "tests")
            for index in 0..collections.length(entries):
                if std.path.extension(entries[index]) == ".rocket" and(filter == "" or string.contains(entries[index], filter)):
                    selected = selected + 1
                    let source = std.path.join(package.test_directory, entries[index])
                    let built = build_native_source_with_package(package, source, artifact_directory, string.concat("test-", string.from_int(index)), output_executable(), target_sdk)
                    let expected_failure = string.ends_with(entries[index], ".xfail.rocket")
                    if built.status != 0:
                        failed = failed + 1
                    else:
                        let status = direct_process(built.executable, [])
                        if expected_failure and status != 0:
                            expected_failures = expected_failures + 1
                        else:
                            if expected_failure:
                                failed = failed + 1
                            else:
                                if status == 0:
                                    passed = passed + 1
                                else:
                                    failed = failed + 1
            if selected == 0:
                print("rocketc: error[R5002]: test filter selected no .rocket files")
                return 2
            print(string.concat(string.from_int(passed), string.concat(" passed; ", string.concat(string.from_int(failed), string.concat(" failed; ", string.concat(string.from_int(expected_failures), " expected failure(s)"))))))
            if failed == 0:
                return 0
            return 1

fn new_command(directory: String) -> Int:
    let root = std.path.normalize(directory)
    if file.exists(std.path.join(root, "rocket.toml")):
        print("rocketc: error[R5001]: rocket.toml already exists")
        return 1
    if ensure_directory(std.path.join(root, "src")) != 0 or ensure_directory(std.path.join(root, "tests")) != 0:
        return 1
    let name = std.path.basename(root)
    let manifest = string.concat("[package]\nname = \"", string.concat(name, string.concat("\"\nversion = \"0.1.0\"\nentry = \"src/main.rocket\"\n\n[test]\ndirectory = \"tests\"\n\n[build]\nkind = \"executable\"\nname = \"", string.concat(name, "\"\n"))))
    let main_source = "fn main() -> Int:\n    print(\"Hello from Rocket\")\n    return 0\n"
    let test_source = "fn main() -> Int:\n    return 0\n"
    let manifest_written = file.write_text(std.path.join(root, "rocket.toml"), manifest)
    let main_written = file.write_text(std.path.join(root, "src/main.rocket"), main_source)
    let test_written = file.write_text(std.path.join(root, "tests/basic.rocket"), test_source)
    match manifest_written:
        case Err(error):
            print(string.concat("rocketc: error[R5002]: ", error))
            return 1
        case Ok(value):
            match main_written:
                case Err(error):
                    print(string.concat("rocketc: error[R5002]: ", error))
                    return 1
                case Ok(value):
                    match test_written:
                        case Err(error):
                            print(string.concat("rocketc: error[R5002]: ", error))
                            return 1
                        case Ok(value):
                            print(string.concat("created ", root))
                            return 0

fn emit_assembly_command(input: String, output: String) -> Int:
    let package = resolve_package(input)
    if not package.valid:
        print(string.concat("rocketc: error[R5001]: ", package.error))
        return 1
    let toolchain = locate_toolchain()
    if not toolchain.valid:
        print(string.concat("rocketc: error[R5002]: ", toolchain.error))
        return 1
    let temporary_ir = string.concat(output, ".ll")
    if write_generated_ir_kind(package.entry, temporary_ir, package.output_kind != output_executable()) != 0:
        return 1
    return direct_process(toolchain.clang, ["-S", "-O2", "-Wno-override-module", temporary_ir, "-o", output])

fn package_stage0_path() -> String:
    let configured = environment_or_empty("ROCKET_STAGE0")
    if configured != "" and file.exists(configured):
        return std.path.normalize(configured)
    let executable = process.executable_path()
    match executable:
        case Err(error):
            return ""
        case Ok(path_value):
            let executable_directory = source_parent(std.path.normalize(path_value))
            let packaged = std.path.normalize(std.path.join(source_parent(executable_directory), string.concat("stage0/rocketc-stage0", host_tool_suffix())))
            if file.exists(packaged):
                return packaged
            let repository_root = source_parent(source_parent(executable_directory))
            let release = first_existing([std.path.normalize(std.path.join(repository_root, std.path.join(string.concat("out/build/", string.concat(native_target().alias, "-release")), string.concat("rocketc", host_tool_suffix())))), std.path.normalize(std.path.join(repository_root, std.path.join(string.concat("out/build/", string.concat(native_target().os, "-release")), string.concat("rocketc", host_tool_suffix()))))])
            if file.exists(release):
                return release
            let debug = first_existing([std.path.normalize(std.path.join(repository_root, std.path.join(string.concat("out/build/", string.concat(native_target().alias, "-debug")), string.concat("rocketc", host_tool_suffix())))), std.path.normalize(std.path.join(repository_root, std.path.join(string.concat("out/build/", string.concat(native_target().os, "-debug")), string.concat("rocketc", host_tool_suffix()))))])
            if file.exists(debug):
                return debug
    return ""

fn forward_package_command(arguments: Array[String]) -> Int:
    let stage0 = package_stage0_path()
    if stage0 == "":
        print("rocketc: error[R5002]: the self-hosted package security host is unavailable; set ROCKET_STAGE0 or install the packaged stage0 compiler")
        return 1
    let invoked = process.run(stage0, arguments)
    match invoked:
        case Ok(status):
            return status
        case Err(error):
            print(string.concat("rocketc: error[R5002]: could not start the package security host: ", error))
            return 1

fn verify_package_graph(input: String) -> Int:
    let normalized = std.path.normalize(input)
    if std.path.extension(normalized) == ".rocket" or not file.exists(std.path.join(normalized, "rocket.toml")):
        return 0
    let stage0 = package_stage0_path()
    if stage0 == "":
        print("rocketc: error[R5002]: the self-hosted package security host is unavailable; set ROCKET_STAGE0 or install the packaged stage0 compiler")
        return 1
    let verified = process.run(stage0, ["--verify-package-lock", normalized])
    match verified:
        case Ok(status):
            return status
        case Err(error):
            print(string.concat("rocketc: error[R5002]: could not verify the exact package graph: ", error))
            return 1

fn print_help() -> Unit:
    print("Rocket compiler 2.1.0")
    print("usage: rocketc <check|build|run|test|fmt|new|resolve|tree|audit|doc|coverage|profile|benchmark|login|logout|publish|registry|emit-ir|emit-asm|emit-header|bind|target> [arguments]")
    print("  check <path>        parse and type-check a source file or package")
    print("  build <path> [--target alias-or-triple] [--target-sdk directory] build a target-qualified artifact")
    print("  run <path> -- ...   build and run with optional arguments")
    print("  test <package> [--filter text] build and run package tests")
    print("  fmt <path> [--check] format or verify source formatting")
    print("  resolve <package> [--locked|--offline] resolve the exact dependency graph")
    print("  tree|audit|doc <package> inspect, audit, or document dependencies")
    print("  login|logout|publish|registry ... authenticated package workflows")
    print("  emit-header <package> [--output output.h] generate a deterministic C header")
    print("  bind <header.h> [--output bindings.rocket] generate deterministic Rocket bindings")
    print("  target [--target alias-or-triple] [--verbose] inspect host and target")

fn lexer_self_test() -> Int:
    let source = "fn main() -> Int:\r\n    let text = \"Rocket\\n\"\r\n    return 0\r\n"
    let result = lex_source(source)
    if collections.length(result.diagnostics) != 0:
        return 1
    if collections.length(result.tokens) != 19:
        return 2
    if result.tokens[0].kind != kind_fn() or result.tokens[0].text != "fn":
        return 3
    if result.tokens[8].kind != kind_indent():
        return 4
    if result.tokens[12].kind != kind_string() or result.tokens[12].text != "Rocket\n":
        return 5
    if result.tokens[17].kind != kind_dedent() or result.tokens[18].kind != kind_end():
        return 6
    return 0

fn main() -> Int:
    let arguments = process.arguments()
    if collections.length(arguments) > 0 and arguments[0] == "target":
        return target_command(arguments)
    if collections.length(arguments) == 1 and arguments[0] == "--self-test-lexer":
        let status = lexer_self_test()
        if status == 0:
            print("self-hosted lexer tests passed")
        return status
    if collections.length(arguments) == 1 and arguments[0] == "--self-test-parser":
        let status = parser_self_test()
        if status == 0:
            print("self-hosted parser tests passed")
        return status
    if collections.length(arguments) == 2 and arguments[0] == "--check-syntax":
        return syntax_check(arguments[1])
    if collections.length(arguments) == 2 and arguments[0] == "--check-hir":
        return hir_check(arguments[1])
    if collections.length(arguments) == 2 and arguments[0] == "--check-mir":
        return mir_check(arguments[1])
    if collections.length(arguments) == 3 and arguments[0] == "--emit-ir":
        return emit_ir_file(arguments[1], arguments[2])
    if collections.length(arguments) == 0 or(collections.length(arguments) == 1 and arguments[0] == "--help"):
        print_help()
        return 0
    if collections.length(arguments) == 1 and arguments[0] == "--version":
        print("rocketc 2.1.0")
        return 0
    if collections.length(arguments) > 0 and contains_string(["coverage", "profile", "benchmark"], arguments[0]):
        return forward_package_command(arguments)
    if contains_string(arguments, "--message-format=json") or contains_string(arguments, "--debug"):
        return forward_package_command(arguments)
    if collections.length(arguments) > 0 and contains_string(["resolve", "tree", "audit", "doc", "login", "logout", "publish", "registry"], arguments[0]):
        return forward_package_command(arguments)
    if collections.length(arguments) > 0 and contains_string(["check", "build", "run", "test"], arguments[0]):
        let options = parse_target_command_options(arguments, arguments[0] == "test")
        if not options.valid:
            print(string.concat("rocketc: error[", string.concat(options.error_code, string.concat("]: ", options.error))))
            return 2
        let verified = verify_package_graph(options.input)
        if verified != 0:
            return verified
        if arguments[0] == "check":
            return check_command_target(options.input, options.selected_target)
        if arguments[0] == "build":
            let available = ensure_target_build_available(options.selected_target, options.target_sdk)
            if available != 0:
                return available
            return build_command_target(options.input, options.selected_target, options.target_sdk).status
        if arguments[0] == "run":
            let executable = ensure_target_execution_available(options.selected_target, false)
            if executable != 0:
                return executable
            return run_command_target(arguments, options.input, options.selected_target, options.target_sdk)
        let tests = ensure_target_execution_available(options.selected_target, true)
        if tests != 0:
            return tests
        return test_command_target(options.input, options.filter, options.selected_target, options.target_sdk)
    if collections.length(arguments) >= 2 and collections.length(arguments) <= 3 and arguments[0] == "fmt":
        var check_only = false
        if collections.length(arguments) == 3 and arguments[2] == "--check":
            check_only = true
        return format_command(arguments[1], check_only)
    if collections.length(arguments) == 2 and arguments[0] == "new":
        return new_command(arguments[1])
    if collections.length(arguments) == 3 and arguments[0] == "emit-ir":
        let package = resolve_package(arguments[1])
        if not package.valid:
            print(string.concat("rocketc: error[R5001]: ", package.error))
            return 1
        let status = write_generated_ir_kind(package.entry, arguments[2], package.output_kind != output_executable())
        if status == 0:
            print(string.concat("emitted self-hosted LLVM IR to ", arguments[2]))
        return status
    if collections.length(arguments) == 3 and arguments[0] == "emit-asm":
        return emit_assembly_command(arguments[1], arguments[2])
    if collections.length(arguments) == 2 and arguments[0] == "emit-header":
        return emit_header_command(arguments[1], "")
    if collections.length(arguments) == 4 and arguments[0] == "emit-header" and arguments[2] == "--output":
        return emit_header_command(arguments[1], arguments[3])
    if collections.length(arguments) == 2 and arguments[0] == "bind":
        return bind_command(arguments[1], "")
    if collections.length(arguments) == 4 and arguments[0] == "bind" and arguments[2] == "--output":
        return bind_command(arguments[1], arguments[3])
    print("rocketc: error[R5002]: unknown or incomplete command; use --help")
    return 1
