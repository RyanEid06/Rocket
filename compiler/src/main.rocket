fn find_struct_index(module: AstModule, name: String) -> Int:
    for index in 0..collections.length(module.structs):
        if module.structs[index].name == name:
            return index
    return -1

fn find_enum_index(module: AstModule, name: String) -> Int:
    for index in 0..collections.length(module.enums):
        if module.enums[index].name == name:
            return index
    return -1

fn structurally_transferable_seen(module: AstModule, type_name: String, sharing: Bool, visiting: Array[String]) -> Bool:
    if type_name == "<invalid>":
        return false
    if type_name == "Int" or type_name == "Float" or type_name == "Bool" or type_name == "Char" or type_name == "Unit" or type_name == "String":
        return true
    if is_native_type(module, type_name) or type_name == "std.string.Builder":
        return false
    let base = type_base(type_name)
    if base == "std.cancel.CancellationToken" or base == "std.sync.Mutex" or base == "std.sync.Event" or base == "std.sync.AtomicInt" or base == "std.sync.Once" or base == "std.channel.Channel" or base == "std.channel.Sender" or base == "std.channel.Receiver":
        return true
    if base == "std.sync.LockGuard":
        return false
    var key = string.concat("send:", type_name)
    if sharing:
        key = string.concat("share:", type_name)
    for index in 0..collections.length(visiting):
        if visiting[index] == key:
            return true
    let next_visiting = append(visiting, key)
    let arguments = type_arguments(type_name)
    if base == "UniqueBuffer":
        if sharing or collections.length(arguments) != 1:
            return false
        return structurally_transferable_seen(module, arguments[0], true, next_visiting)
    if base == "Array" or base == "Slice":
        return collections.length(arguments) == 1 and structurally_transferable_seen(module, arguments[0], sharing, next_visiting)
    if base == "Weak":
        return collections.length(arguments) == 1 and structurally_transferable_seen(module, arguments[0], true, next_visiting)
    if base == "Task":
        return not sharing and collections.length(arguments) == 1 and structurally_transferable_seen(module, arguments[0], false, next_visiting)
    if base == "std.thread.Thread":
        return not sharing and collections.length(arguments) == 1 and structurally_transferable_seen(module, arguments[0], false, next_visiting)
    let structure_index = find_struct_index(module, base)
    if structure_index >= 0:
        let declaration = module.structs[structure_index]
        if declaration.representation != representation_rocket():
            return false
        var substitutions = Substitutions([], [])
        substitutions = infer_type(make_type(declaration.name, declaration.type_parameters), type_name, declaration.type_parameters, substitutions)
        for field_index in 0..collections.length(declaration.fields):
            if not structurally_transferable_seen(module, substitute_type(declaration.fields[field_index].type_name, substitutions), sharing, next_visiting):
                return false
        return true
    let enum_index = find_enum_index(module, base)
    if enum_index >= 0:
        let declaration = module.enums[enum_index]
        var substitutions = Substitutions([], [])
        substitutions = infer_type(make_type(declaration.name, declaration.type_parameters), type_name, declaration.type_parameters, substitutions)
        for variant_index in 0..collections.length(declaration.variants):
            for payload_index in 0..collections.length(declaration.variants[variant_index].payload_types):
                if not structurally_transferable_seen(module, substitute_type(declaration.variants[variant_index].payload_types[payload_index], substitutions), sharing, next_visiting):
                    return false
        return true
    return false

fn is_send_type(module: AstModule, type_name: String) -> Bool:
    var visiting: Array[String] = []
    return structurally_transferable_seen(module, type_name, false, visiting)

fn is_share_type(module: AstModule, type_name: String) -> Bool:
    var visiting: Array[String] = []
    return structurally_transferable_seen(module, type_name, true, visiting)

fn is_move_only_type_seen(module: AstModule, type_name: String, visiting: Array[String]) -> Bool:
    let base = type_base(type_name)
    if base == "UniqueBuffer" or base == "Task" or base == "std.sync.LockGuard" or base == "std.task.TaskGroup" or base == "std.thread.Thread":
        return true
    if type_name == "<invalid>" or base == "Int" or base == "Float" or base == "Bool" or base == "Char" or base == "Unit" or base == "String" or base == "Weak" or base == "Pointer" or base == "std.string.Builder" or base == "std.cancel.CancellationToken" or base == "std.sync.Mutex" or base == "std.sync.Event" or base == "std.sync.AtomicInt" or base == "std.sync.Once" or base == "std.channel.Channel" or base == "std.channel.Sender" or base == "std.channel.Receiver":
        return false
    let arguments = type_arguments(type_name)
    if base == "Array" or base == "Slice" or base == "Option" or base == "Result":
        for argument_index in 0..collections.length(arguments):
            if is_move_only_type_seen(module, arguments[argument_index], visiting):
                return true
        return false
    var already_visiting = false
    for visit_index in 0..collections.length(visiting):
        if visiting[visit_index] == type_name:
            already_visiting = true
    if already_visiting:
        return false
    let next_visiting = append(visiting, type_name)
    let structure_index = find_struct_index(module, base)
    if structure_index >= 0:
        let declaration = module.structs[structure_index]
        var substitutions = Substitutions([], [])
        substitutions = infer_type(make_type(declaration.name, declaration.type_parameters), type_name, declaration.type_parameters, substitutions)
        for field_index in 0..collections.length(declaration.fields):
            if is_move_only_type_seen(module, substitute_type(declaration.fields[field_index].type_name, substitutions), next_visiting):
                return true
        return false
    let enum_index = find_enum_index(module, base)
    if enum_index >= 0:
        let declaration = module.enums[enum_index]
        var substitutions = Substitutions([], [])
        substitutions = infer_type(make_type(declaration.name, declaration.type_parameters), type_name, declaration.type_parameters, substitutions)
        for variant_index in 0..collections.length(declaration.variants):
            for payload_index in 0..collections.length(declaration.variants[variant_index].payload_types):
                if is_move_only_type_seen(module, substitute_type(declaration.variants[variant_index].payload_types[payload_index], substitutions), next_visiting):
                    return true
    return false

fn is_move_only_type(module: AstModule, type_name: String) -> Bool:
    var visiting: Array[String] = []
    return is_move_only_type_seen(module, type_name, visiting)

fn type_spelling_may_move(type_name: String) -> Bool:
    return string.contains(type_name, "UniqueBuffer[") or string.contains(type_name, "Task[") or string.contains(type_name, "std.sync.LockGuard[") or string.contains(type_name, "std.task.TaskGroup[") or string.contains(type_name, "std.thread.Thread[")

fn module_may_move(module: AstModule) -> Bool:
    for import_index in 0..collections.length(module.imports):
        let name = module.imports[import_index].name
        if name == "std.buffer" or name == "std.task" or name == "std.thread" or name == "std.sync" or string.starts_with(name, "std.async_"):
            return true
    for struct_index in 0..collections.length(module.structs):
        let declaration = module.structs[struct_index]
        for field_index in 0..collections.length(declaration.fields):
            if type_spelling_may_move(declaration.fields[field_index].type_name):
                return true
    for enum_index in 0..collections.length(module.enums):
        let declaration = module.enums[enum_index]
        for variant_index in 0..collections.length(declaration.variants):
            for payload_index in 0..collections.length(declaration.variants[variant_index].payload_types):
                if type_spelling_may_move(declaration.variants[variant_index].payload_types[payload_index]):
                    return true
    for trait_index in 0..collections.length(module.traits):
        let declaration = module.traits[trait_index]
        for method_index in 0..collections.length(declaration.methods):
            let method = declaration.methods[method_index]
            if type_spelling_may_move(method.result_type):
                return true
            for parameter_index in 0..collections.length(method.parameters):
                if type_spelling_may_move(method.parameters[parameter_index].type_name):
                    return true
    for function_index in 0..collections.length(module.functions):
        let function = module.functions[function_index]
        if function.asynchronous or type_spelling_may_move(function.result_type):
            return true
        for parameter_index in 0..collections.length(function.parameters):
            if type_spelling_may_move(function.parameters[parameter_index].type_name):
                return true
    return false

fn find_function_index(module: AstModule, name: String) -> Int:
    for index in 0..collections.length(module.functions):
        if module.functions[index].name == name:
            return index
    return -1

fn find_trait_index(module: AstModule, name: String) -> Int:
    for index in 0..collections.length(module.traits):
        if module.traits[index].name == name:
            return index
    return -1

fn trait_owner_matches(function: AstFunction, concrete: String) -> Bool:
    var substitutions = Substitutions([], [])
    substitutions = infer_type(function.method_owner, concrete, function.type_parameters, substitutions)
    return substitute_type(function.method_owner, substitutions) == concrete

fn trait_method_function(module: AstModule, concrete: String, member: String) -> Int:
    var selected = -1
    for index in 0..collections.length(module.functions):
        let function = module.functions[index]
        if function.method_trait != "" and trait_owner_matches(function, concrete):
            let pieces = string.split(function.name, ".")
            if collections.length(pieces) > 0 and pieces[collections.length(pieces) - 1] == member:
                if selected >= 0 and module.functions[selected].method_trait != function.method_trait:
                    return -2
                selected = index
    return selected

fn type_implements_trait(module: AstModule, concrete: String, trait_name: String) -> Bool:
    for index in 0..collections.length(module.functions):
        let function = module.functions[index]
        if function.method_trait == trait_name and trait_owner_matches(function, concrete):
            return true
    return false

fn find_enum_constructor(module: AstModule, name: String) -> EnumConstructor:
    for declaration_index in 0..collections.length(module.enums):
        let declaration = module.enums[declaration_index]
        for variant_index in 0..collections.length(declaration.variants):
            if declaration.variants[variant_index].name == name:
                return EnumConstructor(true, declaration_index, variant_index)
    return EnumConstructor(false, -1, -1)

fn hir_expression(kind: Int, text: String, type_name: String, children: Array[HirExpr], symbol: Int, field: Int, source: AstExpr) -> HirExpr:
    return HirExpr(kind, text, type_name, children, symbol, field, source.line, source.column)

fn lower_array_expression(state: LowerState, expression: AstExpr, expected: String) -> HirExprResult:
    var next = state
    var element_type = ""
    if is_array_type(expected):
        element_type = collection_element_type(expected)
    var elements: Array[HirExpr] = []
    for index in 0..collections.length(expression.children):
        let lowered = lower_hir_expression(next, expression.children[index], element_type)
        next = lowered.state
        elements = append(elements, lowered.expression)
        if element_type == "":
            element_type = lowered.expression.type_name
        else:
            if lowered.expression.type_name != "<invalid>" and lowered.expression.type_name != element_type:
                next = lower_error(next, expression.children[index].line, expression.children[index].column, "Array elements must have one type")
    if element_type == "":
        next = lower_error(next, expression.line, expression.column, "cannot infer the type of an empty Array")
        element_type = "<invalid>"
    if is_native_type(next.module, element_type):
        next = lower_error(next, expression.line, expression.column, "collections cannot contain native values")
    return HirExprResult(hir_expression(expr_array(), "", make_type("Array", [element_type]), elements, -1, -1, expression), next)

fn find_specialization(state: LowerState, key: String) -> Int:
    for index in 0..collections.length(state.specializations):
        if state.specializations[index].key == key:
            return state.specializations[index].symbol
    return -1

fn specialization_key(name: String, substitutions: Substitutions, parameters: Array[String]) -> String:
    var arguments: Array[String] = []
    for index in 0..collections.length(parameters):
        arguments = append(arguments, substitution_value(substitutions, parameters[index]))
    return string.concat(name, string.concat("[", string.concat(collections.join(arguments, ","), "]")))

fn standard_call(state: LowerState, expression: AstExpr, name: String, signature: StandardSignature, arguments: Array[AstExpr]) -> HirExprResult:
    var next = state
    var substitutions = Substitutions([], [])
    var lowered_arguments: Array[HirExpr] = []
    for index in 0..collections.length(arguments):
        var expected = ""
        if index < collections.length(signature.parameter_types):
            let candidate = substitute_type(signature.parameter_types[index], substitutions)
            if not contains_type_parameter(candidate, signature.type_parameters):
                expected = candidate
        var argument_state = next
        let borrows_buffer = index == 0 and(signature.intrinsic == intrinsic_buffer_length() or signature.intrinsic == intrinsic_buffer_capacity() or signature.intrinsic == intrinsic_buffer_get() or signature.intrinsic == intrinsic_sync_guard_get() or signature.intrinsic == intrinsic_sync_guard_set() or signature.intrinsic == intrinsic_task_is_complete() or signature.intrinsic == intrinsic_task_cancel() or signature.intrinsic == intrinsic_task_group_cancel() or signature.intrinsic == intrinsic_thread_is_complete())
        if borrows_buffer:
            argument_state = state_borrowing_unique(argument_state, true)
        let lowered = lower_hir_expression(argument_state, arguments[index], expected)
        next = lowered.state
        if borrows_buffer:
            next = state_borrowing_unique(next, false)
        lowered_arguments = append(lowered_arguments, lowered.expression)
        if index < collections.length(signature.parameter_types):
            substitutions = infer_type(signature.parameter_types[index], lowered.expression.type_name, signature.type_parameters, substitutions)
    if collections.length(arguments) != collections.length(signature.parameter_types):
        next = lower_error(next, expression.line, expression.column, string.concat("standard function '", string.concat(name, "' has the wrong number of arguments")))
    var parameter_types: Array[String] = []
    for index in 0..collections.length(signature.parameter_types):
        let required = substitute_type(signature.parameter_types[index], substitutions)
        parameter_types = append(parameter_types, required)
        if index < collections.length(lowered_arguments) and required != lowered_arguments[index].type_name:
            next = lower_error(next, arguments[index].line, arguments[index].column, string.concat("argument type is ", string.concat(lowered_arguments[index].type_name, string.concat(", expected ", required))))
    let result_type = substitute_type(signature.result_type, substitutions)
    if signature.intrinsic == intrinsic_collections_map_from_arrays() or signature.intrinsic == intrinsic_collections_map_length() or signature.intrinsic == intrinsic_collections_map_find() or signature.intrinsic == intrinsic_collections_map_get() or signature.intrinsic == intrinsic_collections_map_keys() or signature.intrinsic == intrinsic_collections_map_values():
        if not is_hashable_key(substitution_value(substitutions, "K")):
            next = lower_error(next, expression.line, expression.column, "Map keys must be Int, Bool, Char, or String")
    if signature.intrinsic == intrinsic_collections_set_from_array() or signature.intrinsic == intrinsic_collections_set_contains() or signature.intrinsic == intrinsic_collections_set_values() or signature.intrinsic == intrinsic_collections_hash() or signature.intrinsic == intrinsic_collections_map_hash():
        if not is_hashable_key(substitution_value(substitutions, "T")):
            next = lower_error(next, expression.line, expression.column, "Set elements and hash values must be Int, Bool, Char, or String")
    if signature.intrinsic == intrinsic_collections_contains() or signature.intrinsic == intrinsic_collections_find() or signature.intrinsic == intrinsic_collections_filter_equal():
        if not is_collection_comparable(substitution_value(substitutions, "T")):
            next = lower_error(next, expression.line, expression.column, "collection equality requires Int, Float, Bool, Char, or String")
    if signature.intrinsic == intrinsic_ownership_downgrade() and not is_share_type(next.module, substitution_value(substitutions, "T")):
        next = lower_issue(next, "R4102", expression.line, expression.column, "Weak targets must satisfy Share")
    if signature.intrinsic == intrinsic_sync_mutex() or signature.intrinsic == intrinsic_sync_once() or signature.intrinsic == intrinsic_sync_once_empty() or signature.intrinsic == intrinsic_channel_bounded() or signature.intrinsic == intrinsic_channel_unbounded() or signature.intrinsic == intrinsic_channel_send() or signature.intrinsic == intrinsic_task_group() or signature.intrinsic == intrinsic_thread_spawn():
        let transferred = substitution_value(substitutions, "T")
        let share_value = signature.intrinsic == intrinsic_sync_mutex() or signature.intrinsic == intrinsic_sync_once() or signature.intrinsic == intrinsic_sync_once_empty()
        if(share_value and not is_share_type(next.module, transferred)) or(not share_value and not is_send_type(next.module, transferred)):
            next = lower_issue(next, "R4101", expression.line, expression.column, "concurrency boundary value does not satisfy Send/Share")
    if signature.intrinsic == intrinsic_buffer_thaw() and not is_share_type(next.module, substitution_value(substitutions, "T")):
        next = lower_issue(next, "R4101", expression.line, expression.column, "UniqueBuffer element type does not satisfy Share")
    var key = name
    if collections.length(signature.type_parameters) > 0:
        key = specialization_key(name, substitutions, signature.type_parameters)
    var symbol = find_specialization(next, key)
    if symbol < 0:
        let added = add_hir_symbol(next, symbol_builtin(), key, result_type, false, parameter_types, signature.intrinsic)
        symbol = added.symbol
        next = state_specializations(added.state, append(added.state.specializations, Specialization(key, symbol)))
    return HirExprResult(hir_expression(expr_call(), name, result_type, lowered_arguments, symbol, -1, expression), next)

fn struct_call(state: LowerState, expression: AstExpr, declaration_index: Int, arguments: Array[AstExpr], expected_type: String) -> HirExprResult:
    let declaration = state.module.structs[declaration_index]
    var next = state
    if declaration.representation != representation_rocket():
        next = lower_error(next, expression.line, expression.column, "native types cannot be constructed as Rocket values; use an extern function returning a pointer or opaque handle")
        return HirExprResult(hir_expression(expr_call(), declaration.name, "<invalid>", [], -1, -1, expression), next)
    var substitutions = Substitutions([], [])
    if type_base(expected_type) == declaration.name:
        substitutions = infer_type(make_type(declaration.name, declaration.type_parameters), expected_type, declaration.type_parameters, substitutions)
    var lowered_arguments: Array[HirExpr] = []
    for index in 0..collections.length(arguments):
        var expected = ""
        if index < collections.length(declaration.fields):
            let candidate = substitute_type(declaration.fields[index].type_name, substitutions)
            if not contains_type_parameter(candidate, declaration.type_parameters):
                expected = candidate
        let lowered = lower_hir_expression(next, arguments[index], expected)
        next = lowered.state
        lowered_arguments = append(lowered_arguments, lowered.expression)
        if index < collections.length(declaration.fields):
            substitutions = infer_type(declaration.fields[index].type_name, lowered.expression.type_name, declaration.type_parameters, substitutions)
            let required = substitute_type(declaration.fields[index].type_name, substitutions)
            if required != lowered.expression.type_name:
                next = lower_error(next, arguments[index].line, arguments[index].column, string.concat("constructor argument type is ", string.concat(lowered.expression.type_name, string.concat(", expected ", required))))
    if collections.length(arguments) != collections.length(declaration.fields):
        next = lower_error(next, expression.line, expression.column, string.concat("constructor '", string.concat(declaration.name, "' has the wrong number of arguments")))
    var result_type = declaration.name
    if collections.length(declaration.type_parameters) > 0:
        var type_arguments: Array[String] = []
        for index in 0..collections.length(declaration.type_parameters):
            let value = substitution_value(substitutions, declaration.type_parameters[index])
            if value == declaration.type_parameters[index]:
                next = lower_error(next, expression.line, expression.column, string.concat("cannot infer type parameter '", string.concat(value, "'")))
            type_arguments = append(type_arguments, value)
        result_type = make_type(declaration.name, type_arguments)
    if(declaration.name == "std.collections.Map" or declaration.name == "std.collections.Set") and not is_hashable_key(type_arguments(result_type)[0]):
        next = lower_error(next, expression.line, expression.column, "Map and Set keys must be Int, Bool, Char, or String")
    return HirExprResult(hir_expression(expr_call(), "$struct", result_type, lowered_arguments, -1, 0, expression), next)

fn enum_constructor_call(state: LowerState, expression: AstExpr, declaration_index: Int, variant_index: Int, arguments: Array[AstExpr], expected_type: String) -> HirExprResult:
    let declaration = state.module.enums[declaration_index]
    let variant = declaration.variants[variant_index]
    var next = state
    var substitutions = Substitutions([], [])
    if type_base(expected_type) == declaration.name:
        substitutions = infer_type(make_type(declaration.name, declaration.type_parameters), expected_type, declaration.type_parameters, substitutions)
    var lowered_arguments: Array[HirExpr] = []
    for index in 0..collections.length(arguments):
        var expected = ""
        if index < collections.length(variant.payload_types):
            let candidate = substitute_type(variant.payload_types[index], substitutions)
            if not contains_type_parameter(candidate, declaration.type_parameters):
                expected = candidate
        let lowered = lower_hir_expression(next, arguments[index], expected)
        next = lowered.state
        lowered_arguments = append(lowered_arguments, lowered.expression)
        if index < collections.length(variant.payload_types):
            substitutions = infer_type(variant.payload_types[index], lowered.expression.type_name, declaration.type_parameters, substitutions)
            let required = substitute_type(variant.payload_types[index], substitutions)
            if required != lowered.expression.type_name:
                next = lower_error(next, arguments[index].line, arguments[index].column, string.concat("variant argument type is ", string.concat(lowered.expression.type_name, string.concat(", expected ", required))))
    if collections.length(arguments) != collections.length(variant.payload_types):
        next = lower_error(next, expression.line, expression.column, string.concat("variant '", string.concat(variant.name, "' has the wrong number of arguments")))
    var result_type = declaration.name
    if collections.length(declaration.type_parameters) > 0:
        var result_arguments: Array[String] = []
        for index in 0..collections.length(declaration.type_parameters):
            let value = substitution_value(substitutions, declaration.type_parameters[index])
            if value == declaration.type_parameters[index]:
                next = lower_error(next, expression.line, expression.column, string.concat("cannot infer type parameter '", string.concat(value, "'")))
            result_arguments = append(result_arguments, value)
        result_type = make_type(declaration.name, result_arguments)
    return HirExprResult(hir_expression(expr_call(), "$enum", result_type, lowered_arguments, -1, variant_index, expression), next)

fn builtin_enum_constructor_call(state: LowerState, expression: AstExpr, name: String, arguments: Array[AstExpr], expected_type: String) -> HirExprResult:
    var next = state
    var lowered_arguments: Array[HirExpr] = []
    var result_type = expected_type
    var tag = 0
    var expected_payload = ""
    if name == "Some":
        if type_base(expected_type) == "Option":
            expected_payload = collection_element_type(expected_type)
        tag = 0
    if name == "None":
        tag = 1
    if name == "Ok":
        if type_base(expected_type) == "Result":
            let parts = type_arguments(expected_type)
            if collections.length(parts) > 0:
                expected_payload = parts[0]
        tag = 0
    if name == "Err":
        if type_base(expected_type) == "Result":
            let parts = type_arguments(expected_type)
            if collections.length(parts) > 1:
                expected_payload = parts[1]
        tag = 1
    for index in 0..collections.length(arguments):
        let lowered = lower_hir_expression(next, arguments[index], expected_payload)
        next = lowered.state
        lowered_arguments = append(lowered_arguments, lowered.expression)
    var required_arity = 1
    if name == "None":
        required_arity = 0
    if collections.length(arguments) != required_arity:
        next = lower_error(next, expression.line, expression.column, string.concat("variant '", string.concat(name, "' has the wrong number of arguments")))
    if result_type == "":
        if name == "Some" and collections.length(lowered_arguments) == 1:
            result_type = make_type("Option", [lowered_arguments[0].type_name])
        else:
            next = lower_error(next, expression.line, expression.column, string.concat("cannot infer result type for '", string.concat(name, "'")))
            result_type = "<invalid>"
    return HirExprResult(hir_expression(expr_call(), "$enum", result_type, lowered_arguments, -1, tag, expression), next)

fn user_call(state: LowerState, expression: AstExpr, function_index: Int, arguments: Array[AstExpr]) -> HirExprResult:
    let function = state.module.functions[function_index]
    var next = state
    if function.native_import and state.unsafe_depth == 0:
        next = lower_error(next, expression.line, expression.column, string.concat("call to extern function '", string.concat(function.name, "' requires an explicit unsafe block")))
    var substitutions = Substitutions([], [])
    var lowered_arguments: Array[HirExpr] = []
    for index in 0..collections.length(arguments):
        var expected = ""
        if index < collections.length(function.parameters):
            let pattern = function.parameters[index].type_name
            let candidate = substitute_type(pattern, substitutions)
            if not contains_type_parameter(candidate, function.type_parameters):
                expected = candidate
        let lowered = lower_hir_expression(next, arguments[index], expected)
        next = lowered.state
        lowered_arguments = append(lowered_arguments, lowered.expression)
        if index < collections.length(function.parameters):
            substitutions = infer_type(function.parameters[index].type_name, lowered.expression.type_name, function.type_parameters, substitutions)
    if collections.length(arguments) != collections.length(function.parameters):
        next = lower_error(next, expression.line, expression.column, string.concat("function '", string.concat(function.name, "' has the wrong number of arguments")))
    for constraint_index in 0..collections.length(function.constraints):
        let constraint = function.constraints[constraint_index]
        let concrete = substitution_value(substitutions, constraint.type_parameter)
        if concrete == constraint.type_parameter or not type_implements_trait(next.module, concrete, constraint.trait_name):
            next = lower_error(next, expression.line, expression.column, string.concat("type ", string.concat(concrete, string.concat(" does not implement trait '", string.concat(constraint.trait_name, "'")))))
    var parameter_types: Array[String] = []
    for index in 0..collections.length(function.parameters):
        let required = substitute_type(function.parameters[index].type_name, substitutions)
        parameter_types = append(parameter_types, required)
        if index < collections.length(lowered_arguments) and required != lowered_arguments[index].type_name:
            next = lower_error(next, arguments[index].line, arguments[index].column, string.concat("argument type is ", string.concat(lowered_arguments[index].type_name, string.concat(", expected ", required))))
    let result_type = substitute_type(function.result_type, substitutions)
    var symbol = -1
    if collections.length(function.type_parameters) == 0:
        symbol = find_symbol_by_name(next, function.name, symbol_function())
    else:
        let key = specialization_key(function.name, substitutions, function.type_parameters)
        symbol = find_specialization(next, key)
        if symbol < 0:
            if collections.length(next.pending) >= 4096:
                next = lower_error(next, expression.line, expression.column, "generic specialization limit of 4096 exceeded")
            else:
                let added = add_hir_symbol(next, symbol_function(), key, result_type, false, parameter_types, intrinsic_none())
                symbol = added.symbol
                next = set_hir_async_symbol(added.state, symbol, function.asynchronous)
                next = state_specializations(next, append(next.specializations, Specialization(key, symbol)))
                next = state_pending(next, append(next.pending, PendingSpecialization(function_index, symbol, substitutions)))
    if function.asynchronous:
        for index in 0..collections.length(lowered_arguments):
            if not is_send_type(next.module, lowered_arguments[index].type_name):
                next = lower_issue(next, "R4101", arguments[index].line, arguments[index].column, "async arguments must satisfy Send")
        let results = type_arguments(result_type)
        var success = "<invalid>"
        if collections.length(results) == 2:
            success = results[0]
            if not is_send_type(next.module, success):
                next = lower_issue(next, "R4101", expression.line, expression.column, "async task result must satisfy Send")
        return HirExprResult(hir_expression(expr_call(), "$async", make_type("Task", [success]), lowered_arguments, symbol, -1, expression), next)
    return HirExprResult(hir_expression(expr_call(), function.name, result_type, lowered_arguments, symbol, -1, expression), next)

fn closure_value_call(state: LowerState, expression: AstExpr, closure: HirExpr, arguments: Array[AstExpr]) -> HirExprResult:
    let callable_name = string.concat(closure.type_name, ".call")
    let function_index = find_function_index(state.module, callable_name)
    var next = state
    var lowered_arguments: Array[HirExpr] = [closure]
    if function_index < 0:
        next = lower_error(next, expression.line, expression.column, string.concat("undefined closure callable '", string.concat(callable_name, "'")))
        for index in 0..collections.length(arguments):
            let lowered = lower_hir_expression(next, arguments[index], "")
            next = lowered.state
            lowered_arguments = append(lowered_arguments, lowered.expression)
        return HirExprResult(hir_expression(expr_call(), callable_name, "<invalid>", lowered_arguments, -1, -1, expression), next)
    let function = next.module.functions[function_index]
    for index in 0..collections.length(arguments):
        var expected = ""
        let parameter_index = index + 1
        if parameter_index < collections.length(function.parameters):
            expected = function.parameters[parameter_index].type_name
        let lowered = lower_hir_expression(next, arguments[index], expected)
        next = lowered.state
        lowered_arguments = append(lowered_arguments, lowered.expression)
        if expected != "" and lowered.expression.type_name != expected:
            next = lower_error(next, arguments[index].line, arguments[index].column, string.concat("argument type is ", string.concat(lowered.expression.type_name, string.concat(", expected ", expected))))
    if collections.length(arguments) + 1 != collections.length(function.parameters):
        next = lower_error(next, expression.line, expression.column, string.concat("function '", string.concat(callable_name, "' has the wrong number of arguments")))
    let symbol = find_symbol_by_name(next, callable_name, symbol_function())
    if symbol < 0:
        next = lower_error(next, expression.line, expression.column, string.concat("undefined closure callable '", string.concat(callable_name, "'")))
    return HirExprResult(hir_expression(expr_call(), callable_name, function.result_type, lowered_arguments, symbol, -1, expression), next)

fn lower_call_expression(state: LowerState, expression: AstExpr, expected_type: String) -> HirExprResult:
    let callee = expression.children[0]
    if callee.kind == expr_name():
        let callback_symbol = find_scope_symbol(state, callee.text)
        if callback_symbol >= 0 and string.starts_with(state.symbols[callback_symbol].type_name, "$closure."):
            let callback_type = state.symbols[callback_symbol].type_name
            let callback_function = find_function_index(state.module, string.concat(callback_type, ".call"))
            if callback_function >= 0:
                var callback_arguments: Array[AstExpr] = [callee]
                for callback_index in 1..collections.length(expression.children):
                    callback_arguments = append(callback_arguments, expression.children[callback_index])
                return user_call(state, expression, callback_function, callback_arguments)
    if callee.kind == expr_lambda():
        let lowered_callee = lower_hir_expression(state, callee, "")
        var immediate_arguments: Array[AstExpr] = []
        for immediate_index in 1..collections.length(expression.children):
            immediate_arguments = append(immediate_arguments, expression.children[immediate_index])
        return closure_value_call(lowered_callee.state, expression, lowered_callee.expression, immediate_arguments)
    if callee.kind == expr_field() and collections.length(callee.children) == 1:
        let qualified_raw = callable_name(callee)
        let qualified_name = associated_standard_callable(standard_callable(state.module, qualified_raw))
        var qualified_arguments: Array[AstExpr] = []
        for qualified_index in 1..collections.length(expression.children):
            qualified_arguments = append(qualified_arguments, expression.children[qualified_index])
        let qualified_standard = standard_signature(qualified_name)
        if qualified_standard.found:
            return standard_call(state, expression, qualified_name, qualified_standard, qualified_arguments)
        let qualified_struct = find_struct_index(state.module, qualified_name)
        if qualified_struct >= 0:
            return struct_call(state, expression, qualified_struct, qualified_arguments, expected_type)
        let qualified_constructor = find_enum_constructor(state.module, qualified_name)
        if qualified_constructor.found:
            return enum_constructor_call(state, expression, qualified_constructor.declaration, qualified_constructor.variant, qualified_arguments, expected_type)
        let qualified_function = find_function_index(state.module, qualified_name)
        if qualified_function >= 0:
            return user_call(state, expression, qualified_function, qualified_arguments)
        let qualified_private = string.concat("$", qualified_name)
        if find_struct_index(state.module, qualified_private) >= 0 or find_function_index(state.module, qualified_private) >= 0 or find_enum_constructor(state.module, qualified_private).found:
            var private_state = lower_issue(state, "R3003", expression.line, expression.column, string.concat("private declaration '", string.concat(qualified_name, "' is not visible")))
            var private_arguments: Array[HirExpr] = []
            for private_index in 0..collections.length(qualified_arguments):
                let private_argument = lower_hir_expression(private_state, qualified_arguments[private_index], "")
                private_state = private_argument.state
                private_arguments = append(private_arguments, private_argument.expression)
            return HirExprResult(hir_expression(expr_call(), qualified_name, "<invalid>", private_arguments, -1, -1, expression), private_state)
        if callee.children[0].kind == expr_name():
            let owner = callee.children[0].text
            if find_struct_index(state.module, owner) >= 0 or find_enum_index(state.module, owner) >= 0 or owner == "String":
                let associated_name = associated_standard_callable(string.concat(owner, string.concat(".", callee.text)))
                var associated_arguments: Array[AstExpr] = []
                for associated_index in 1..collections.length(expression.children):
                    associated_arguments = append(associated_arguments, expression.children[associated_index])
                let associated_standard = standard_signature(associated_name)
                if associated_standard.found:
                    return standard_call(state, expression, associated_name, associated_standard, associated_arguments)
                let associated_function = find_function_index(state.module, associated_name)
                if associated_function >= 0:
                    return user_call(state, expression, associated_function, associated_arguments)
        let receiver = callee.children[0]
        let probe = lower_hir_expression(state, receiver, "")
        var method_name = standard_method_callable(probe.expression.type_name, callee.text)
        if method_name == "":
            method_name = string.concat(type_base(probe.expression.type_name), string.concat(".", callee.text))
        var method_arguments: Array[AstExpr] = [receiver]
        for method_index in 1..collections.length(expression.children):
            method_arguments = append(method_arguments, expression.children[method_index])
        let method_standard = standard_signature(method_name)
        if method_standard.found:
            return standard_call(state, expression, method_name, method_standard, method_arguments)
        let method_function = find_function_index(state.module, method_name)
        if method_function >= 0:
            return user_call(state, expression, method_function, method_arguments)
        let trait_method = trait_method_function(state.module, probe.expression.type_name, callee.text)
        if trait_method >= 0:
            return user_call(state, expression, trait_method, method_arguments)
        if trait_method == -2:
            let ambiguous = lower_error(state, expression.line, expression.column, string.concat("ambiguous trait method '", string.concat(callee.text, "'")))
            return HirExprResult(hir_expression(expr_call(), callee.text, "<invalid>", [], -1, -1, expression), ambiguous)
        var method_error = lower_error(state, expression.line, expression.column, string.concat("undefined method '", string.concat(method_name, "'")))
        var invalid_arguments: Array[HirExpr] = []
        for invalid_index in 0..collections.length(method_arguments):
            let lowered = lower_hir_expression(method_error, method_arguments[invalid_index], "")
            method_error = lowered.state
            invalid_arguments = append(invalid_arguments, lowered.expression)
        return HirExprResult(hir_expression(expr_call(), method_name, "<invalid>", invalid_arguments, -1, -1, expression), method_error)
    let raw_name = callable_name(callee)
    let name = associated_standard_callable(standard_callable(state.module, raw_name))
    var arguments: Array[AstExpr] = []
    for index in 1..collections.length(expression.children):
        arguments = append(arguments, expression.children[index])
    if name == "print":
        var next = state
        var lowered_arguments: Array[HirExpr] = []
        for index in 0..collections.length(arguments):
            let lowered = lower_hir_expression(next, arguments[index], "")
            next = lowered.state
            lowered_arguments = append(lowered_arguments, lowered.expression)
        if collections.length(arguments) != 1:
            next = lower_error(next, expression.line, expression.column, "print expects one argument")
        else:
            if is_native_type(next.module, lowered_arguments[0].type_name):
                next = lower_error(next, expression.line, expression.column, "print does not accept aggregate or native values")
        return HirExprResult(hir_expression(expr_call(), name, "Unit", lowered_arguments, 0, -1, expression), next)
    let standard = standard_signature(name)
    if standard.found:
        return standard_call(state, expression, name, standard, arguments)
    if name == "Some" or name == "None" or name == "Ok" or name == "Err":
        return builtin_enum_constructor_call(state, expression, name, arguments, expected_type)
    let structure = find_struct_index(state.module, name)
    if structure >= 0:
        return struct_call(state, expression, structure, arguments, expected_type)
    let constructor = find_enum_constructor(state.module, name)
    if constructor.found:
        return enum_constructor_call(state, expression, constructor.declaration, constructor.variant, arguments, expected_type)
    let function = find_function_index(state.module, name)
    if function >= 0:
        return user_call(state, expression, function, arguments)
    let private_name = string.concat("$", name)
    if find_struct_index(state.module, private_name) >= 0 or find_function_index(state.module, private_name) >= 0 or find_enum_constructor(state.module, private_name).found:
        var next = lower_issue(state, "R3003", expression.line, expression.column, string.concat("private declaration '", string.concat(name, "' is not visible")))
        var lowered_arguments: Array[HirExpr] = []
        for index in 0..collections.length(arguments):
            let lowered = lower_hir_expression(next, arguments[index], "")
            next = lowered.state
            lowered_arguments = append(lowered_arguments, lowered.expression)
        return HirExprResult(hir_expression(expr_call(), name, "<invalid>", lowered_arguments, -1, -1, expression), next)
    var next = lower_error(state, expression.line, expression.column, string.concat("undefined callable '", string.concat(name, "'")))
    var lowered_arguments: Array[HirExpr] = []
    for index in 0..collections.length(arguments):
        let lowered = lower_hir_expression(next, arguments[index], "")
        next = lowered.state
        lowered_arguments = append(lowered_arguments, lowered.expression)
    return HirExprResult(hir_expression(expr_call(), name, "<invalid>", lowered_arguments, -1, -1, expression), next)

fn has_lambda_capture(captures: Array[LambdaCapture], symbol: Int) -> Bool:
    for index in 0..collections.length(captures):
        if captures[index].symbol == symbol:
            return true
    return false

fn collect_lambda_captures(state: LowerState, expression: AstExpr, parameter_names: Array[String], captures: Array[LambdaCapture]) -> Array[LambdaCapture]:
    var result = captures
    if expression.kind == expr_name() and not contains_string(parameter_names, expression.text):
        let symbol = find_scope_symbol(state, expression.text)
        if symbol >= 0 and not has_lambda_capture(result, symbol):
            result = append(result, LambdaCapture(expression.text, symbol))
        return result
    if expression.kind == expr_lambda():
        return result
    for index in 0..collections.length(expression.children):
        result = collect_lambda_captures(state, expression.children[index], parameter_names, result)
    return result

fn rewrite_lambda_captures(expression: AstExpr, captures: Array[LambdaCapture]) -> AstExpr:
    if expression.kind == expr_name():
        for index in 0..collections.length(captures):
            if captures[index].name == expression.text:
                let receiver = AstExpr(expr_name(), "self", [], expression.line, expression.column)
                return AstExpr(expr_field(), expression.text, [receiver], expression.line, expression.column)
    var children: Array[AstExpr] = []
    for index in 0..collections.length(expression.children):
        children = append(children, rewrite_lambda_captures(expression.children[index], captures))
    return AstExpr(expression.kind, expression.text, children, expression.line, expression.column)

fn lower_hir_expression(state: LowerState, expression: AstExpr, expected: String) -> HirExprResult:
    if expression.kind == expr_integer():
        return HirExprResult(hir_expression(expression.kind, expression.text, "Int", [], -1, -1, expression), state)
    if expression.kind == expr_float():
        return HirExprResult(hir_expression(expression.kind, expression.text, "Float", [], -1, -1, expression), state)
    if expression.kind == expr_character():
        return HirExprResult(hir_expression(expression.kind, expression.text, "Char", [], -1, -1, expression), state)
    if expression.kind == expr_string():
        return HirExprResult(hir_expression(expression.kind, expression.text, "String", [], -1, -1, expression), state)
    if expression.kind == expr_bool():
        return HirExprResult(hir_expression(expression.kind, expression.text, "Bool", [], -1, -1, expression), state)
    if expression.kind == expr_name():
        let callback_index = foreign_type_index(state.module, expected)
        if callback_index >= 0 and state.module.structs[callback_index].representation == representation_callback():
            let function_index = find_function_index(state.module, expression.text)
            if function_index >= 0 and callback_matches(state.module, callback_index, function_index):
                let function_symbol = find_symbol_by_name(state, expression.text, symbol_function())
                if function_symbol >= 0:
                    return HirExprResult(hir_expression(expr_function_ref(), expression.text, expected, [], function_symbol, -1, expression), state)
            let next = lower_error(state, expression.line, expression.column, string.concat("callback argument '", string.concat(expression.text, "' must name a top-level noncapturing function with the declared callback signature")))
            return HirExprResult(hir_expression(expr_function_ref(), expression.text, "<invalid>", [], -1, -1, expression), next)
        let constant_index = find_function_index(state.module, expression.text)
        if constant_index >= 0 and state.module.functions[constant_index].native_constant:
            let constant = state.module.functions[constant_index]
            if collections.length(constant.body) == 1 and collections.length(constant.body[0].expressions) == 1:
                let lowered = lower_hir_expression(state, constant.body[0].expressions[0], constant.result_type)
                if lowered.expression.type_name != constant.result_type:
                    let next = lower_error(lowered.state, expression.line, expression.column, "extern constant initializer does not match its declared type")
                    return HirExprResult(lowered.expression, next)
                return lowered
        let symbol = find_scope_symbol(state, expression.text)
        if symbol < 0:
            let next = lower_error(state, expression.line, expression.column, string.concat("undefined name '", string.concat(expression.text, "'")))
            return HirExprResult(hir_expression(expression.kind, expression.text, "<invalid>", [], -1, -1, expression), next)
        var next = state
        if state.move_analysis_enabled and is_move_only_type(state.module, state.symbols[symbol].type_name):
            if contains_symbol(state.moved_symbols, symbol):
                next = lower_issue(next, "R4103", expression.line, expression.column, string.concat("move-only value '", string.concat(expression.text, "' was already consumed")))
            else:
                if not state.borrowing_unique:
                    next = state_moved_symbols(next, append(next.moved_symbols, symbol))
        return HirExprResult(hir_expression(expression.kind, expression.text, state.symbols[symbol].type_name, [], symbol, -1, expression), next)
    if expression.kind == expr_lambda():
        var parameter_names: Array[String] = []
        var parameters: Array[AstParameter] = []
        var parameter_types: Array[String] = []
        let parameter_count = collections.length(expression.children) - 1
        for index in 0..parameter_count:
            let node = expression.children[index]
            let parameter_type = substitute_type(node.children[0].text, state.substitutions)
            parameter_names = append(parameter_names, node.text)
            parameters = append(parameters, AstParameter(node.text, parameter_type, node.line, node.column))
            parameter_types = append(parameter_types, parameter_type)
        let body = expression.children[parameter_count]
        let captures = collect_lambda_captures(state, body, parameter_names, [])
        let closure_name = string.concat("$closure.", string.from_int(collections.length(state.module.structs)))
        var fields: Array[AstTypeField] = []
        var captured_values: Array[HirExpr] = []
        var capture_state = state
        for index in 0..collections.length(captures):
            let symbol = captures[index].symbol
            if capture_state.move_analysis_enabled and is_move_only_type(capture_state.module, capture_state.symbols[symbol].type_name):
                capture_state = lower_issue(capture_state, "R4103", expression.line, expression.column, string.concat("move-only value '", string.concat(captures[index].name, "' cannot be captured by a reusable closure")))
            fields = append(fields, AstTypeField(captures[index].name, state.symbols[symbol].type_name, expression.line, expression.column))
            captured_values = append(captured_values, hir_expression(expr_name(), captures[index].name, state.symbols[symbol].type_name, [], symbol, -1, expression))
        let closure = AstStructDecl(closure_name, false, [], fields, representation_rocket(), [], "", closure_name, expression.line, expression.column)
        let self_parameter = AstParameter("self", closure_name, expression.line, expression.column)
        let rewritten = rewrite_lambda_captures(body, captures)
        let returned = AstStatement(statement_return(), "", "", false, [rewritten], [], [], [], expression.line, expression.column)
        let callable_name = string.concat(closure_name, ".call")
        let result_type = substitute_type(expression.text, state.substitutions)
        let callable = AstFunction(callable_name, false, [], collections.concat([self_parameter], parameters), result_type, [returned], closure_name, "", false, false, false, false, callable_name, [], expression.line, expression.column, false)
        var module = state.module
        module = AstModule(module.imports, append(module.structs, closure), module.enums, module.traits, append(module.functions, callable))
        var next = state_module(capture_state, module)
        let added = add_hir_symbol(next, symbol_function(), callable_name, result_type, false, collections.concat([closure_name], parameter_types), intrinsic_none())
        next = state_pending(added.state, append(added.state.pending, PendingSpecialization(collections.length(module.functions) - 1, added.symbol, state.substitutions)))
        return HirExprResult(hir_expression(expr_call(), "$struct", closure_name, captured_values, -1, 0, expression), next)
    if expression.kind == expr_array():
        return lower_array_expression(state, expression, expected)
    if expression.kind == expr_call():
        return lower_call_expression(state, expression, expected)
    if expression.kind == expr_index():
        let collection = lower_hir_expression(state, expression.children[0], "")
        let index = lower_hir_expression(collection.state, expression.children[1], "Int")
        var next = index.state
        if index.expression.type_name != "Int":
            next = lower_error(next, expression.line, expression.column, "collection index must be Int")
        if not is_array_type(collection.expression.type_name) and not is_slice_type(collection.expression.type_name):
            next = lower_error(next, expression.line, expression.column, "indexing requires Array or Slice")
        return HirExprResult(hir_expression(expression.kind, "", collection_element_type(collection.expression.type_name), [collection.expression, index.expression], -1, -1, expression), next)
    if expression.kind == expr_slice():
        let collection = lower_hir_expression(state, expression.children[0], "")
        let start = lower_hir_expression(collection.state, expression.children[1], "Int")
        let end = lower_hir_expression(start.state, expression.children[2], "Int")
        var next = end.state
        if start.expression.type_name != "Int" or end.expression.type_name != "Int":
            next = lower_error(next, expression.line, expression.column, "slice bounds must be Int")
        let result_type = make_type("Slice", [collection_element_type(collection.expression.type_name)])
        return HirExprResult(hir_expression(expression.kind, "", result_type, [collection.expression, start.expression, end.expression], -1, -1, expression), next)
    if expression.kind == expr_field():
        let constant_name = callable_name(expression)
        let constant_index = find_function_index(state.module, constant_name)
        if constant_index >= 0 and state.module.functions[constant_index].associated_constant:
            return user_call(state, expression, constant_index, [])
        let value = lower_hir_expression(state, expression.children[0], "")
        let declaration_index = find_struct_index(value.state.module, type_base(value.expression.type_name))
        var next = value.state
        if declaration_index < 0:
            next = lower_error(next, expression.line, expression.column, "field access requires a struct value")
            return HirExprResult(hir_expression(expression.kind, expression.text, "<invalid>", [value.expression], -1, -1, expression), next)
        let declaration = next.module.structs[declaration_index]
        for field_index in 0..collections.length(declaration.fields):
            if declaration.fields[field_index].name == expression.text:
                var substitutions = Substitutions([], [])
                substitutions = infer_type(make_type(declaration.name, declaration.type_parameters), value.expression.type_name, declaration.type_parameters, substitutions)
                let result_type = substitute_type(declaration.fields[field_index].type_name, substitutions)
                return HirExprResult(hir_expression(expression.kind, expression.text, result_type, [value.expression], -1, field_index, expression), next)
        next = lower_error(next, expression.line, expression.column, string.concat("unknown field '", string.concat(expression.text, "'")))
        return HirExprResult(hir_expression(expression.kind, expression.text, "<invalid>", [value.expression], -1, -1, expression), next)
    if expression.kind == expr_unary():
        let operand = lower_hir_expression(state, expression.children[0], "")
        var next = operand.state
        var result_type = operand.expression.type_name
        if expression.text == "not":
            result_type = "Bool"
            if operand.expression.type_name != "Bool":
                next = lower_error(next, expression.line, expression.column, "'not' requires Bool")
        else:
            if operand.expression.type_name != "Int" and operand.expression.type_name != "Float":
                next = lower_error(next, expression.line, expression.column, "unary '-' requires Int or Float")
        return HirExprResult(hir_expression(expression.kind, expression.text, result_type, [operand.expression], -1, -1, expression), next)
    if expression.kind == expr_binary():
        let left = lower_hir_expression(state, expression.children[0], "")
        let right = lower_hir_expression(left.state, expression.children[1], left.expression.type_name)
        var next = right.state
        if left.expression.type_name != right.expression.type_name:
            next = lower_error(next, expression.line, expression.column, "operator operands have different types")
        var result_type = left.expression.type_name
        if expression.text == "==" or expression.text == "!=" or expression.text == "<" or expression.text == "<=" or expression.text == ">" or expression.text == ">=" or expression.text == "and" or expression.text == "or":
            result_type = "Bool"
        return HirExprResult(hir_expression(expression.kind, expression.text, result_type, [left.expression, right.expression], -1, -1, expression), next)
    if expression.kind == expr_propagate():
        let value = lower_hir_expression(state, expression.children[0], "")
        var next = value.state
        let arguments = type_arguments(value.expression.type_name)
        if type_base(value.expression.type_name) != "Result" or collections.length(arguments) != 2:
            next = lower_error(next, expression.line, expression.column, "'?' requires Result[T, E]")
            return HirExprResult(hir_expression(expression.kind, "", "<invalid>", [value.expression], -1, -1, expression), next)
        if type_base(next.return_type) != "Result":
            next = lower_error(next, expression.line, expression.column, "'?' requires a Result-returning function")
        else:
            let return_arguments = type_arguments(next.return_type)
            if collections.length(return_arguments) != 2 or return_arguments[1] != arguments[1]:
                next = lower_error(next, expression.line, expression.column, "'?' error type does not match the function result")
        return HirExprResult(hir_expression(expression.kind, "", arguments[0], [value.expression], -1, -1, expression), next)
    if expression.kind == expr_await():
        let task = lower_hir_expression(state, expression.children[0], "")
        var next = task.state
        if not next.current_async:
            next = lower_issue(next, "R4105", expression.line, expression.column, "await is valid only inside an async function")
        for binding_index in 0..collections.length(next.bindings):
            let binding = next.bindings[binding_index]
            if is_native_type(next.module, next.symbols[binding.symbol].type_name):
                next = lower_issue(next, "R4106", expression.line, expression.column, "native values cannot remain live across await")
        let arguments = type_arguments(task.expression.type_name)
        if type_base(task.expression.type_name) != "Task" or collections.length(arguments) != 1:
            next = lower_issue(next, "R4105", expression.line, expression.column, "await requires a Task[T] operand")
            return HirExprResult(hir_expression(expr_await(), "", "<invalid>", [task.expression], -1, -1, expression), next)
        return HirExprResult(hir_expression(expr_await(), "", make_type("Result", [arguments[0], "String"]), [task.expression], -1, -1, expression), next)
    let next = lower_error(state, expression.line, expression.column, "unsupported expression in self-hosted HIR")
    return HirExprResult(hir_expression(expression.kind, expression.text, "<invalid>", [], -1, -1, expression), next)

fn hir_statement(kind: Int, symbol: Int, expressions: Array[HirExpr], body: Array[HirStatement], else_body: Array[HirStatement], cases: Array[HirMatchCase], source: AstStatement) -> HirStatement:
    return HirStatement(kind, symbol, -1, expressions, body, else_body, cases, source.line, source.column)

fn lower_hir_block(state: LowerState, statements: Array[AstStatement], nested: Bool) -> HirStatementsResult:
    let original_depth = state.depth
    let original_bindings = collections.length(state.bindings)
    var next = state
    if nested:
        next = state_depth(next, original_depth + 1)
    var lowered: Array[HirStatement] = []
    for index in 0..collections.length(statements):
        let statement = lower_hir_statement(next, statements[index])
        next = statement.state
        lowered = append(lowered, statement.statement)
    next = state_bindings(state_depth(next, original_depth), prefix(next.bindings, original_bindings))
    return HirStatementsResult(lowered, next)

fn lower_hir_match(state: LowerState, statement: AstStatement) -> HirStatementResult:
    let value = lower_hir_expression(state, statement.expressions[0], "")
    var next = value.state
    let base = type_base(value.expression.type_name)
    let arguments = type_arguments(value.expression.type_name)
    let enum_index = find_enum_index(next.module, base)
    if base != "Result" and base != "Option" and enum_index < 0:
        next = lower_issue(next, "R4004", statement.line, statement.column, "match requires an enum value")
    var cases: Array[HirMatchCase] = []
    var seen_tags: Array[Int] = []
    var saw_wildcard = false
    for case_index in 0..collections.length(statement.cases):
        let source_case = statement.cases[case_index]
        let original_bindings = collections.length(next.bindings)
        var tag = -1
        var payload_types: Array[String] = []
        if source_case.wildcard:
            tag = -1
        else:
            if base == "Result" and source_case.variant == "Ok":
                tag = 0
                if collections.length(arguments) > 0:
                    payload_types = append(payload_types, arguments[0])
            else:
                if base == "Result" and source_case.variant == "Err":
                    tag = 1
                    if collections.length(arguments) > 1:
                        payload_types = append(payload_types, arguments[1])
                else:
                    if base == "Option" and source_case.variant == "Some":
                        tag = 0
                        if collections.length(arguments) > 0:
                            payload_types = append(payload_types, arguments[0])
                    else:
                        if base == "Option" and source_case.variant == "None":
                            tag = 1
                        else:
                            if enum_index >= 0:
                                let declaration = next.module.enums[enum_index]
                                var substitutions = Substitutions([], [])
                                substitutions = infer_type(make_type(declaration.name, declaration.type_parameters), value.expression.type_name, declaration.type_parameters, substitutions)
                                for variant_index in 0..collections.length(declaration.variants):
                                    let variant = declaration.variants[variant_index]
                                    if variant.name == source_case.variant:
                                        tag = variant_index
                                        for payload_index in 0..collections.length(variant.payload_types):
                                            payload_types = append(payload_types, substitute_type(variant.payload_types[payload_index], substitutions))
                            if tag < 0:
                                next = lower_issue(next, "R4004", source_case.line, source_case.column, string.concat("unknown match variant '", string.concat(source_case.variant, "'")))
        if source_case.wildcard:
            if saw_wildcard:
                next = lower_issue(next, "R4004", source_case.line, source_case.column, "duplicate wildcard match case")
            saw_wildcard = true
        else:
            if tag >= 0 and contains_int(seen_tags, tag):
                next = lower_issue(next, "R4004", source_case.line, source_case.column, string.concat("duplicate match variant '", string.concat(source_case.variant, "'")))
            if tag >= 0:
                seen_tags = append(seen_tags, tag)
        let original_depth = next.depth
        next = state_depth(next, original_depth + 1)
        var bindings: Array[Int] = []
        for binding_index in 0..collections.length(source_case.bindings):
            var binding_type = "<invalid>"
            if binding_index < collections.length(payload_types):
                binding_type = payload_types[binding_index]
            let added = add_hir_symbol(next, symbol_pattern(), source_case.bindings[binding_index], binding_type, false, [], intrinsic_none())
            next = add_scope_binding(added.state, source_case.bindings[binding_index], added.symbol)
            bindings = append(bindings, added.symbol)
        if collections.length(source_case.bindings) != collections.length(payload_types) and not source_case.wildcard:
            next = lower_issue(next, "R4005", source_case.line, source_case.column, "match pattern has the wrong payload arity")
        let body = lower_hir_block(next, source_case.body, false)
        next = state_bindings(state_depth(body.state, original_depth), prefix(body.state.bindings, original_bindings))
        cases = append(cases, HirMatchCase(tag, bindings, body.statements, source_case.line, source_case.column))
    var required_cases = 0
    if base == "Result" or base == "Option":
        required_cases = 2
    if enum_index >= 0:
        required_cases = collections.length(next.module.enums[enum_index].variants)
    if not saw_wildcard and required_cases > 0 and collections.length(seen_tags) != required_cases:
        next = lower_issue(next, "R4004", statement.line, statement.column, "match is not exhaustive")
    return HirStatementResult(hir_statement(statement_match(), -1, [value.expression], [], [], cases, statement), next)

fn lower_hir_statement(state: LowerState, statement: AstStatement) -> HirStatementResult:
    if statement.kind == statement_unsafe():
        let entered = state_unsafe_depth(state, state.unsafe_depth + 1)
        let body = lower_hir_block(entered, statement.body, true)
        let next = state_unsafe_depth(body.state, body.state.unsafe_depth - 1)
        return HirStatementResult(hir_statement(statement_unsafe(), -1, [], body.statements, [], [], statement), next)
    if statement.kind == statement_binding():
        var expected = substitute_type(statement.type_name, state.substitutions)
        let initializer = lower_hir_expression(state, statement.expressions[0], expected)
        var next = initializer.state
        if expected == "":
            expected = initializer.expression.type_name
        if expected != initializer.expression.type_name and initializer.expression.type_name != "<invalid>":
            next = lower_error(next, statement.line, statement.column, string.concat("binding initializer is ", string.concat(initializer.expression.type_name, string.concat(", expected ", expected))))
        for index in 0..collections.length(next.bindings):
            let existing = next.bindings[index]
            if existing.depth == next.depth and existing.name == statement.name:
                next = lower_error(next, statement.line, statement.column, string.concat("duplicate local '", string.concat(statement.name, "'")))
        let added = add_hir_symbol(next, symbol_local(), statement.name, expected, statement.mutable_binding, [], intrinsic_none())
        next = add_scope_binding(added.state, statement.name, added.symbol)
        return HirStatementResult(hir_statement(statement_binding(), added.symbol, [initializer.expression], [], [], [], statement), next)
    if statement.kind == statement_assignment():
        let symbol = find_scope_symbol(state, statement.name)
        var next = state
        var expected = "<invalid>"
        if symbol < 0:
            next = lower_error(next, statement.line, statement.column, string.concat("undefined assignment target '", string.concat(statement.name, "'")))
        else:
            expected = next.symbols[symbol].type_name
            if not next.symbols[symbol].mutable_binding:
                next = lower_error(next, statement.line, statement.column, string.concat("cannot assign to immutable binding '", string.concat(statement.name, "'")))
        let value = lower_hir_expression(next, statement.expressions[0], expected)
        next = value.state
        if value.expression.type_name != expected and value.expression.type_name != "<invalid>":
            next = lower_error(next, statement.line, statement.column, "assignment changes the binding type")
        return HirStatementResult(hir_statement(statement_assignment(), symbol, [value.expression], [], [], [], statement), next)
    if statement.kind == statement_index_assignment():
        let symbol = find_scope_symbol(state, statement.name)
        var next = state
        var element_type = "<invalid>"
        if symbol < 0:
            next = lower_error(next, statement.line, statement.column, string.concat("undefined mutation target '", string.concat(statement.name, "'")))
        else:
            let target_type = next.symbols[symbol].type_name
            if not next.symbols[symbol].mutable_binding:
                next = lower_error(next, statement.line, statement.column, string.concat("cannot mutate immutable binding '", string.concat(statement.name, "'")))
            if type_base(target_type) != "Array":
                next = lower_error(next, statement.line, statement.column, "indexed assignment requires a mutable Array binding")
            else:
                element_type = type_arguments(target_type)[0]
        let index = lower_hir_expression(next, statement.expressions[0], "Int")
        let value = lower_hir_expression(index.state, statement.expressions[1], element_type)
        next = value.state
        if index.expression.type_name != "Int" and index.expression.type_name != "<invalid>":
            next = lower_error(next, statement.line, statement.column, "Array assignment index must have type Int")
        if element_type != "<invalid>" and value.expression.type_name != element_type and value.expression.type_name != "<invalid>":
            next = lower_error(next, statement.line, statement.column, "Array assignment changes the element type")
        return HirStatementResult(hir_statement(statement_index_assignment(), symbol, [index.expression, value.expression], [], [], [], statement), next)
    if statement.kind == statement_return():
        var next = state
        var expressions: Array[HirExpr] = []
        if collections.length(statement.expressions) == 0:
            if next.return_type != "Unit":
                next = lower_error(next, statement.line, statement.column, "non-Unit function must return a value")
        else:
            let value = lower_hir_expression(next, statement.expressions[0], next.return_type)
            next = value.state
            expressions = append(expressions, value.expression)
            if type_base(value.expression.type_name) == "std.sync.LockGuard" or type_base(value.expression.type_name) == "std.task.TaskGroup":
                next = lower_issue(next, "R4104", statement.line, statement.column, "scoped concurrency value cannot escape its function")
            if value.expression.type_name != next.return_type and value.expression.type_name != "<invalid>":
                next = lower_error(next, statement.line, statement.column, string.concat("return value is ", string.concat(value.expression.type_name, string.concat(", expected ", next.return_type))))
        return HirStatementResult(hir_statement(statement_return(), -1, expressions, [], [], [], statement), next)
    if statement.kind == statement_expression():
        let expression = lower_hir_expression(state, statement.expressions[0], "")
        return HirStatementResult(hir_statement(statement_expression(), -1, [expression.expression], [], [], [], statement), expression.state)
    if statement.kind == statement_if():
        let condition = lower_hir_expression(state, statement.expressions[0], "Bool")
        var next = condition.state
        if condition.expression.type_name != "Bool":
            next = lower_error(next, statement.line, statement.column, "if condition must be Bool")
        let then_body = lower_hir_block(next, statement.body, true)
        let else_body = lower_hir_block(then_body.state, statement.else_body, true)
        return HirStatementResult(hir_statement(statement_if(), -1, [condition.expression], then_body.statements, else_body.statements, [], statement), else_body.state)
    if statement.kind == statement_while():
        let condition = lower_hir_expression(state, statement.expressions[0], "Bool")
        var next = condition.state
        if condition.expression.type_name != "Bool":
            next = lower_error(next, statement.line, statement.column, "while condition must be Bool")
        next = state_loop_depth(next, next.loop_depth + 1)
        let body = lower_hir_block(next, statement.body, true)
        next = state_loop_depth(body.state, body.state.loop_depth - 1)
        return HirStatementResult(hir_statement(statement_while(), -1, [condition.expression], body.statements, [], [], statement), next)
    if statement.kind == statement_for():
        if collections.length(statement.expressions) == 1:
            let source = statement.expressions[0]
            let iterator_field = AstExpr(expr_field(), "iterator", [source], statement.line, statement.column)
            let iterator_call = AstExpr(expr_call(), "", [iterator_field], statement.line, statement.column)
            let iterator = lower_hir_expression(state, iterator_call, "")
            var next = iterator.state
            let original_depth = next.depth
            let original_bindings = collections.length(next.bindings)
            let cursor_name = string.concat("$iterator.", string.from_int(statement.line))
            let added_cursor = add_hir_symbol(next, symbol_local(), cursor_name, iterator.expression.type_name, true, [], intrinsic_none())
            next = add_scope_binding(added_cursor.state, cursor_name, added_cursor.symbol)
            let cursor = AstExpr(expr_name(), cursor_name, [], statement.line, statement.column)
            let condition_field = AstExpr(expr_field(), "has_next", [cursor], statement.line, statement.column)
            let condition_call = AstExpr(expr_call(), "", [condition_field], statement.line, statement.column)
            let condition = lower_hir_expression(next, condition_call, "Bool")
            let value_field = AstExpr(expr_field(), "value", [cursor], statement.line, statement.column)
            let value_call = AstExpr(expr_call(), "", [value_field], statement.line, statement.column)
            let value = lower_hir_expression(condition.state, value_call, "")
            let advance_field = AstExpr(expr_field(), "advance", [cursor], statement.line, statement.column)
            let advance_call = AstExpr(expr_call(), "", [advance_field], statement.line, statement.column)
            let advance = lower_hir_expression(value.state, advance_call, iterator.expression.type_name)
            next = advance.state
            if condition.expression.type_name != "Bool":
                next = lower_error(next, statement.line, statement.column, "iterator has_next() must return Bool")
            if advance.expression.type_name != iterator.expression.type_name:
                next = lower_error(next, statement.line, statement.column, "iterator advance() must preserve its type")
            next = state_depth(next, original_depth + 1)
            let added_value = add_hir_symbol(next, symbol_loop(), statement.name, value.expression.type_name, false, [], intrinsic_none())
            next = add_scope_binding(added_value.state, statement.name, added_value.symbol)
            next = state_loop_depth(next, next.loop_depth + 1)
            let body = lower_hir_block(next, statement.body, false)
            next = state_loop_depth(body.state, body.state.loop_depth - 1)
            next = state_bindings(state_depth(next, original_depth), prefix(next.bindings, original_bindings))
            let lowered = HirStatement(statement_for_each(), added_cursor.symbol, added_value.symbol, [iterator.expression, condition.expression, value.expression, advance.expression], body.statements, [], [], statement.line, statement.column)
            return HirStatementResult(lowered, next)
        let start = lower_hir_expression(state, statement.expressions[0], "Int")
        let end = lower_hir_expression(start.state, statement.expressions[1], "Int")
        var next = end.state
        if start.expression.type_name != "Int" or end.expression.type_name != "Int":
            next = lower_error(next, statement.line, statement.column, "for range bounds must be Int")
        let original_depth = next.depth
        let original_bindings = collections.length(next.bindings)
        next = state_depth(next, original_depth + 1)
        let added = add_hir_symbol(next, symbol_loop(), statement.name, "Int", false, [], intrinsic_none())
        next = add_scope_binding(added.state, statement.name, added.symbol)
        next = state_loop_depth(next, next.loop_depth + 1)
        let body = lower_hir_block(next, statement.body, false)
        next = state_loop_depth(body.state, body.state.loop_depth - 1)
        next = state_bindings(state_depth(next, original_depth), prefix(next.bindings, original_bindings))
        return HirStatementResult(hir_statement(statement_for(), added.symbol, [start.expression, end.expression], body.statements, [], [], statement), next)
    if statement.kind == statement_break() or statement.kind == statement_continue():
        var next = state
        if next.loop_depth == 0:
            next = lower_error(next, statement.line, statement.column, "loop control is only valid inside a loop")
        return HirStatementResult(hir_statement(statement.kind, -1, [], [], [], [], statement), next)
    if statement.kind == statement_match():
        return lower_hir_match(state, statement)
    let next = lower_error(state, statement.line, statement.column, "unsupported statement in self-hosted HIR")
    return HirStatementResult(hir_statement(statement.kind, -1, [], [], [], [], statement), next)

fn lower_hir_function(state: LowerState, function_index: Int, symbol: Int, substitutions: Substitutions) -> HirFunctionResult:
    let function = state.module.functions[function_index]
    let saved_depth = state.depth
    let saved_return = state.return_type
    let saved_loop = state.loop_depth
    let saved_substitutions = state.substitutions
    let saved_bindings = state.bindings
    let saved_async = state.current_async
    var next = state_bindings(state_function_context(state_depth(state, 0), substitute_type(function.result_type, substitutions), 0, substitutions, function.asynchronous), [])
    var parameters: Array[Int] = []
    for index in 0..collections.length(function.parameters):
        let parameter = function.parameters[index]
        let parameter_type = substitute_type(parameter.type_name, substitutions)
        let added = add_hir_symbol(next, symbol_parameter(), parameter.name, parameter_type, false, [], intrinsic_none())
        next = add_scope_binding(added.state, parameter.name, added.symbol)
        parameters = append(parameters, added.symbol)
    let body = lower_hir_block(next, function.body, false)
    next = state_bindings(state_function_context(state_depth(body.state, saved_depth), saved_return, saved_loop, saved_substitutions, saved_async), saved_bindings)
    return HirFunctionResult(HirFunction(symbol, parameters, substitute_type(function.result_type, substitutions), body.statements, function.asynchronous), next)

fn lower_to_hir(module: AstModule, parser_diagnostics: Array[Diagnostic], library: Bool) -> HirResult:
    let pop_type = AstStructDecl("std.collections.Pop", true, ["T"], [AstTypeField("values", "Array[T]", 1, 1), AstTypeField("value", "T", 1, 1)], representation_rocket(), [], "", "std.collections.Pop", 1, 1)
    let removal_type = AstStructDecl("std.collections.Removal", true, ["T"], [AstTypeField("values", "Array[T]", 1, 1), AstTypeField("value", "T", 1, 1)], representation_rocket(), [], "", "std.collections.Removal", 1, 1)
    let tuple2_type = AstStructDecl("std.collections.Tuple2", true, ["A", "B"], [AstTypeField("first", "A", 1, 1), AstTypeField("second", "B", 1, 1)], representation_rocket(), [], "", "std.collections.Tuple2", 1, 1)
    let tuple3_type = AstStructDecl("std.collections.Tuple3", true, ["A", "B", "C"], [AstTypeField("first", "A", 1, 1), AstTypeField("second", "B", 1, 1), AstTypeField("third", "C", 1, 1)], representation_rocket(), [], "", "std.collections.Tuple3", 1, 1)
    let map_type = AstStructDecl("std.collections.Map", true, ["K", "V"], [AstTypeField("keys", "Array[K]", 1, 1), AstTypeField("values", "Array[V]", 1, 1)], representation_rocket(), [], "", "std.collections.Map", 1, 1)
    let set_type = AstStructDecl("std.collections.Set", true, ["T"], [AstTypeField("values", "Array[T]", 1, 1)], representation_rocket(), [], "", "std.collections.Set", 1, 1)
    let queue_type = AstStructDecl("std.collections.Queue", true, ["T"], [AstTypeField("values", "Array[T]", 1, 1)], representation_rocket(), [], "", "std.collections.Queue", 1, 1)
    let stack_type = AstStructDecl("std.collections.Stack", true, ["T"], [AstTypeField("values", "Array[T]", 1, 1)], representation_rocket(), [], "", "std.collections.Stack", 1, 1)
    let buffer_type = AstStructDecl("std.collections.ByteBuffer", true, [], [AstTypeField("bytes", "Array[Char]", 1, 1)], representation_rocket(), [], "", "std.collections.ByteBuffer", 1, 1)
    let http_response_type = AstStructDecl("std.http.Response", true, [], [AstTypeField("status", "Int", 1, 1), AstTypeField("body", "std.collections.ByteBuffer", 1, 1)], representation_rocket(), [], "", "std.http.Response", 1, 1)
    let http_request_type = AstStructDecl("std.http.Request", true, [], [AstTypeField("method", "String", 1, 1), AstTypeField("path", "String", 1, 1), AstTypeField("body", "std.collections.ByteBuffer", 1, 1)], representation_rocket(), [], "", "std.http.Request", 1, 1)
    let builtins = [pop_type, removal_type, tuple2_type, tuple3_type, map_type, set_type, queue_type, stack_type, buffer_type, http_response_type, http_request_type]
    let complete_module = AstModule(module.imports, collections.concat(builtins, module.structs), module.enums, module.traits, module.functions)
    var state = LowerState(complete_module, [], [], [], 0, "", 0, 0, Substitutions([], []), [], [], parser_diagnostics, false, [], false, module_may_move(complete_module))
    let print_symbol = add_hir_symbol(state, symbol_builtin(), "print", "Unit", false, [], intrinsic_print())
    state = print_symbol.state
    var function_symbols: Array[Int] = []
    for declaration_index in 0..collections.length(complete_module.structs):
        let declaration = complete_module.structs[declaration_index]
        if declaration.representation == representation_native():
            if collections.length(declaration.fields) == 0:
                state = lower_error(state, declaration.line, declaration.column, "native struct must declare at least one field")
            for field_index in 0..collections.length(declaration.fields):
                let field = declaration.fields[field_index]
                if not is_native_abi_value(complete_module, field.type_name) or field.type_name == "Unit" or foreign_type_index(complete_module, field.type_name) >= 0 and complete_module.structs[foreign_type_index(complete_module, field.type_name)].representation == representation_callback():
                    state = lower_error(state, field.line, field.column, "native struct fields must use primitive, Pointer, or opaque types")
        if declaration.representation == representation_callback():
            for parameter_index in 0..collections.length(declaration.callback_parameters):
                let parameter = declaration.callback_parameters[parameter_index]
                if not is_native_abi_value(complete_module, parameter.type_name) or parameter.type_name == "Unit" or foreign_type_index(complete_module, parameter.type_name) >= 0 and complete_module.structs[foreign_type_index(complete_module, parameter.type_name)].representation == representation_callback():
                    state = lower_error(state, parameter.line, parameter.column, "callback parameters must use primitive, Pointer, or opaque types")
            if not is_native_abi_value(complete_module, declaration.callback_result) or foreign_type_index(complete_module, declaration.callback_result) >= 0 and complete_module.structs[foreign_type_index(complete_module, declaration.callback_result)].representation == representation_callback():
                state = lower_error(state, declaration.line, declaration.column, "callback results must use primitive, Pointer, opaque, or Unit types")
    for trait_index in 0..collections.length(complete_module.traits):
        let trait_declaration = complete_module.traits[trait_index]
        for earlier in 0..trait_index:
            if complete_module.traits[earlier].name == trait_declaration.name:
                state = lower_error(state, trait_declaration.line, trait_declaration.column, string.concat("duplicate trait '", string.concat(trait_declaration.name, "'")))
        if collections.length(trait_declaration.methods) == 0:
            state = lower_error(state, trait_declaration.line, trait_declaration.column, "trait must declare at least one method")
        for method_index in 0..collections.length(trait_declaration.methods):
            let method = trait_declaration.methods[method_index]
            if collections.length(method.parameters) == 0 or method.parameters[0].name != "self" or method.parameters[0].type_name != "Self":
                state = lower_error(state, method.line, method.column, "trait methods require first parameter 'self: Self'")
    for index in 0..collections.length(complete_module.functions):
        let function = complete_module.functions[index]
        if function.asynchronous:
            let async_result = type_arguments(function.result_type)
            if type_base(function.result_type) != "Result" or collections.length(async_result) != 2 or async_result[1] != "String":
                state = lower_issue(state, "R4106", function.line, function.column, "async functions must return Result[T, String]")
            if function.native_import or function.native_export:
                state = lower_issue(state, "R4106", function.line, function.column, "async functions cannot be native imports or exports")
        if collection_contains_native(complete_module, function.result_type):
            state = lower_error(state, function.line, function.column, "collections cannot contain native values")
        for parameter_index in 0..collections.length(function.parameters):
            if collection_contains_native(complete_module, function.parameters[parameter_index].type_name):
                state = lower_error(state, function.parameters[parameter_index].line, function.parameters[parameter_index].column, "collections cannot contain native values")
        if function.native_constant:
            if not is_native_primitive(function.result_type) or function.result_type == "Unit":
                state = lower_error(state, function.line, function.column, "extern constants must use Int, Float, Bool, or Char")
            if collections.length(function.body) != 1 or collections.length(function.body[0].expressions) != 1 or not native_constant_literal(function.body[0].expressions[0]):
                state = lower_error(state, function.line, function.column, "native constant initializer must be a primitive literal")
            function_symbols = append(function_symbols, -1)
            continue
        if function.method_owner != "":
            let owner_base = type_base(function.method_owner)
            if find_struct_index(complete_module, owner_base) < 0 and find_enum_index(complete_module, owner_base) < 0:
                state = lower_error(state, function.line, function.column, "impl owner must be a struct or enum type")
            for parameter_index in 0..collections.length(function.parameters):
                let parameter = function.parameters[parameter_index]
                if parameter.name == "self":
                    if parameter_index != 0:
                        state = lower_error(state, parameter.line, parameter.column, "'self' must be the first method parameter")
                    else:
                        if parameter.type_name != function.method_owner:
                            state = lower_error(state, parameter.line, parameter.column, string.concat("method receiver must have impl type ", function.method_owner))
            if function.method_trait != "":
                let trait_index = find_trait_index(complete_module, function.method_trait)
                if trait_index < 0:
                    state = lower_error(state, function.line, function.column, string.concat("unknown trait '", string.concat(function.method_trait, "'")))
                else:
                    let pieces = string.split(function.name, ".")
                    let member = pieces[collections.length(pieces) - 1]
                    var required_method = -1
                    let trait_declaration = complete_module.traits[trait_index]
                    for method_index in 0..collections.length(trait_declaration.methods):
                        if trait_declaration.methods[method_index].name == member:
                            required_method = method_index
                    if required_method < 0:
                        state = lower_error(state, function.line, function.column, string.concat("trait has no method '", string.concat(member, "'")))
                    else:
                        let required = trait_declaration.methods[required_method]
                        let self_substitution = Substitutions(["Self"], [function.method_owner])
                        if collections.length(required.parameters) != collections.length(function.parameters) or substitute_type(required.result_type, self_substitution) != function.result_type:
                            state = lower_error(state, function.line, function.column, "trait method signature does not match")
                        for parameter_index in 0..collections.length(required.parameters):
                            if parameter_index < collections.length(function.parameters) and substitute_type(required.parameters[parameter_index].type_name, self_substitution) != function.parameters[parameter_index].type_name:
                                state = lower_error(state, function.line, function.column, "trait method signature does not match")
        for constraint_index in 0..collections.length(function.constraints):
            let constraint = function.constraints[constraint_index]
            if not contains_string(function.type_parameters, constraint.type_parameter):
                state = lower_error(state, constraint.line, constraint.column, string.concat("unknown constrained type parameter '", string.concat(constraint.type_parameter, "'")))
            if find_trait_index(complete_module, constraint.trait_name) < 0:
                state = lower_error(state, constraint.line, constraint.column, string.concat("unknown trait '", string.concat(constraint.trait_name, "'")))
        if collections.length(function.type_parameters) == 0:
            var parameter_types: Array[String] = []
            for parameter_index in 0..collections.length(function.parameters):
                parameter_types = append(parameter_types, function.parameters[parameter_index].type_name)
            let added = add_hir_symbol(state, symbol_function(), function.name, function.result_type, false, parameter_types, intrinsic_none())
            state = set_hir_native_symbol(added.state, added.symbol, function.native_import, function.native_export, function.native_name)
            state = set_hir_async_symbol(state, added.symbol, function.asynchronous)
            if function.native_import or function.native_export:
                for parameter_index in 0..collections.length(parameter_types):
                    let parameter_type = parameter_types[parameter_index]
                    let foreign_index = foreign_type_index(complete_module, parameter_type)
                    if not is_native_abi_value(complete_module, parameter_type) or parameter_type == "Unit" or foreign_index >= 0 and complete_module.structs[foreign_index].representation == representation_native():
                        state = lower_error(state, function.line, function.column, "native function parameters must use primitive, Pointer, opaque, or callback types")
                let result_index = foreign_type_index(complete_module, function.result_type)
                if not is_native_abi_value(complete_module, function.result_type) or result_index >= 0 and complete_module.structs[result_index].representation == representation_native() or function.native_export and result_index >= 0 and complete_module.structs[result_index].representation == representation_callback():
                    state = lower_error(state, function.line, function.column, "native function result must use primitive, Pointer, opaque, or Unit type")
            function_symbols = append(function_symbols, added.symbol)
        else:
            function_symbols = append(function_symbols, -1)
    for index in 0..collections.length(complete_module.functions):
        if function_symbols[index] >= 0 and not complete_module.functions[index].native_import:
            let lowered = lower_hir_function(state, index, function_symbols[index], Substitutions([], []))
            state = state_functions(lowered.state, append(lowered.state.functions, lowered.function))
    var pending_index = 0
    while pending_index < collections.length(state.pending):
        let pending = state.pending[pending_index]
        let lowered = lower_hir_function(state, pending.function_index, pending.symbol, pending.substitutions)
        state = state_functions(lowered.state, append(lowered.state.functions, lowered.function))
        pending_index = pending_index + 1
    return HirResult(HirModule(state.symbols, state.module.structs, state.module.enums, state.functions, library), state.diagnostics)

fn analyze_source(source: String) -> HirResult:
    let parsed = parse_source(source)
    return lower_to_hir(parsed.module, parsed.diagnostics, false)

fn analyze_program(source_path: String) -> HirResult:
    let parsed = parse_program(source_path)
    return lower_to_hir(parsed.module, parsed.diagnostics, false)

fn analyze_program_kind(source_path: String, library: Bool) -> HirResult:
    let parsed = parse_program(source_path)
    return lower_to_hir(parsed.module, parsed.diagnostics, library)

fn analyze_program_kind_target(source_path: String, target_root: String, library: Bool) -> HirResult:
    let parsed = parse_program_target(source_path, target_root)
    return lower_to_hir(parsed.module, parsed.diagnostics, library)

fn empty_mir_operand() -> MirOperand:
    return MirOperand(-1, "", "Unit", false)

fn mir_state_locals(state: MirState, locals: Array[MirLocal]) -> MirState:
    return MirState(state.module, locals, state.symbol_locals, state.blocks, state.current_block, state.current_instructions, state.terminated, state.next_block, state.break_targets, state.continue_targets, state.diagnostics)

fn mir_state_symbol_locals(state: MirState, symbol_locals: Array[MirSymbolLocal]) -> MirState:
    return MirState(state.module, state.locals, symbol_locals, state.blocks, state.current_block, state.current_instructions, state.terminated, state.next_block, state.break_targets, state.continue_targets, state.diagnostics)

fn mir_state_blocks(state: MirState, blocks: Array[MirBlock]) -> MirState:
    return MirState(state.module, state.locals, state.symbol_locals, blocks, state.current_block, state.current_instructions, state.terminated, state.next_block, state.break_targets, state.continue_targets, state.diagnostics)

fn mir_state_current(state: MirState, block: Int, instructions: Array[MirInstruction], terminated: Bool) -> MirState:
    return MirState(state.module, state.locals, state.symbol_locals, state.blocks, block, instructions, terminated, state.next_block, state.break_targets, state.continue_targets, state.diagnostics)

fn mir_state_next_block(state: MirState, next_block: Int) -> MirState:
    return MirState(state.module, state.locals, state.symbol_locals, state.blocks, state.current_block, state.current_instructions, state.terminated, next_block, state.break_targets, state.continue_targets, state.diagnostics)

fn mir_state_loops(state: MirState, break_targets: Array[Int], continue_targets: Array[Int]) -> MirState:
    return MirState(state.module, state.locals, state.symbol_locals, state.blocks, state.current_block, state.current_instructions, state.terminated, state.next_block, break_targets, continue_targets, state.diagnostics)

fn mir_error(state: MirState, line: Int, column: Int, message: String) -> MirState:
    let diagnostic = make_diagnostic("R9001", line, column, message)
    return MirState(state.module, state.locals, state.symbol_locals, state.blocks, state.current_block, state.current_instructions, state.terminated, state.next_block, state.break_targets, state.continue_targets, append(state.diagnostics, diagnostic))

fn add_mir_local(state: MirState, type_name: String, parameter: Bool) -> MirOperandResult:
    let id = collections.length(state.locals)
    let next = mir_state_locals(state, append(state.locals, MirLocal(id, type_name, parameter)))
    return MirOperandResult(MirOperand(id, "", type_name, false), next)

fn bind_mir_symbol(state: MirState, symbol: Int, local: Int) -> MirState:
    return mir_state_symbol_locals(state, append(state.symbol_locals, MirSymbolLocal(symbol, local)))

fn mir_local_for_symbol(state: MirState, symbol: Int) -> Int:
    let length = collections.length(state.symbol_locals)
    for offset in 0..length:
        let mapping = state.symbol_locals[length - offset - 1]
        if mapping.symbol == symbol:
            return mapping.local
    return -1

fn emit_mir_instruction(state: MirState, instruction: MirInstruction) -> MirState:
    if state.terminated:
        return mir_error(state, 1, 1, "instruction emitted after a MIR terminator")
    return mir_state_current(state, state.current_block, append(state.current_instructions, instruction), false)

fn finish_mir_block(state: MirState, terminator: MirTerminator) -> MirState:
    if state.terminated:
        return state
    let block = MirBlock(state.current_block, state.current_instructions, terminator)
    let next = mir_state_blocks(state, append(state.blocks, block))
    return mir_state_current(next, state.current_block, [], true)

fn start_mir_block(state: MirState, block: Int) -> MirState:
    return mir_state_current(state, block, [], false)

fn allocate_mir_block(state: MirState) -> MirBlockResult:
    return MirBlockResult(state.next_block, mir_state_next_block(state, state.next_block + 1))

fn goto_terminator(block_target: Int) -> MirTerminator:
    return MirTerminator(terminator_goto(), block_target, -1, -1, empty_mir_operand(), empty_mir_operand(), false)

fn branch_terminator(condition: MirOperand, then_target: Int, else_target: Int) -> MirTerminator:
    return MirTerminator(terminator_branch(), -1, then_target, else_target, condition, empty_mir_operand(), false)

fn return_terminator(returned: MirOperand, has_returned: Bool) -> MirTerminator:
    return MirTerminator(terminator_return(), -1, -1, -1, empty_mir_operand(), returned, has_returned)

fn emit_copy(state: MirState, destination: Int, source: MirOperand, type_name: String) -> MirState:
    var next = state
    if managed_type_for_structs(state.module.structs, type_name):
        next = emit_mir_instruction(next, MirInstruction(mir_retain(), -1, [source], -1, -1, "", type_name))
        let previous = MirOperand(destination, "", type_name, false)
        next = emit_mir_instruction(next, MirInstruction(mir_release(), -1, [previous], -1, -1, "", type_name))
    return emit_mir_instruction(next, MirInstruction(mir_copy(), destination, [source], -1, -1, "", type_name))

fn lower_mir_short_circuit(state: MirState, expression: HirExpr) -> MirOperandResult:
    let destination = add_mir_local(state, "Bool", false)
    let left = lower_mir_expression(destination.state, expression.children[0])
    let right_block = allocate_mir_block(left.state)
    let short_block = allocate_mir_block(right_block.state)
    let join_block = allocate_mir_block(short_block.state)
    var next = join_block.state
    if expression.text == "and":
        next = finish_mir_block(next, branch_terminator(left.operand, right_block.block, short_block.block))
    else:
        next = finish_mir_block(next, branch_terminator(left.operand, short_block.block, right_block.block))
    next = start_mir_block(next, short_block.block)
    var short_text = "false"
    if expression.text == "or":
        short_text = "true"
    let short_value = MirOperand(-1, short_text, "Bool", true)
    next = emit_copy(next, destination.operand.local, short_value, "Bool")
    next = finish_mir_block(next, goto_terminator(join_block.block))
    next = start_mir_block(next, right_block.block)
    let right = lower_mir_expression(next, expression.children[1])
    next = emit_copy(right.state, destination.operand.local, right.operand, "Bool")
    next = finish_mir_block(next, goto_terminator(join_block.block))
    next = start_mir_block(next, join_block.block)
    return MirOperandResult(destination.operand, next)

fn lower_mir_expression(state: MirState, expression: HirExpr) -> MirOperandResult:
    if expression.kind == expr_name():
        let local = mir_local_for_symbol(state, expression.symbol)
        if local < 0:
            let next = mir_error(state, expression.line, expression.column, "HIR name has no MIR local")
            return MirOperandResult(MirOperand(-1, "", expression.type_name, false), next)
        return MirOperandResult(MirOperand(local, "", expression.type_name, false), state)
    if expression.kind == expr_binary() and(expression.text == "and" or expression.text == "or"):
        return lower_mir_short_circuit(state, expression)
    if expression.kind == expr_propagate():
        let value = lower_mir_expression(state, expression.children[0])
        let tag = add_mir_local(value.state, "Int", false)
        var next = emit_mir_instruction(tag.state, MirInstruction(mir_tag(), tag.operand.local, [value.operand], -1, -1, "", "Int"))
        let success = allocate_mir_block(next)
        let failure = allocate_mir_block(success.state)
        let join = allocate_mir_block(failure.state)
        let condition = add_mir_local(join.state, "Bool", false)
        let ok_tag = MirOperand(-1, "0", "Int", true)
        next = emit_mir_instruction(condition.state, MirInstruction(mir_binary(), condition.operand.local, [tag.operand, ok_tag], -1, -1, "==", "Bool"))
        next = finish_mir_block(next, branch_terminator(condition.operand, success.block, failure.block))
        next = start_mir_block(next, failure.block)
        next = finish_mir_block(next, return_terminator(value.operand, true))
        next = start_mir_block(next, success.block)
        let destination = add_mir_local(next, expression.type_name, false)
        next = emit_mir_instruction(destination.state, MirInstruction(mir_field(), destination.operand.local, [value.operand], -1, 0, "", expression.type_name))
        next = finish_mir_block(next, goto_terminator(join.block))
        next = start_mir_block(next, join.block)
        return MirOperandResult(destination.operand, next)
    if expression.kind == expr_function_ref():
        let destination = add_mir_local(state, expression.type_name, false)
        let instruction = MirInstruction(mir_constant(), destination.operand.local, [], expression.symbol, -1, string.from_int(expression.symbol), expression.type_name)
        return MirOperandResult(destination.operand, emit_mir_instruction(destination.state, instruction))
    if expression.kind == expr_integer() or expression.kind == expr_float() or expression.kind == expr_character() or expression.kind == expr_string() or expression.kind == expr_bool():
        let destination = add_mir_local(state, expression.type_name, false)
        let instruction = MirInstruction(mir_constant(), destination.operand.local, [], -1, -1, expression.text, expression.type_name)
        return MirOperandResult(destination.operand, emit_mir_instruction(destination.state, instruction))
    var next = state
    var operands: Array[MirOperand] = []
    for index in 0..collections.length(expression.children):
        let child = lower_mir_expression(next, expression.children[index])
        next = child.state
        operands = append(operands, child.operand)
    let destination = add_mir_local(next, expression.type_name, false)
    next = destination.state
    var instruction_kind = mir_copy()
    if expression.kind == expr_unary():
        instruction_kind = mir_unary()
    if expression.kind == expr_binary():
        instruction_kind = mir_binary()
    if expression.kind == expr_call():
        if expression.symbol < 0 and expression.field >= 0:
            instruction_kind = mir_aggregate()
        else:
            if expression.text == "$async":
                instruction_kind = mir_async_call()
            else:
                instruction_kind = mir_call()
    if expression.kind == expr_await():
        instruction_kind = mir_await()
    if expression.kind == expr_array():
        instruction_kind = mir_array()
    if expression.kind == expr_index():
        instruction_kind = mir_index()
    if expression.kind == expr_slice():
        instruction_kind = mir_slice()
    if expression.kind == expr_field():
        instruction_kind = mir_field()
    let instruction = MirInstruction(instruction_kind, destination.operand.local, operands, expression.symbol, expression.field, expression.text, expression.type_name)
    return MirOperandResult(destination.operand, emit_mir_instruction(next, instruction))

fn lower_mir_block(state: MirState, statements: Array[HirStatement]) -> MirState:
    var next = state
    for index in 0..collections.length(statements):
        if next.terminated:
            break
        next = lower_mir_statement(next, statements[index])
    return next

fn lower_mir_if(state: MirState, statement: HirStatement) -> MirState:
    let condition = lower_mir_expression(state, statement.expressions[0])
    let then_block = allocate_mir_block(condition.state)
    let else_block = allocate_mir_block(then_block.state)
    let join_block = allocate_mir_block(else_block.state)
    var next = finish_mir_block(join_block.state, branch_terminator(condition.operand, then_block.block, else_block.block))
    next = start_mir_block(next, then_block.block)
    next = lower_mir_block(next, statement.body)
    let then_terminated = next.terminated
    if not next.terminated:
        next = finish_mir_block(next, goto_terminator(join_block.block))
    next = start_mir_block(next, else_block.block)
    next = lower_mir_block(next, statement.else_body)
    let else_terminated = next.terminated
    if not next.terminated:
        next = finish_mir_block(next, goto_terminator(join_block.block))
    if then_terminated and else_terminated:
        return mir_state_current(next, join_block.block, [], true)
    return start_mir_block(next, join_block.block)

fn lower_mir_while(state: MirState, statement: HirStatement) -> MirState:
    let condition_block = allocate_mir_block(state)
    let body_block = allocate_mir_block(condition_block.state)
    let exit_block = allocate_mir_block(body_block.state)
    var next = finish_mir_block(exit_block.state, goto_terminator(condition_block.block))
    next = start_mir_block(next, condition_block.block)
    let condition = lower_mir_expression(next, statement.expressions[0])
    next = finish_mir_block(condition.state, branch_terminator(condition.operand, body_block.block, exit_block.block))
    next = start_mir_block(next, body_block.block)
    next = mir_state_loops(next, append(next.break_targets, exit_block.block), append(next.continue_targets, condition_block.block))
    next = lower_mir_block(next, statement.body)
    next = mir_state_loops(next, prefix(next.break_targets, collections.length(next.break_targets) - 1), prefix(next.continue_targets, collections.length(next.continue_targets) - 1))
    if not next.terminated:
        next = finish_mir_block(next, goto_terminator(condition_block.block))
    return start_mir_block(next, exit_block.block)

fn lower_mir_for(state: MirState, statement: HirStatement) -> MirState:
    let start = lower_mir_expression(state, statement.expressions[0])
    let end = lower_mir_expression(start.state, statement.expressions[1])
    let variable = add_mir_local(end.state, "Int", false)
    var next = bind_mir_symbol(variable.state, statement.symbol, variable.operand.local)
    next = emit_copy(next, variable.operand.local, start.operand, "Int")
    let condition_block = allocate_mir_block(next)
    let body_block = allocate_mir_block(condition_block.state)
    let increment_block = allocate_mir_block(body_block.state)
    let exit_block = allocate_mir_block(increment_block.state)
    next = finish_mir_block(exit_block.state, goto_terminator(condition_block.block))
    next = start_mir_block(next, condition_block.block)
    let condition = add_mir_local(next, "Bool", false)
    next = emit_mir_instruction(condition.state, MirInstruction(mir_binary(), condition.operand.local, [variable.operand, end.operand], -1, -1, "<", "Bool"))
    next = finish_mir_block(next, branch_terminator(condition.operand, body_block.block, exit_block.block))
    next = start_mir_block(next, body_block.block)
    next = mir_state_loops(next, append(next.break_targets, exit_block.block), append(next.continue_targets, increment_block.block))
    next = lower_mir_block(next, statement.body)
    next = mir_state_loops(next, prefix(next.break_targets, collections.length(next.break_targets) - 1), prefix(next.continue_targets, collections.length(next.continue_targets) - 1))
    if not next.terminated:
        next = finish_mir_block(next, goto_terminator(increment_block.block))
    next = start_mir_block(next, increment_block.block)
    let one = MirOperand(-1, "1", "Int", true)
    let incremented = add_mir_local(next, "Int", false)
    next = emit_mir_instruction(incremented.state, MirInstruction(mir_binary(), incremented.operand.local, [variable.operand, one], -1, -1, "+", "Int"))
    next = emit_copy(next, variable.operand.local, incremented.operand, "Int")
    next = finish_mir_block(next, goto_terminator(condition_block.block))
    return start_mir_block(next, exit_block.block)

fn lower_mir_for_each(state: MirState, statement: HirStatement) -> MirState:
    let iterator = lower_mir_expression(state, statement.expressions[0])
    let cursor = add_mir_local(iterator.state, iterator.operand.type_name, false)
    var next = bind_mir_symbol(cursor.state, statement.symbol, cursor.operand.local)
    next = emit_copy(next, cursor.operand.local, iterator.operand, iterator.operand.type_name)
    let condition_block = allocate_mir_block(next)
    let body_block = allocate_mir_block(condition_block.state)
    let advance_block = allocate_mir_block(body_block.state)
    let exit_block = allocate_mir_block(advance_block.state)
    next = finish_mir_block(exit_block.state, goto_terminator(condition_block.block))
    next = start_mir_block(next, condition_block.block)
    let condition = lower_mir_expression(next, statement.expressions[1])
    next = finish_mir_block(condition.state, branch_terminator(condition.operand, body_block.block, exit_block.block))
    next = start_mir_block(next, body_block.block)
    let value = lower_mir_expression(next, statement.expressions[2])
    let variable = add_mir_local(value.state, value.operand.type_name, false)
    next = bind_mir_symbol(variable.state, statement.extra_symbol, variable.operand.local)
    next = emit_copy(next, variable.operand.local, value.operand, value.operand.type_name)
    next = mir_state_loops(next, append(next.break_targets, exit_block.block), append(next.continue_targets, advance_block.block))
    next = lower_mir_block(next, statement.body)
    next = mir_state_loops(next, prefix(next.break_targets, collections.length(next.break_targets) - 1), prefix(next.continue_targets, collections.length(next.continue_targets) - 1))
    if not next.terminated:
        next = finish_mir_block(next, goto_terminator(advance_block.block))
    next = start_mir_block(next, advance_block.block)
    let advanced = lower_mir_expression(next, statement.expressions[3])
    next = emit_copy(advanced.state, cursor.operand.local, advanced.operand, advanced.operand.type_name)
    next = finish_mir_block(next, goto_terminator(condition_block.block))
    return start_mir_block(next, exit_block.block)

fn lower_mir_match(state: MirState, statement: HirStatement) -> MirState:
    let value = lower_mir_expression(state, statement.expressions[0])
    let tag = add_mir_local(value.state, "Int", false)
    var next = emit_mir_instruction(tag.state, MirInstruction(mir_tag(), tag.operand.local, [value.operand], -1, -1, "", "Int"))
    let exit_block = allocate_mir_block(next)
    next = exit_block.state
    var reaches_exit = false
    for case_index in 0..collections.length(statement.cases):
        let match_case = statement.cases[case_index]
        let case_block = allocate_mir_block(next)
        next = case_block.state
        var next_check = -1
        if case_index + 1 < collections.length(statement.cases):
            let allocated_check = allocate_mir_block(next)
            next_check = allocated_check.block
            next = allocated_check.state
        else:
            next_check = exit_block.block
        if match_case.tag < 0 or case_index + 1 == collections.length(statement.cases):
            next = finish_mir_block(next, goto_terminator(case_block.block))
        else:
            let condition = add_mir_local(next, "Bool", false)
            let expected = MirOperand(-1, string.from_int(match_case.tag), "Int", true)
            next = emit_mir_instruction(condition.state, MirInstruction(mir_binary(), condition.operand.local, [tag.operand, expected], -1, -1, "==", "Bool"))
            next = finish_mir_block(next, branch_terminator(condition.operand, case_block.block, next_check))
        next = start_mir_block(next, case_block.block)
        for binding_index in 0..collections.length(match_case.bindings):
            let symbol = match_case.bindings[binding_index]
            let local = add_mir_local(next, next.module.symbols[symbol].type_name, false)
            next = bind_mir_symbol(local.state, symbol, local.operand.local)
            next = emit_mir_instruction(next, MirInstruction(mir_field(), local.operand.local, [value.operand], -1, binding_index, "", local.operand.type_name))
        next = lower_mir_block(next, match_case.body)
        if not next.terminated:
            reaches_exit = true
            next = finish_mir_block(next, goto_terminator(exit_block.block))
        if case_index + 1 < collections.length(statement.cases):
            next = start_mir_block(next, next_check)
    if not reaches_exit:
        return mir_state_current(next, exit_block.block, [], true)
    return start_mir_block(next, exit_block.block)

fn lower_mir_statement(state: MirState, statement: HirStatement) -> MirState:
    if statement.kind == statement_unsafe():
        return lower_mir_block(state, statement.body)
    if statement.kind == statement_binding():
        let value = lower_mir_expression(state, statement.expressions[0])
        let destination = add_mir_local(value.state, value.operand.type_name, false)
        var next = bind_mir_symbol(destination.state, statement.symbol, destination.operand.local)
        return emit_copy(next, destination.operand.local, value.operand, value.operand.type_name)
    if statement.kind == statement_assignment():
        let value = lower_mir_expression(state, statement.expressions[0])
        let destination = mir_local_for_symbol(value.state, statement.symbol)
        return emit_copy(value.state, destination, value.operand, value.operand.type_name)
    if statement.kind == statement_index_assignment():
        let index = lower_mir_expression(state, statement.expressions[0])
        let value = lower_mir_expression(index.state, statement.expressions[1])
        let destination = mir_local_for_symbol(value.state, statement.symbol)
        let array_type = value.state.module.symbols[statement.symbol].type_name
        let array = MirOperand(destination, "", array_type, false)
        let updated = add_mir_local(value.state, array_type, false)
        var next = emit_mir_instruction(updated.state, MirInstruction(mir_array_update(), updated.operand.local, [array, index.operand, value.operand], -1, -1, "", array_type))
        return emit_copy(next, destination, updated.operand, array_type)
    if statement.kind == statement_expression():
        let value = lower_mir_expression(state, statement.expressions[0])
        return value.state
    if statement.kind == statement_return():
        if collections.length(statement.expressions) == 0:
            return finish_mir_block(state, return_terminator(empty_mir_operand(), false))
        let value = lower_mir_expression(state, statement.expressions[0])
        return finish_mir_block(value.state, return_terminator(value.operand, true))
    if statement.kind == statement_if():
        return lower_mir_if(state, statement)
    if statement.kind == statement_while():
        return lower_mir_while(state, statement)
    if statement.kind == statement_for():
        return lower_mir_for(state, statement)
    if statement.kind == statement_for_each():
        return lower_mir_for_each(state, statement)
    if statement.kind == statement_break():
        if collections.length(state.break_targets) == 0:
            return mir_error(state, statement.line, statement.column, "MIR break has no target")
        return finish_mir_block(state, goto_terminator(state.break_targets[collections.length(state.break_targets) - 1]))
    if statement.kind == statement_continue():
        if collections.length(state.continue_targets) == 0:
            return mir_error(state, statement.line, statement.column, "MIR continue has no target")
        return finish_mir_block(state, goto_terminator(state.continue_targets[collections.length(state.continue_targets) - 1]))
    if statement.kind == statement_match():
        return lower_mir_match(state, statement)
    return mir_error(state, statement.line, statement.column, "unsupported HIR statement reached MIR")

fn add_explicit_ownership(module: HirModule, function: MirFunction) -> MirFunction:
    var blocks: Array[MirBlock] = []
    for block_index in 0..collections.length(function.blocks):
        let block = function.blocks[block_index]
        var instructions = block.instructions
        if block.terminator.kind == terminator_return():
            if block.terminator.has_returned and managed_type_for_structs(module.structs, function.result_type):
                instructions = append(instructions, MirInstruction(mir_retain(), -1, [block.terminator.returned], -1, -1, "return transfer", function.result_type))
            for local_index in 0..collections.length(function.locals):
                let local = function.locals[local_index]
                if managed_type_for_structs(module.structs, local.type_name) and not local.parameter:
                    instructions = append(instructions, MirInstruction(mir_release(), -1, [MirOperand(local.id, "", local.type_name, false)], -1, -1, "function cleanup", local.type_name))
        blocks = append(blocks, MirBlock(block.id, instructions, block.terminator))
    return MirFunction(function.symbol, function.parameters, function.locals, blocks, function.result_type, function.asynchronous)

fn build_mir_function(module: HirModule, function: HirFunction, input_diagnostics: Array[Diagnostic]) -> MirFunctionBuildResult:
    var state = MirState(module, [], [], [], 0, [], false, 1, [], [], input_diagnostics)
    var parameters: Array[Int] = []
    for index in 0..collections.length(function.parameters):
        let symbol = function.parameters[index]
        let local = add_mir_local(state, module.symbols[symbol].type_name, true)
        state = bind_mir_symbol(local.state, symbol, local.operand.local)
        parameters = append(parameters, local.operand.local)
    state = lower_mir_block(state, function.body)
    if not state.terminated:
        if function.result_type == "Unit":
            state = finish_mir_block(state, return_terminator(empty_mir_operand(), false))
        else:
            state = mir_error(state, 1, 1, "non-Unit MIR function can reach its end")
            let fallback = MirOperand(-1, "0", function.result_type, true)
            state = finish_mir_block(state, return_terminator(fallback, true))
    let lowered = MirFunction(function.symbol, parameters, state.locals, state.blocks, function.result_type, function.asynchronous)
    return MirFunctionBuildResult(add_explicit_ownership(module, lowered), state.diagnostics)

fn block_exists(blocks: Array[MirBlock], id: Int) -> Bool:
    for index in 0..collections.length(blocks):
        if blocks[index].id == id:
            return true
    return false

fn verify_mir_function(function: MirFunction, diagnostics: Array[Diagnostic]) -> Array[Diagnostic]:
    var result = diagnostics
    for block_index in 0..collections.length(function.blocks):
        let block = function.blocks[block_index]
        for instruction_index in 0..collections.length(block.instructions):
            let instruction = block.instructions[instruction_index]
            if instruction.kind != mir_retain() and instruction.kind != mir_release() and(instruction.destination < 0 or instruction.destination >= collections.length(function.locals)):
                result = append(result, make_diagnostic("R9001", 1, 1, "MIR instruction destination is out of range"))
            for operand_index in 0..collections.length(instruction.operands):
                let operand = instruction.operands[operand_index]
                if not operand.is_constant and(operand.local < 0 or operand.local >= collections.length(function.locals)):
                    result = append(result, make_diagnostic("R9001", 1, 1, "MIR instruction operand is out of range"))
            if instruction.kind == mir_array_update():
                if collections.length(instruction.operands) != 3 or type_base(instruction.type_name) != "Array":
                    result = append(result, make_diagnostic("R9001", 1, 1, "invalid Array update instruction"))
                else:
                    if instruction.operands[0].type_name != instruction.type_name or instruction.operands[1].type_name != "Int" or instruction.operands[2].type_name != collection_element_type(instruction.type_name):
                        result = append(result, make_diagnostic("R9001", 1, 1, "Array update operand type mismatch"))
            if instruction.kind == mir_async_call() and type_base(instruction.type_name) != "Task":
                result = append(result, make_diagnostic("R9001", 1, 1, "async MIR call must produce Task[T]"))
            if instruction.kind == mir_await():
                if not function.asynchronous or collections.length(instruction.operands) != 1 or type_base(instruction.operands[0].type_name) != "Task" or type_base(instruction.type_name) != "Result":
                    result = append(result, make_diagnostic("R9001", 1, 1, "invalid await MIR instruction"))
        if block.terminator.kind == terminator_goto() and not block_exists(function.blocks, block.terminator.target):
            result = append(result, make_diagnostic("R9001", 1, 1, "MIR goto target does not exist"))
        if block.terminator.kind == terminator_branch() and(not block_exists(function.blocks, block.terminator.then_target) or not block_exists(function.blocks, block.terminator.else_target)):
            result = append(result, make_diagnostic("R9001", 1, 1, "MIR branch target does not exist"))
    return result

fn lower_to_mir(hir: HirModule, input_diagnostics: Array[Diagnostic]) -> MirResult:
    var functions: Array[MirFunction] = []
    var diagnostics = input_diagnostics
    for index in 0..collections.length(hir.functions):
        let built = build_mir_function(hir, hir.functions[index], diagnostics)
        functions = append(functions, built.function)
        diagnostics = verify_mir_function(built.function, built.diagnostics)
    return MirResult(MirModule(hir.symbols, hir.structs, functions, hir.library), diagnostics)

fn compile_to_mir(source: String) -> MirResult:
    let hir = analyze_source(source)
    return lower_to_mir(hir.module, hir.diagnostics)

fn compile_program_to_mir(source_path: String) -> MirResult:
    let hir = analyze_program(source_path)
    return lower_to_mir(hir.module, hir.diagnostics)

fn compile_program_to_mir_kind(source_path: String, library: Bool) -> MirResult:
    let hir = analyze_program_kind(source_path, library)
    return lower_to_mir(hir.module, hir.diagnostics)

fn compile_program_to_mir_kind_target(source_path: String, target_root: String, library: Bool) -> MirResult:
    let hir = analyze_program_kind_target(source_path, target_root, library)
    return lower_to_mir(hir.module, hir.diagnostics)

fn llvm_type(type_name: String) -> String:
    if type_name == "Int":
        return "i64"
    if type_name == "Float":
        return "double"
    if type_name == "Bool":
        return "i1"
    if type_name == "Char" or type_name == "Unit":
        return "i8"
    return "ptr"

fn llvm_result_type(type_name: String) -> String:
    if type_name == "Unit":
        return "void"
    return llvm_type(type_name)

fn native_llvm_type(type_name: String) -> String:
    if type_name == "Unit":
        return "void"
    if type_name == "Int":
        return "i64"
    if type_name == "Float":
        return "double"
    if type_name == "Bool" or type_name == "Char":
        return "i8"
    return "ptr"

fn callback_wrapper_name(symbol: Int) -> String:
    return string.concat("@rocket_callback_", string.from_int(symbol))

fn native_symbol_name(symbol: HirSymbol) -> String:
    return string.concat("@", symbol.native_name)

fn mir_function_for_symbol(module: MirModule, symbol: Int) -> Int:
    for index in 0..collections.length(module.functions):
        if module.functions[index].symbol == symbol:
            return index
    return -1

fn callback_declaration_for_type(module: MirModule, type_name: String) -> Int:
    for index in 0..collections.length(module.structs):
        if module.structs[index].name == type_name and module.structs[index].representation == representation_callback():
            return index
    return -1

fn symbol_matches_callback(module: MirModule, symbol: HirSymbol, callback_declaration: AstStructDecl) -> Bool:
    if symbol.native_import or collections.length(symbol.parameter_types) != collections.length(callback_declaration.callback_parameters) or symbol.type_name != callback_declaration.callback_result:
        return false
    for index in 0..collections.length(symbol.parameter_types):
        if symbol.parameter_types[index] != callback_declaration.callback_parameters[index].type_name:
            return false
    return mir_function_for_symbol(module, symbol.id) >= 0

fn managed_type(type_name: String) -> Bool:
    return type_name != "Int" and type_name != "Float" and type_name != "Bool" and type_name != "Char" and type_name != "Unit" and type_name != "<invalid>" and type_base(type_name) != "Pointer"

fn managed_type_for_structs(structs: Array[AstStructDecl], type_name: String) -> Bool:
    if not managed_type(type_name):
        return false
    let base = type_base(type_name)
    for index in 0..collections.length(structs):
        if structs[index].name == base and structs[index].representation != representation_rocket():
            return false
    return true

fn llvm_zero(type_name: String) -> String:
    if llvm_type(type_name) == "ptr":
        return "null"
    if type_name == "Float":
        return "0.000000e+00"
    return "0"

fn llvm_function_name(symbol: Int) -> String:
    return string.concat("@rocket_fn_", string.from_int(symbol))

fn llvm_async_entry_name(symbol: Int) -> String:
    return string.concat("@rocket_async_entry_", string.from_int(symbol))

fn llvm_local_name(local: Int) -> String:
    return string.concat("%l", string.from_int(local))

fn emit_llvm_line(builder: std.string.Builder, line: String) -> Unit:
    string.builder_append(builder, line)
    string.builder_append(builder, "\n")

fn hex_digit(value: Int) -> String:
    return string.slice("0123456789ABCDEF", value, value + 1)

fn llvm_escape_bytes(value: String) -> String:
    let builder = string.builder()
    for index in 0..string.byte_length(value):
        let byte = string.byte_value_at(value, index)
        let high = byte / 16
        let low = byte - high * 16
        string.builder_append(builder, "\\")
        string.builder_append(builder, hex_digit(high))
        string.builder_append(builder, hex_digit(low))
    return string.builder_finish(builder)

fn llvm_constant_value(operand: MirOperand) -> String:
    if operand.type_name == "Bool":
        if operand.constant == "true":
            return "1"
        return "0"
    if operand.type_name == "Char":
        if string.byte_length(operand.constant) == 0:
            return "0"
        return string.from_int(string.byte_value_at(operand.constant, 0))
    return operand.constant

fn load_llvm_operand(builder: std.string.Builder, operand: MirOperand, name: String) -> LlvmValue:
    if operand.is_constant:
        return LlvmValue(llvm_constant_value(operand), operand.type_name)
    let type_name = llvm_type(operand.type_name)
    emit_llvm_line(builder, string.concat("  %", string.concat(name, string.concat(" = load ", string.concat(type_name, string.concat(", ptr ", llvm_local_name(operand.local)))))))
    return LlvmValue(string.concat("%", name), operand.type_name)

fn release_old_destination(builder: std.string.Builder, local: Int, type_name: String, name: String) -> Unit:
    if managed_type(type_name):
        let old_name = string.concat("%", string.concat(name, "_old"))
        emit_llvm_line(builder, string.concat("  ", string.concat(old_name, string.concat(" = load ptr, ptr ", llvm_local_name(local)))))
        emit_llvm_line(builder, string.concat("  call void @rocket_rt_release(ptr ", string.concat(old_name, ")")))

fn store_owned_llvm(builder: std.string.Builder, local: Int, value: LlvmValue, name: String) -> Unit:
    emit_llvm_line(builder, string.concat("  store ", string.concat(llvm_type(value.type_name), string.concat(" ", string.concat(value.name, string.concat(", ptr ", llvm_local_name(local)))))))

fn store_copied_llvm(builder: std.string.Builder, local: Int, value: LlvmValue, name: String) -> Unit:
    store_owned_llvm(builder, local, value, name)

fn cleanup_llvm_locals(builder: std.string.Builder, function: MirFunction, name: String) -> Unit:
    for index in 0..collections.length(function.locals):
        let local = function.locals[index]
        if managed_type(local.type_name) and not local.parameter:
            let loaded = string.concat("%", string.concat(name, string.concat("_cleanup_", string.from_int(index))))
            emit_llvm_line(builder, string.concat("  ", string.concat(loaded, string.concat(" = load ptr, ptr ", llvm_local_name(local.id)))))
            emit_llvm_line(builder, string.concat("  call void @rocket_rt_release(ptr ", string.concat(loaded, ")")))

fn llvm_element_kind(type_name: String) -> Int:
    if type_name == "Int":
        return 1
    if type_name == "Float":
        return 2
    if type_name == "Bool":
        return 3
    if type_name == "Char":
        return 4
    if type_name == "String":
        return 5
    return 6

