{
  "version": 6,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 25,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "windows-base",
      "hidden": true,
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/out/build/${presetName}",
      "cacheVariables": {
        "CMAKE_C_COMPILER": "$env{ROCKET_MSVC_COMPILER}",
        "CMAKE_CXX_COMPILER": "$env{ROCKET_MSVC_COMPILER}",
        "CMAKE_AR": "$env{ROCKET_MSVC_LIBRARIAN}",
        "CMAKE_LINKER": "$env{ROCKET_MSVC_LINKER}",
        "LLVM_DIR": "$env{LLVM_DIR}",
        "ROCKETC_ENABLE_LLVM": "ON"
      }
    },
    {
      "name": "windows-debug",
      "inherits": "windows-base",
      "displayName": "Frozen-path-compatible Windows x64 Debug",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Debug" }
    },
    {
      "name": "windows-release",
      "inherits": "windows-base",
      "displayName": "Frozen Rocket 2.0 Windows x64 Release path (do not use for Phase 19)",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Release" }
    },
    {
      "name": "windows-asan",
      "inherits": "windows-base",
      "displayName": "Windows x64 AddressSanitizer",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "ROCKETC_ENABLE_SANITIZERS": "ON",
        "ROCKETC_ENABLE_LLVM": "OFF"
      }
    },
    {
      "name": "phase19-windows-base",
      "hidden": true,
      "inherits": "windows-base",
      "binaryDir": "${sourceDir}/out/phase19/build/${presetName}",
      "cacheVariables": {
        "ROCKET_EXPECTED_NATIVE_TARGET": "windows-x64"
      }
    },
    {
      "name": "phase19-native-base",
      "hidden": true,
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/out/phase19/build/${presetName}",
      "cacheVariables": {
        "CMAKE_C_COMPILER": "$env{ROCKET_HOST_C_COMPILER}",
        "CMAKE_CXX_COMPILER": "$env{ROCKET_HOST_CXX_COMPILER}",
        "CMAKE_AR": "$env{ROCKET_HOST_AR}",
        "CMAKE_LINKER": "$env{ROCKET_HOST_LINKER}",
        "LLVM_DIR": "$env{LLVM_DIR}",
        "ROCKETC_ENABLE_LLVM": "ON"
      }
    },
    {
      "name": "phase19-windows-x64-debug",
      "inherits": "phase19-windows-base",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Debug" }
    },
    {
      "name": "phase19-windows-x64-release",
      "inherits": "phase19-windows-base",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Release" }
    },
    {
      "name": "phase19-windows-x64-stage0-debug",
      "inherits": "phase19-windows-base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "ROCKETC_ENABLE_LLVM": "OFF"
      }
    },
    {
      "name": "phase19-windows-x64-stage0-release",
      "inherits": "phase19-windows-base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "ROCKETC_ENABLE_LLVM": "OFF"
      }
    },
    {
      "name": "phase19-linux-x64-debug",
      "inherits": "phase19-native-base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "ROCKET_EXPECTED_NATIVE_TARGET": "linux-x64"
      }
    },
    {
      "name": "phase19-linux-x64-release",
      "inherits": "phase19-native-base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "ROCKET_EXPECTED_NATIVE_TARGET": "linux-x64"
      }
    },
    {
      "name": "phase19-linux-x64-stage0-debug",
      "inherits": "phase19-native-base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "ROCKETC_ENABLE_LLVM": "OFF",
        "ROCKET_EXPECTED_NATIVE_TARGET": "linux-x64"
      }
    },
    {
      "name": "phase19-linux-x64-stage0-release",
      "inherits": "phase19-native-base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "ROCKETC_ENABLE_LLVM": "OFF",
        "ROCKET_EXPECTED_NATIVE_TARGET": "linux-x64"
      }
    },
    {
      "name": "phase19-linux-arm64-debug",
      "inherits": "phase19-native-base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "ROCKET_EXPECTED_NATIVE_TARGET": "linux-arm64"
      }
    },
    {
      "name": "phase19-linux-arm64-release",
      "inherits": "phase19-native-base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "ROCKET_EXPECTED_NATIVE_TARGET": "linux-arm64"
      }
    },
    {
      "name": "phase19-linux-arm64-stage0-debug",
      "inherits": "phase19-native-base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "ROCKETC_ENABLE_LLVM": "OFF",
        "ROCKET_EXPECTED_NATIVE_TARGET": "linux-arm64"
      }
    },
    {
      "name": "phase19-linux-arm64-stage0-release",
      "inherits": "phase19-native-base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "ROCKETC_ENABLE_LLVM": "OFF",
        "ROCKET_EXPECTED_NATIVE_TARGET": "linux-arm64"
      }
    },
    {
      "name": "phase19-macos-arm64-debug",
      "inherits": "phase19-native-base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "ROCKET_EXPECTED_NATIVE_TARGET": "macos-arm64"
      }
    },
    {
      "name": "phase19-macos-arm64-release",
      "inherits": "phase19-native-base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "ROCKET_EXPECTED_NATIVE_TARGET": "macos-arm64"
      }
    },
    {
      "name": "phase19-macos-arm64-stage0-debug",
      "inherits": "phase19-native-base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "ROCKETC_ENABLE_LLVM": "OFF",
        "ROCKET_EXPECTED_NATIVE_TARGET": "macos-arm64"
      }
    },
    {
      "name": "phase19-macos-arm64-stage0-release",
      "inherits": "phase19-native-base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "ROCKETC_ENABLE_LLVM": "OFF",
        "ROCKET_EXPECTED_NATIVE_TARGET": "macos-arm64"
      }
    }
  ],
  "buildPresets": [
    { "name": "windows-debug", "configurePreset": "windows-debug" },
    { "name": "windows-release", "configurePreset": "windows-release" },
    { "name": "windows-asan", "configurePreset": "windows-asan" },
    { "name": "phase19-windows-x64-debug", "configurePreset": "phase19-windows-x64-debug" },
    { "name": "phase19-windows-x64-release", "configurePreset": "phase19-windows-x64-release" },
    { "name": "phase19-windows-x64-stage0-debug", "configurePreset": "phase19-windows-x64-stage0-debug" },
    { "name": "phase19-windows-x64-stage0-release", "configurePreset": "phase19-windows-x64-stage0-release" },
    { "name": "phase19-linux-x64-debug", "configurePreset": "phase19-linux-x64-debug" },
    { "name": "phase19-linux-x64-release", "configurePreset": "phase19-linux-x64-release" },
    { "name": "phase19-linux-x64-stage0-debug", "configurePreset": "phase19-linux-x64-stage0-debug" },
    { "name": "phase19-linux-x64-stage0-release", "configurePreset": "phase19-linux-x64-stage0-release" },
    { "name": "phase19-linux-arm64-debug", "configurePreset": "phase19-linux-arm64-debug" },
    { "name": "phase19-linux-arm64-release", "configurePreset": "phase19-linux-arm64-release" },
    { "name": "phase19-linux-arm64-stage0-debug", "configurePreset": "phase19-linux-arm64-stage0-debug" },
    { "name": "phase19-linux-arm64-stage0-release", "configurePreset": "phase19-linux-arm64-stage0-release" },
    { "name": "phase19-macos-arm64-debug", "configurePreset": "phase19-macos-arm64-debug" },
    { "name": "phase19-macos-arm64-release", "configurePreset": "phase19-macos-arm64-release" },
    { "name": "phase19-macos-arm64-stage0-debug", "configurePreset": "phase19-macos-arm64-stage0-debug" },
    { "name": "phase19-macos-arm64-stage0-release", "configurePreset": "phase19-macos-arm64-stage0-release" }
  ],
  "testPresets": [
    { "name": "windows-debug", "configurePreset": "windows-debug", "output": { "outputOnFailure": true } },
    { "name": "windows-release", "configurePreset": "windows-release", "output": { "outputOnFailure": true } },
    { "name": "windows-asan", "configurePreset": "windows-asan", "output": { "outputOnFailure": true } },
    { "name": "phase19-windows-x64-debug", "configurePreset": "phase19-windows-x64-debug", "output": { "outputOnFailure": true } },
    { "name": "phase19-windows-x64-release", "configurePreset": "phase19-windows-x64-release", "output": { "outputOnFailure": true } },
    { "name": "phase19-windows-x64-stage0-debug", "configurePreset": "phase19-windows-x64-stage0-debug", "output": { "outputOnFailure": true } },
    { "name": "phase19-windows-x64-stage0-release", "configurePreset": "phase19-windows-x64-stage0-release", "output": { "outputOnFailure": true } },
    { "name": "phase19-linux-x64-debug", "configurePreset": "phase19-linux-x64-debug", "output": { "outputOnFailure": true } },
    { "name": "phase19-linux-x64-release", "configurePreset": "phase19-linux-x64-release", "output": { "outputOnFailure": true } },
    { "name": "phase19-linux-x64-stage0-debug", "configurePreset": "phase19-linux-x64-stage0-debug", "output": { "outputOnFailure": true } },
    { "name": "phase19-linux-x64-stage0-release", "configurePreset": "phase19-linux-x64-stage0-release", "output": { "outputOnFailure": true } },
    { "name": "phase19-linux-arm64-debug", "configurePreset": "phase19-linux-arm64-debug", "output": { "outputOnFailure": true } },
    { "name": "phase19-linux-arm64-release", "configurePreset": "phase19-linux-arm64-release", "output": { "outputOnFailure": true } },
    { "name": "phase19-linux-arm64-stage0-debug", "configurePreset": "phase19-linux-arm64-stage0-debug", "output": { "outputOnFailure": true } },
    { "name": "phase19-linux-arm64-stage0-release", "configurePreset": "phase19-linux-arm64-stage0-release", "output": { "outputOnFailure": true } },
    { "name": "phase19-macos-arm64-debug", "configurePreset": "phase19-macos-arm64-debug", "output": { "outputOnFailure": true } },
    { "name": "phase19-macos-arm64-release", "configurePreset": "phase19-macos-arm64-release", "output": { "outputOnFailure": true } },
    { "name": "phase19-macos-arm64-stage0-debug", "configurePreset": "phase19-macos-arm64-stage0-debug", "output": { "outputOnFailure": true } },
    { "name": "phase19-macos-arm64-stage0-release", "configurePreset": "phase19-macos-arm64-stage0-release", "output": { "outputOnFailure": true } }
  ]
}
