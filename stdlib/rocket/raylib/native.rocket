# Reviewed primitive-only declarations for the production raylib adapter.
# Application code uses rocket.raylib.safe instead of importing this module.

pub extern fn rlv_buffer_create() -> Int
pub extern fn rlv_buffer_push(buffer_id: Int, byte_value: Char) -> Int
pub extern fn rlv_buffer_destroy(buffer_id: Int) -> Int
pub extern fn rlv_window_open(width: Int, height: Int, title_buffer_id: Int) -> Int
pub extern fn rlv_window_close(window_id: Int) -> Int
pub extern fn rlv_begin_drawing(window_id: Int) -> Int
pub extern fn rlv_end_drawing(frame_id: Int) -> Int
pub extern fn rlv_abort_drawing(frame_id: Int) -> Int
pub extern fn rlv_font_load(window_id: Int, path_buffer_id: Int) -> Int
pub extern fn rlv_font_default(window_id: Int) -> Int
pub extern fn rlv_font_measure(font_id: Int, text_buffer_id: Int, size: Float, spacing: Float, line_height: Float, max_width: Float, max_height: Float, wrap: Bool, overflow: Int) -> Int
pub extern fn rlv_text_layout_width(layout_id: Int) -> Float
pub extern fn rlv_text_layout_height(layout_id: Int) -> Float
pub extern fn rlv_text_layout_baseline(layout_id: Int) -> Float
pub extern fn rlv_text_layout_line_height(layout_id: Int) -> Float
pub extern fn rlv_text_layout_line_count(layout_id: Int) -> Int
pub extern fn rlv_text_layout_clipped(layout_id: Int) -> Bool
pub extern fn rlv_text_layout_ellipsized(layout_id: Int) -> Bool
pub extern fn rlv_text_layout_destroy(layout_id: Int) -> Int
pub extern fn rlv_font_draw_layout(frame_id: Int, font_id: Int, text_buffer_id: Int, bounds_x: Float, bounds_y: Float, bounds_width: Float, bounds_height: Float, size: Float, spacing: Float, line_height: Float, horizontal_align: Int, vertical_align: Int, wrap: Bool, clip: Bool, overflow: Int, red: Int, green: Int, blue: Int, alpha: Int) -> Int
pub extern fn rlv_font_invalidate_measurements(font_id: Int) -> Int
pub extern fn rlv_font_unload(font_id: Int) -> Int
