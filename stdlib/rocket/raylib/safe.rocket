    unsafe:
        return status_result(native.rlv_draw_line(frame.id, start_x, start_y, end_x, end_y, red, green, blue, alpha))

pub fn draw_thick_line(frame: Frame, start_x: Float, start_y: Float, end_x: Float, end_y: Float, thickness: Float, red: Int, green: Int, blue: Int, alpha: Int) -> Result[Bool, String]:
    if not finite(start_x) or not finite(start_y) or not finite(end_x) or not finite(end_y) or not finite(thickness) or thickness < 0.0 or not valid_color(red, green, blue, alpha):
