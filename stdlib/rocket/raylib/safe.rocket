    unsafe:
        return status_result(native.rlv_window_set_borderless(window.id, enabled))

pub fn load_texture(window: Window, path: String) -> Result[Texture, String]:
    match encode_text(path):
        case Err(error):
            return Err(error)
        case Ok(buffer_id):
            var texture_id = 0
            unsafe:
                texture_id = native.rlv_texture_load(window.id, buffer_id)
            let released = release_text(buffer_id)
            if texture_id > 0:
                return Ok(Texture(texture_id))
            return Err(status_message(texture_id))

pub fn texture_width(texture: Texture) -> Result[Int, String]:
    unsafe:
        let width = native.rlv_texture_width(texture.id)
        if width < 0:
            return Err(status_message(width))
        return Ok(width)

pub fn texture_height(texture: Texture) -> Result[Int, String]:
    unsafe:
        let height = native.rlv_texture_height(texture.id)
        if height < 0:
            return Err(status_message(height))
        return Ok(height)

pub fn unload_texture(texture: Texture) -> Result[Bool, String]:
    unsafe:
        return status_result(native.rlv_texture_unload(texture.id))

pub fn draw_texture(frame: Frame, texture: Texture, x: Int, y: Int, tint: Color) -> Result[Bool, String]:
    if not valid_color(tint.red, tint.green, tint.blue, tint.alpha):
        return invalid_geometry()
    unsafe:
        return status_result(native.rlv_texture_draw(frame.id, texture.id, x, y, tint.red, tint.green, tint.blue, tint.alpha))

pub fn draw_texture_scaled(frame: Frame, texture: Texture, x: Int, y: Int, scale: Float, tint: Color) -> Result[Bool, String]:
    if not finite(scale) or scale <= 0.0 or not valid_color(tint.red, tint.green, tint.blue, tint.alpha):
        return invalid_geometry()
    unsafe:
        return status_result(native.rlv_texture_draw_scaled(frame.id, texture.id, x, y, scale, tint.red, tint.green, tint.blue, tint.alpha))

# Negative source width or height flips artwork within the selected atlas region.
pub fn draw_texture_pro(frame: Frame, texture: Texture, source: graphics.Rect, dest: graphics.Rect, origin: graphics.Vec2, rotation: Float, tint: Color) -> Result[Bool, String]:
    if not finite(source.x) or not finite(source.y) or not finite(source.width) or not finite(source.height) or source.width == 0.0 or source.height == 0.0 or source.x < 0.0 or source.y < 0.0:
        return invalid_geometry()
    if not valid_rect(dest.x, dest.y, dest.width, dest.height) or not finite(origin.x) or not finite(origin.y) or not finite(rotation) or not valid_color(tint.red, tint.green, tint.blue, tint.alpha):
        return invalid_geometry()
    unsafe:
        return status_result(native.rlv_texture_draw_pro(frame.id, texture.id, source.x, source.y, source.width, source.height, dest.x, dest.y, dest.width, dest.height, origin.x, origin.y, rotation, tint.red, tint.green, tint.blue, tint.alpha))

pub fn texture_filter_supported(value: TextureFilter) -> Bool:
    if not filter_is_valid(value):
        return false
    unsafe:
        return native.rlv_texture_filter_supported(value.mode)

pub fn texture_max_anisotropy() -> Float:
    unsafe:
        return native.rlv_texture_max_anisotropy()

pub fn get_texture_filter(texture: Texture) -> Result[TextureFilter, String]:
    unsafe:
        let mode = native.rlv_texture_get_filter(texture.id)
        if mode < 0:
            return Err(status_message(mode))
        return Ok(TextureFilter(mode))

pub fn set_texture_filter(window: Window, texture: Texture, value: TextureFilter) -> Result[Bool, String]:
    if not filter_is_valid(value):
        return Err("raylib: invalid argument")
    if not texture_is_valid(texture):
        return Err("raylib: stale or already released handle")
    if not texture_filter_supported(value):
        return Err("raylib: device or backend unavailable")
    unsafe:
        return status_result(native.rlv_texture_set_filter(window.id, texture.id, value.mode))

pub fn set_texture_filter_with_fallback(window: Window, texture: Texture, preferred: TextureFilter, fallback: TextureFilter) -> Result[TextureFilter, String]:
    if not filter_is_valid(preferred) or not filter_is_valid(fallback):
        return Err("raylib: invalid argument")
    if texture_filter_supported(preferred):
        match set_texture_filter(window, texture, preferred):
            case Ok(success):
                return Ok(preferred)
            case Err(error):
                if error != "raylib: device or backend unavailable":
                    return Err(error)
    match set_texture_filter(window, texture, fallback):
        case Ok(success):
            return Ok(fallback)
        case Err(error):
            return Err(error)

pub fn create_render_texture(window: Window, width: Int, height: Int) -> Result[RenderTexture, String]:
    if width <= 0 or height <= 0:
        return Err("raylib: invalid argument")
    unsafe:
        let target_id = native.rlv_render_texture_load(window.id, width, height)
        if target_id > 0:
            return Ok(RenderTexture(target_id))
        return Err(status_message(target_id))

pub fn render_texture_width(target: RenderTexture) -> Result[Float, String]:
    if not render_texture_is_valid(target):
        return Err("raylib: stale or already released handle")
    unsafe:
        return Ok(native.rlv_render_texture_width_f64(target.id))

pub fn render_texture_height(target: RenderTexture) -> Result[Float, String]:
    if not render_texture_is_valid(target):
        return Err("raylib: stale or already released handle")
    unsafe:
        return Ok(native.rlv_render_texture_height_f64(target.id))

pub fn set_render_texture_filter(window: Window, target: RenderTexture, value: TextureFilter) -> Result[Bool, String]:
    if value.mode != 0 and value.mode != 1:
        return Err("raylib: invalid argument")
    unsafe:
        return status_result(native.rlv_render_texture_set_filter(window.id, target.id, value.mode))

pub fn get_render_texture_filter(target: RenderTexture) -> Result[TextureFilter, String]:
    unsafe:
        let mode = native.rlv_render_texture_get_filter(target.id)
