pub fn save_screenshot(window: Window, path: String) -> Result[Bool, String]:
    match encode_text(path):
        case Err(error):
            return Err(error)
        case Ok(buffer_id):
            var status = -2
            unsafe:
                status = native.rlv_window_screenshot(window.id, buffer_id)
            let released = release_text(buffer_id)
            if status != 0:
                return Err(status_message(status))
            return released

