import rocket.graphics
import rocket.raylib.native
import std.string

# Production-safe typography access to the reviewed primitive-only raylib
# adapter. Native layout tokens never escape this module.

pub struct Window:
    id: Int

pub struct Frame:
    id: Int

pub struct Font:
    id: Int

pub struct Color:
    red: Int
    green: Int
    blue: Int
    alpha: Int

pub fn color(red: Int, green: Int, blue: Int, alpha: Int = 255) -> Color:
    return Color(red, green, blue, alpha)

fn status_message(status: Int) -> String:
    if status == -1:
        return "raylib: invalid argument"
    if status == -2:
        return "raylib: invalid lifecycle state"
    if status == -3:
        return "raylib: font or asset not found"
    if status == -4:
        return "raylib: owned resource is still live"
    if status == -5:
        return "raylib: device or backend unavailable"
    if status == -6:
        return "raylib: stale or already released handle"
    return "raylib: unknown native failure"

fn status_result(status: Int) -> Result[Bool, String]:
    if status == 0:
        return Ok(true)
    return Err(status_message(status))

fn finite(value: Float) -> Bool:
    return value == value and value - value == 0.0

fn valid_color_channel(channel: Int) -> Bool:
    return channel >= 0 and channel <= 255

fn valid_color(value: Color) -> Bool:
    return valid_color_channel(value.red) and valid_color_channel(value.green) and valid_color_channel(value.blue) and valid_color_channel(value.alpha)

fn encode_text(value: String) -> Result[Int, String]:
    unsafe:
        let buffer_id = native.rlv_buffer_create()
        if buffer_id <= 0:
            return Err(status_message(buffer_id))
        var index = 0
        while index < string.byte_length(value):
            let status = native.rlv_buffer_push(buffer_id, string.byte_at(value, index))
            if status != 0:
                native.rlv_buffer_destroy(buffer_id)
                return Err(status_message(status))
            index = index + 1
        return Ok(buffer_id)

fn release_text(buffer_id: Int) -> Result[Bool, String]:
    unsafe:
        return status_result(native.rlv_buffer_destroy(buffer_id))

pub fn open_window(width: Int, height: Int, title: String) -> Result[Window, String]:
    match encode_text(title):
        case Err(error):
            return Err(error)
        case Ok(buffer_id):
            var window_id = -2
            unsafe:
                window_id = native.rlv_window_open(width, height, buffer_id)
            let released = release_text(buffer_id)
            if window_id <= 0:
                return Err(status_message(window_id))
            return Ok(Window(window_id))

pub fn close_window(window: Window) -> Result[Bool, String]:
    unsafe:
        return status_result(native.rlv_window_close(window.id))

pub fn begin_frame(window: Window) -> Result[Frame, String]:
    unsafe:
        let frame_id = native.rlv_begin_drawing(window.id)
        if frame_id <= 0:
            return Err(status_message(frame_id))
        return Ok(Frame(frame_id))

pub fn end_frame(frame: Frame) -> Result[Bool, String]:
    unsafe:
        return status_result(native.rlv_end_drawing(frame.id))

pub fn abort_frame(frame: Frame) -> Result[Bool, String]:
    unsafe:
        return status_result(native.rlv_abort_drawing(frame.id))

pub fn load_font(window: Window, path: String) -> Result[Font, String]:
    if window.id <= 0:
        return Err("raylib: stale or already released handle")
    match encode_text(path):
        case Err(error):
            return Err(error)
        case Ok(buffer_id):
            var font_id = -2
            unsafe:
                font_id = native.rlv_font_load(window.id, buffer_id)
            let released = release_text(buffer_id)
            if font_id <= 0:
                return Err(status_message(font_id))
            return Ok(Font(font_id))

pub fn default_font(window: Window) -> Result[Font, String]:
    if window.id <= 0:
        return Err("raylib: stale or already released handle")
    unsafe:
        let font_id = native.rlv_font_default(window.id)
        if font_id <= 0:
            return Err(status_message(font_id))
        return Ok(Font(font_id))

fn consume_text_layout(layout_id: Int) -> Result[graphics.TextLayout, String]:
    if layout_id <= 0:
        return Err(status_message(layout_id))
    var width = 0.0
    var height = 0.0
    var baseline = 0.0
    var line_height = 0.0
    var line_count = 0
    var clipped = false
    var ellipsized = false
    var destroy_status = -2
    unsafe:
        width = native.rlv_text_layout_width(layout_id)
        height = native.rlv_text_layout_height(layout_id)
        baseline = native.rlv_text_layout_baseline(layout_id)
        line_height = native.rlv_text_layout_line_height(layout_id)
        line_count = native.rlv_text_layout_line_count(layout_id)
        clipped = native.rlv_text_layout_clipped(layout_id)
        ellipsized = native.rlv_text_layout_ellipsized(layout_id)
        destroy_status = native.rlv_text_layout_destroy(layout_id)
    if destroy_status != 0:
        return Err(status_message(destroy_status))
    let metrics = graphics.text_metrics(width, height, baseline, line_height)
    return Ok(graphics.text_layout(metrics, graphics.rect(0.0, 0.0, width, height), line_count, clipped, ellipsized))

pub fn measure_text(font: Font, text: String, style: graphics.TextStyle, max_width: Float = 0.0, max_height: Float = 0.0, wrap: Bool = false, overflow: Int = 0) -> Result[graphics.TextLayout, String]:
    if font.id <= 0:
        return Err("raylib: stale or already released handle")
    if not graphics.text_style_is_valid(style) or not finite(max_width) or not finite(max_height) or max_width < 0.0 or max_height < 0.0:
        return Err("raylib: invalid argument")
    if overflow != graphics.text_overflow_clip() and overflow != graphics.text_overflow_ellipsis():
        return Err("raylib: invalid argument")
    match encode_text(text):
        case Err(error):
            return Err(error)
        case Ok(buffer_id):
            var layout_id = -2
            unsafe:
                layout_id = native.rlv_font_measure(font.id, buffer_id, style.size, style.letter_spacing, style.line_height, max_width, max_height, wrap, overflow)
            match release_text(buffer_id):
                case Err(error):
                    return Err(error)
                case Ok(released):
                    if not released:
                        return Err("raylib: stale or already released handle")
                    return consume_text_layout(layout_id)

pub fn draw_text_layout(frame: Frame, font: Font, text: String, bounds: graphics.Rect, style: graphics.TextStyle, value: Color, horizontal_align: Int = 0, vertical_align: Int = 0, wrap: Bool = false, clip: Bool = true, overflow: Int = 0) -> Result[Bool, String]:
    if frame.id <= 0 or font.id <= 0:
        return Err("raylib: stale or already released handle")
    if not graphics.rect_has_nonnegative_size(bounds) or bounds.width <= 0.0 or bounds.height <= 0.0 or not graphics.text_style_is_valid(style) or not valid_color(value):
        return Err("raylib: invalid argument")
    if horizontal_align < graphics.text_align_left() or horizontal_align > graphics.text_align_right():
        return Err("raylib: invalid argument")
    if vertical_align < graphics.text_align_top() or vertical_align > graphics.text_align_bottom():
        return Err("raylib: invalid argument")
    if overflow != graphics.text_overflow_clip() and overflow != graphics.text_overflow_ellipsis():
        return Err("raylib: invalid argument")
    match encode_text(text):
        case Err(error):
            return Err(error)
        case Ok(buffer_id):
            var status = -2
            unsafe:
                status = native.rlv_font_draw_layout(frame.id, font.id, buffer_id, bounds.x, bounds.y, bounds.width, bounds.height, style.size, style.letter_spacing, style.line_height, horizontal_align, vertical_align, wrap, clip, overflow, value.red, value.green, value.blue, value.alpha)
            match release_text(buffer_id):
                case Err(error):
                    return Err(error)
                case Ok(released):
                    if not released:
                        return Err("raylib: stale or already released handle")
                    return status_result(status)

pub fn invalidate_font_measurements(font: Font) -> Result[Bool, String]:
    if font.id <= 0:
        return Err("raylib: stale or already released handle")
    unsafe:
        return status_result(native.rlv_font_invalidate_measurements(font.id))

pub fn unload_font(font: Font) -> Result[Bool, String]:
    if font.id <= 0:
        return Err("raylib: stale or already released handle")
    unsafe:
        return status_result(native.rlv_font_unload(font.id))
