# Narrow bundled Rocket wrapper over the reviewed primitive raylib adapter.
# Every native call is isolated inside this module's unsafe blocks; applications
# and higher-level Rocket libraries exchange value-owned tokens and Results.

import rocket.graphics
import rocket.raylib.native
import std.string

pub struct Window:
    id: Int

pub struct Frame:
    id: Int

pub struct RenderTexture:
    id: Int

pub struct RenderTargetScope:
    id: Int

pub struct ScissorScope:
    id: Int

pub struct Font:
    id: Int

pub struct Color:
    red: Int
    green: Int
    blue: Int
    alpha: Int

pub fn color(red: Int, green: Int, blue: Int, alpha: Int = 255) -> Color:
    return Color(red, green, blue, alpha)

fn status_message(status: Int) -> String:
    if status == -1:
        return "raylib: invalid argument"
    if status == -2:
        return "raylib: invalid lifecycle state"
    if status == -3:
        return "raylib: asset or uniform not found"
    if status == -4:
        return "raylib: owned resource is still live"
    if status == -5:
        return "raylib: device or backend unavailable"
    if status == -6:
        return "raylib: stale or already released handle"
    if status == -7:
        return "raylib: invalid shader program"
    if status == -8:
        return "raylib: shader uniform type mismatch or unsupported type"
    if status == -12:
        return "raylib: bounded resource capacity exceeded"
    return "raylib: unknown native failure"

fn status_result(status: Int) -> Result[Bool, String]:
    if status == 0:
        return Ok(true)
    return Err(status_message(status))

fn finite(value: Float) -> Bool:
    return value == value and value - value == 0.0

fn valid_color(red: Int, green: Int, blue: Int, alpha: Int) -> Bool:
    return red >= 0 and red <= 255 and green >= 0 and green <= 255 and blue >= 0 and blue <= 255 and alpha >= 0 and alpha <= 255

fn valid_rect(x: Float, y: Float, width: Float, height: Float) -> Bool:
    return finite(x) and finite(y) and finite(width) and finite(height) and width >= 0.0 and height >= 0.0

fn valid_circle(x: Float, y: Float, radius: Float) -> Bool:
    return finite(x) and finite(y) and finite(radius) and radius >= 0.0

fn invalid_geometry() -> Result[Bool, String]:
    return Err("raylib: invalid argument")

fn window_is_valid(window: Window) -> Bool:
    unsafe:
        return native.rlv_window_logical_width(window.id) > 0

fn render_texture_is_valid(target: RenderTexture) -> Bool:
    unsafe:
        return native.rlv_render_texture_width(target.id) > 0

fn valid_input_code(value: Int) -> Bool:
    return value >= 0 and value <= 2147483647

fn encode_text(value: String) -> Result[Int, String]:
    unsafe:
        let buffer_id = native.rlv_buffer_create()
        if buffer_id <= 0:
            return Err(status_message(buffer_id))
        var index = 0
        while index < string.byte_length(value):
            let status = native.rlv_buffer_push(buffer_id, string.byte_at(value, index))
            if status != 0:
                native.rlv_buffer_destroy(buffer_id)
                return Err(status_message(status))
            index = index + 1
        return Ok(buffer_id)

fn release_text(buffer_id: Int) -> Result[Bool, String]:
    unsafe:
        return status_result(native.rlv_buffer_destroy(buffer_id))

pub fn open_window(width: Int, height: Int, title: String) -> Result[Window, String]:
    if width <= 0 or height <= 0:
        return Err("raylib: invalid argument")
    match encode_text(title):
        case Err(error):
            return Err(error)
        case Ok(buffer_id):
            var window_id = 0
            unsafe:
                window_id = native.rlv_window_open(width, height, buffer_id)
            let released = release_text(buffer_id)
            if window_id > 0:
                return Ok(Window(window_id))
            return Err(status_message(window_id))

pub fn close_window(window: Window) -> Result[Bool, String]:
    unsafe:
        return status_result(native.rlv_window_close(window.id))

pub fn begin_frame(window: Window) -> Result[Frame, String]:
    unsafe:
        let frame_id = native.rlv_begin_drawing(window.id)
        if frame_id > 0:
            return Ok(Frame(frame_id))
        return Err(status_message(frame_id))

pub fn end_frame(frame: Frame) -> Result[Bool, String]:
    unsafe:
        return status_result(native.rlv_end_drawing(frame.id))

pub fn abort_frame(frame: Frame) -> Result[Bool, String]:
    unsafe:
        return status_result(native.rlv_abort_drawing(frame.id))

pub fn draw_rect(frame: Frame, x: Float, y: Float, width: Float, height: Float, red: Int, green: Int, blue: Int, alpha: Int) -> Result[Bool, String]:
    if not valid_rect(x, y, width, height) or not valid_color(red, green, blue, alpha):
        return invalid_geometry()
    unsafe:
        return status_result(native.rlv_draw_rectangle_gradient_vertical(frame.id, x, y, width, height, red, green, blue, alpha, red, green, blue, alpha))

pub fn draw_rect_outline(frame: Frame, x: Float, y: Float, width: Float, height: Float, thickness: Float, red: Int, green: Int, blue: Int, alpha: Int) -> Result[Bool, String]:
    if not valid_rect(x, y, width, height) or not finite(thickness) or thickness < 0.0 or not valid_color(red, green, blue, alpha):
        return invalid_geometry()
    unsafe:
        return status_result(native.rlv_draw_rectangle_outline(frame.id, x, y, width, height, thickness, red, green, blue, alpha))

pub fn draw_rounded_rect(frame: Frame, x: Float, y: Float, width: Float, height: Float, roundness: Float, red: Int, green: Int, blue: Int, alpha: Int) -> Result[Bool, String]:
    if not valid_rect(x, y, width, height) or not finite(roundness) or roundness < 0.0 or roundness > 1.0 or not valid_color(red, green, blue, alpha):
        return invalid_geometry()
    unsafe:
        return status_result(native.rlv_draw_rounded_rectangle(frame.id, x, y, width, height, roundness, red, green, blue, alpha))

pub fn draw_rounded_rect_outline(frame: Frame, x: Float, y: Float, width: Float, height: Float, roundness: Float, thickness: Float, red: Int, green: Int, blue: Int, alpha: Int) -> Result[Bool, String]:
    if not valid_rect(x, y, width, height) or not finite(roundness) or roundness < 0.0 or roundness > 1.0 or not finite(thickness) or thickness < 0.0 or not valid_color(red, green, blue, alpha):
        return invalid_geometry()
    unsafe:
        return status_result(native.rlv_draw_rounded_rectangle_outline(frame.id, x, y, width, height, roundness, thickness, red, green, blue, alpha))

pub fn draw_circle(frame: Frame, x: Float, y: Float, radius: Float, red: Int, green: Int, blue: Int, alpha: Int) -> Result[Bool, String]:
    if not valid_circle(x, y, radius) or not valid_color(red, green, blue, alpha):
        return invalid_geometry()
    unsafe:
        return status_result(native.rlv_draw_circle_gradient(frame.id, x, y, radius, red, green, blue, alpha, red, green, blue, alpha))

pub fn draw_circle_outline(frame: Frame, x: Float, y: Float, radius: Float, thickness: Float, red: Int, green: Int, blue: Int, alpha: Int) -> Result[Bool, String]:
    if not valid_circle(x, y, radius) or not finite(thickness) or thickness < 0.0 or not valid_color(red, green, blue, alpha):
        return invalid_geometry()
    unsafe:
        return status_result(native.rlv_draw_circle_outline(frame.id, x, y, radius, thickness, red, green, blue, alpha))

pub fn draw_ellipse(frame: Frame, x: Float, y: Float, radius_x: Float, radius_y: Float, red: Int, green: Int, blue: Int, alpha: Int) -> Result[Bool, String]:
    if not finite(x) or not finite(y) or not finite(radius_x) or not finite(radius_y) or radius_x < 0.0 or radius_y < 0.0 or not valid_color(red, green, blue, alpha):
        return invalid_geometry()
    unsafe:
        return status_result(native.rlv_draw_ellipse(frame.id, x, y, radius_x, radius_y, red, green, blue, alpha))

pub fn draw_ring(frame: Frame, x: Float, y: Float, inner_radius: Float, outer_radius: Float, red: Int, green: Int, blue: Int, alpha: Int) -> Result[Bool, String]:
    if not finite(x) or not finite(y) or not finite(inner_radius) or not finite(outer_radius) or inner_radius < 0.0 or outer_radius < inner_radius or not valid_color(red, green, blue, alpha):
        return invalid_geometry()
    unsafe:
        return status_result(native.rlv_draw_ring(frame.id, x, y, inner_radius, outer_radius, red, green, blue, alpha))

pub fn draw_ring_sector(frame: Frame, x: Float, y: Float, inner_radius: Float, outer_radius: Float, start_angle: Float, end_angle: Float, red: Int, green: Int, blue: Int, alpha: Int) -> Result[Bool, String]:
    if not finite(x) or not finite(y) or not finite(inner_radius) or not finite(outer_radius) or inner_radius < 0.0 or outer_radius < inner_radius or not finite(start_angle) or not finite(end_angle) or not valid_color(red, green, blue, alpha):
        return invalid_geometry()
    unsafe:
        return status_result(native.rlv_draw_ring_sector(frame.id, x, y, inner_radius, outer_radius, start_angle, end_angle, red, green, blue, alpha))

pub fn draw_sector(frame: Frame, x: Float, y: Float, radius: Float, start_angle: Float, end_angle: Float, red: Int, green: Int, blue: Int, alpha: Int) -> Result[Bool, String]:
    if not valid_circle(x, y, radius) or not finite(start_angle) or not finite(end_angle) or not valid_color(red, green, blue, alpha):
        return invalid_geometry()
    unsafe:
        return status_result(native.rlv_draw_circle_sector(frame.id, x, y, radius, start_angle, end_angle, red, green, blue, alpha))

pub fn draw_line(frame: Frame, start_x: Float, start_y: Float, end_x: Float, end_y: Float, red: Int, green: Int, blue: Int, alpha: Int) -> Result[Bool, String]:
    if not finite(start_x) or not finite(start_y) or not finite(end_x) or not finite(end_y) or not valid_color(red, green, blue, alpha):
        return invalid_geometry()
    unsafe:
        return status_result(native.rlv_draw_line(frame.id, start_x, start_y, end_x, end_y, red, green, blue, alpha))

pub fn draw_thick_line(frame: Frame, start_x: Float, start_y: Float, end_x: Float, end_y: Float, thickness: Float, red: Int, green: Int, blue: Int, alpha: Int) -> Result[Bool, String]:
    if not finite(start_x) or not finite(start_y) or not finite(end_x) or not finite(end_y) or not finite(thickness) or thickness < 0.0 or not valid_color(red, green, blue, alpha):
        return invalid_geometry()
    unsafe:
        return status_result(native.rlv_draw_thick_line(frame.id, start_x, start_y, end_x, end_y, thickness, red, green, blue, alpha))

pub fn draw_triangle(frame: Frame, first_x: Float, first_y: Float, second_x: Float, second_y: Float, third_x: Float, third_y: Float, red: Int, green: Int, blue: Int, alpha: Int) -> Result[Bool, String]:
    if not finite(first_x) or not finite(first_y) or not finite(second_x) or not finite(second_y) or not finite(third_x) or not finite(third_y) or not valid_color(red, green, blue, alpha):
        return invalid_geometry()
    unsafe:
        return status_result(native.rlv_draw_triangle(frame.id, first_x, first_y, second_x, second_y, third_x, third_y, red, green, blue, alpha))

pub fn draw_triangle_outline(frame: Frame, first_x: Float, first_y: Float, second_x: Float, second_y: Float, third_x: Float, third_y: Float, thickness: Float, red: Int, green: Int, blue: Int, alpha: Int) -> Result[Bool, String]:
    if not finite(first_x) or not finite(first_y) or not finite(second_x) or not finite(second_y) or not finite(third_x) or not finite(third_y) or not finite(thickness) or thickness < 0.0 or not valid_color(red, green, blue, alpha):
        return invalid_geometry()
    unsafe:
        return status_result(native.rlv_draw_triangle_outline(frame.id, first_x, first_y, second_x, second_y, third_x, third_y, thickness, red, green, blue, alpha))

pub fn draw_polygon(frame: Frame, x: Float, y: Float, sides: Int, radius: Float, rotation: Float, red: Int, green: Int, blue: Int, alpha: Int) -> Result[Bool, String]:
    if not valid_circle(x, y, radius) or sides < 3 or not finite(rotation) or not valid_color(red, green, blue, alpha):
        return invalid_geometry()
    unsafe:
        return status_result(native.rlv_draw_polygon(frame.id, x, y, sides, radius, rotation, red, green, blue, alpha))

pub fn draw_polygon_outline(frame: Frame, x: Float, y: Float, sides: Int, radius: Float, rotation: Float, thickness: Float, red: Int, green: Int, blue: Int, alpha: Int) -> Result[Bool, String]:
    if not valid_circle(x, y, radius) or sides < 3 or not finite(rotation) or not finite(thickness) or thickness < 0.0 or not valid_color(red, green, blue, alpha):
        return invalid_geometry()
    unsafe:
        return status_result(native.rlv_draw_polygon_outline(frame.id, x, y, sides, radius, rotation, thickness, red, green, blue, alpha))

pub fn draw_bezier(frame: Frame, start_x: Float, start_y: Float, end_x: Float, end_y: Float, thickness: Float, red: Int, green: Int, blue: Int, alpha: Int) -> Result[Bool, String]:
    if not finite(start_x) or not finite(start_y) or not finite(end_x) or not finite(end_y) or not finite(thickness) or thickness < 0.0 or not valid_color(red, green, blue, alpha):
        return invalid_geometry()
    unsafe:
        return status_result(native.rlv_draw_bezier_line(frame.id, start_x, start_y, end_x, end_y, thickness, red, green, blue, alpha))

pub fn draw_gradient_rect(frame: Frame, x: Float, y: Float, width: Float, height: Float, start_red: Int, start_green: Int, start_blue: Int, start_alpha: Int, end_red: Int, end_green: Int, end_blue: Int, end_alpha: Int, vertical: Bool) -> Result[Bool, String]:
    if not valid_rect(x, y, width, height) or not valid_color(start_red, start_green, start_blue, start_alpha) or not valid_color(end_red, end_green, end_blue, end_alpha):
        return invalid_geometry()
    unsafe:
        if vertical:
            return status_result(native.rlv_draw_rectangle_gradient_vertical(frame.id, x, y, width, height, start_red, start_green, start_blue, start_alpha, end_red, end_green, end_blue, end_alpha))
        return status_result(native.rlv_draw_rectangle_gradient_horizontal(frame.id, x, y, width, height, start_red, start_green, start_blue, start_alpha, end_red, end_green, end_blue, end_alpha))

pub fn draw_gradient_circle(frame: Frame, x: Float, y: Float, radius: Float, inner_red: Int, inner_green: Int, inner_blue: Int, inner_alpha: Int, outer_red: Int, outer_green: Int, outer_blue: Int, outer_alpha: Int) -> Result[Bool, String]:
    if not valid_circle(x, y, radius) or not valid_color(inner_red, inner_green, inner_blue, inner_alpha) or not valid_color(outer_red, outer_green, outer_blue, outer_alpha):
        return invalid_geometry()
    unsafe:
        return status_result(native.rlv_draw_circle_gradient(frame.id, x, y, radius, inner_red, inner_green, inner_blue, inner_alpha, outer_red, outer_green, outer_blue, outer_alpha))

pub fn pointer_pressed(window: Window, button: Int) -> Result[Bool, String]:
    if not window_is_valid(window):
        return Err("raylib: stale or already released handle")
    if not valid_input_code(button):
        return Err("raylib: invalid argument")
    unsafe:
        return Ok(native.rlv_mouse_pressed(window.id, button))

pub fn pointer_down(window: Window, button: Int) -> Result[Bool, String]:
    if not window_is_valid(window):
        return Err("raylib: stale or already released handle")
    if not valid_input_code(button):
        return Err("raylib: invalid argument")
    unsafe:
        return Ok(native.rlv_mouse_down(window.id, button))

pub fn pointer_released(window: Window, button: Int) -> Result[Bool, String]:
    if not window_is_valid(window):
        return Err("raylib: stale or already released handle")
    if not valid_input_code(button):
        return Err("raylib: invalid argument")
    unsafe:
        return Ok(native.rlv_mouse_released(window.id, button))

pub fn key_pressed(window: Window, key: Int) -> Result[Bool, String]:
    if not window_is_valid(window):
        return Err("raylib: stale or already released handle")
    if not valid_input_code(key):
        return Err("raylib: invalid argument")
    unsafe:
        return Ok(native.rlv_key_pressed(window.id, key))

pub fn key_down(window: Window, key: Int) -> Result[Bool, String]:
    if not window_is_valid(window):
        return Err("raylib: stale or already released handle")
    if not valid_input_code(key):
        return Err("raylib: invalid argument")
    unsafe:
        return Ok(native.rlv_key_down(window.id, key))

pub fn pointer_framebuffer_x(window: Window) -> Result[Float, String]:
    if not window_is_valid(window):
        return Err("raylib: stale or already released handle")
    unsafe:
        return Ok(native.rlv_mouse_framebuffer_x(window.id))

pub fn pointer_framebuffer_y(window: Window) -> Result[Float, String]:
    if not window_is_valid(window):
        return Err("raylib: stale or already released handle")
    unsafe:
        return Ok(native.rlv_mouse_framebuffer_y(window.id))

# F17 display/render-target primitives used by rocket.graphics.canvas.
pub fn framebuffer_width(window: Window) -> Result[Float, String]:
    if not window_is_valid(window):
        return Err("raylib: stale or already released handle")
    unsafe:
        return Ok(native.rlv_window_framebuffer_width_f64(window.id))

pub fn framebuffer_height(window: Window) -> Result[Float, String]:
    if not window_is_valid(window):
        return Err("raylib: stale or already released handle")
    unsafe:
        return Ok(native.rlv_window_framebuffer_height_f64(window.id))

pub fn dpi_scale_x(window: Window) -> Result[Float, String]:
    if not window_is_valid(window):
        return Err("raylib: stale or already released handle")
    unsafe:
        return Ok(native.rlv_window_dpi_scale_x(window.id))

pub fn dpi_scale_y(window: Window) -> Result[Float, String]:
    if not window_is_valid(window):
        return Err("raylib: stale or already released handle")
    unsafe:
        return Ok(native.rlv_window_dpi_scale_y(window.id))

pub fn display_revision(window: Window) -> Result[Int, String]:
    if not window_is_valid(window):
        return Err("raylib: stale or already released handle")
    unsafe:
        return Ok(native.rlv_window_display_revision(window.id))

pub fn set_window_size(window: Window, width: Int, height: Int) -> Result[Bool, String]:
    if width <= 0 or height <= 0:
        return Err("raylib: invalid argument")
    unsafe:
        return status_result(native.rlv_window_set_size(window.id, width, height))

pub fn set_window_fullscreen(window: Window, enabled: Bool) -> Result[Bool, String]:
    unsafe:
        return status_result(native.rlv_window_set_fullscreen(window.id, enabled))

pub fn set_window_borderless(window: Window, enabled: Bool) -> Result[Bool, String]:
    unsafe:
        return status_result(native.rlv_window_set_borderless(window.id, enabled))

pub fn create_render_texture(window: Window, width: Int, height: Int) -> Result[RenderTexture, String]:
    if width <= 0 or height <= 0:
        return Err("raylib: invalid argument")
    unsafe:
        let target_id = native.rlv_render_texture_load(window.id, width, height)
        if target_id > 0:
            return Ok(RenderTexture(target_id))
        return Err(status_message(target_id))

pub fn render_texture_width(target: RenderTexture) -> Result[Float, String]:
    if not render_texture_is_valid(target):
        return Err("raylib: stale or already released handle")
    unsafe:
        return Ok(native.rlv_render_texture_width_f64(target.id))

pub fn render_texture_height(target: RenderTexture) -> Result[Float, String]:
    if not render_texture_is_valid(target):
        return Err("raylib: stale or already released handle")
    unsafe:
        return Ok(native.rlv_render_texture_height_f64(target.id))

pub fn unload_render_texture(target: RenderTexture) -> Result[Bool, String]:
    unsafe:
        return status_result(native.rlv_render_texture_unload(target.id))

pub fn begin_render_target(frame: Frame, target: RenderTexture) -> Result[RenderTargetScope, String]:
    unsafe:
        let scope_id = native.rlv_render_target_begin(frame.id, target.id)
        if scope_id > 0:
            return Ok(RenderTargetScope(scope_id))
        return Err(status_message(scope_id))

pub fn end_render_target(scope: RenderTargetScope) -> Result[Bool, String]:
    unsafe:
        return status_result(native.rlv_render_target_end(scope.id))

pub fn draw_render_texture(frame: Frame, target: RenderTexture, source_x: Float, source_y: Float, source_width: Float, source_height: Float, dest_x: Float, dest_y: Float, dest_width: Float, dest_height: Float) -> Result[Bool, String]:
    if not finite(source_x) or not finite(source_y) or not finite(source_width) or not finite(source_height) or not finite(dest_x) or not finite(dest_y) or not finite(dest_width) or not finite(dest_height):
        return Err("raylib: invalid argument")
    unsafe:
        return status_result(native.rlv_render_texture_draw(frame.id, target.id, source_x, source_y, source_width, source_height, dest_x, dest_y, dest_width, dest_height, 0.0, 0.0, 0.0, 255, 255, 255, 255))

pub fn draw_render_texture_framebuffer(frame: Frame, target: RenderTexture, source_x: Float, source_y: Float, source_width: Float, source_height: Float, dest_x: Float, dest_y: Float, dest_width: Float, dest_height: Float) -> Result[Bool, String]:
    if not finite(source_x) or not finite(source_y) or not finite(source_width) or not finite(source_height) or not finite(dest_x) or not finite(dest_y) or not finite(dest_width) or not finite(dest_height):
        return Err("raylib: invalid argument")
    unsafe:
        return status_result(native.rlv_render_texture_draw_framebuffer(frame.id, target.id, source_x, source_y, source_width, source_height, dest_x, dest_y, dest_width, dest_height, 0.0, 0.0, 0.0, 255, 255, 255, 255))

pub fn save_render_texture_png(window: Window, target: RenderTexture, path: String) -> Result[Bool, String]:
    match encode_text(path):
        case Err(error):
            return Err(error)
        case Ok(buffer_id):
            var status = -2
            unsafe:
                status = native.rlv_render_texture_save_png(window.id, target.id, buffer_id)
            let released = release_text(buffer_id)
            if status != 0:
                return Err(status_message(status))
            return released

pub fn begin_scissor(frame: Frame, x: Float, y: Float, width: Float, height: Float) -> Result[ScissorScope, String]:
    if not valid_rect(x, y, width, height):
        return Err("raylib: invalid argument")
    unsafe:
        let scope_id = native.rlv_scissor_begin(frame.id, x, y, width, height)
        if scope_id > 0:
            return Ok(ScissorScope(scope_id))
        return Err(status_message(scope_id))

pub fn begin_framebuffer_scissor(frame: Frame, x: Float, y: Float, width: Float, height: Float) -> Result[ScissorScope, String]:
    if not valid_rect(x, y, width, height):
        return Err("raylib: invalid argument")
    unsafe:
        let scope_id = native.rlv_scissor_begin_framebuffer(frame.id, x, y, width, height)
        if scope_id > 0:
            return Ok(ScissorScope(scope_id))
        return Err(status_message(scope_id))

pub fn end_scissor(scope: ScissorScope) -> Result[Bool, String]:
    unsafe:
        return status_result(native.rlv_scissor_end(scope.id))

# Typography stays behind the same checked boundary as the legacy drawing
# helpers above. Layout tokens are consumed and destroyed before they escape
# this module, so callers only receive value-owned graphics metrics.
pub fn load_font(window: Window, path: String) -> Result[Font, String]:
    if window.id <= 0:
        return Err("raylib: stale or already released handle")
    match encode_text(path):
        case Err(error):
            return Err(error)
        case Ok(buffer_id):
            var font_id = -2
            unsafe:
                font_id = native.rlv_font_load(window.id, buffer_id)
            let released = release_text(buffer_id)
            if font_id <= 0:
                return Err(status_message(font_id))
            return Ok(Font(font_id))

pub fn default_font(window: Window) -> Result[Font, String]:
    if window.id <= 0:
        return Err("raylib: stale or already released handle")
    unsafe:
        let font_id = native.rlv_font_default(window.id)
        if font_id <= 0:
            return Err(status_message(font_id))
        return Ok(Font(font_id))

fn consume_text_layout(layout_id: Int) -> Result[graphics.TextLayout, String]:
    if layout_id <= 0:
        return Err(status_message(layout_id))
    var width = 0.0
    var height = 0.0
    var baseline = 0.0
    var line_height = 0.0
    var line_count = 0
    var clipped = false
    var ellipsized = false
    var destroy_status = -2
    unsafe:
        width = native.rlv_text_layout_width(layout_id)
        height = native.rlv_text_layout_height(layout_id)
        baseline = native.rlv_text_layout_baseline(layout_id)
        line_height = native.rlv_text_layout_line_height(layout_id)
        line_count = native.rlv_text_layout_line_count(layout_id)
        clipped = native.rlv_text_layout_clipped(layout_id)
        ellipsized = native.rlv_text_layout_ellipsized(layout_id)
        destroy_status = native.rlv_text_layout_destroy(layout_id)
    if destroy_status != 0:
        return Err(status_message(destroy_status))
    let metrics = graphics.text_metrics(width, height, baseline, line_height)
    return Ok(graphics.text_layout(metrics, graphics.rect(0.0, 0.0, width, height), line_count, clipped, ellipsized))

pub fn measure_text(font: Font, text: String, style: graphics.TextStyle, max_width: Float = 0.0, max_height: Float = 0.0, wrap: Bool = false, overflow: Int = 0) -> Result[graphics.TextLayout, String]:
    if font.id <= 0:
        return Err("raylib: stale or already released handle")
    if not graphics.text_style_is_valid(style) or not finite(max_width) or not finite(max_height) or max_width < 0.0 or max_height < 0.0:
        return Err("raylib: invalid argument")
    if overflow != graphics.text_overflow_clip() and overflow != graphics.text_overflow_ellipsis():
        return Err("raylib: invalid argument")
    match encode_text(text):
        case Err(error):
            return Err(error)
        case Ok(buffer_id):
            var layout_id = -2
            unsafe:
                layout_id = native.rlv_font_measure(font.id, buffer_id, style.size, style.letter_spacing, style.line_height, max_width, max_height, wrap, overflow)
            match release_text(buffer_id):
                case Err(error):
                    return Err(error)
                case Ok(released):
                    if not released:
                        return Err("raylib: stale or already released handle")
                    return consume_text_layout(layout_id)

pub fn draw_text_layout(frame: Frame, font: Font, text: String, bounds: graphics.Rect, style: graphics.TextStyle, value: Color, horizontal_align: Int = 0, vertical_align: Int = 0, wrap: Bool = false, clip: Bool = true, overflow: Int = 0) -> Result[Bool, String]:
    if frame.id <= 0 or font.id <= 0:
        return Err("raylib: stale or already released handle")
    if not graphics.rect_has_nonnegative_size(bounds) or bounds.width <= 0.0 or bounds.height <= 0.0 or not graphics.text_style_is_valid(style) or not valid_color(value.red, value.green, value.blue, value.alpha):
        return Err("raylib: invalid argument")
    if horizontal_align < graphics.text_align_left() or horizontal_align > graphics.text_align_right():
        return Err("raylib: invalid argument")
    if vertical_align < graphics.text_align_top() or vertical_align > graphics.text_align_bottom():
        return Err("raylib: invalid argument")
    if overflow != graphics.text_overflow_clip() and overflow != graphics.text_overflow_ellipsis():
        return Err("raylib: invalid argument")
    match encode_text(text):
        case Err(error):
            return Err(error)
        case Ok(buffer_id):
            var status = -2
            unsafe:
                status = native.rlv_font_draw_layout(frame.id, font.id, buffer_id, bounds.x, bounds.y, bounds.width, bounds.height, style.size, style.letter_spacing, style.line_height, horizontal_align, vertical_align, wrap, clip, overflow, value.red, value.green, value.blue, value.alpha)
            match release_text(buffer_id):
                case Err(error):
                    return Err(error)
                case Ok(released):
                    if not released:
                        return Err("raylib: stale or already released handle")
                    return status_result(status)

pub fn invalidate_font_measurements(font: Font) -> Result[Bool, String]:
    if font.id <= 0:
        return Err("raylib: stale or already released handle")
    unsafe:
        return status_result(native.rlv_font_invalidate_measurements(font.id))

pub fn unload_font(font: Font) -> Result[Bool, String]:
    if font.id <= 0:
        return Err("raylib: stale or already released handle")
    unsafe:
        return status_result(native.rlv_font_unload(font.id))
