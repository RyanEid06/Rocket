# Narrow bundled Rocket wrapper over the reviewed primitive raylib adapter.
# Every native call is isolated inside this module's unsafe blocks; applications
# and higher-level Rocket libraries exchange value-owned tokens and Results.

import rocket.graphics
import rocket.raylib.native
import std.binary
import std.string

pub struct Window:
    id: Int

pub struct Frame:
    id: Int

pub struct RenderTexture:
    id: Int

pub struct Texture:
    id: Int

pub struct TextureFilter:
    mode: Int

pub struct RenderTargetScope:
    id: Int

pub struct ScissorScope:
    id: Int

pub struct BlendMode:
    mode: Int

pub struct BlendScope:
    id: Int

pub struct Shader:
    id: Int

pub struct ShaderUniformType:
    kind: Int

pub struct ShaderUniform:
    id: Int

pub struct ShaderScope:
    id: Int

pub struct Font:
    id: Int

pub struct AudioDevice:
    id: Int

pub struct Sound:
    id: Int

pub struct Music:
    id: Int

pub struct Color:
    red: Int
    green: Int
    blue: Int
    alpha: Int

pub fn color(red: Int, green: Int, blue: Int, alpha: Int = 255) -> Color:
    return Color(red, green, blue, alpha)

# Stable game-facing key names for the checked key_pressed/key_down queries.
# Host constants stay in rocket.raylib.native.
pub fn key_space() -> Int:
    return native.RLV_KEY_SPACE

pub fn key_escape() -> Int:
    return native.RLV_KEY_ESCAPE

pub fn key_right() -> Int:
    return native.RLV_KEY_RIGHT

pub fn key_left() -> Int:
    return native.RLV_KEY_LEFT

pub fn key_down_arrow() -> Int:
    return native.RLV_KEY_DOWN

pub fn key_up_arrow() -> Int:
    return native.RLV_KEY_UP

pub fn point_filter() -> TextureFilter:
    return TextureFilter(0)

pub fn bilinear_filter() -> TextureFilter:
    return TextureFilter(1)

pub fn trilinear_filter() -> TextureFilter:
    return TextureFilter(2)

pub fn anisotropic_4x_filter() -> TextureFilter:
    return TextureFilter(3)

pub fn anisotropic_8x_filter() -> TextureFilter:
    return TextureFilter(4)

pub fn anisotropic_16x_filter() -> TextureFilter:
    return TextureFilter(5)

pub fn alpha_blend() -> BlendMode:
    return BlendMode(0)

pub fn additive_blend() -> BlendMode:
    return BlendMode(1)

pub fn multiplied_blend() -> BlendMode:
    return BlendMode(2)

pub fn add_colors_blend() -> BlendMode:
    return BlendMode(3)

pub fn subtract_colors_blend() -> BlendMode:
    return BlendMode(4)

pub fn premultiplied_alpha_blend() -> BlendMode:
    return BlendMode(5)

pub fn float_uniform() -> ShaderUniformType:
    return ShaderUniformType(0)

pub fn int_uniform() -> ShaderUniformType:
    return ShaderUniformType(1)

pub fn vec2_uniform() -> ShaderUniformType:
    return ShaderUniformType(2)

pub fn color_uniform() -> ShaderUniformType:
    return ShaderUniformType(3)

fn status_message(status: Int) -> String:
    if status == -1:
        return "raylib: invalid argument"
    if status == -2:
        return "raylib: invalid lifecycle state"
    if status == -3:
        return "raylib: asset or uniform not found"
    if status == -4:
        return "raylib: owned resource is still live"
    if status == -5:
        return "raylib: device or backend unavailable"
    if status == -6:
        return "raylib: stale or already released handle"
    if status == -7:
        return "raylib: invalid shader program"
    if status == -8:
        return "raylib: shader uniform type mismatch or unsupported type"
    if status == -12:
        return "raylib: bounded resource capacity exceeded"
    return "raylib: unknown native failure"

fn status_result(status: Int) -> Result[Bool, String]:
    if status == 0:
        return Ok(true)
    return Err(status_message(status))

fn finite(value: Float) -> Bool:
    return value == value and value - value == 0.0

fn valid_color(red: Int, green: Int, blue: Int, alpha: Int) -> Bool:
    return red >= 0 and red <= 255 and green >= 0 and green <= 255 and blue >= 0 and blue <= 255 and alpha >= 0 and alpha <= 255

fn valid_rect(x: Float, y: Float, width: Float, height: Float) -> Bool:
    return finite(x) and finite(y) and finite(width) and finite(height) and width >= 0.0 and height >= 0.0

fn valid_circle(x: Float, y: Float, radius: Float) -> Bool:
    return finite(x) and finite(y) and finite(radius) and radius >= 0.0

fn invalid_geometry() -> Result[Bool, String]:
    return Err("raylib: invalid argument")

fn window_is_valid(window: Window) -> Bool:
    unsafe:
        return native.rlv_window_logical_width(window.id) > 0

fn render_texture_is_valid(target: RenderTexture) -> Bool:
    unsafe:
        return native.rlv_render_texture_width(target.id) > 0

fn texture_is_valid(texture: Texture) -> Bool:
    unsafe:
        return native.rlv_texture_width(texture.id) > 0

fn filter_is_valid(value: TextureFilter) -> Bool:
    return value.mode >= 0 and value.mode <= 5

fn valid_input_code(value: Int) -> Bool:
    return value >= 0 and value <= 2147483647

fn encode_text(value: String) -> Result[Int, String]:
    unsafe:
        let buffer_id = native.rlv_buffer_create()
        if buffer_id <= 0:
            return Err(status_message(buffer_id))
        var index = 0
        while index < string.byte_length(value):
            let status = native.rlv_buffer_push(buffer_id, string.byte_at(value, index))
            if status != 0:
                native.rlv_buffer_destroy(buffer_id)
                return Err(status_message(status))
            index = index + 1
        return Ok(buffer_id)

fn release_text(buffer_id: Int) -> Result[Bool, String]:
    unsafe:
        return status_result(native.rlv_buffer_destroy(buffer_id))

pub fn open_window(width: Int, height: Int, title: String) -> Result[Window, String]:
    if width <= 0 or height <= 0:
        return Err("raylib: invalid argument")
    match encode_text(title):
        case Err(error):
            return Err(error)
        case Ok(buffer_id):
            var window_id = 0
            unsafe:
                window_id = native.rlv_window_open(width, height, buffer_id)
            let released = release_text(buffer_id)
            if window_id > 0:
                return Ok(Window(window_id))
            return Err(status_message(window_id))

pub fn open_window_quality(width: Int, height: Int, title: String, resizable: Bool = true, high_dpi: Bool = true, msaa4x: Bool = true) -> Result[Window, String]:
    if width <= 0 or height <= 0:
        return Err("raylib: invalid argument")
    match encode_text(title):
        case Err(error):
            return Err(error)
        case Ok(buffer_id):
            var window_id = 0
            unsafe:
                window_id = native.rlv_window_open_quality(width, height, buffer_id, resizable, high_dpi, msaa4x)
            let released = release_text(buffer_id)
            if window_id > 0:
                return Ok(Window(window_id))
            return Err(status_message(window_id))

pub fn close_window(window: Window) -> Result[Bool, String]:
    unsafe:
        return status_result(native.rlv_window_close(window.id))

pub fn window_should_close(window: Window) -> Result[Bool, String]:
    if not window_is_valid(window):
        return Err("raylib: stale or already released handle")
    unsafe:
        return Ok(native.rlv_window_should_close(window.id))

pub fn set_target_fps(window: Window, fps: Int) -> Result[Bool, String]:
    if fps < 0:
        return Err("raylib: invalid argument")
    unsafe:
        return status_result(native.rlv_set_target_fps(window.id, fps))

pub fn frame_time(window: Window) -> Result[Float, String]:
    if not window_is_valid(window):
        return Err("raylib: stale or already released handle")
    unsafe:
        return Ok(native.rlv_frame_time(window.id))

pub fn elapsed_time(window: Window) -> Result[Float, String]:
    if not window_is_valid(window):
        return Err("raylib: stale or already released handle")
    unsafe:
        return Ok(native.rlv_time(window.id))

pub fn begin_frame(window: Window) -> Result[Frame, String]:
    unsafe:
        let frame_id = native.rlv_begin_drawing(window.id)
        if frame_id > 0:
            return Ok(Frame(frame_id))
        return Err(status_message(frame_id))

pub fn end_frame(frame: Frame) -> Result[Bool, String]:
    unsafe:
        return status_result(native.rlv_end_drawing(frame.id))

pub fn abort_frame(frame: Frame) -> Result[Bool, String]:
    unsafe:
        return status_result(native.rlv_abort_drawing(frame.id))

pub fn clear_background(frame: Frame, value: Color) -> Result[Bool, String]:
    if not valid_color(value.red, value.green, value.blue, value.alpha):
        return invalid_geometry()
    unsafe:
        return status_result(native.rlv_clear_background(frame.id, value.red, value.green, value.blue, value.alpha))

pub fn draw_rect(frame: Frame, x: Float, y: Float, width: Float, height: Float, red: Int, green: Int, blue: Int, alpha: Int) -> Result[Bool, String]:
    if not valid_rect(x, y, width, height) or not valid_color(red, green, blue, alpha):
        return invalid_geometry()
    unsafe:
        return status_result(native.rlv_draw_rectangle_gradient_vertical(frame.id, x, y, width, height, red, green, blue, alpha, red, green, blue, alpha))

pub fn draw_rect_outline(frame: Frame, x: Float, y: Float, width: Float, height: Float, thickness: Float, red: Int, green: Int, blue: Int, alpha: Int) -> Result[Bool, String]:
    if not valid_rect(x, y, width, height) or not finite(thickness) or thickness < 0.0 or not valid_color(red, green, blue, alpha):
        return invalid_geometry()
    unsafe:
        return status_result(native.rlv_draw_rectangle_outline(frame.id, x, y, width, height, thickness, red, green, blue, alpha))

pub fn draw_rounded_rect(frame: Frame, x: Float, y: Float, width: Float, height: Float, roundness: Float, red: Int, green: Int, blue: Int, alpha: Int) -> Result[Bool, String]:
    if not valid_rect(x, y, width, height) or not finite(roundness) or roundness < 0.0 or roundness > 1.0 or not valid_color(red, green, blue, alpha):
        return invalid_geometry()
    unsafe:
        return status_result(native.rlv_draw_rounded_rectangle(frame.id, x, y, width, height, roundness, red, green, blue, alpha))

pub fn draw_rounded_rect_outline(frame: Frame, x: Float, y: Float, width: Float, height: Float, roundness: Float, thickness: Float, red: Int, green: Int, blue: Int, alpha: Int) -> Result[Bool, String]:
    if not valid_rect(x, y, width, height) or not finite(roundness) or roundness < 0.0 or roundness > 1.0 or not finite(thickness) or thickness < 0.0 or not valid_color(red, green, blue, alpha):
        return invalid_geometry()
    unsafe:
        return status_result(native.rlv_draw_rounded_rectangle_outline(frame.id, x, y, width, height, roundness, thickness, red, green, blue, alpha))

pub fn draw_circle(frame: Frame, x: Float, y: Float, radius: Float, red: Int, green: Int, blue: Int, alpha: Int) -> Result[Bool, String]:
    if not valid_circle(x, y, radius) or not valid_color(red, green, blue, alpha):
        return invalid_geometry()
    unsafe:
        return status_result(native.rlv_draw_circle_gradient(frame.id, x, y, radius, red, green, blue, alpha, red, green, blue, alpha))

pub fn draw_circle_outline(frame: Frame, x: Float, y: Float, radius: Float, thickness: Float, red: Int, green: Int, blue: Int, alpha: Int) -> Result[Bool, String]:
    if not valid_circle(x, y, radius) or not finite(thickness) or thickness < 0.0 or not valid_color(red, green, blue, alpha):
        return invalid_geometry()
    unsafe:
        return status_result(native.rlv_draw_circle_outline(frame.id, x, y, radius, thickness, red, green, blue, alpha))

pub fn draw_ellipse(frame: Frame, x: Float, y: Float, radius_x: Float, radius_y: Float, red: Int, green: Int, blue: Int, alpha: Int) -> Result[Bool, String]:
    if not finite(x) or not finite(y) or not finite(radius_x) or not finite(radius_y) or radius_x < 0.0 or radius_y < 0.0 or not valid_color(red, green, blue, alpha):
        return invalid_geometry()
    unsafe:
        return status_result(native.rlv_draw_ellipse(frame.id, x, y, radius_x, radius_y, red, green, blue, alpha))

pub fn draw_ring(frame: Frame, x: Float, y: Float, inner_radius: Float, outer_radius: Float, red: Int, green: Int, blue: Int, alpha: Int) -> Result[Bool, String]:
    if not finite(x) or not finite(y) or not finite(inner_radius) or not finite(outer_radius) or inner_radius < 0.0 or outer_radius < inner_radius or not valid_color(red, green, blue, alpha):
        return invalid_geometry()
    unsafe:
        return status_result(native.rlv_draw_ring(frame.id, x, y, inner_radius, outer_radius, red, green, blue, alpha))

pub fn draw_ring_sector(frame: Frame, x: Float, y: Float, inner_radius: Float, outer_radius: Float, start_angle: Float, end_angle: Float, red: Int, green: Int, blue: Int, alpha: Int) -> Result[Bool, String]:
    if not finite(x) or not finite(y) or not finite(inner_radius) or not finite(outer_radius) or inner_radius < 0.0 or outer_radius < inner_radius or not finite(start_angle) or not finite(end_angle) or not valid_color(red, green, blue, alpha):
        return invalid_geometry()
    unsafe:
        return status_result(native.rlv_draw_ring_sector(frame.id, x, y, inner_radius, outer_radius, start_angle, end_angle, red, green, blue, alpha))

pub fn draw_sector(frame: Frame, x: Float, y: Float, radius: Float, start_angle: Float, end_angle: Float, red: Int, green: Int, blue: Int, alpha: Int) -> Result[Bool, String]:
    if not valid_circle(x, y, radius) or not finite(start_angle) or not finite(end_angle) or not valid_color(red, green, blue, alpha):
        return invalid_geometry()
    unsafe:
        return status_result(native.rlv_draw_circle_sector(frame.id, x, y, radius, start_angle, end_angle, red, green, blue, alpha))

pub fn draw_line(frame: Frame, start_x: Float, start_y: Float, end_x: Float, end_y: Float, red: Int, green: Int, blue: Int, alpha: Int) -> Result[Bool, String]:
    if not finite(start_x) or not finite(start_y) or not finite(end_x) or not finite(end_y) or not valid_color(red, green, blue, alpha):
