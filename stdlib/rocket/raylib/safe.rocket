        return status_result(native.rlv_music_play(music.id))

# Call once per game-loop iteration while the stream is playing.
pub fn update_music(music: Music) -> Result[Bool, String]:
    unsafe:
        return status_result(native.rlv_music_update(music.id))

pub fn pause_music(music: Music) -> Result[Bool, String]:
