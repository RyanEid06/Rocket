extern fn rlv_buffer_push(buffer_id: Int, byte_value: Char) -> Int
extern fn rlv_buffer_destroy(buffer_id: Int) -> Int
extern fn rlv_window_open(width: Int, height: Int, title_buffer_id: Int) -> Int
extern fn rlv_window_close(window_id: Int) -> Int
