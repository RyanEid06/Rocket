        return status_result(native.rlv_sound_set_pitch(sound.id, pitch))

pub fn unload_sound(sound: Sound) -> Result[Bool, String]:
    unsafe:
        return status_result(native.rlv_sound_unload(sound.id))

pub fn load_music(audio: AudioDevice, path: String) -> Result[Music, String]:
    match encode_text(path):
        case Err(error):
            return Err(error)
        case Ok(buffer_id):
            var music_id = -2
            unsafe:
                music_id = native.rlv_music_load(audio.id, buffer_id)
            let released = release_text(buffer_id)
            if music_id > 0:
                return Ok(Music(music_id))
            return Err(status_message(music_id))

pub fn play_music(music: Music) -> Result[Bool, String]:
