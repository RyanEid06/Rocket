extern fn rlv_draw_polygon_outline(frame_id: Int, x: Float, y: Float, sides: Int, radius: Float, rotation: Float, thickness: Float, red: Int, green: Int, blue: Int, alpha: Int) -> Int
extern fn rlv_draw_bezier_line(frame_id: Int, start_x: Float, start_y: Float, end_x: Float, end_y: Float, thickness: Float, red: Int, green: Int, blue: Int, alpha: Int) -> Int
extern fn rlv_mouse_pressed(window_id: Int, button: Int) -> Bool
extern fn rlv_mouse_down(window_id: Int, button: Int) -> Bool
extern fn rlv_mouse_released(window_id: Int, button: Int) -> Bool
