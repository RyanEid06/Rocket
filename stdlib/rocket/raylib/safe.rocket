pub fn begin_render_target(frame: Frame, target: RenderTexture) -> Result[RenderTargetScope, String]:
    unsafe:
        let scope_id = native.rlv_render_target_begin(frame.id, target.id)
        if scope_id > 0:
            return Ok(RenderTargetScope(scope_id))
        return Err(status_message(scope_id))

pub fn end_render_target(scope: RenderTargetScope) -> Result[Bool, String]:
