pub fn draw_render_texture(frame: Frame, target: RenderTexture, source_x: Float, source_y: Float, source_width: Float, source_height: Float, dest_x: Float, dest_y: Float, dest_width: Float, dest_height: Float) -> Result[Bool, String]:
    if not finite(source_x) or not finite(source_y) or not finite(source_width) or not finite(source_height) or not finite(dest_x) or not finite(dest_y) or not finite(dest_width) or not finite(dest_height):
        return Err("raylib: invalid argument")
    unsafe:
        return status_result(native.rlv_render_texture_draw(frame.id, target.id, source_x, source_y, source_width, source_height, dest_x, dest_y, dest_width, dest_height, 0.0, 0.0, 0.0, 255, 255, 255, 255))

pub fn draw_render_texture_pro(frame: Frame, target: RenderTexture, source: graphics.Rect, dest: graphics.Rect, origin: graphics.Vec2, rotation: Float, tint: Color) -> Result[Bool, String]:
    if not finite(source.x) or not finite(source.y) or not finite(source.width) or not finite(source.height) or source.width == 0.0 or source.height == 0.0 or source.x < 0.0 or source.y < 0.0:
        return invalid_geometry()
    if not valid_rect(dest.x, dest.y, dest.width, dest.height) or not finite(origin.x) or not finite(origin.y) or not finite(rotation) or not valid_color(tint.red, tint.green, tint.blue, tint.alpha):
        return invalid_geometry()
    unsafe:
        return status_result(native.rlv_render_texture_draw(frame.id, target.id, source.x, source.y, source.width, source.height, dest.x, dest.y, dest.width, dest.height, origin.x, origin.y, rotation, tint.red, tint.green, tint.blue, tint.alpha))

pub fn draw_render_texture_framebuffer(frame: Frame, target: RenderTexture, source_x: Float, source_y: Float, source_width: Float, source_height: Float, dest_x: Float, dest_y: Float, dest_width: Float, dest_height: Float) -> Result[Bool, String]:
    if not finite(source_x) or not finite(source_y) or not finite(source_width) or not finite(source_height) or not finite(dest_x) or not finite(dest_y) or not finite(dest_width) or not finite(dest_height):
        return Err("raylib: invalid argument")
    unsafe:
        return status_result(native.rlv_render_texture_draw_framebuffer(frame.id, target.id, source_x, source_y, source_width, source_height, dest_x, dest_y, dest_width, dest_height, 0.0, 0.0, 0.0, 255, 255, 255, 255))

pub fn save_render_texture_png(window: Window, target: RenderTexture, path: String) -> Result[Bool, String]:
    match encode_text(path):
        case Err(error):
            return Err(error)
        case Ok(buffer_id):
            var status = -2
            unsafe:
                status = native.rlv_render_texture_save_png(window.id, target.id, buffer_id)
            let released = release_text(buffer_id)
            if status != 0:
                return Err(status_message(status))
            return released

pub fn begin_scissor(frame: Frame, x: Float, y: Float, width: Float, height: Float) -> Result[ScissorScope, String]:
    if not valid_rect(x, y, width, height):
        return Err("raylib: invalid argument")
    unsafe:
        let scope_id = native.rlv_scissor_begin(frame.id, x, y, width, height)
        if scope_id > 0:
            return Ok(ScissorScope(scope_id))
        return Err(status_message(scope_id))

pub fn begin_framebuffer_scissor(frame: Frame, x: Float, y: Float, width: Float, height: Float) -> Result[ScissorScope, String]:
    if not valid_rect(x, y, width, height):
        return Err("raylib: invalid argument")
    unsafe:
        let scope_id = native.rlv_scissor_begin_framebuffer(frame.id, x, y, width, height)
        if scope_id > 0:
            return Ok(ScissorScope(scope_id))
        return Err(status_message(scope_id))

pub fn end_scissor(scope: ScissorScope) -> Result[Bool, String]:
    unsafe:
        return status_result(native.rlv_scissor_end(scope.id))

pub fn begin_blend(frame: Frame, mode: BlendMode) -> Result[BlendScope, String]:
    if mode.mode < 0 or mode.mode > 5:
        return Err("raylib: invalid argument")
    unsafe:
        let scope_id = native.rlv_blend_begin(frame.id, mode.mode)
        if scope_id > 0:
            return Ok(BlendScope(scope_id))
        return Err(status_message(scope_id))

pub fn end_blend(scope: BlendScope) -> Result[Bool, String]:
    unsafe:
        return status_result(native.rlv_blend_end(scope.id))

pub fn shader_supported(window: Window) -> Result[Bool, String]:
    if not window_is_valid(window):
        return Err("raylib: stale or already released handle")
    unsafe:
        return Ok(native.rlv_shader_supported(window.id))

fn shader_load_error(status: Int) -> String:
    if status != -7:
        return status_message(status)
    var bytes = binary.from_string("")
    var length = 0
    unsafe:
        length = native.rlv_shader_diagnostic_length()
    var index = 0
    while index < length and index < 16384:
        var byte_value = 0
        unsafe:
            byte_value = native.rlv_shader_diagnostic_byte(index)
        match binary.write_u8(byte_value):
            case Err(error):
                return status_message(status)
            case Ok(part):
                bytes = binary.concat(bytes, part)
        index = index + 1
    match binary.to_string(bytes):
        case Err(error):
            return status_message(status)
        case Ok(diagnostic):
            if string.byte_length(diagnostic) == 0:
                return status_message(status)
            return string.concat("raylib: invalid shader program: ", diagnostic)

fn load_shader_buffers(window: Window, vertex: String, fragment: String, from_source: Bool) -> Result[Shader, String]:
    if not window_is_valid(window):
        return Err("raylib: stale or already released handle")
    match encode_text(vertex):
        case Err(error):
            return Err(error)
        case Ok(vertex_buffer):
            match encode_text(fragment):
                case Err(error):
                    let released = release_text(vertex_buffer)
                    return Err(error)
                case Ok(fragment_buffer):
                    var shader_id = -2
                    unsafe:
                        if from_source:
                            shader_id = native.rlv_shader_load_memory(window.id, vertex_buffer, fragment_buffer)
                        else:
                            shader_id = native.rlv_shader_load_files(window.id, vertex_buffer, fragment_buffer)
                    let released_vertex = release_text(vertex_buffer)
                    let released_fragment = release_text(fragment_buffer)
                    if shader_id <= 0:
                        return Err(shader_load_error(shader_id))
                    return Ok(Shader(shader_id))

# Pass "" for a stage that should use the backend's default shader stage.
pub fn load_shader(window: Window, vertex_path: String, fragment_path: String) -> Result[Shader, String]:
    return load_shader_buffers(window, vertex_path, fragment_path, false)

pub fn load_shader_from_source(window: Window, vertex_source: String, fragment_source: String) -> Result[Shader, String]:
    return load_shader_buffers(window, vertex_source, fragment_source, true)

pub fn unload_shader(shader: Shader) -> Result[Bool, String]:
    unsafe:
        return status_result(native.rlv_shader_unload(shader.id))

pub fn shader_uniform(shader: Shader, name: String, uniform_type: ShaderUniformType) -> Result[ShaderUniform, String]:
    if string.byte_length(name) == 0 or uniform_type.kind < 0 or uniform_type.kind > 3:
        return Err("raylib: invalid argument")
    match encode_text(name):
        case Err(error):
            return Err(error)
        case Ok(name_buffer):
            var uniform_id = -2
            unsafe:
                uniform_id = native.rlv_shader_uniform(shader.id, name_buffer, uniform_type.kind)
            let released = release_text(name_buffer)
            if uniform_id <= 0:
                return Err(status_message(uniform_id))
            return Ok(ShaderUniform(uniform_id))

pub fn set_shader_float(shader: Shader, uniform: ShaderUniform, value: Float) -> Result[Bool, String]:
    if not finite(value):
        return Err("raylib: invalid argument")
    unsafe:
        return status_result(native.rlv_shader_set_float(shader.id, uniform.id, value))

pub fn set_shader_int(shader: Shader, uniform: ShaderUniform, value: Int) -> Result[Bool, String]:
    unsafe:
        return status_result(native.rlv_shader_set_int(shader.id, uniform.id, value))

pub fn set_shader_vec2(shader: Shader, uniform: ShaderUniform, value: graphics.Vec2) -> Result[Bool, String]:
    if not finite(value.x) or not finite(value.y):
        return Err("raylib: invalid argument")
    unsafe:
        return status_result(native.rlv_shader_set_vec2(shader.id, uniform.id, value.x, value.y))

pub fn set_shader_color(shader: Shader, uniform: ShaderUniform, value: Color) -> Result[Bool, String]:
    if not valid_color(value.red, value.green, value.blue, value.alpha):
        return Err("raylib: invalid argument")
    unsafe:
        return status_result(native.rlv_shader_set_color(shader.id, uniform.id, value.red, value.green, value.blue, value.alpha))

pub fn begin_shader(frame: Frame, shader: Shader) -> Result[ShaderScope, String]:
    unsafe:
        let scope_id = native.rlv_shader_begin(frame.id, shader.id)
        if scope_id > 0:
            return Ok(ShaderScope(scope_id))
        return Err(status_message(scope_id))

pub fn end_shader(scope: ShaderScope) -> Result[Bool, String]:
    unsafe:
        return status_result(native.rlv_shader_end(scope.id))

# Typography stays behind the same checked boundary as the legacy drawing
# helpers above. Layout tokens are consumed and destroyed before they escape
# this module, so callers only receive value-owned graphics metrics.
pub fn load_font(window: Window, path: String) -> Result[Font, String]:
    if window.id <= 0:
        return Err("raylib: stale or already released handle")
    match encode_text(path):
        case Err(error):
            return Err(error)
        case Ok(buffer_id):
            var font_id = -2
            unsafe:
                font_id = native.rlv_font_load(window.id, buffer_id)
            let released = release_text(buffer_id)
            if font_id <= 0:
                return Err(status_message(font_id))
            return Ok(Font(font_id))

pub fn default_font(window: Window) -> Result[Font, String]:
    if window.id <= 0:
        return Err("raylib: stale or already released handle")
    unsafe:
        let font_id = native.rlv_font_default(window.id)
        if font_id <= 0:
            return Err(status_message(font_id))
        return Ok(Font(font_id))

fn consume_text_layout(layout_id: Int) -> Result[graphics.TextLayout, String]:
    if layout_id <= 0:
        return Err(status_message(layout_id))
    var width = 0.0
    var height = 0.0
    var baseline = 0.0
    var line_height = 0.0
    var line_count = 0
    var clipped = false
    var ellipsized = false
    var destroy_status = -2
    unsafe:
        width = native.rlv_text_layout_width(layout_id)
        height = native.rlv_text_layout_height(layout_id)
        baseline = native.rlv_text_layout_baseline(layout_id)
        line_height = native.rlv_text_layout_line_height(layout_id)
        line_count = native.rlv_text_layout_line_count(layout_id)
        clipped = native.rlv_text_layout_clipped(layout_id)
        ellipsized = native.rlv_text_layout_ellipsized(layout_id)
        destroy_status = native.rlv_text_layout_destroy(layout_id)
    if destroy_status != 0:
        return Err(status_message(destroy_status))
    let metrics = graphics.text_metrics(width, height, baseline, line_height)
    return Ok(graphics.text_layout(metrics, graphics.rect(0.0, 0.0, width, height), line_count, clipped, ellipsized))

pub fn measure_text(font: Font, text: String, style: graphics.TextStyle, max_width: Float = 0.0, max_height: Float = 0.0, wrap: Bool = false, overflow: Int = 0) -> Result[graphics.TextLayout, String]:
    if font.id <= 0:
        return Err("raylib: stale or already released handle")
    if not graphics.text_style_is_valid(style) or not finite(max_width) or not finite(max_height) or max_width < 0.0 or max_height < 0.0:
        return Err("raylib: invalid argument")
    if overflow != graphics.text_overflow_clip() and overflow != graphics.text_overflow_ellipsis():
        return Err("raylib: invalid argument")
    match encode_text(text):
        case Err(error):
            return Err(error)
        case Ok(buffer_id):
            var layout_id = -2
            unsafe:
                layout_id = native.rlv_font_measure(font.id, buffer_id, style.size, style.letter_spacing, style.line_height, max_width, max_height, wrap, overflow)
            match release_text(buffer_id):
                case Err(error):
                    return Err(error)
                case Ok(released):
                    if not released:
                        return Err("raylib: stale or already released handle")
                    return consume_text_layout(layout_id)

pub fn draw_text_layout(frame: Frame, font: Font, text: String, bounds: graphics.Rect, style: graphics.TextStyle, value: Color, horizontal_align: Int = 0, vertical_align: Int = 0, wrap: Bool = false, clip: Bool = true, overflow: Int = 0) -> Result[Bool, String]:
    if frame.id <= 0 or font.id <= 0:
        return Err("raylib: stale or already released handle")
    if not graphics.rect_has_nonnegative_size(bounds) or bounds.width <= 0.0 or bounds.height <= 0.0 or not graphics.text_style_is_valid(style) or not valid_color(value.red, value.green, value.blue, value.alpha):
        return Err("raylib: invalid argument")
    if horizontal_align < graphics.text_align_left() or horizontal_align > graphics.text_align_right():
        return Err("raylib: invalid argument")
    if vertical_align < graphics.text_align_top() or vertical_align > graphics.text_align_bottom():
        return Err("raylib: invalid argument")
    if overflow != graphics.text_overflow_clip() and overflow != graphics.text_overflow_ellipsis():
        return Err("raylib: invalid argument")
    match encode_text(text):
        case Err(error):
            return Err(error)
        case Ok(buffer_id):
            var status = -2
            unsafe:
                status = native.rlv_font_draw_layout(frame.id, font.id, buffer_id, bounds.x, bounds.y, bounds.width, bounds.height, style.size, style.letter_spacing, style.line_height, horizontal_align, vertical_align, wrap, clip, overflow, value.red, value.green, value.blue, value.alpha)
            match release_text(buffer_id):
                case Err(error):
                    return Err(error)
                case Ok(released):
                    if not released:
                        return Err("raylib: stale or already released handle")
                    return status_result(status)

pub fn invalidate_font_measurements(font: Font) -> Result[Bool, String]:
    if font.id <= 0:
        return Err("raylib: stale or already released handle")
    unsafe:
        return status_result(native.rlv_font_invalidate_measurements(font.id))

pub fn unload_font(font: Font) -> Result[Bool, String]:
    if font.id <= 0:
        return Err("raylib: stale or already released handle")
    unsafe:
        return status_result(native.rlv_font_unload(font.id))

# The device owns sounds and music. Unload every resource before closing it.
# A close with live resources fails, leaving the device open for cleanup.
pub fn open_audio() -> Result[AudioDevice, String]:
    unsafe:
        let audio_id = native.rlv_audio_open()
        if audio_id > 0:
            return Ok(AudioDevice(audio_id))
        return Err(status_message(audio_id))

pub fn close_audio(audio: AudioDevice) -> Result[Bool, String]:
    unsafe:
        return status_result(native.rlv_audio_close(audio.id))

pub fn audio_ready(audio: AudioDevice) -> Result[Bool, String]:
    unsafe:
        let status = native.rlv_audio_ready(audio.id)
        if status < 0:
            return Err(status_message(status))
        return Ok(status != 0)

pub fn load_sound(audio: AudioDevice, path: String) -> Result[Sound, String]:
    match encode_text(path):
        case Err(error):
            return Err(error)
        case Ok(buffer_id):
            var sound_id = -2
            unsafe:
                sound_id = native.rlv_sound_load(audio.id, buffer_id)
            let released = release_text(buffer_id)
            if sound_id > 0:
                return Ok(Sound(sound_id))
            return Err(status_message(sound_id))

pub fn create_tone(audio: AudioDevice, frequency: Float, seconds: Float) -> Result[Sound, String]:
    unsafe:
        let sound_id = native.rlv_sound_tone(audio.id, frequency, seconds)
        if sound_id > 0:
            return Ok(Sound(sound_id))
        return Err(status_message(sound_id))

pub fn play_sound(sound: Sound) -> Result[Bool, String]:
    unsafe:
