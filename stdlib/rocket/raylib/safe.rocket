        return status_result(native.rlv_music_resume(music.id))

pub fn stop_music(music: Music) -> Result[Bool, String]:
    unsafe:
        return status_result(native.rlv_music_stop(music.id))

pub fn music_playing(music: Music) -> Result[Bool, String]:
    unsafe:
        let status = native.rlv_music_playing(music.id)
        if status < 0:
            return Err(status_message(status))
        return Ok(status != 0)

pub fn set_music_volume(music: Music, volume: Float) -> Result[Bool, String]:
    unsafe:
        return status_result(native.rlv_music_set_volume(music.id, volume))

pub fn set_music_looping(music: Music, looping: Bool) -> Result[Bool, String]:
    unsafe:
        return status_result(native.rlv_music_set_looping(music.id, looping))

pub fn unload_music(music: Music) -> Result[Bool, String]:
    unsafe:
        return status_result(native.rlv_music_unload(music.id))
