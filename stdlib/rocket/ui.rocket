# Rocket 3 immediate-mode UI context foundation. WP23 owns lifecycle, stable
# identity, input snapshots, focus, disabled behavior, modal capture, and
# response freshness. Layout, themes, and concrete controls are layered later.

import std.collections
import std.string
import std.sync
import rocket.graphics
import rocket.graphics.input
import rocket.raylib.safe

pub struct WidgetId:
    path: String
    hash: Int

pub struct Context:
    namespace: String
    capacity: Int
    retention_frames: Int
    paths: Array[String]
    hashes: Array[Int]
    last_seen: Array[Int]
    active_present: Bool
    active_path: String
    active_hash: Int
    focused_present: Bool
    focused_path: String
    focused_hash: Int
    modal_present: Bool
    modal_path: String
    modal_hash: Int
    frame_index: Int
    frame_open: Bool
    lease: sync.AtomicInt
    lease_version: Int

pub struct UiFrame:
    context: Context
    pointer_present: Bool
    pointer: graphics.Vec2
    pointer_pressed: Bool
    pointer_down: Bool
    pointer_released: Bool
    space_pressed: Bool
    enter_pressed: Bool
    escape_pressed: Bool
    tab_pressed: Bool
    left_pressed: Bool
    right_pressed: Bool
    up_pressed: Bool
    down_pressed: Bool
    modal_scope_present: Bool
    modal_scope_path: String
    modal_scope_hash: Int

pub struct Response:
    id: WidgetId
    context_namespace: String
    frame_index: Int
    context_lease: sync.AtomicInt
    hovered: Bool
    active: Bool
    clicked: Bool
    focused: Bool
    disabled: Bool
    modal_blocked: Bool
    pointer_pressed: Bool
    pointer_released: Bool
    keyboard_activated: Bool

pub struct Interaction:
    frame: UiFrame
    response: Response

struct Records:
    paths: Array[String]
    hashes: Array[Int]
    last_seen: Array[Int]

struct InputSnapshot:
    pointer_present: Bool
    pointer: graphics.Vec2
    pointer_pressed: Bool
    pointer_down: Bool
    pointer_released: Bool
    space_pressed: Bool
    enter_pressed: Bool
    escape_pressed: Bool
    tab_pressed: Bool
    left_pressed: Bool
    right_pressed: Bool
    up_pressed: Bool
    down_pressed: Bool

pub fn widget_id(name: String) -> WidgetId:
    return compose_id("", name)

pub fn child_id(parent: WidgetId, child: String) -> WidgetId:
    return compose_id(parent.path, child)

pub fn default_context_capacity() -> Int:
    return 2048

pub fn default_unseen_retention_frames() -> Int:
    return 8

pub fn new_context(namespace: String, capacity: Int = 2048, unseen_retention_frames: Int = 8) -> Result[Context, String]:
    if string.byte_length(namespace) == 0:
        return Err("UI context namespace must not be empty")
    if capacity <= 0 or capacity > 100000:
        return Err("UI context capacity must be between 1 and 100000")
    if unseen_retention_frames < 0 or unseen_retention_frames > 10000:
        return Err("UI context unseen retention must be between 0 and 10000 frames")
    var paths: Array[String] = []
    var hashes: Array[Int] = []
    var last_seen: Array[Int] = []
    paths = collections.reserve(paths, capacity)
    hashes = collections.reserve(hashes, capacity)
    last_seen = collections.reserve(last_seen, capacity)
    return Ok(Context(namespace, capacity, unseen_retention_frames, paths, hashes, last_seen, false, "", 0, false, "", 0, false, "", 0, 0, false, sync.atomic_int(0), 0))

pub fn begin_frame(context: Context, window: safe.Window, canvas: graphics.VirtualCanvas) -> Result[UiFrame, String]:
    if not lease_is_current(context):
        return Err("stale UI context or frame state")
    if context.frame_open:
        return Err("UI context already has an open frame")
    if not graphics.virtual_canvas_is_valid(canvas):
        return Err("UI frame requires a valid virtual canvas")
    var snapshot = InputSnapshot(false, graphics.vec2(0.0, 0.0), false, false, false, false, false, false, false, false, false, false, false)
    match capture_input(window, canvas):
        case Err(message):
            return Err(message)
        case Ok(value):
            snapshot = value
    let opened = Context(context.namespace, context.capacity, context.retention_frames, context.paths, context.hashes, context.last_seen, context.active_present, context.active_path, context.active_hash, context.focused_present, context.focused_path, context.focused_hash, context.modal_present, context.modal_path, context.modal_hash, context.frame_index + 1, true, context.lease, context.lease_version)
    match commit_context(context, opened):
        case Err(message):
            return Err(message)
        case Ok(committed):
            return Ok(UiFrame(committed, snapshot.pointer_present, snapshot.pointer, snapshot.pointer_pressed, snapshot.pointer_down, snapshot.pointer_released, snapshot.space_pressed, snapshot.enter_pressed, snapshot.escape_pressed, snapshot.tab_pressed, snapshot.left_pressed, snapshot.right_pressed, snapshot.up_pressed, snapshot.down_pressed, false, "", 0))

fn capture_input(window: safe.Window, canvas: graphics.VirtualCanvas) -> Result[InputSnapshot, String]:
    var pointer_pressed = false
    var pointer_down = false
    var pointer_released = false
    var space_pressed = false
    var enter_pressed = false
    var escape_pressed = false
    var tab_pressed = false
    var left_pressed = false
    var right_pressed = false
    var up_pressed = false
    var down_pressed = false
    match input.pointer_pressed(window):
        case Err(message):
            return Err(message)
        case Ok(value):
            pointer_pressed = value
    match input.pointer_down(window):
        case Err(message):
            return Err(message)
        case Ok(value):
            pointer_down = value
    match input.pointer_released(window):
        case Err(message):
            return Err(message)
        case Ok(value):
            pointer_released = value
    match safe.key_pressed(window, 32):
        case Err(message):
            return Err(message)
        case Ok(value):
            space_pressed = value
    match safe.key_pressed(window, 257):
        case Err(message):
            return Err(message)
        case Ok(value):
            enter_pressed = value
    match safe.key_pressed(window, 256):
        case Err(message):
            return Err(message)
        case Ok(value):
            escape_pressed = value
    match safe.key_pressed(window, 258):
        case Err(message):
            return Err(message)
        case Ok(value):
            tab_pressed = value
    match safe.key_pressed(window, 263):
        case Err(message):
            return Err(message)
        case Ok(value):
            left_pressed = value
    match safe.key_pressed(window, 262):
        case Err(message):
            return Err(message)
        case Ok(value):
            right_pressed = value
    match safe.key_pressed(window, 265):
        case Err(message):
            return Err(message)
        case Ok(value):
            up_pressed = value
    match safe.key_pressed(window, 264):
        case Err(message):
            return Err(message)
        case Ok(value):
            down_pressed = value
    match input.pointer_position_in_canvas(window, canvas):
        case Err(message):
            return Err(message)
        case Ok(position):
            match position:
                case Some(pointer):
                    return Ok(InputSnapshot(true, pointer, pointer_pressed, pointer_down, pointer_released, space_pressed, enter_pressed, escape_pressed, tab_pressed, left_pressed, right_pressed, up_pressed, down_pressed))
                case None():
                    return Ok(InputSnapshot(false, graphics.vec2(0.0, 0.0), pointer_pressed, pointer_down, pointer_released, space_pressed, enter_pressed, escape_pressed, tab_pressed, left_pressed, right_pressed, up_pressed, down_pressed))

pub fn register_widget(frame: UiFrame, id: WidgetId) -> Result[UiFrame, String]:
    match register_widget_uncommitted(frame, id):
        case Err(message):
            return Err(message)
        case Ok(registered):
            return commit_frame(registered, registered.context)

fn register_widget_uncommitted(frame: UiFrame, id: WidgetId) -> Result[UiFrame, String]:
    if not lease_is_current(frame.context):
        return Err("stale UI context or frame state")
    if not frame.context.frame_open:
        return Err("UI operation requires an open frame")
    var index = 0
    while index < collections.length(frame.context.hashes):
        if frame.context.hashes[index] == id.hash and frame.context.paths[index] == id.path:
            if frame.context.last_seen[index] == frame.context.frame_index:
                return Err("duplicate widget ID in UI frame")
            var last_seen = frame.context.last_seen
            last_seen = collections.remove(last_seen, index).values
            last_seen = collections.insert(last_seen, index, frame.context.frame_index)
            let next = Context(frame.context.namespace, frame.context.capacity, frame.context.retention_frames, frame.context.paths, frame.context.hashes, last_seen, frame.context.active_present, frame.context.active_path, frame.context.active_hash, frame.context.focused_present, frame.context.focused_path, frame.context.focused_hash, frame.context.modal_present, frame.context.modal_path, frame.context.modal_hash, frame.context.frame_index, true, frame.context.lease, frame.context.lease_version)
            return Ok(with_context(frame, next))
        index = index + 1
    match make_widget_room(frame.context):
        case Err(message):
            return Err(message)
        case Ok(context):
            let paths = collections.append(context.paths, id.path)
            let hashes = collections.append(context.hashes, id.hash)
            let last_seen = collections.append(context.last_seen, context.frame_index)
            let next = Context(context.namespace, context.capacity, context.retention_frames, paths, hashes, last_seen, context.active_present, context.active_path, context.active_hash, context.focused_present, context.focused_path, context.focused_hash, context.modal_present, context.modal_path, context.modal_hash, context.frame_index, true, context.lease, context.lease_version)
            return Ok(with_context(frame, next))

pub fn interact(frame: UiFrame, id: WidgetId, bounds: graphics.Rect, disabled: Bool = false) -> Result[Interaction, String]:
    if not lease_is_current(frame.context):
        return Err("stale UI context or frame state")
    if not frame.context.frame_open:
        return Err("UI interaction requires an open frame")
    if not graphics.rect_has_nonnegative_size(bounds):
        return Err("UI interaction bounds must be finite with nonnegative size")
    match register_widget_uncommitted(frame, id):
        case Err(message):
            return Err(message)
        case Ok(registered):
            let blocked = modal_blocks(registered, id)
            let eligible = not disabled and not blocked
            var context = registered.context
            if disabled:
                if active_is_unchecked(context, id):
                    context = clear_active(context)
                if focused_is_unchecked(context, id):
                    context = clear_focus(context)
            if blocked and active_is_unchecked(context, id):
                context = clear_active(context)
            var hovered = false
            if eligible and registered.pointer_present:
                hovered = graphics.point_in_rect(registered.pointer, bounds)
            var pressed_here = false
            if eligible and hovered and registered.pointer_pressed and not context.active_present:
                context = set_active(set_focus(context, id), id)
                pressed_here = true
            let was_active = active_is_unchecked(context, id)
            var released_here = false
            var clicked = false
            if was_active and registered.pointer_released:
                released_here = true
                if eligible and hovered:
                    clicked = true
                context = clear_active(context)
            var activation = false
            match activation_pressed(registered):
                case Err(message):
                    return Err(message)
                case Ok(value):
                    activation = value
            let keyboard_activated = eligible and focused_is_unchecked(context, id) and activation
            if keyboard_activated:
                clicked = true
            let active = active_is_unchecked(context, id)
            let focused = focused_is_unchecked(context, id)
            match commit_frame(registered, context):
                case Err(message):
                    return Err(message)
                case Ok(next_frame):
                    let response = Response(id, next_frame.context.namespace, next_frame.context.frame_index, next_frame.context.lease, hovered, active, clicked, focused, disabled, blocked, pressed_here, released_here, keyboard_activated)
                    return Ok(Interaction(next_frame, response))

pub fn request_focus(frame: UiFrame, id: WidgetId) -> Result[UiFrame, String]:
    if not lease_is_current(frame.context):
        return Err("stale UI context or frame state")
    if not frame.context.frame_open:
        return Err("UI focus request requires an open frame")
    if not seen_this_frame(frame.context, id.path, id.hash):
        return Err("UI focus target must be registered in the current frame")
    if modal_blocks(frame, id):
        return Err("UI focus target is blocked by the active modal scope")
    return commit_frame(frame, set_focus(frame.context, id))

pub fn activate_modal(context: Context, id: WidgetId) -> Result[Context, String]:
    if not lease_is_current(context):
        return Err("stale UI context or frame state")
    if context.frame_open:
        return Err("UI modal state cannot change while a frame is open")
    let next = Context(context.namespace, context.capacity, context.retention_frames, context.paths, context.hashes, context.last_seen, false, context.active_path, context.active_hash, false, context.focused_path, context.focused_hash, true, id.path, id.hash, context.frame_index, false, context.lease, context.lease_version)
    return commit_context(context, next)

pub fn clear_modal(context: Context, id: WidgetId) -> Result[Context, String]:
    if not lease_is_current(context):
        return Err("stale UI context or frame state")
    if context.frame_open:
        return Err("UI modal state cannot change while a frame is open")
    if not context.modal_present:
        return Err("UI context has no active modal")
    if context.modal_hash != id.hash or context.modal_path != id.path:
        return Err("UI modal ID does not match the active modal")
    let next = Context(context.namespace, context.capacity, context.retention_frames, context.paths, context.hashes, context.last_seen, context.active_present, context.active_path, context.active_hash, context.focused_present, context.focused_path, context.focused_hash, false, "", 0, context.frame_index, false, context.lease, context.lease_version)
    return commit_context(context, next)

pub fn enter_modal(frame: UiFrame, id: WidgetId) -> Result[UiFrame, String]:
    if not lease_is_current(frame.context):
        return Err("stale UI context or frame state")
    if not frame.context.frame_open:
        return Err("UI modal scope requires an open frame")
    if frame.modal_scope_present:
        return Err("UI frame already has an active modal scope")
    if not frame.context.modal_present or frame.context.modal_hash != id.hash or frame.context.modal_path != id.path:
        return Err("UI modal scope does not match the active modal")
    match register_widget_uncommitted(frame, id):
        case Err(message):
            return Err(message)
        case Ok(registered):
            let scoped = with_modal_scope(registered, true, id.path, id.hash)
            return commit_frame(scoped, scoped.context)

pub fn exit_modal(frame: UiFrame) -> Result[UiFrame, String]:
    if not lease_is_current(frame.context):
        return Err("stale UI context or frame state")
    if not frame.context.frame_open:
        return Err("UI modal scope requires an open frame")
    if not frame.modal_scope_present:
        return Err("UI frame has no active modal scope")
    let scoped = with_modal_scope(frame, false, "", 0)
    return commit_frame(scoped, scoped.context)

pub fn end_frame(frame: UiFrame) -> Result[Context, String]:
    if not lease_is_current(frame.context):
        return Err("stale UI context or frame state")
    if not frame.context.frame_open:
        return Err("UI frame is already closed")
    if frame.modal_scope_present:
        return Err("UI modal scope must be exited before ending the frame")
    let records = retained_records(frame.context, 0, collections.length(frame.context.paths))
    var active_present = frame.context.active_present
    if active_present and not seen_this_frame(frame.context, frame.context.active_path, frame.context.active_hash):
        active_present = false
    var focused_present = frame.context.focused_present
    if focused_present and not seen_this_frame(frame.context, frame.context.focused_path, frame.context.focused_hash):
        focused_present = false
    var modal_present = frame.context.modal_present
    if modal_present and not seen_this_frame(frame.context, frame.context.modal_path, frame.context.modal_hash):
        modal_present = false
    let next = Context(frame.context.namespace, frame.context.capacity, frame.context.retention_frames, records.paths, records.hashes, records.last_seen, active_present, frame.context.active_path, frame.context.active_hash, focused_present, frame.context.focused_path, frame.context.focused_hash, modal_present, frame.context.modal_path, frame.context.modal_hash, frame.context.frame_index, false, frame.context.lease, frame.context.lease_version)
    return commit_context(frame.context, next)

pub fn activation_pressed(frame: UiFrame) -> Result[Bool, String]:
    match require_current_frame(frame):
        case Err(message):
            return Err(message)
        case Ok(current):
            let ignored = current
    return Ok(frame.space_pressed or frame.enter_pressed)

pub fn cancel_pressed(frame: UiFrame) -> Result[Bool, String]:
    match require_current_frame(frame):
        case Err(message):
            return Err(message)
        case Ok(current):
            let ignored = current
    return Ok(frame.escape_pressed)

pub fn focus_next_pressed(frame: UiFrame) -> Result[Bool, String]:
    match require_current_frame(frame):
        case Err(message):
            return Err(message)
        case Ok(current):
            let ignored = current
    return Ok(frame.tab_pressed)

pub fn navigation_left_pressed(frame: UiFrame) -> Result[Bool, String]:
    match require_current_frame(frame):
        case Err(message):
            return Err(message)
        case Ok(current):
            let ignored = current
    return Ok(frame.left_pressed)

pub fn navigation_right_pressed(frame: UiFrame) -> Result[Bool, String]:
    match require_current_frame(frame):
        case Err(message):
            return Err(message)
        case Ok(current):
            let ignored = current
    return Ok(frame.right_pressed)

pub fn navigation_up_pressed(frame: UiFrame) -> Result[Bool, String]:
    match require_current_frame(frame):
        case Err(message):
            return Err(message)
        case Ok(current):
            let ignored = current
    return Ok(frame.up_pressed)

pub fn navigation_down_pressed(frame: UiFrame) -> Result[Bool, String]:
    match require_current_frame(frame):
        case Err(message):
            return Err(message)
        case Ok(current):
            let ignored = current
    return Ok(frame.down_pressed)

pub fn active_is(context: Context, id: WidgetId) -> Result[Bool, String]:
    if not lease_is_current(context):
        return Err("stale UI context or frame state")
    return Ok(active_is_unchecked(context, id))

pub fn focused_is(context: Context, id: WidgetId) -> Result[Bool, String]:
    if not lease_is_current(context):
        return Err("stale UI context or frame state")
    return Ok(focused_is_unchecked(context, id))

pub fn modal_is(context: Context, id: WidgetId) -> Result[Bool, String]:
    if not lease_is_current(context):
        return Err("stale UI context or frame state")
    return Ok(context.modal_present and context.modal_hash == id.hash and context.modal_path == id.path)

pub fn context_capacity(context: Context) -> Result[Int, String]:
    if not lease_is_current(context):
        return Err("stale UI context or frame state")
    return Ok(context.capacity)

pub fn context_unseen_retention_frames(context: Context) -> Result[Int, String]:
    if not lease_is_current(context):
        return Err("stale UI context or frame state")
    return Ok(context.retention_frames)

pub fn context_retained_count(context: Context) -> Result[Int, String]:
    if not lease_is_current(context):
        return Err("stale UI context or frame state")
    return Ok(collections.length(context.paths))

pub fn context_contains(context: Context, id: WidgetId) -> Result[Bool, String]:
    if not lease_is_current(context):
        return Err("stale UI context or frame state")
    return Ok(context_contains_unchecked(context, id))

fn context_contains_unchecked(context: Context, id: WidgetId) -> Bool:
    var index = 0
    while index < collections.length(context.hashes):
        if context.hashes[index] == id.hash and context.paths[index] == id.path:
            return true
        index = index + 1
    return false

pub fn response_is_current(frame: UiFrame, response: Response) -> Bool:
    return frame.context.frame_open and lease_is_current(frame.context) and response.context_namespace == frame.context.namespace and response.frame_index == frame.context.frame_index and seen_this_frame(frame.context, response.id.path, response.id.hash) and response_belongs_to(frame.context, response)

pub fn response_is_current_context(context: Context, response: Response) -> Bool:
    return context.frame_open and lease_is_current(context) and response.context_namespace == context.namespace and response.frame_index == context.frame_index and seen_this_frame(context, response.id.path, response.id.hash) and response_belongs_to(context, response)

fn compose_id(parent: String, child: String) -> WidgetId:
    let segment = string.concat(string.from_int(string.byte_length(child)), string.concat(":", child))
    let path = string.concat(string.from_int(string.byte_length(parent)), string.concat(":", string.concat(parent, segment)))
    return WidgetId(path, collections.hash(path))

fn modal_blocks(frame: UiFrame, id: WidgetId) -> Bool:
    if not frame.context.modal_present:
        return false
    if frame.modal_scope_present and frame.modal_scope_hash == frame.context.modal_hash and frame.modal_scope_path == frame.context.modal_path:
        return false
    return true

fn set_active(context: Context, id: WidgetId) -> Context:
    return Context(context.namespace, context.capacity, context.retention_frames, context.paths, context.hashes, context.last_seen, true, id.path, id.hash, context.focused_present, context.focused_path, context.focused_hash, context.modal_present, context.modal_path, context.modal_hash, context.frame_index, context.frame_open, context.lease, context.lease_version)

fn clear_active(context: Context) -> Context:
    return Context(context.namespace, context.capacity, context.retention_frames, context.paths, context.hashes, context.last_seen, false, context.active_path, context.active_hash, context.focused_present, context.focused_path, context.focused_hash, context.modal_present, context.modal_path, context.modal_hash, context.frame_index, context.frame_open, context.lease, context.lease_version)

fn set_focus(context: Context, id: WidgetId) -> Context:
    return Context(context.namespace, context.capacity, context.retention_frames, context.paths, context.hashes, context.last_seen, context.active_present, context.active_path, context.active_hash, true, id.path, id.hash, context.modal_present, context.modal_path, context.modal_hash, context.frame_index, context.frame_open, context.lease, context.lease_version)

fn clear_focus(context: Context) -> Context:
    return Context(context.namespace, context.capacity, context.retention_frames, context.paths, context.hashes, context.last_seen, context.active_present, context.active_path, context.active_hash, false, context.focused_path, context.focused_hash, context.modal_present, context.modal_path, context.modal_hash, context.frame_index, context.frame_open, context.lease, context.lease_version)

fn claim_context(context: Context) -> Result[Int, String]:
    let next = context.lease_version + 1
    if not sync.atomic_compare_exchange(context.lease, context.lease_version, next):
        return Err("stale UI context or frame state")
    return Ok(next)

fn commit_context(source: Context, candidate: Context) -> Result[Context, String]:
    match claim_context(source):
        case Err(message):
            return Err(message)
        case Ok(version):
            return Ok(with_lease_version(candidate, version))

fn commit_frame(frame: UiFrame, candidate: Context) -> Result[UiFrame, String]:
    match commit_context(frame.context, candidate):
        case Err(message):
            return Err(message)
        case Ok(context):
            return Ok(with_context(frame, context))

fn lease_is_current(context: Context) -> Bool:
    return sync.atomic_load(context.lease) == context.lease_version

fn require_current_frame(frame: UiFrame) -> Result[Bool, String]:
    if not frame.context.frame_open or not lease_is_current(frame.context):
        return Err("stale UI context or frame state")
    return Ok(true)

fn active_is_unchecked(context: Context, id: WidgetId) -> Bool:
    return context.active_present and context.active_hash == id.hash and context.active_path == id.path

fn focused_is_unchecked(context: Context, id: WidgetId) -> Bool:
    return context.focused_present and context.focused_hash == id.hash and context.focused_path == id.path

fn response_belongs_to(context: Context, response: Response) -> Bool:
    let version = context.lease_version
    let marker = 0 - version - 1
    if not sync.atomic_compare_exchange(context.lease, version, marker):
        return false
    let belongs = sync.atomic_load(response.context_lease) == marker
    let restored = sync.atomic_compare_exchange(context.lease, marker, version)
    return belongs and restored

fn with_lease_version(context: Context, version: Int) -> Context:
    return Context(context.namespace, context.capacity, context.retention_frames, context.paths, context.hashes, context.last_seen, context.active_present, context.active_path, context.active_hash, context.focused_present, context.focused_path, context.focused_hash, context.modal_present, context.modal_path, context.modal_hash, context.frame_index, context.frame_open, context.lease, version)

fn with_context(frame: UiFrame, context: Context) -> UiFrame:
    return UiFrame(context, frame.pointer_present, frame.pointer, frame.pointer_pressed, frame.pointer_down, frame.pointer_released, frame.space_pressed, frame.enter_pressed, frame.escape_pressed, frame.tab_pressed, frame.left_pressed, frame.right_pressed, frame.up_pressed, frame.down_pressed, frame.modal_scope_present, frame.modal_scope_path, frame.modal_scope_hash)

fn with_modal_scope(frame: UiFrame, present: Bool, path: String, hash: Int) -> UiFrame:
    return UiFrame(frame.context, frame.pointer_present, frame.pointer, frame.pointer_pressed, frame.pointer_down, frame.pointer_released, frame.space_pressed, frame.enter_pressed, frame.escape_pressed, frame.tab_pressed, frame.left_pressed, frame.right_pressed, frame.up_pressed, frame.down_pressed, present, path, hash)

fn seen_this_frame(context: Context, path: String, hash: Int) -> Bool:
    var index = 0
    while index < collections.length(context.hashes):
        if context.hashes[index] == hash and context.paths[index] == path and context.last_seen[index] == context.frame_index:
            return true
        index = index + 1
    return false

fn make_widget_room(context: Context) -> Result[Context, String]:
    if collections.length(context.paths) < context.capacity:
        return Ok(context)
    var oldest_index = -1
    var oldest_frame = context.frame_index
    var index = 0
    while index < collections.length(context.last_seen):
        if context.last_seen[index] != context.frame_index and(oldest_index < 0 or context.last_seen[index] < oldest_frame):
            oldest_index = index
            oldest_frame = context.last_seen[index]
        index = index + 1
    if oldest_index < 0:
        return Err("UI context widget capacity exceeded")
    let removed_path = context.paths[oldest_index]
    let removed_hash = context.hashes[oldest_index]
    let paths = collections.remove(context.paths, oldest_index).values
    let hashes = collections.remove(context.hashes, oldest_index).values
    let last_seen = collections.remove(context.last_seen, oldest_index).values
    let active_present = context.active_present and(context.active_hash != removed_hash or context.active_path != removed_path)
    let focused_present = context.focused_present and(context.focused_hash != removed_hash or context.focused_path != removed_path)
    let modal_present = context.modal_present and(context.modal_hash != removed_hash or context.modal_path != removed_path)
    return Ok(Context(context.namespace, context.capacity, context.retention_frames, paths, hashes, last_seen, active_present, context.active_path, context.active_hash, focused_present, context.focused_path, context.focused_hash, modal_present, context.modal_path, context.modal_hash, context.frame_index, context.frame_open, context.lease, context.lease_version))

fn retained_records(context: Context, start: Int, end: Int) -> Records:
    if start >= end:
        return Records([], [], [])
    if end - start == 1:
        if context.frame_index - context.last_seen[start] <= context.retention_frames:
            return Records([context.paths[start]], [context.hashes[start]], [context.last_seen[start]])
        return Records([], [], [])
    let middle = start +(end - start) / 2
    let left = retained_records(context, start, middle)
    let right = retained_records(context, middle, end)
    return Records(collections.concat(left.paths, right.paths), collections.concat(left.hashes, right.hashes), collections.concat(left.last_seen, right.last_seen))
