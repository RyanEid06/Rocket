{
  "name": "rocket-language",
  "displayName": "Rocket Language",
  "description": "Syntax, snippets, live diagnostics, and language configuration for Rocket.",
  "version": "1.7.0",
  "publisher": "rocket-lang",
  "license": "UNLICENSED",
  "engines": {
    "vscode": "^1.85.0"
  },
  "main": "./extension.js",
  "activationEvents": ["onLanguage:rocket"],
  "categories": ["Programming Languages"],
  "contributes": {
    "languages": [
      {
        "id": "rocket",
        "aliases": ["Rocket", "rocket"],
        "extensions": [".rocket"],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "rocket",
        "scopeName": "source.rocket",
        "path": "./syntaxes/rocket.tmLanguage.json"
      }
    ],
    "snippets": [
      {
        "language": "rocket",
        "path": "./snippets/rocket.json"
      }
    ],
    "problemMatchers": [
      {
        "name": "rocket",
        "owner": "rocket",
        "fileLocation": "absolute",
        "pattern": {
          "regexp": "^(.*):(\\d+):(\\d+): error\\[(R\\d{4})\\]: (.*)$",
          "file": 1,
          "line": 2,
          "column": 3,
          "code": 4,
          "message": 5
        }
      }
    ],
    "configuration": {
      "title": "Rocket Language Server",
      "properties": {
        "rocket.languageServer.path": {
          "type": "string",
          "default": "rocket-lsp",
          "description": "Path to the rocket-lsp executable."
        },
        "rocket.languageServer.trace": {
          "type": "boolean",
          "default": false,
          "description": "Log language-server protocol method names to the Rocket output channel."
        }
      }
    }
  }
}
