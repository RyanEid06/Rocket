import std.async_process
import std.cancel
import std.task
import std.time

fn main() -> Int:
    let token = cancel.token()
    let deadline = time.monotonic_milliseconds() + 5000
    match task.join(async_process.run("cmd.exe", ["/c", "exit", "7"], deadline, token)):
        case Ok(code):
            print(code)
        case Err(message):
            print(message)
            return 1

    let slow = async_process.run("cmd.exe", ["/c", "ping", "-n", "6", "127.0.0.1", ">", "nul"], time.monotonic_milliseconds() + 10000, token)
    time.sleep_milliseconds(50)
    print(task.cancel(slow))
    match task.join(slow):
        case Ok(code):
            print(code)
            return 2
        case Err(message):
            print(message)
    return 0
