import std.thread

async fn compute(value: String) -> Result[String, String]:
    return Ok(value)

fn main() -> Int:
    match thread.spawn(compute("thread-result")):
        case Ok(worker):
            match thread.join(worker):
                case Ok(value):
                    print(value)
                case Err(message):
                    print(message)
                    return 2
        case Err(message):
            print(message)
            return 1
    return 0
