import rocket.raylib.native
import rocket.raylib.safe


pub fn enable() -> Bool:
    unsafe:
        return native.rlv_enable_test_mode(true) == 0

pub fn reset() -> Bool:
    unsafe:
        return native.rlv_test_reset() == 0

pub fn set_display(logical_width: Int, logical_height: Int, framebuffer_width: Int, framebuffer_height: Int, dpi_x: Float, dpi_y: Float) -> Bool:
    unsafe:
        return native.rlv_test_set_display_metrics(logical_width, logical_height, framebuffer_width, framebuffer_height, dpi_x, dpi_y, 1, 0) == 0

pub fn set_capabilities(resize: Bool, fullscreen: Bool, borderless: Bool) -> Bool:
    unsafe:
        return native.rlv_test_set_display_capabilities(resize, fullscreen, borderless, true, true) == 0

pub fn set_mouse(x: Int, y: Int) -> Bool:
    unsafe:
        return native.rlv_test_set_mouse_state(x, y, false, false, false) == 0

pub fn scissor_x() -> Int:
    unsafe:
        return native.rlv_test_scissor_x()

pub fn scissor_y() -> Int:
    unsafe:
        return native.rlv_test_scissor_y()

pub fn scissor_width() -> Int:
    unsafe:
        return native.rlv_test_scissor_width()

pub fn scissor_height() -> Int:
    unsafe:
        return native.rlv_test_scissor_height()

pub fn draw_calls() -> Int:
    unsafe:
        return native.rlv_draw_count()

pub fn screenshots() -> Int:
    unsafe:
        return native.rlv_screenshot_count()

pub fn fullscreen(window: safe.Window) -> Bool:
    unsafe:
        return native.rlv_window_fullscreen(window.id)

pub fn borderless(window: safe.Window) -> Bool:
    unsafe:
        return native.rlv_window_borderless(window.id)
