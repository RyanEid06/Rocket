import rocket.raylib.native

pub fn enable() -> Bool:
    unsafe:
        return native.rlv_enable_test_mode(true) == 0

pub fn reset() -> Bool:
    unsafe:
        return native.rlv_test_reset() == 0

pub fn set_display() -> Bool:
    unsafe:
        return native.rlv_test_set_display_metrics(800, 450, 1600, 900, 2.0, 2.0, 1, 0) == 0

pub fn set_mouse(pressed: Bool, down: Bool, released: Bool) -> Bool:
    unsafe:
        return native.rlv_test_set_mouse_state(400, 225, pressed, down, released) == 0
