import rocket.raylib.native

pub fn enable() -> Bool:
    unsafe:
        return native.rlv_enable_test_mode(true) == 0

pub fn reset() -> Bool:
    unsafe:
        return native.rlv_test_reset() == 0

pub fn set_display(width: Int, height: Int) -> Bool:
    unsafe:
        return native.rlv_test_set_display_metrics(width, height, width, height, 1.0, 1.0, 1, 0) == 0

pub fn set_mouse(x: Int, y: Int, pressed: Bool, down: Bool, released: Bool) -> Bool:
    unsafe:
        return native.rlv_test_set_mouse_state(x, y, pressed, down, released) == 0

pub fn scope_depth() -> Int:
    unsafe:
        return native.rlv_scope_depth()

pub fn scissor_x() -> Int:
    unsafe:
        return native.rlv_test_scissor_x()

pub fn scissor_y() -> Int:
    unsafe:
        return native.rlv_test_scissor_y()

pub fn scissor_width() -> Int:
    unsafe:
        return native.rlv_test_scissor_width()

pub fn scissor_height() -> Int:
    unsafe:
        return native.rlv_test_scissor_height()
