import std.math

fn main() -> Int:
    let _pi = math.pi()
    let _tau = math.tau()
    let _e = math.e()
    let _abs = math.abs(value: -2.0)
    let _abs_int = math.abs_int(value: -2)
    let _min = math.min(right: 2.0, left: 1.0)
    let _max = math.max(right: 2.0, left: 1.0)
    let _min_int = math.min_int(right: 2, left: 1)
    let _max_int = math.max_int(right: 2, left: 1)
    let _clamp = math.clamp(maximum: 1.0, value: 0.5, minimum: 0.0)
    let _clamp_int = math.clamp_int(maximum: 1, value: 0, minimum: -1)
    let _sign = math.sign(value: -1.0)
    let _sign_int = math.sign_int(value: -1)
    let _floor = math.floor(value: 1.0)
    let _ceil = math.ceil(value: 1.0)
    let _round = math.round(value: 1.0)
    let _trunc = math.trunc(value: 1.0)
    let _fract = math.fract(value: 1.0)
    let _sqrt = math.sqrt(value: 1.0)
    let _pow = math.pow(exponent: 2.0, base: 2.0)
    let _exp = math.exp(value: 1.0)
    let _log = math.log(value: 1.0)
    let _log10 = math.log10(value: 1.0)
    let _sin = math.sin(radians: 1.0)
    let _cos = math.cos(radians: 1.0)
    let _tan = math.tan(radians: 1.0)
    let _asin = math.asin(value: 0.0)
    let _acos = math.acos(value: 0.0)
    let _atan = math.atan(value: 0.0)
    let _atan2 = math.atan2(x: 1.0, y: 0.0)
    let _radians = math.radians(degrees: 180.0)
    let _degrees = math.degrees(radians: 1.0)
    let _lerp = math.lerp(progress: 0.5, end: 1.0, start: 0.0)
    let _inverse_lerp = math.inverse_lerp(value: 0.5, end: 1.0, start: 0.0)
    let _remap = math.remap(value: 0.5, output_end: 1.0, output_start: 0.0, input_end: 1.0, input_start: 0.0)
    let _smoothstep = math.smoothstep(value: 0.5, end: 1.0, start: 0.0)
    let _smootherstep = math.smootherstep(value: 0.5, end: 1.0, start: 0.0)
    let _approach = math.approach(maximum_delta: 1.0, target: 1.0, current: 0.0)
    let _move_towards = math.move_towards(maximum_delta: 1.0, target: 1.0, current: 0.0)
    return 0
