import rocket.graphics
import rocket.graphics.shapes
import rocket.raylib.safe

fn main() -> Int:
    let frame = safe.Frame(1)
    let color = graphics.color_from_rgba(1.0, 0.0, 0.0, 1.0)
    let invalid_bounds = graphics.vec2(10.0, 20.0)
    let result = shapes.draw_rect(frame, invalid_bounds, color)
    return 0
