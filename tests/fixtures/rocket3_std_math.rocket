import std.math

fn main() -> Int:
    let tolerance = 0.000000000001
    print(math.abs(math.pi() - 3.141592653589793) <= tolerance)
    print(math.abs(math.tau() - 6.283185307179586) <= tolerance)
    print(math.abs(math.e() - 2.718281828459045) <= tolerance)
    print(math.abs(-2.5) == 2.5)
    print(math.abs_int(-7) == 7)
    print(math.min(2.0, -1.0) == -1.0)
    print(math.max(2.0, -1.0) == 2.0)
    print(math.min_int(2, -1) == -1)
    print(math.max_int(2, -1) == 2)
    print(math.clamp(4.0, 0.0, 3.0) == 3.0)
    print(math.clamp_int(-1, 0, 3) == 0)
    print(math.sign(-0.5) == -1.0 and math.sign(0.0) == 0.0)
    print(math.sign_int(-1) == -1 and math.sign_int(0) == 0)
    print(math.floor(-1.2) == -2.0 and math.ceil(-1.2) == -1.0)
    print(math.round(-1.5) == -2.0 and math.trunc(-1.9) == -1.0)
    print(math.fract(-1.25) == 0.75)
    print(math.sqrt(9.0) == 3.0 and math.abs(math.sqrt(2.0) - 1.4142135623730951) <= tolerance)
    print(math.pow(2.0, 3.0) == 8.0 and math.pow(-2.0, 3.0) == -8.0)
    print(math.exp(0.0) == 1.0 and math.abs(math.exp(1.0) - math.e()) <= tolerance)
    print(math.abs(math.log(math.e()) - 1.0) <= tolerance and math.log10(1000.0) == 3.0)
    print(math.sin(0.0) == 0.0 and math.abs(math.sin(math.pi() / 6.0) - 0.5) <= tolerance)
    print(math.cos(0.0) == 1.0 and math.abs(math.cos(math.pi() / 3.0) - 0.5) <= tolerance)
    print(math.tan(0.0) == 0.0 and math.abs(math.tan(math.pi() / 4.0) - 1.0) <= tolerance)
    print(math.asin(0.0) == 0.0 and math.abs(math.asin(0.5) - math.pi() / 6.0) <= tolerance)
    print(math.acos(1.0) == 0.0 and math.abs(math.acos(0.5) - math.pi() / 3.0) <= tolerance)
    print(math.atan(0.0) == 0.0 and math.abs(math.atan(1.0) - math.pi() / 4.0) <= tolerance)
    print(math.abs(math.atan2(1.0, -1.0) - 3.0 * math.pi() / 4.0) <= tolerance)
    print(math.abs(math.degrees(math.pi()) - 180.0) <= tolerance)
    print(math.abs(math.radians(180.0) - math.pi()) <= tolerance)
    print(math.lerp(10.0, 20.0, 0.25) == 12.5)
    print(math.inverse_lerp(10.0, 20.0, 12.5) == 0.25)
    print(math.remap(10.0, 20.0, 0.0, 100.0, 12.5) == 25.0)
    print(math.smoothstep(0.0, 1.0, 0.0) == 0.0 and math.smoothstep(0.0, 1.0, 1.0) == 1.0)
    print(math.smootherstep(0.0, 1.0, 0.0) == 0.0 and math.smootherstep(0.0, 1.0, 1.0) == 1.0)
    print(math.approach(0.0, 10.0, 3.0) == 3.0 and math.approach(10.0, 0.0, 3.0) == 7.0)
    print(math.move_towards(0.0, 10.0, 12.0) == 10.0)
    let nan = math.sqrt(-1.0)
    let infinity = math.exp(1000.0)
    let huge = math.exp(709.0) * 2.0
    let int_min = -9223372036854775807 - 1
    print(not (nan == nan) and math.sign(nan) != math.sign(nan))
    print(infinity == infinity and math.sign(infinity) == 1.0)
    print(math.sign(-infinity) == -1.0 and math.abs(-infinity) == infinity)
    print(math.atan2(math.sign(-0.0), -1.0) < 0.0 and math.atan2(math.sign(0.0), -1.0) > 0.0)
    print(math.atan2(math.abs(-0.0), -1.0) > 0.0)
    print(math.min(nan, 2.0) == 2.0 and math.max(2.0, nan) == 2.0)
    print(not (math.min(nan, nan) == math.min(nan, nan)) and not (math.max(nan, nan) == math.max(nan, nan)))
    print(not (math.clamp(0.0, 2.0, 1.0) == math.clamp(0.0, 2.0, 1.0)))
    print(math.clamp(2.0, nan, 1.0) == 1.0 and math.clamp(-1.0, 0.0, nan) == 0.0)
    print(math.clamp_int(2, 3, 1) == 2)
    print(not (math.inverse_lerp(1.0, 1.0, 1.0) == math.inverse_lerp(1.0, 1.0, 1.0)))
    print(math.abs_int(int_min) == 9223372036854775807)
    print(math.round(1.5) == 2.0 and math.round(-1.5) == -2.0)
    print(not (math.fract(infinity) == math.fract(infinity)))
    print(not (math.asin(2.0) == math.asin(2.0)) and not (math.acos(2.0) == math.acos(2.0)))
    print(not (math.log(-1.0) == math.log(-1.0)) and not (math.pow(-1.0, 0.5) == math.pow(-1.0, 0.5)))
    print(math.log(0.0) == math.log(0.0) and math.sign(math.log(0.0)) == -1.0)
    print(math.lerp(-huge, huge, 0.0) == -huge and math.lerp(-huge, huge, 1.0) == huge)
    print(math.lerp(-huge, huge, 0.5) == 0.0)
    print(math.lerp(10.0, 20.0, -1.0) == 0.0 and math.lerp(10.0, 20.0, 2.0) == 30.0)
    print(math.abs(math.inverse_lerp(-huge, huge, 0.0) - 0.5) <= tolerance)
    print(math.inverse_lerp(-huge, huge, -huge) == 0.0 and math.inverse_lerp(-huge, huge, huge) == 1.0)
    print(math.abs(math.inverse_lerp(huge, -huge, 0.0) - 0.5) <= tolerance)
    print(math.inverse_lerp(0.0, 10.0, -5.0) == -0.5 and math.inverse_lerp(0.0, 10.0, 15.0) == 1.5)
    print(math.remap(-huge, huge, 0.0, 1.0, -huge) == 0.0 and math.remap(-huge, huge, 0.0, 1.0, huge) == 1.0)
    print(math.remap(0.0, 10.0, 10.0, 20.0, -5.0) == 5.0)
    print(not (math.smoothstep(1.0, 1.0, 1.0) == math.smoothstep(1.0, 1.0, 1.0)))
    print(not (math.smootherstep(1.0, 1.0, 1.0) == math.smootherstep(1.0, 1.0, 1.0)))
    print(math.smoothstep(0.0, 1.0, -1.0) == 0.0 and math.smoothstep(0.0, 1.0, 2.0) == 1.0)
    print(math.smootherstep(0.0, 1.0, -1.0) == 0.0 and math.smootherstep(0.0, 1.0, 2.0) == 1.0)
    print(math.radians(huge) < huge and math.radians(huge) == math.radians(huge))
    print(math.degrees(huge / 100.0) < huge and math.degrees(huge / 100.0) == math.degrees(huge / 100.0))
    print(math.approach(0.0, 10.0, -1.0) == 0.0 and math.move_towards(0.0, 10.0, -1.0) == 0.0)
    print(math.approach(0.0, 10.0, 0.0) == 0.0 and math.move_towards(10.0, 10.0, infinity) == 10.0)
    print(math.approach(-huge, huge, huge) == 0.0 and math.move_towards(huge, -huge, huge) == 0.0)
    print(math.approach(-infinity, 0.0, infinity) == 0.0 and math.move_towards(infinity, 0.0, infinity) == 0.0)
    print(math.approach(infinity, 0.0, 1.0) == infinity and math.move_towards(-infinity, 0.0, 1.0) == -infinity)
    print(not (math.approach(nan, 0.0, 1.0) == math.approach(nan, 0.0, 1.0)))
    print(not (math.move_towards(0.0, nan, 1.0) == math.move_towards(0.0, nan, 1.0)))
    print(not (math.approach(0.0, 1.0, nan) == math.approach(0.0, 1.0, nan)))
    return 0
