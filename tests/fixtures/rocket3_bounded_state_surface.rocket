import rocket.ui

fn retains(context: ui.Context, id: ui.WidgetId) -> Result[Bool, String]:
    match ui.context_contains(context, id):
        case Err(message):
            return Err(message)
        case Ok(present):
            match ui.context_retained_count(context):
                case Err(message):
                    return Err(message)
                case Ok(count):
                    match ui.context_capacity(context):
                        case Err(message):
                            return Err(message)
                        case Ok(capacity):
                            return Ok(present and count <= capacity)

fn main() -> Int:
    let defaults = ui.new_context("surface")
    let configured = ui.new_context("configured", capacity: 32, unseen_retention_frames: 4)
    let default_capacity = ui.default_context_capacity()
    let default_retention = ui.default_unseen_retention_frames()
    return 0
