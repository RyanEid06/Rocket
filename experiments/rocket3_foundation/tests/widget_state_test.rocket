import std.collections
import std.string
import src.widget_state

fn same_text(left: String, right: String) -> Bool:
    return left == right

fn main() -> Int:
    let root = widget_state.compose_id("", "panel")
    let child = widget_state.compose_id(root.path, "button")
    let same_child = widget_state.compose_id(root.path, "button")
    if not same_text(child.path, "9:0:5:panel6:button") or child.hash != same_child.hash:
        return 1
    let slash_parent = widget_state.compose_id("", "a/b")
    let slash_child = widget_state.compose_id(slash_parent.path, "c")
    let nested_parent = widget_state.compose_id("", "a")
    let nested_child = widget_state.compose_id(nested_parent.path, "b/c")
    if slash_child.path == nested_child.path:
        return 18
    let raw_parent_first = widget_state.compose_id("seed", "x2:ab")
    let raw_parent_second = widget_state.compose_id("seed5:x", "ab")
    if raw_parent_first.path == raw_parent_second.path:
        return 24

    match widget_state.new_state(3):
        case Ok(initial):
            var state = widget_state.begin_frame(initial)
            let first = widget_state.register(state, root)
            if not first.accepted or first.duplicate:
                return 2
            state = first.state
            let second = widget_state.register(state, child)
            if not second.accepted or second.duplicate:
                return 3
            state = second.state
            let duplicate = widget_state.register(state, child)
            if duplicate.accepted or not duplicate.duplicate:
                return 4
            state = duplicate.state
            state = widget_state.set_active(state, child)
            state = widget_state.set_focused(state, root)
            state = widget_state.end_frame(state)
            if widget_state.count(state) != 2:
                return 5
            if not widget_state.active_is(state, child):
                return 19
            if not widget_state.focused_is(state, root):
                return 20

            state = widget_state.begin_frame(state)
            let third = widget_state.register(state, widget_state.compose_id("", "new"))
            if not third.accepted:
                return 6
            state = widget_state.end_frame(third.state)
            if widget_state.count(state) != 1:
                return 7
            if widget_state.has_active(state) or widget_state.has_focused(state):
                return 21

            state = widget_state.begin_frame(state)
            let a = widget_state.register(state, root)
            state = a.state
            let b = widget_state.register(state, child)
            state = b.state
            let c = widget_state.register(state, same_child)
            state = c.state
            let full = widget_state.register(state, widget_state.compose_id("", "fourth"))
            if full.accepted or full.duplicate:
                return 8
            state = widget_state.end_frame(full.state)
            if widget_state.count(state) != 2:
                return 9
        case Err(message):
            return 10

    let colliding_left = widget_state.WidgetId("left", 7)
    let colliding_right = widget_state.WidgetId("right", 7)
    match widget_state.new_state(2):
        case Ok(initial):
            var collision = widget_state.begin_frame(initial)
            let left = widget_state.register(collision, colliding_left)
            if not left.accepted:
                return 25
            collision = left.state
            let right = widget_state.register(collision, colliding_right)
            if not right.accepted:
                return 26
            collision = right.state
            collision = widget_state.set_active(collision, colliding_left)
            collision = widget_state.set_focused(collision, colliding_right)
            collision = widget_state.end_frame(collision)
            collision = widget_state.begin_frame(collision)
            let seen_right = widget_state.register(collision, colliding_right)
            collision = widget_state.end_frame(seen_right.state)
            if widget_state.has_active(collision):
                return 22
            if not widget_state.focused_is(collision, colliding_right):
                return 23
        case Err(message):
            return 30

    match widget_state.new_state(0):
        case Ok(value):
            return 11
        case Err(message):
            if message.byte_length() == 0:
                return 12
    match widget_state.new_state(100001):
        case Ok(value):
            return 13
        case Err(message):
            if message.byte_length() == 0:
                return 14

    match widget_state.new_state(100000):
        case Ok(initial):
            var stress = widget_state.begin_frame(initial)
            match widget_state.register_many(stress, "stress", 100000):
                case Ok(value):
                    stress = value
                case Err(message):
                    return 15
            if widget_state.count(stress) != 100000:
                return 16
            let repeated = widget_state.register(stress, widget_state.compose_id("stress", "99999"))
            if repeated.accepted or not repeated.duplicate:
                return 17
            stress = widget_state.end_frame(repeated.state)
            if widget_state.count(stress) != 100000:
                return 18
        case Err(message):
            return 19
    return 0
