# Deprecated Rocket 1.4 compatibility shim. New games import rocket.assets.
# All store behavior and ownership live in the bundled module.
import rocket.assets
import rocket.raylib.safe
import src.rocket_raylib

pub struct AssetStore:
    id: Int

pub struct TextureRef:
    id: Int

pub struct FontRef:
    id: Int

pub struct SoundRef:
    id: Int

pub struct MusicRef:
    id: Int

pub struct ShaderRef:
    id: Int

pub fn open(window: rocket_raylib.Window, audio: rocket_raylib.AudioDevice, package_root: String = ".", capacity: Int = 256) -> Result[AssetStore, String]:
    match assets.open(safe.Window(window.id), safe.AudioDevice(audio.id), package_root, capacity):
        case Err(message):
            return Err(message)
        case Ok(store):
            return Ok(AssetStore(store.id))

pub fn open_graphics(window: rocket_raylib.Window, package_root: String = ".") -> Result[AssetStore, String]:
    match assets.open_graphics(safe.Window(window.id), package_root):
        case Err(message):
            return Err(message)
        case Ok(store):
            return Ok(AssetStore(store.id))

pub fn capacity(store: AssetStore) -> Result[Int, String]:
    return assets.capacity(assets.AssetStore(store.id))

pub fn cleanup(store: AssetStore) -> Result[Bool, String]:
    return assets.cleanup(assets.AssetStore(store.id))

pub fn load_texture(store: AssetStore, name: String, path: String) -> Result[TextureRef, String]:
    match assets.load_texture(assets.AssetStore(store.id), name, path):
        case Err(message):
            return Err(message)
        case Ok(reference):
            return Ok(TextureRef(reference.id))

pub fn load_font(store: AssetStore, name: String, path: String) -> Result[FontRef, String]:
    match assets.load_font(assets.AssetStore(store.id), name, path):
        case Err(message):
            return Err(message)
        case Ok(reference):
            return Ok(FontRef(reference.id))

pub fn load_sound(store: AssetStore, name: String, path: String) -> Result[SoundRef, String]:
    match assets.load_sound(assets.AssetStore(store.id), name, path):
        case Err(message):
            return Err(message)
        case Ok(reference):
            return Ok(SoundRef(reference.id))

