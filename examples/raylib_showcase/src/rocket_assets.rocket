        case Err(message):
            return Err(message)
        case Ok(reference):
            return Ok(MusicRef(reference.id))

pub fn load_shader(store: AssetStore, name: String, vertex_path: String, fragment_path: String) -> Result[ShaderRef, String]:
    match assets.load_shader(assets.AssetStore(store.id), name, vertex_path, fragment_path):
        case Err(message):
            return Err(message)
        case Ok(reference):
            return Ok(ShaderRef(reference.id))

