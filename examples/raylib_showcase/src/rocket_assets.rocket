pub fn borrow_texture(reference: TextureRef) -> Result[rocket_raylib.Texture, String]:
    match assets.borrow_texture(assets.TextureRef(reference.id)):
        case Err(message):
            return Err(message)
        case Ok(texture):
            match safe.texture_width(texture):
                case Err(message):
                    return Err(message)
                case Ok(width):
                    match safe.texture_height(texture):
                        case Err(message):
                            return Err(message)
                        case Ok(height):
                            return Ok(rocket_raylib.Texture(texture.id, width, height))

pub fn borrow_font(reference: FontRef) -> Result[rocket_raylib.Font, String]:
    match assets.borrow_font(assets.FontRef(reference.id)):
        case Err(message):
            return Err(message)
        case Ok(resource):
            return Ok(rocket_raylib.Font(resource.id))

pub fn borrow_sound(reference: SoundRef) -> Result[rocket_raylib.Sound, String]:
    match assets.borrow_sound(assets.SoundRef(reference.id)):
        case Err(message):
