            return Ok(rocket_raylib.Music(resource.id))

pub fn borrow_shader(reference: ShaderRef) -> Result[rocket_raylib.Shader, String]:
    match assets.borrow_shader(assets.ShaderRef(reference.id)):
        case Err(message):
            return Err(message)
        case Ok(resource):
            return Ok(rocket_raylib.Shader(resource.id))
