# The showcase application uses the supported Rocket 3.5 runtime. Its legacy
# tests still exercise src.rocket_raylib until their migration is complete.
import std.process
import rocket.assets
import rocket.graphics
import rocket.graphics.input
import rocket.motion
import rocket.raylib.safe

fn succeeded(value: Result[Bool, String]) -> Bool:
    match value:
        case Ok(success):
            return success
        case Err(message):
            print(message)
            return false

fn key_down(window: safe.Window, key: Int) -> Bool:
    match safe.key_down(window, key):
        case Ok(down):
            return down
        case Err(message):
            print(message)
            return false

fn key_pressed(window: safe.Window, key: Int) -> Bool:
    match safe.key_pressed(window, key):
        case Ok(pressed):
            return pressed
        case Err(message):
            print(message)
            return false

fn draw_scene(frame: safe.Frame, texture: safe.Texture, font: safe.Font, x: Float, y: Float, satellite: Float) -> Bool:
    if not succeeded(safe.clear_background(frame, safe.color(18, 22, 31))):
        return false
    if not succeeded(safe.draw_rect(frame, 42.0, 62.0, 876.0, 472.0, 30, 39, 57, 255)):
        return false
    if not succeeded(safe.draw_text_layout(frame, font, "Rocket + raylib: Orbital Workshop", graphics.rect(64.0, 78.0, 810.0, 42.0), graphics.text_style("default", 28.0), safe.color(245, 245, 245), graphics.text_align_left(), graphics.text_align_middle())):
        return false
    if not succeeded(safe.draw_text_layout(frame, font, "A compatibility showcase using Rocket 3.5 APIs", graphics.rect(64.0, 116.0, 810.0, 34.0), graphics.text_style("default", 18.0), safe.color(102, 191, 255), graphics.text_align_left(), graphics.text_align_middle())):
        return false
    if not succeeded(safe.draw_text_layout(frame, font, "Arrows move | click relocates | space plays audio | escape exits", graphics.rect(64.0, 492.0, 810.0, 32.0), graphics.text_style("default", 16.0), safe.color(180, 190, 210), graphics.text_align_left(), graphics.text_align_middle())):
        return false
    if not succeeded(safe.draw_circle(frame, 480.0, 300.0, 116.0, 45, 58, 82, 255)):
        return false
    if not succeeded(safe.draw_texture_pro(frame, texture, graphics.rect(0.0, 0.0, 8.0, 8.0), graphics.rect(x, y, 64.0, 64.0), graphics.vec2(32.0, 32.0), 0.0, safe.color(245, 245, 245))):
        return false
    return succeeded(safe.draw_circle(frame, 104.0 + satellite, 468.0, 7.0, 255, 183, 3, 255))

fn scene(window: safe.Window, texture: safe.Texture, font: safe.Font, sound: Option[safe.Sound]) -> Int:
    var x = 410.0
    var y = 245.0
    var velocity_x = 2.0
    var velocity_y = 1.0
    let movement = motion.pulse(0.0, 720.0, 12.0)
    let policy = motion.policy(false, false)
    var frames = 0
    var max_frames = 0
    match process.environment("ROCKET_SHOWCASE_FRAMES"):
        case None:
            max_frames = 0
        case Some(value):
            max_frames = 120
    while true:
        if max_frames > 0 and frames >= max_frames:
            break
        match safe.window_should_close(window):
            case Err(message):
                print(message)
                return 21
            case Ok(closing):
                if closing:
                    break
        if key_down(window, safe.key_left()):
            velocity_x = -3.0
        if key_down(window, safe.key_right()):
            velocity_x = 3.0
        if key_down(window, safe.key_up_arrow()):
            velocity_y = -3.0
        if key_down(window, safe.key_down_arrow()):
            velocity_y = 3.0
        match input.pointer_pressed(window):
            case Err(message):
                print(message)
                return 22
            case Ok(pressed):
                if pressed:
                    match input.pointer_position(window):
                        case Err(message):
                            print(message)
                            return 23
                        case Ok(position):
                            x = position.x
                            y = position.y
        if key_pressed(window, safe.key_space()):
            match sound:
                case None:
                    let ignored = x
                case Some(handle):
                    if not succeeded(safe.play_sound(handle)):
                        return 24
        x = x + velocity_x
        y = y + velocity_y
        if x < 90.0 or x > 850.0:
            velocity_x = 0.0 - velocity_x
        if y < 130.0 or y > 470.0:
            velocity_y = 0.0 - velocity_y
        var elapsed = 0.0
        match safe.elapsed_time(window):
            case Err(message):
                print(message)
                return 25
            case Ok(value):
                elapsed = value
        let satellite = motion.sample_float(policy, movement, elapsed).value
        match safe.begin_frame(window):
            case Err(message):
                print(message)
                return 26
            case Ok(frame):
                if not draw_scene(frame, texture, font, x, y, satellite):
                    let aborted = safe.abort_frame(frame)
                    return 27
                if not succeeded(safe.end_frame(frame)):
                    return 28
        frames = frames + 1
    return 0

fn run_loaded(window: safe.Window, texture: safe.Texture) -> Int:
    match safe.default_font(window):
        case Err(message):
            print(message)
            return 13
        case Ok(font):
            var audio: Option[safe.AudioDevice] = None()
            var sound: Option[safe.Sound] = None()
            match safe.open_audio():
                case Err(message):
                    print("Audio device unavailable; continuing silently")
                case Ok(device):
                    audio = Some(device)
                    match safe.create_tone(device, 523.25, 0.12):
                        case Err(message):
                            print("Audio tone unavailable; continuing silently")
                        case Ok(tone):
                            sound = Some(tone)
                            let volume = safe.set_sound_volume(tone, 0.35)
            let status = scene(window, texture, font, sound)
            var cleanup_ok = true
            match sound:
                case None:
                    let ignored = status
                case Some(tone):
                    if not succeeded(safe.stop_sound(tone)):
                        cleanup_ok = false
                    if not succeeded(safe.unload_sound(tone)):
                        cleanup_ok = false
            match audio:
                case None:
                    let ignored = status
                case Some(device):
                    if not succeeded(safe.close_audio(device)):
                        cleanup_ok = false
            if not succeeded(safe.unload_font(font)):
                return 14
            if not cleanup_ok:
                return 20
            return status

pub fn run() -> Int:
    match safe.open_window(960, 600, "Rocket 3.5 raylib compatibility showcase"):
        case Err(message):
            print(message)
            return 11
        case Ok(window):
            if not succeeded(safe.set_target_fps(window, 60)):
                let closed = safe.close_window(window)
                return 15
            var package_root = "."
            match process.environment("ROCKET_SHOWCASE_PACKAGE_ROOT"):
                case None:
                    package_root = "."
                case Some(root):
                    package_root = root
            match assets.open_graphics(window, package_root):
                case Err(message):
                    print(message)
                    let closed = safe.close_window(window)
                    return 12
                case Ok(store):
                    var status = 0
                    match assets.load_texture(store, "orbiter", "assets/orbit.ppm"):
                        case Err(message):
                            print(message)
                            status = 16
                        case Ok(reference):
                            match assets.borrow_texture(reference):
                                case Err(message):
                                    print(message)
                                    status = 17
                                case Ok(texture):
                                    status = run_loaded(window, texture)
                    if not succeeded(assets.cleanup(store)):
                        status = 18
                    if not succeeded(safe.close_window(window)):
                        status = 19
                    return status
