import src.rocket_raylib
import std.collections
import std.file
import std.string

fn caption() -> String:
    match file.read_text("assets/about.txt"):
        case Ok(value):
            return string.trim(value)
        case Err(error):
            return "Rocket 1.4 native interoperability"

fn draw_trail(frame: rocket_raylib.Frame, trail: Array[Int]) -> Bool:
    var index = 0
    while index + 1 < collections.length(trail):
        let result = rocket_raylib.draw_circle(frame, trail[index], trail[index + 1], 3.0, rocket_raylib.sky())
        index = index + 2
    return true

fn scene(window: rocket_raylib.Window, texture: rocket_raylib.Texture, sound: rocket_raylib.Sound, audio_enabled: Bool) -> Int:
    var x = 410
    var y = 245
    var velocity_x = 2
    var velocity_y = 1
    var frame_number = 0
    var trail: Array[Int] = [x, y]
    let description = caption()
    while not rocket_raylib.window_should_close(window):
        if rocket_raylib.is_key_down(window, rocket_raylib.key_left()):
            velocity_x = -3
        if rocket_raylib.is_key_down(window, rocket_raylib.key_right()):
            velocity_x = 3
        if rocket_raylib.is_key_down(window, rocket_raylib.key_up()):
            velocity_y = -3
        if rocket_raylib.is_key_down(window, rocket_raylib.key_down()):
            velocity_y = 3
        if rocket_raylib.is_mouse_pressed(window, rocket_raylib.mouse_left()):
            x = rocket_raylib.mouse_x(window)
            y = rocket_raylib.mouse_y(window)
        if audio_enabled and rocket_raylib.is_key_pressed(window, rocket_raylib.key_space()):
            let played = rocket_raylib.play_sound(sound)
        x = x + velocity_x
        y = y + velocity_y
        if x < 90 or x > 850:
            velocity_x = 0 - velocity_x
        if y < 130 or y > 470:
            velocity_y = 0 - velocity_y
        if frame_number / 6 * 6 == frame_number:
            trail = collections.append(trail, x)
            trail = collections.append(trail, y)
        if collections.length(trail) > 160:
            trail = collections.clear(trail)
        match rocket_raylib.begin_frame(window):
            case Ok(frame):
                let cleared = rocket_raylib.clear(frame, rocket_raylib.black())
                let panel = rocket_raylib.draw_rectangle(frame, 42, 62, 876, 472, rocket_raylib.color(30, 39, 57, 255))
                let heading = rocket_raylib.draw_text(frame, "Rocket + raylib: Orbital Workshop", 64, 80, 28, rocket_raylib.white())
                let details = rocket_raylib.draw_text(frame, description, 64, 116, 18, rocket_raylib.sky())
                let controls = rocket_raylib.draw_text(frame, "Arrows move | click relocates | space plays audio | escape exits", 64, 504, 16, rocket_raylib.color(180, 190, 210, 255))
                let elapsed = rocket_raylib.elapsed_time(window)
                let pulse_value = rocket_raylib.apply_pulse(frame_number - frame_number / 60 * 60)
                let orbit = rocket_raylib.draw_circle(frame, 480, 300, 116.0, rocket_raylib.color(45, 58, 82, 255))
                let trail_drawn = draw_trail(frame, trail)
                let sprite = rocket_raylib.draw_texture_scaled(frame, texture, x - texture.width * 4, y - texture.height * 4, 8.0, rocket_raylib.white())
                let satellite = rocket_raylib.draw_circle(frame, 104 + pulse_value - pulse_value / 720 * 720, 468, 7.0, rocket_raylib.accent())
                let ended = rocket_raylib.end_frame(frame)
            case Err(error):
                print(error)
                return 21
        frame_number = frame_number + 1
    return 0

fn run_silent(window: rocket_raylib.Window, texture: rocket_raylib.Texture) -> Int:
    let invalid_sound = rocket_raylib.Sound(0)
    let status = scene(window, texture, invalid_sound, false)
    let texture_closed = rocket_raylib.unload_texture(texture)
    let window_closed = rocket_raylib.close_window(window)
    return status

fn run_with_audio(window: rocket_raylib.Window, texture: rocket_raylib.Texture, audio: rocket_raylib.AudioDevice, sound: rocket_raylib.Sound) -> Int:
    let volume = rocket_raylib.set_sound_volume(sound, 0.35)
    let status = scene(window, texture, sound, true)
    let stopped = rocket_raylib.stop_sound(sound)
    let sound_closed = rocket_raylib.unload_sound(sound)
    let audio_closed = rocket_raylib.close_audio(audio)
    let texture_closed = rocket_raylib.unload_texture(texture)
    let window_closed = rocket_raylib.close_window(window)
    return status

pub fn run() -> Int:
    match rocket_raylib.open_window(960, 600, "Rocket 1.4 raylib validation"):
        case Ok(window):
            let target = rocket_raylib.set_target_fps(window, 60)
            match rocket_raylib.load_texture(window, "assets/orbit.ppm"):
                case Ok(texture):
                    match rocket_raylib.open_audio():
                        case Ok(audio):
                            match rocket_raylib.create_tone(audio, 523.25, 0.12):
                                case Ok(sound):
                                    return run_with_audio(window, texture, audio, sound)
                                case Err(error):
                                    print("Audio tone unavailable; continuing silently")
                                    let audio_closed = rocket_raylib.close_audio(audio)
                                    return run_silent(window, texture)
                        case Err(error):
                            print("Audio device unavailable; continuing silently")
                            return run_silent(window, texture)
                case Err(error):
                    print(error)
                    let closed = rocket_raylib.close_window(window)
                    return 12
        case Err(error):
            print(error)
            return 11
