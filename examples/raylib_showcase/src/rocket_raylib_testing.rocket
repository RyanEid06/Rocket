pub fn render_target_switch_count() -> Int:
    unsafe:
        return rocket_raylib_adapter.rlv_render_target_switch_count()

pub fn scissor_switch_count() -> Int:
    unsafe:
        return rocket_raylib_adapter.rlv_scissor_switch_count()

pub fn blend_switch_count() -> Int:
    unsafe:
        return rocket_raylib_adapter.rlv_blend_switch_count()

pub fn screenshot_count() -> Int:
    unsafe:
        return rocket_raylib_adapter.rlv_screenshot_count()

pub fn shader_live_count() -> Int:
    unsafe:
        return rocket_raylib_adapter.rlv_shader_live_count()

pub fn shader_uniform_live_count() -> Int:
    unsafe:
        return rocket_raylib_adapter.rlv_shader_uniform_live_count()

pub fn shader_switch_count() -> Int:
    unsafe:
        return rocket_raylib_adapter.rlv_shader_switch_count()

pub fn font_live_count() -> Int:
