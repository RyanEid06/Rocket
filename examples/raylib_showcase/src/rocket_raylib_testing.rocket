        return rocket_raylib_adapter.rlv_texture_live_count()

pub fn render_texture_live_count() -> Int:
    unsafe:
        return rocket_raylib_adapter.rlv_render_texture_live_count()

pub fn scope_depth() -> Int:
    unsafe:
