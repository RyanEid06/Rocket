pub fn set_display_metrics(logical_width: Int, logical_height: Int, framebuffer_width: Int, framebuffer_height: Int, dpi_scale_x: Float, dpi_scale_y: Float, monitor_count: Int, current_monitor: Int) -> Bool:
    unsafe:
        return checked(rocket_raylib_adapter.rlv_test_set_display_metrics(logical_width, logical_height, framebuffer_width, framebuffer_height, dpi_scale_x, dpi_scale_y, monitor_count, current_monitor))

pub fn set_display_capabilities(resize: Bool, fullscreen: Bool, borderless: Bool, monitor_selection: Bool, screenshot: Bool) -> Bool:
    unsafe:
        return checked(rocket_raylib_adapter.rlv_test_set_display_capabilities(resize, fullscreen, borderless, monitor_selection, screenshot))
