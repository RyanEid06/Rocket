        return rocket_raylib_adapter.rlv_sound_live_count()

pub fn set_test_anisotropy(level: Int) -> Bool:
    unsafe:
        return checked(rocket_raylib_adapter.rlv_test_set_anisotropy(level))

pub fn set_shader_supported(supported: Bool) -> Bool:
