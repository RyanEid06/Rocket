import src.rocket_raylib_adapter
import src.rocket_raylib_callbacks
import std.collections
import std.string

# Safe Rocket-facing wrapper for the primitive-only adapter generated by
# `rocketc bind`. Every foreign call stays in this module's explicit unsafe
# blocks. Positive resource ids are generation-like tokens validated by the
# native adapter; stale or forged tokens become Result errors, never memory
# access.

pub struct Color:
    red: Int
    green: Int
    blue: Int
    alpha: Int

pub struct Point:
    x: Float
    y: Float

pub struct Rect:
    x: Float
    y: Float
    width: Float
    height: Float

pub struct Window:
    id: Int

pub struct Frame:
    window_id: Int

pub struct Texture:
    id: Int
    width: Int
    height: Int

pub struct Font:
    id: Int

pub struct AudioDevice:
    id: Int

pub struct Sound:
    id: Int

pub fn color(red: Int, green: Int, blue: Int, alpha: Int) -> Color:
    return Color(red, green, blue, alpha)

pub fn black() -> Color:
    return Color(18, 22, 31, 255)

pub fn white() -> Color:
    return Color(245, 245, 245, 255)

pub fn sky() -> Color:
    return Color(102, 191, 255, 255)

pub fn accent() -> Color:
    return Color(255, 183, 3, 255)

pub fn key_space() -> Int:
    return rocket_raylib_adapter.RLV_KEY_SPACE

pub fn key_escape() -> Int:
    return rocket_raylib_adapter.RLV_KEY_ESCAPE

pub fn key_right() -> Int:
    return rocket_raylib_adapter.RLV_KEY_RIGHT

pub fn key_left() -> Int:
    return rocket_raylib_adapter.RLV_KEY_LEFT

pub fn key_down() -> Int:
    return rocket_raylib_adapter.RLV_KEY_DOWN

pub fn key_up() -> Int:
    return rocket_raylib_adapter.RLV_KEY_UP

pub fn mouse_left() -> Int:
    return rocket_raylib_adapter.RLV_MOUSE_LEFT

pub fn point(x: Float, y: Float) -> Point:
    return Point(x, y)

pub fn rect(x: Float, y: Float, width: Float, height: Float) -> Rect:
    return Rect(x, y, width, height)

pub fn texture_filter_point() -> Int:
    return rocket_raylib_adapter.RLV_TEXTURE_FILTER_POINT

pub fn texture_filter_bilinear() -> Int:
    return rocket_raylib_adapter.RLV_TEXTURE_FILTER_BILINEAR

pub fn texture_filter_trilinear() -> Int:
    return rocket_raylib_adapter.RLV_TEXTURE_FILTER_TRILINEAR

pub fn texture_filter_anisotropic_4x() -> Int:
    return rocket_raylib_adapter.RLV_TEXTURE_FILTER_ANISOTROPIC_4X

pub fn texture_filter_anisotropic_8x() -> Int:
    return rocket_raylib_adapter.RLV_TEXTURE_FILTER_ANISOTROPIC_8X

pub fn texture_filter_anisotropic_16x() -> Int:
    return rocket_raylib_adapter.RLV_TEXTURE_FILTER_ANISOTROPIC_16X


fn status_message(status: Int) -> String:
    if status == rocket_raylib_adapter.RLV_ERR_INVALID_ARGUMENT:
        return "raylib: invalid argument"
    if status == rocket_raylib_adapter.RLV_ERR_INVALID_STATE:
        return "raylib: invalid lifecycle state"
    if status == rocket_raylib_adapter.RLV_ERR_NOT_FOUND:
        return "raylib: asset not found or invalid"
    if status == rocket_raylib_adapter.RLV_ERR_RESOURCE_LIVE:
        return "raylib: owned resource is still live"
    if status == rocket_raylib_adapter.RLV_ERR_UNAVAILABLE:
        return "raylib: device or backend unavailable"
    if status == rocket_raylib_adapter.RLV_ERR_STALE_HANDLE:
        return "raylib: stale or already released handle"
    return "raylib: unknown native failure"

fn status_result(status: Int) -> Result[Bool, String]:
    if status == rocket_raylib_adapter.RLV_OK:
        return Ok(true)
    return Err(status_message(status))

fn finite(value: Float) -> Bool:
    return value == value and value - value == 0.0

fn valid_rectangle(x: Float, y: Float, width: Float, height: Float) -> Bool:
    return finite(x) and finite(y) and finite(width) and finite(height) and width >= 0.0 and height >= 0.0

fn valid_circle(x: Float, y: Float, radius: Float) -> Bool:
    return finite(x) and finite(y) and finite(radius) and radius >= 0.0

fn valid_color_channel(channel: Int) -> Bool:
    return channel >= 0 and channel <= 255

fn valid_color(value: Color) -> Bool:
    return valid_color_channel(value.red) and valid_color_channel(value.green) and valid_color_channel(value.blue) and valid_color_channel(value.alpha)

fn abs_float(value: Float) -> Float:
    if value < 0.0:
        return 0.0 - value
    return value


fn invalid_geometry() -> Result[Bool, String]:
    return Err("raylib: invalid argument")

fn encode_text(value: String) -> Result[Int, String]:
    unsafe:
        let buffer_id = rocket_raylib_adapter.rlv_buffer_create()
        if buffer_id <= 0:
            return Err(status_message(buffer_id))
        var index = 0
        while index < string.byte_length(value):
            let status = rocket_raylib_adapter.rlv_buffer_push(buffer_id, string.byte_at(value, index))
            if status != rocket_raylib_adapter.RLV_OK:
                rocket_raylib_adapter.rlv_buffer_destroy(buffer_id)
                return Err(status_message(status))
            index = index + 1
        return Ok(buffer_id)

fn release_text(buffer_id: Int) -> Result[Bool, String]:
    unsafe:
        return status_result(rocket_raylib_adapter.rlv_buffer_destroy(buffer_id))

pub fn version_major() -> Int:
    unsafe:
        return rocket_raylib_adapter.rlv_version_major()

pub fn version_minor() -> Int:
    unsafe:
        return rocket_raylib_adapter.rlv_version_minor()

pub fn open_window(width: Int, height: Int, title: String) -> Result[Window, String]:
    match encode_text(title):
        case Ok(buffer_id):
            var window_id = 0
            unsafe:
                window_id = rocket_raylib_adapter.rlv_window_open(width, height, buffer_id)
            let released = release_text(buffer_id)
            if window_id > 0:
                return Ok(Window(window_id))
            return Err(status_message(window_id))
        case Err(error):
            return Err(error)

pub fn close_window(window: Window) -> Result[Bool, String]:
    unsafe:
        return status_result(rocket_raylib_adapter.rlv_window_close(window.id))

pub fn window_ready(window: Window) -> Bool:
    unsafe:
        return rocket_raylib_adapter.rlv_window_ready(window.id)

pub fn window_should_close(window: Window) -> Bool:
    unsafe:
        return rocket_raylib_adapter.rlv_window_should_close(window.id)

pub fn set_target_fps(window: Window, fps: Int) -> Result[Bool, String]:
    unsafe:
        return status_result(rocket_raylib_adapter.rlv_set_target_fps(window.id, fps))

pub fn frame_time(window: Window) -> Float:
    unsafe:
        return rocket_raylib_adapter.rlv_frame_time(window.id)

pub fn elapsed_time(window: Window) -> Float:
    unsafe:
        return rocket_raylib_adapter.rlv_time(window.id)

pub fn begin_frame(window: Window) -> Result[Frame, String]:
    unsafe:
        let frame_id = rocket_raylib_adapter.rlv_begin_drawing(window.id)
        if frame_id > 0:
            return Ok(Frame(frame_id))
        return Err(status_message(frame_id))

pub fn end_frame(frame: Frame) -> Result[Bool, String]:
    unsafe:
        return status_result(rocket_raylib_adapter.rlv_end_drawing(frame.window_id))

pub fn clear(frame: Frame, value: Color) -> Result[Bool, String]:
    unsafe:
        return status_result(rocket_raylib_adapter.rlv_clear_background(frame.window_id, value.red, value.green, value.blue, value.alpha))

pub fn draw_rectangle(frame: Frame, x: Int, y: Int, width: Int, height: Int, value: Color) -> Result[Bool, String]:
    if width < 0 or height < 0:
        return invalid_geometry()
    unsafe:
        return status_result(rocket_raylib_adapter.rlv_draw_rectangle(frame.window_id, x, y, width, height, value.red, value.green, value.blue, value.alpha))

pub fn draw_circle(frame: Frame, x: Int, y: Int, radius: Float, value: Color) -> Result[Bool, String]:
    if not finite(radius) or radius < 0.0:
        return invalid_geometry()
    unsafe:
        return status_result(rocket_raylib_adapter.rlv_draw_circle(frame.window_id, x, y, radius, value.red, value.green, value.blue, value.alpha))

pub fn draw_rectangle_outline(frame: Frame, x: Float, y: Float, width: Float, height: Float, thickness: Float, value: Color) -> Result[Bool, String]:
    if not valid_rectangle(x, y, width, height) or not finite(thickness) or thickness < 0.0:
        return invalid_geometry()
    unsafe:
        return status_result(rocket_raylib_adapter.rlv_draw_rectangle_outline(frame.window_id, x, y, width, height, thickness, value.red, value.green, value.blue, value.alpha))

pub fn draw_rounded_rectangle(frame: Frame, x: Float, y: Float, width: Float, height: Float, roundness: Float, value: Color) -> Result[Bool, String]:
    if not valid_rectangle(x, y, width, height) or not finite(roundness) or roundness < 0.0 or roundness > 1.0:
        return invalid_geometry()
    unsafe:
        return status_result(rocket_raylib_adapter.rlv_draw_rounded_rectangle(frame.window_id, x, y, width, height, roundness, value.red, value.green, value.blue, value.alpha))

pub fn draw_rounded_rectangle_outline(frame: Frame, x: Float, y: Float, width: Float, height: Float, roundness: Float, thickness: Float, value: Color) -> Result[Bool, String]:
    if not valid_rectangle(x, y, width, height) or not finite(roundness) or roundness < 0.0 or roundness > 1.0 or not finite(thickness) or thickness < 0.0:
        return invalid_geometry()
    unsafe:
        return status_result(rocket_raylib_adapter.rlv_draw_rounded_rectangle_outline(frame.window_id, x, y, width, height, roundness, thickness, value.red, value.green, value.blue, value.alpha))

pub fn draw_rectangle_gradient_vertical(frame: Frame, x: Float, y: Float, width: Float, height: Float, top: Color, bottom: Color) -> Result[Bool, String]:
    if not valid_rectangle(x, y, width, height):
        return invalid_geometry()
    unsafe:
        return status_result(rocket_raylib_adapter.rlv_draw_rectangle_gradient_vertical(frame.window_id, x, y, width, height, top.red, top.green, top.blue, top.alpha, bottom.red, bottom.green, bottom.blue, bottom.alpha))

pub fn draw_rectangle_gradient_horizontal(frame: Frame, x: Float, y: Float, width: Float, height: Float, left: Color, right: Color) -> Result[Bool, String]:
    if not valid_rectangle(x, y, width, height):
        return invalid_geometry()
    unsafe:
        return status_result(rocket_raylib_adapter.rlv_draw_rectangle_gradient_horizontal(frame.window_id, x, y, width, height, left.red, left.green, left.blue, left.alpha, right.red, right.green, right.blue, right.alpha))

pub fn draw_rectangle_gradient_four(frame: Frame, x: Float, y: Float, width: Float, height: Float, top_left: Color, bottom_left: Color, bottom_right: Color, top_right: Color) -> Result[Bool, String]:
    if not valid_rectangle(x, y, width, height):
        return invalid_geometry()
    unsafe:
        return status_result(rocket_raylib_adapter.rlv_draw_rectangle_gradient_four(frame.window_id, x, y, width, height, top_left.red, top_left.green, top_left.blue, top_left.alpha, bottom_left.red, bottom_left.green, bottom_left.blue, bottom_left.alpha, bottom_right.red, bottom_right.green, bottom_right.blue, bottom_right.alpha, top_right.red, top_right.green, top_right.blue, top_right.alpha))

pub fn draw_circle_outline(frame: Frame, x: Float, y: Float, radius: Float, thickness: Float, value: Color) -> Result[Bool, String]:
    if not valid_circle(x, y, radius) or not finite(thickness) or thickness < 0.0:
        return invalid_geometry()
    unsafe:
        return status_result(rocket_raylib_adapter.rlv_draw_circle_outline(frame.window_id, x, y, radius, thickness, value.red, value.green, value.blue, value.alpha))

pub fn draw_ellipse(frame: Frame, x: Float, y: Float, radius_x: Float, radius_y: Float, value: Color) -> Result[Bool, String]:
    if not finite(x) or not finite(y) or not finite(radius_x) or not finite(radius_y) or radius_x < 0.0 or radius_y < 0.0:
        return invalid_geometry()
    unsafe:
        return status_result(rocket_raylib_adapter.rlv_draw_ellipse(frame.window_id, x, y, radius_x, radius_y, value.red, value.green, value.blue, value.alpha))

pub fn draw_ellipse_outline(frame: Frame, x: Float, y: Float, radius_x: Float, radius_y: Float, value: Color) -> Result[Bool, String]:
    if not finite(x) or not finite(y) or not finite(radius_x) or not finite(radius_y) or radius_x < 0.0 or radius_y < 0.0:
        return invalid_geometry()
    unsafe:
        return status_result(rocket_raylib_adapter.rlv_draw_ellipse_outline(frame.window_id, x, y, radius_x, radius_y, value.red, value.green, value.blue, value.alpha))

fn valid_ring(x: Float, y: Float, inner_radius: Float, outer_radius: Float) -> Bool:
    return finite(x) and finite(y) and finite(inner_radius) and finite(outer_radius) and inner_radius >= 0.0 and outer_radius >= inner_radius

pub fn draw_ring(frame: Frame, x: Float, y: Float, inner_radius: Float, outer_radius: Float, value: Color) -> Result[Bool, String]:
    if not valid_ring(x, y, inner_radius, outer_radius):
        return invalid_geometry()
    unsafe:
        return status_result(rocket_raylib_adapter.rlv_draw_ring(frame.window_id, x, y, inner_radius, outer_radius, value.red, value.green, value.blue, value.alpha))

pub fn draw_ring_outline(frame: Frame, x: Float, y: Float, inner_radius: Float, outer_radius: Float, value: Color) -> Result[Bool, String]:
    if not valid_ring(x, y, inner_radius, outer_radius):
        return invalid_geometry()
    unsafe:
        return status_result(rocket_raylib_adapter.rlv_draw_ring_outline(frame.window_id, x, y, inner_radius, outer_radius, value.red, value.green, value.blue, value.alpha))

pub fn draw_ring_sector(frame: Frame, x: Float, y: Float, inner_radius: Float, outer_radius: Float, start_angle: Float, end_angle: Float, value: Color) -> Result[Bool, String]:
    if not valid_ring(x, y, inner_radius, outer_radius) or not finite(start_angle) or not finite(end_angle):
        return invalid_geometry()
    unsafe:
        return status_result(rocket_raylib_adapter.rlv_draw_ring_sector(frame.window_id, x, y, inner_radius, outer_radius, start_angle, end_angle, value.red, value.green, value.blue, value.alpha))

pub fn draw_circle_sector(frame: Frame, x: Float, y: Float, radius: Float, start_angle: Float, end_angle: Float, value: Color) -> Result[Bool, String]:
    if not valid_circle(x, y, radius) or not finite(start_angle) or not finite(end_angle):
        return invalid_geometry()
    unsafe:
        return status_result(rocket_raylib_adapter.rlv_draw_circle_sector(frame.window_id, x, y, radius, start_angle, end_angle, value.red, value.green, value.blue, value.alpha))

pub fn draw_circle_sector_outline(frame: Frame, x: Float, y: Float, radius: Float, start_angle: Float, end_angle: Float, value: Color) -> Result[Bool, String]:
    if not valid_circle(x, y, radius) or not finite(start_angle) or not finite(end_angle):
        return invalid_geometry()
    unsafe:
        return status_result(rocket_raylib_adapter.rlv_draw_circle_sector_outline(frame.window_id, x, y, radius, start_angle, end_angle, value.red, value.green, value.blue, value.alpha))

pub fn draw_circle_gradient(frame: Frame, x: Float, y: Float, radius: Float, inner: Color, outer: Color) -> Result[Bool, String]:
    if not valid_circle(x, y, radius):
        return invalid_geometry()
    unsafe:
        return status_result(rocket_raylib_adapter.rlv_draw_circle_gradient(frame.window_id, x, y, radius, inner.red, inner.green, inner.blue, inner.alpha, outer.red, outer.green, outer.blue, outer.alpha))

fn valid_line(start_x: Float, start_y: Float, end_x: Float, end_y: Float) -> Bool:
    return finite(start_x) and finite(start_y) and finite(end_x) and finite(end_y)

pub fn draw_line(frame: Frame, start_x: Float, start_y: Float, end_x: Float, end_y: Float, value: Color) -> Result[Bool, String]:
    if not valid_line(start_x, start_y, end_x, end_y):
        return invalid_geometry()
    unsafe:
        return status_result(rocket_raylib_adapter.rlv_draw_line(frame.window_id, start_x, start_y, end_x, end_y, value.red, value.green, value.blue, value.alpha))

pub fn draw_thick_line(frame: Frame, start_x: Float, start_y: Float, end_x: Float, end_y: Float, thickness: Float, value: Color) -> Result[Bool, String]:
    if not valid_line(start_x, start_y, end_x, end_y) or not finite(thickness) or thickness < 0.0:
        return invalid_geometry()
    unsafe:
        return status_result(rocket_raylib_adapter.rlv_draw_thick_line(frame.window_id, start_x, start_y, end_x, end_y, thickness, value.red, value.green, value.blue, value.alpha))

pub fn draw_triangle(frame: Frame, first_x: Float, first_y: Float, second_x: Float, second_y: Float, third_x: Float, third_y: Float, value: Color) -> Result[Bool, String]:
    if not valid_line(first_x, first_y, second_x, second_y) or not finite(third_x) or not finite(third_y):
        return invalid_geometry()
    unsafe:
        return status_result(rocket_raylib_adapter.rlv_draw_triangle(frame.window_id, first_x, first_y, second_x, second_y, third_x, third_y, value.red, value.green, value.blue, value.alpha))

pub fn draw_triangle_outline(frame: Frame, first_x: Float, first_y: Float, second_x: Float, second_y: Float, third_x: Float, third_y: Float, thickness: Float, value: Color) -> Result[Bool, String]:
    if not valid_line(first_x, first_y, second_x, second_y) or not finite(third_x) or not finite(third_y) or not finite(thickness) or thickness < 0.0:
        return invalid_geometry()
    unsafe:
        return status_result(rocket_raylib_adapter.rlv_draw_triangle_outline(frame.window_id, first_x, first_y, second_x, second_y, third_x, third_y, thickness, value.red, value.green, value.blue, value.alpha))

pub fn draw_polygon(frame: Frame, x: Float, y: Float, sides: Int, radius: Float, rotation: Float, value: Color) -> Result[Bool, String]:
    if not valid_circle(x, y, radius) or sides < 3 or not finite(rotation):
        return invalid_geometry()
    unsafe:
        return status_result(rocket_raylib_adapter.rlv_draw_polygon(frame.window_id, x, y, sides, radius, rotation, value.red, value.green, value.blue, value.alpha))

pub fn draw_polygon_outline(frame: Frame, x: Float, y: Float, sides: Int, radius: Float, rotation: Float, thickness: Float, value: Color) -> Result[Bool, String]:
    if not valid_circle(x, y, radius) or sides < 3 or not finite(rotation) or not finite(thickness) or thickness < 0.0:
        return invalid_geometry()
    unsafe:
        return status_result(rocket_raylib_adapter.rlv_draw_polygon_outline(frame.window_id, x, y, sides, radius, rotation, thickness, value.red, value.green, value.blue, value.alpha))

pub fn draw_bezier_line(frame: Frame, start_x: Float, start_y: Float, end_x: Float, end_y: Float, thickness: Float, value: Color) -> Result[Bool, String]:
    if not valid_line(start_x, start_y, end_x, end_y) or not finite(thickness) or thickness < 0.0:
        return invalid_geometry()
    unsafe:
        return status_result(rocket_raylib_adapter.rlv_draw_bezier_line(frame.window_id, start_x, start_y, end_x, end_y, thickness, value.red, value.green, value.blue, value.alpha))

fn valid_points(points: Array[Point]) -> Bool:
    var index = 0
    while index < collections.length(points):
        if not finite(points[index].x) or not finite(points[index].y):
            return false
        index = index + 1
    return true

fn draw_bezier_points(frame: Frame, points: Array[Point], thickness: Float, value: Color, cubic: Bool) -> Result[Bool, String]:
    let count = collections.length(points)
    if not valid_points(points) or not finite(thickness) or thickness < 0.0:
        return invalid_geometry()
    if cubic and(count < 4 or(count - 1) / 3 * 3 != count - 1):
        return invalid_geometry()
    if not cubic and(count < 3 or(count - 1) / 2 * 2 != count - 1):
        return invalid_geometry()
    unsafe:
        let buffer_id = rocket_raylib_adapter.rlv_point_buffer_create()
        if buffer_id <= 0:
            return Err(status_message(buffer_id))
        var index = 0
        while index < count:
            let pushed = rocket_raylib_adapter.rlv_point_buffer_push(buffer_id, points[index].x, points[index].y)
            if pushed != rocket_raylib_adapter.RLV_OK:
                rocket_raylib_adapter.rlv_point_buffer_destroy(buffer_id)
                return Err(status_message(pushed))
            index = index + 1
        var status = rocket_raylib_adapter.RLV_ERR_INVALID_STATE
        if cubic:
            status = rocket_raylib_adapter.rlv_draw_bezier_cubic(frame.window_id, buffer_id, thickness, value.red, value.green, value.blue, value.alpha)
        else:
            status = rocket_raylib_adapter.rlv_draw_bezier_quadratic(frame.window_id, buffer_id, thickness, value.red, value.green, value.blue, value.alpha)
        let released = rocket_raylib_adapter.rlv_point_buffer_destroy(buffer_id)
        if released != rocket_raylib_adapter.RLV_OK:
            return Err(status_message(released))
        return status_result(status)

pub fn draw_bezier_quadratic(frame: Frame, points: Array[Point], thickness: Float, value: Color) -> Result[Bool, String]:
    return draw_bezier_points(frame, points, thickness, value, false)

pub fn draw_bezier_cubic(frame: Frame, points: Array[Point], thickness: Float, value: Color) -> Result[Bool, String]:
    return draw_bezier_points(frame, points, thickness, value, true)

pub fn draw_text(frame: Frame, text: String, x: Int, y: Int, size: Int, value: Color) -> Result[Bool, String]:
    match encode_text(text):
        case Ok(buffer_id):
            var status = rocket_raylib_adapter.RLV_ERR_INVALID_STATE
            unsafe:
                status = rocket_raylib_adapter.rlv_draw_text(frame.window_id, buffer_id, x, y, size, value.red, value.green, value.blue, value.alpha)
            let released = release_text(buffer_id)
            return status_result(status)
        case Err(error):
            return Err(error)

pub fn is_key_pressed(window: Window, key: Int) -> Bool:
    unsafe:
        return rocket_raylib_adapter.rlv_key_pressed(window.id, key)

pub fn is_key_down(window: Window, key: Int) -> Bool:
    unsafe:
        return rocket_raylib_adapter.rlv_key_down(window.id, key)

pub fn is_mouse_pressed(window: Window, button: Int) -> Bool:
    unsafe:
        return rocket_raylib_adapter.rlv_mouse_pressed(window.id, button)

pub fn mouse_x(window: Window) -> Int:
    unsafe:
        return rocket_raylib_adapter.rlv_mouse_x(window.id)

pub fn mouse_y(window: Window) -> Int:
    unsafe:
        return rocket_raylib_adapter.rlv_mouse_y(window.id)

pub fn load_texture(window: Window, path: String) -> Result[Texture, String]:
    match encode_text(path):
        case Ok(buffer_id):
            var texture_id = 0
            unsafe:
                texture_id = rocket_raylib_adapter.rlv_texture_load(window.id, buffer_id)
            let released = release_text(buffer_id)
            if texture_id <= 0:
                return Err(status_message(texture_id))
            unsafe:
                let width = rocket_raylib_adapter.rlv_texture_width(texture_id)
                let height = rocket_raylib_adapter.rlv_texture_height(texture_id)
                return Ok(Texture(texture_id, width, height))
        case Err(error):
            return Err(error)

pub fn draw_texture(frame: Frame, texture: Texture, x: Int, y: Int, tint: Color) -> Result[Bool, String]:
    unsafe:
        return status_result(rocket_raylib_adapter.rlv_texture_draw(frame.window_id, texture.id, x, y, tint.red, tint.green, tint.blue, tint.alpha))

pub fn draw_texture_scaled(frame: Frame, texture: Texture, x: Int, y: Int, scale: Float, tint: Color) -> Result[Bool, String]:
    unsafe:
        return status_result(rocket_raylib_adapter.rlv_texture_draw_scaled(frame.window_id, texture.id, x, y, scale, tint.red, tint.green, tint.blue, tint.alpha))

pub fn draw_texture_pro(frame: Frame, texture: Texture, source: Rect, dest: Rect, origin: Point, rotation: Float, tint: Color) -> Result[Bool, String]:
    if frame.window_id <= 0 or texture.id <= 0:
        return Err("raylib: stale or already released handle")
    if not finite(source.x) or not finite(source.y) or not finite(source.width) or not finite(source.height):
        return invalid_geometry()
    if not finite(dest.x) or not finite(dest.y) or not finite(dest.width) or not finite(dest.height):
        return invalid_geometry()
    if not finite(origin.x) or not finite(origin.y) or not finite(rotation):
        return invalid_geometry()
    if not valid_color(tint):
        return invalid_geometry()
    if source.width == 0.0 or source.height == 0.0:
        return invalid_geometry()
    if source.x < 0.0 or source.y < 0.0:
        return invalid_geometry()
    unsafe:
        return status_result(rocket_raylib_adapter.rlv_texture_draw_pro(frame.window_id, texture.id, source.x, source.y, source.width, source.height, dest.x, dest.y, dest.width, dest.height, origin.x, origin.y, rotation, tint.red, tint.green, tint.blue, tint.alpha))

pub fn texture_filter_supported(filter_mode: Int) -> Bool:
    unsafe:
        return rocket_raylib_adapter.rlv_texture_filter_supported(filter_mode)

pub fn texture_max_anisotropy() -> Float:
    unsafe:
        return rocket_raylib_adapter.rlv_texture_max_anisotropy()

pub fn get_texture_filter(texture: Texture) -> Result[Int, String]:
    if texture.id <= 0:
        return Err("raylib: stale or already released handle")
    unsafe:
        let mode = rocket_raylib_adapter.rlv_texture_get_filter(texture.id)
        if mode < 0:
            return Err(status_message(mode))
        return Ok(mode)

pub fn set_texture_filter(window: Window, texture: Texture, filter_mode: Int) -> Result[Bool, String]:
    if window.id <= 0 or texture.id <= 0:
        return Err("raylib: stale or already released handle")
    if filter_mode < rocket_raylib_adapter.RLV_TEXTURE_FILTER_POINT or filter_mode > rocket_raylib_adapter.RLV_TEXTURE_FILTER_ANISOTROPIC_16X:
        return Err("raylib: invalid argument")
    if not texture_filter_supported(filter_mode):
        return Err("raylib: device or backend unavailable")
    unsafe:
        return status_result(rocket_raylib_adapter.rlv_texture_set_filter(window.id, texture.id, filter_mode))

pub fn resolve_texture_filter_fallback(preferred_mode: Int, fallback_mode: Int) -> Result[Int, String]:
    if preferred_mode < rocket_raylib_adapter.RLV_TEXTURE_FILTER_POINT or preferred_mode > rocket_raylib_adapter.RLV_TEXTURE_FILTER_ANISOTROPIC_16X:
        return Err("raylib: invalid argument")
    if fallback_mode < rocket_raylib_adapter.RLV_TEXTURE_FILTER_POINT or fallback_mode > rocket_raylib_adapter.RLV_TEXTURE_FILTER_ANISOTROPIC_16X:
        return Err("raylib: invalid argument")
    if texture_filter_supported(preferred_mode):
        return Ok(preferred_mode)
    if texture_filter_supported(fallback_mode):
        return Ok(fallback_mode)
    return Err("raylib: device or backend unavailable")

pub fn set_texture_filter_with_fallback(window: Window, texture: Texture, preferred_mode: Int, fallback_mode: Int) -> Result[Int, String]:
    match resolve_texture_filter_fallback(preferred_mode, fallback_mode):
        case Ok(resolved_mode):
            match set_texture_filter(window, texture, resolved_mode):
                case Ok(success):
                    return Ok(resolved_mode)
                case Err(error):
                    return Err(error)
        case Err(error):
            return Err(error)


pub fn unload_texture(texture: Texture) -> Result[Bool, String]:
    unsafe:
        return status_result(rocket_raylib_adapter.rlv_texture_unload(texture.id))

pub fn load_font(window: Window, path: String) -> Result[Font, String]:
    match encode_text(path):
        case Ok(buffer_id):
            var font_id = 0
            unsafe:
                font_id = rocket_raylib_adapter.rlv_font_load(window.id, buffer_id)
            let released = release_text(buffer_id)
            if font_id > 0:
                return Ok(Font(font_id))
            return Err(status_message(font_id))
        case Err(error):
            return Err(error)

pub fn draw_font_text(frame: Frame, font: Font, text: String, x: Int, y: Int, size: Float, spacing: Float, value: Color) -> Result[Bool, String]:
    match encode_text(text):
        case Ok(buffer_id):
            var status = rocket_raylib_adapter.RLV_ERR_INVALID_STATE
            unsafe:
                status = rocket_raylib_adapter.rlv_font_draw(frame.window_id, font.id, buffer_id, x, y, size, spacing, value.red, value.green, value.blue, value.alpha)
            let released = release_text(buffer_id)
            return status_result(status)
        case Err(error):
            return Err(error)

pub fn unload_font(font: Font) -> Result[Bool, String]:
    unsafe:
        return status_result(rocket_raylib_adapter.rlv_font_unload(font.id))

pub fn open_audio() -> Result[AudioDevice, String]:
    unsafe:
        let audio_id = rocket_raylib_adapter.rlv_audio_open()
        if audio_id > 0:
            return Ok(AudioDevice(audio_id))
        return Err(status_message(audio_id))

pub fn close_audio(audio: AudioDevice) -> Result[Bool, String]:
    unsafe:
        return status_result(rocket_raylib_adapter.rlv_audio_close(audio.id))

pub fn audio_ready(audio: AudioDevice) -> Bool:
    unsafe:
        return rocket_raylib_adapter.rlv_audio_ready(audio.id)

pub fn load_sound(audio: AudioDevice, path: String) -> Result[Sound, String]:
    match encode_text(path):
        case Ok(buffer_id):
            var sound_id = 0
            unsafe:
                sound_id = rocket_raylib_adapter.rlv_sound_load(audio.id, buffer_id)
            let released = release_text(buffer_id)
            if sound_id > 0:
                return Ok(Sound(sound_id))
            return Err(status_message(sound_id))
        case Err(error):
            return Err(error)

pub fn create_tone(audio: AudioDevice, frequency: Float, seconds: Float) -> Result[Sound, String]:
    unsafe:
        let sound_id = rocket_raylib_adapter.rlv_sound_tone(audio.id, frequency, seconds)
        if sound_id > 0:
            return Ok(Sound(sound_id))
        return Err(status_message(sound_id))

pub fn play_sound(sound: Sound) -> Result[Bool, String]:
    unsafe:
        return status_result(rocket_raylib_adapter.rlv_sound_play(sound.id))

pub fn stop_sound(sound: Sound) -> Result[Bool, String]:
    unsafe:
        return status_result(rocket_raylib_adapter.rlv_sound_stop(sound.id))

pub fn set_sound_volume(sound: Sound, volume: Float) -> Result[Bool, String]:
    unsafe:
        return status_result(rocket_raylib_adapter.rlv_sound_set_volume(sound.id, volume))

pub fn unload_sound(sound: Sound) -> Result[Bool, String]:
    unsafe:
        return status_result(rocket_raylib_adapter.rlv_sound_unload(sound.id))

pub fn apply_pulse(value: Int) -> Int:
    unsafe:
        return rocket_raylib_adapter.rlv_apply_callback(rocket_raylib_callbacks.pulse, value)
