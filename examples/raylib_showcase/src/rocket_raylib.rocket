import src.rocket_raylib_adapter
import src.rocket_raylib_callbacks
import std.string

# Safe Rocket-facing wrapper for the primitive-only adapter generated by
# `rocketc bind`. Every foreign call stays in this module's explicit unsafe
# blocks. Positive resource ids are generation-like tokens validated by the
# native adapter; stale or forged tokens become Result errors, never memory
# access.

pub struct Color:
    red: Int
    green: Int
    blue: Int
    alpha: Int

pub struct Window:
    id: Int

pub struct Frame:
    window_id: Int

pub struct Texture:
    id: Int
    width: Int
    height: Int

pub struct Font:
    id: Int

pub struct AudioDevice:
    id: Int

pub struct Sound:
    id: Int

pub fn color(red: Int, green: Int, blue: Int, alpha: Int) -> Color:
    return Color(red, green, blue, alpha)

pub fn black() -> Color:
    return Color(18, 22, 31, 255)

pub fn white() -> Color:
    return Color(245, 245, 245, 255)

pub fn sky() -> Color:
    return Color(102, 191, 255, 255)

pub fn accent() -> Color:
    return Color(255, 183, 3, 255)

pub fn key_space() -> Int:
    return rocket_raylib_adapter.RLV_KEY_SPACE

pub fn key_escape() -> Int:
    return rocket_raylib_adapter.RLV_KEY_ESCAPE

pub fn key_right() -> Int:
    return rocket_raylib_adapter.RLV_KEY_RIGHT

pub fn key_left() -> Int:
    return rocket_raylib_adapter.RLV_KEY_LEFT

pub fn key_down() -> Int:
    return rocket_raylib_adapter.RLV_KEY_DOWN

pub fn key_up() -> Int:
    return rocket_raylib_adapter.RLV_KEY_UP

pub fn mouse_left() -> Int:
    return rocket_raylib_adapter.RLV_MOUSE_LEFT

fn status_message(status: Int) -> String:
    if status == rocket_raylib_adapter.RLV_ERR_INVALID_ARGUMENT:
        return "raylib: invalid argument"
    if status == rocket_raylib_adapter.RLV_ERR_INVALID_STATE:
        return "raylib: invalid lifecycle state"
    if status == rocket_raylib_adapter.RLV_ERR_NOT_FOUND:
        return "raylib: asset not found or invalid"
    if status == rocket_raylib_adapter.RLV_ERR_RESOURCE_LIVE:
        return "raylib: owned resource is still live"
    if status == rocket_raylib_adapter.RLV_ERR_UNAVAILABLE:
        return "raylib: device or backend unavailable"
    if status == rocket_raylib_adapter.RLV_ERR_STALE_HANDLE:
        return "raylib: stale or already released handle"
    return "raylib: unknown native failure"

fn status_result(status: Int) -> Result[Bool, String]:
    if status == rocket_raylib_adapter.RLV_OK:
        return Ok(true)
    return Err(status_message(status))

fn encode_text(value: String) -> Result[Int, String]:
    unsafe:
        let buffer_id = rocket_raylib_adapter.rlv_buffer_create()
        if buffer_id <= 0:
            return Err(status_message(buffer_id))
        var index = 0
        while index < string.byte_length(value):
            let status = rocket_raylib_adapter.rlv_buffer_push(buffer_id, string.byte_at(value, index))
            if status != rocket_raylib_adapter.RLV_OK:
                rocket_raylib_adapter.rlv_buffer_destroy(buffer_id)
                return Err(status_message(status))
            index = index + 1
        return Ok(buffer_id)

fn release_text(buffer_id: Int) -> Result[Bool, String]:
    unsafe:
        return status_result(rocket_raylib_adapter.rlv_buffer_destroy(buffer_id))

pub fn version_major() -> Int:
    unsafe:
        return rocket_raylib_adapter.rlv_version_major()

pub fn version_minor() -> Int:
    unsafe:
        return rocket_raylib_adapter.rlv_version_minor()

pub fn open_window(width: Int, height: Int, title: String) -> Result[Window, String]:
    match encode_text(title):
        case Ok(buffer_id):
            var window_id = 0
            unsafe:
                window_id = rocket_raylib_adapter.rlv_window_open(width, height, buffer_id)
            let released = release_text(buffer_id)
            if window_id > 0:
                return Ok(Window(window_id))
            return Err(status_message(window_id))
        case Err(error):
            return Err(error)

pub fn close_window(window: Window) -> Result[Bool, String]:
    unsafe:
        return status_result(rocket_raylib_adapter.rlv_window_close(window.id))

pub fn window_ready(window: Window) -> Bool:
    unsafe:
        return rocket_raylib_adapter.rlv_window_ready(window.id)

pub fn window_should_close(window: Window) -> Bool:
    unsafe:
        return rocket_raylib_adapter.rlv_window_should_close(window.id)

pub fn set_target_fps(window: Window, fps: Int) -> Result[Bool, String]:
    unsafe:
        return status_result(rocket_raylib_adapter.rlv_set_target_fps(window.id, fps))

pub fn frame_time(window: Window) -> Float:
    unsafe:
        return rocket_raylib_adapter.rlv_frame_time(window.id)

pub fn elapsed_time(window: Window) -> Float:
    unsafe:
        return rocket_raylib_adapter.rlv_time(window.id)

pub fn begin_frame(window: Window) -> Result[Frame, String]:
    unsafe:
        let frame_id = rocket_raylib_adapter.rlv_begin_drawing(window.id)
        if frame_id > 0:
            return Ok(Frame(frame_id))
        return Err(status_message(frame_id))

pub fn end_frame(frame: Frame) -> Result[Bool, String]:
    unsafe:
        return status_result(rocket_raylib_adapter.rlv_end_drawing(frame.window_id))

pub fn clear(frame: Frame, value: Color) -> Result[Bool, String]:
    unsafe:
        return status_result(rocket_raylib_adapter.rlv_clear_background(frame.window_id, value.red, value.green, value.blue, value.alpha))

pub fn draw_rectangle(frame: Frame, x: Int, y: Int, width: Int, height: Int, value: Color) -> Result[Bool, String]:
    unsafe:
        return status_result(rocket_raylib_adapter.rlv_draw_rectangle(frame.window_id, x, y, width, height, value.red, value.green, value.blue, value.alpha))

pub fn draw_circle(frame: Frame, x: Int, y: Int, radius: Float, value: Color) -> Result[Bool, String]:
    unsafe:
        return status_result(rocket_raylib_adapter.rlv_draw_circle(frame.window_id, x, y, radius, value.red, value.green, value.blue, value.alpha))

pub fn draw_text(frame: Frame, text: String, x: Int, y: Int, size: Int, value: Color) -> Result[Bool, String]:
    match encode_text(text):
        case Ok(buffer_id):
            var status = rocket_raylib_adapter.RLV_ERR_INVALID_STATE
            unsafe:
                status = rocket_raylib_adapter.rlv_draw_text(frame.window_id, buffer_id, x, y, size, value.red, value.green, value.blue, value.alpha)
            let released = release_text(buffer_id)
            return status_result(status)
        case Err(error):
            return Err(error)

pub fn is_key_pressed(window: Window, key: Int) -> Bool:
    unsafe:
        return rocket_raylib_adapter.rlv_key_pressed(window.id, key)

pub fn is_key_down(window: Window, key: Int) -> Bool:
    unsafe:
        return rocket_raylib_adapter.rlv_key_down(window.id, key)

pub fn is_mouse_pressed(window: Window, button: Int) -> Bool:
    unsafe:
        return rocket_raylib_adapter.rlv_mouse_pressed(window.id, button)

pub fn mouse_x(window: Window) -> Int:
    unsafe:
        return rocket_raylib_adapter.rlv_mouse_x(window.id)

pub fn mouse_y(window: Window) -> Int:
    unsafe:
        return rocket_raylib_adapter.rlv_mouse_y(window.id)

pub fn load_texture(window: Window, path: String) -> Result[Texture, String]:
    match encode_text(path):
        case Ok(buffer_id):
            var texture_id = 0
            unsafe:
                texture_id = rocket_raylib_adapter.rlv_texture_load(window.id, buffer_id)
            let released = release_text(buffer_id)
            if texture_id <= 0:
                return Err(status_message(texture_id))
            unsafe:
                let width = rocket_raylib_adapter.rlv_texture_width(texture_id)
                let height = rocket_raylib_adapter.rlv_texture_height(texture_id)
                return Ok(Texture(texture_id, width, height))
        case Err(error):
            return Err(error)

pub fn draw_texture(frame: Frame, texture: Texture, x: Int, y: Int, tint: Color) -> Result[Bool, String]:
    unsafe:
        return status_result(rocket_raylib_adapter.rlv_texture_draw(frame.window_id, texture.id, x, y, tint.red, tint.green, tint.blue, tint.alpha))

pub fn draw_texture_scaled(frame: Frame, texture: Texture, x: Int, y: Int, scale: Float, tint: Color) -> Result[Bool, String]:
    unsafe:
        return status_result(rocket_raylib_adapter.rlv_texture_draw_scaled(frame.window_id, texture.id, x, y, scale, tint.red, tint.green, tint.blue, tint.alpha))

pub fn unload_texture(texture: Texture) -> Result[Bool, String]:
    unsafe:
        return status_result(rocket_raylib_adapter.rlv_texture_unload(texture.id))

pub fn load_font(window: Window, path: String) -> Result[Font, String]:
    match encode_text(path):
        case Ok(buffer_id):
            var font_id = 0
            unsafe:
                font_id = rocket_raylib_adapter.rlv_font_load(window.id, buffer_id)
            let released = release_text(buffer_id)
            if font_id > 0:
                return Ok(Font(font_id))
            return Err(status_message(font_id))
        case Err(error):
            return Err(error)

pub fn draw_font_text(frame: Frame, font: Font, text: String, x: Int, y: Int, size: Float, spacing: Float, value: Color) -> Result[Bool, String]:
    match encode_text(text):
        case Ok(buffer_id):
            var status = rocket_raylib_adapter.RLV_ERR_INVALID_STATE
            unsafe:
                status = rocket_raylib_adapter.rlv_font_draw(frame.window_id, font.id, buffer_id, x, y, size, spacing, value.red, value.green, value.blue, value.alpha)
            let released = release_text(buffer_id)
            return status_result(status)
        case Err(error):
            return Err(error)

pub fn unload_font(font: Font) -> Result[Bool, String]:
    unsafe:
        return status_result(rocket_raylib_adapter.rlv_font_unload(font.id))

pub fn open_audio() -> Result[AudioDevice, String]:
    unsafe:
        let audio_id = rocket_raylib_adapter.rlv_audio_open()
        if audio_id > 0:
            return Ok(AudioDevice(audio_id))
        return Err(status_message(audio_id))

pub fn close_audio(audio: AudioDevice) -> Result[Bool, String]:
    unsafe:
        return status_result(rocket_raylib_adapter.rlv_audio_close(audio.id))

pub fn audio_ready(audio: AudioDevice) -> Bool:
    unsafe:
        return rocket_raylib_adapter.rlv_audio_ready(audio.id)

pub fn load_sound(audio: AudioDevice, path: String) -> Result[Sound, String]:
    match encode_text(path):
        case Ok(buffer_id):
            var sound_id = 0
            unsafe:
                sound_id = rocket_raylib_adapter.rlv_sound_load(audio.id, buffer_id)
            let released = release_text(buffer_id)
            if sound_id > 0:
                return Ok(Sound(sound_id))
            return Err(status_message(sound_id))
        case Err(error):
            return Err(error)

pub fn create_tone(audio: AudioDevice, frequency: Float, seconds: Float) -> Result[Sound, String]:
    unsafe:
        let sound_id = rocket_raylib_adapter.rlv_sound_tone(audio.id, frequency, seconds)
        if sound_id > 0:
            return Ok(Sound(sound_id))
        return Err(status_message(sound_id))

pub fn play_sound(sound: Sound) -> Result[Bool, String]:
    unsafe:
        return status_result(rocket_raylib_adapter.rlv_sound_play(sound.id))

pub fn stop_sound(sound: Sound) -> Result[Bool, String]:
    unsafe:
        return status_result(rocket_raylib_adapter.rlv_sound_stop(sound.id))

pub fn set_sound_volume(sound: Sound, volume: Float) -> Result[Bool, String]:
    unsafe:
        return status_result(rocket_raylib_adapter.rlv_sound_set_volume(sound.id, volume))

pub fn unload_sound(sound: Sound) -> Result[Bool, String]:
    unsafe:
        return status_result(rocket_raylib_adapter.rlv_sound_unload(sound.id))

pub fn apply_pulse(value: Int) -> Int:
    unsafe:
        return rocket_raylib_adapter.rlv_apply_callback(rocket_raylib_callbacks.pulse, value)
