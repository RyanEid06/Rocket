import rocket.graphics
import src.rocket_raylib
import src.rocket_raylib_testing

fn succeeded(result: Result[Bool, String]) -> Bool:
    match result:
        case Ok(value):
            return value
        case Err(message):
            return false

fn main() -> Int:
    if not rocket_raylib_testing.enable() or not rocket_raylib_testing.reset():
        return 1
    match rocket_raylib.open_window(320, 180, "typography test"):
        case Err(message):
            return 2
        case Ok(window):
            match rocket_raylib.default_font(window):
                case Err(message):
                    return 3
                case Ok(font):
                    let style = graphics.text_style("default", 20.0, 2.0, 1.2)
                    match rocket_raylib.measure_text(font, "Hello", style):
                        case Err(message):
                            return 4
                        case Ok(layout):
                            if layout.line_count != 1 or layout.clipped or layout.ellipsized:
                                return 5
                            if layout.metrics.width != 58.0 or layout.metrics.height != 24.0 or layout.metrics.baseline != 16.0:
                                return 6
                    match rocket_raylib.measure_text(font, "one two three four", graphics.text_style("default", 20.0), max_width: 50.0, max_height: 45.0, wrap: true, overflow: graphics.text_overflow_ellipsis()):
                        case Err(message):
                            return 7
                        case Ok(layout):
                            if layout.line_count != 2 or not layout.clipped or not layout.ellipsized:
                                return 8
                    match rocket_raylib.begin_frame(window):
                        case Err(message):
                            return 9
                        case Ok(frame):
                            let bounds = graphics.rect(0.0, 0.0, 100.0, 50.0)
                            if not succeeded(rocket_raylib.draw_text_layout(frame, font, "Hello", bounds, style, rocket_raylib.white(), horizontal_align: graphics.text_align_center(), vertical_align: graphics.text_align_middle(), clip: true)):
                                return 10
                            if not succeeded(rocket_raylib.end_frame(frame)):
                                return 11
                    if rocket_raylib_testing.text_draw_x() != 21.0 or rocket_raylib_testing.text_draw_y() != 13.0:
                        return 12
                    if rocket_raylib_testing.measurement_cache_size() <= 0 or rocket_raylib_testing.measurement_cache_size() > rocket_raylib_testing.measurement_cache_capacity():
                        return 13
                    if not succeeded(rocket_raylib.invalidate_font_measurements(font)):
                        return 14
                    if rocket_raylib_testing.measurement_cache_size() != 0:
                        return 15
                    if not succeeded(rocket_raylib.unload_font(font)):
                        return 16
            if not succeeded(rocket_raylib.close_window(window)):
                return 17
    return 0
